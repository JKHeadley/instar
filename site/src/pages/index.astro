  <!-- Footer -->
  <footer class="py-8 border-t border-slate-800/50">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-slate-500 text-sm">
        <img src="/logo.png" alt="Instar" class="w-4 h-4 rounded-sm" />
        <span>Instar</span>
        <span class="text-slate-700">&middot;</span>
        <span>Built by <a href="https://sagemindai.io" class="hover:text-slate-400 transition-colors" target="_blank" rel="noopener">SageMind AI</a></span>
      </div>
      <p class="text-slate-600 text-xs">Every molt, more autonomous.</p>
    </div>
  </footer>

  <!-- Copy to clipboard script -->
  <script>
    document.querySelectorAll('#install-cmd, #install-cmd-bottom').forEach(el => {
      el.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('npx instar');
          const btn = el.querySelector('button');
          if (btn) {
            btn.innerHTML = '<svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>';
            setTimeout(() => {
              btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
            }, 2000);
          }
        } catch {}
      });
    });
  </script>
