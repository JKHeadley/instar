    {
      "id": "fix-worktree-monitor-test-isolation",
      "title": "Fix worktree-monitor test isolation bug",
      "description": "tests/unit/worktree-monitor.test.ts and possibly other tests using createWorktree-style helpers create branches like worktree-tracked, worktree-work, worktree-active in the parent repo (.git) rather than their isolated temp repo. This pollutes the actual feat/dashboard-grouped-nav branch with phantom commits during pre-push runs and triggers branch-already-exists collisions on every retry. Full pre-push test:smoke gate has been wedged on this for at least three sessions. Workaround used: INSTAR_PRE_PUSH_SKIP=1 + CI authority. Real fix: tests should use unique branch names per test (e.g. include a random suffix from mkdtemp), or createWorktree should be repo-isolation-verified before adding the branch.",
      "status": "active",
      "phases": [
        {
          "id": "investigate",
          "name": "Reproduce + isolate the leak path",
          "status": "pending"
        },
        {
          "id": "fix",
          "name": "Patch test helpers for branch-name uniqueness",
          "status": "pending"
        },
        {
          "id": "verify",
          "name": "Run full test:push twice in a row without pollution",
          "status": "pending"
        }
      ],
      "currentPhaseIndex": 0,
      "lastTouchedAt": "2026-05-08T17:03:56.794Z",
      "needsUser": false,
      "blockers": [],
      "links": [
        {
          "type": "topic",
