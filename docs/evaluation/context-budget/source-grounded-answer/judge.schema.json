{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:instar:evaluation:source-grounded-judge:v1",
  "title": "One semantic judge's criterion findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "submissionId",
    "criteria",
    "unlistedMaterialClaims",
    "limitations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "submissionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "verdict",
          "reason",
          "evidence",
          "answerClaimIds"
        ],
        "properties": {
          "criterionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "disputed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "answerClaimIds": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "collection",
                "recordId",
                "start",
                "end"
              ],
              "properties": {
                "collection": {
                  "enum": [
                    "source",
                    "answer"
                  ]
                },
                "recordId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "unlistedMaterialClaims": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordId",
          "start",
          "end",
          "reason"
        ],
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "recordId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
