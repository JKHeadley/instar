     1	#!/usr/bin/env node
     2	/**
     3	 * Telegram egress boundary.
     4	 *
     5	 * WHAT CHANGED, AND WHY IT IS A DIFFERENT KIND OF CHECK
     6	 *
     7	 * Its predecessor (`lint-telegram-send-funnel-guarded.mjs`) asked a question about SENDERS: for each
     8	 * one, is the guard present, imported, and in the right order? Review passes 34 and 35 showed that
     9	 * question cannot be answered without work that lint was not doing — it could not prove a call
    10	 * resolved to the imported guard (an unused import plus a shadowing local satisfied both halves), and
    11	 * it could only classify API methods written as direct string literals.
    12	 *
    13	 * Both gaps are properties of the QUESTION, not bugs in the answer. Asking "is each of six senders
    14	 * guarded" requires binding resolution and method inference. Asking "may anyone but the door reach
    15	 * the network" requires neither: a decoy import creates no `fetch`, and a method passed through a
    16	 * variable still travels in a URL. Moving the boundary made the hard sub-problems disappear rather
    17	 * than solving them, which is why this replaces its predecessor instead of extending it.
    18	 *
    19	 * WHAT IT PROVES
    20	 *   1. Exactly one file may call `fetch` on a Telegram Bot API URL: src/messaging/telegram-egress.ts.
    21	 *   2. That file runs the visibility check before its `fetch`.
    22	 *
    23	 * WHAT IT DOES NOT PROVE, stated because the previous version's claims outran its analysis:
    24	 *   - It resolves a URL through a LOCAL declaration or a local helper only. A Bot API URL assembled
    25	 *     in another module and imported would not be recognised.
    26	 *   - It does not follow a `fetch` reference stored in a variable and called indirectly.
    27	 *   Both are narrower than the gaps they replace, and both are named here rather than discovered.
    28	 *
    29	 * WHERE THIS ENDS AND THE TESTS BEGIN — established by sabotage, not by assumption. Breaking the
    30	 * door's OWN url-to-method recogniser (so it silently skips the check on every send) leaves this lint
    31	 * CLEAN: the boundary is intact, nobody bypasses the door, and the door still calls the guard before
    32	 * fetching. What changed was the guard's ARGUMENT, which is behaviour, not structure.
    33	 *
    34	 * That case is covered by tests/unit/telegram-egress-boundary.test.ts — the same sabotage reds the
    35	 * method-recovery test and the refusal tests there (measured; an earlier version of this comment
    36	 * claimed 7, which counted failures across TWO files and was corrected by review pass 36 finding 8 —
    37	 * a number asserted from a run I had not scoped to the file I was naming). So: this lint answers
    38	 * "may anyone reach the network without passing the door", the tests
    39	 * answer "does the door actually check what passes through it". Neither covers the other, and a
    40	 * reader who assumed this file alone protected the guarantee would be wrong in a way that only shows
    41	 * up when it matters.
    42	 */
    43	import fs from 'node:fs';
    44	import path from 'node:path';
    45	import { fileURLToPath } from 'node:url';
    46	import ts from 'typescript';
    47	
    48	const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
    49	const SRC = path.join(ROOT, 'src');
    50	const DOOR = path.join(SRC, 'messaging', 'telegram-egress.ts');
    51	// Both Bot API shapes: the method host and the FILE-download host. The marker covered only the
    52	// first, so three direct file fetches in the live tree were invisible while the lint printed
    53	// categorical confinement (pass 39 F8).
    54	const HOST_MARK = 'api.telegram.org/';
    55	const hasHostMark = (t) => t.toLowerCase().includes(HOST_MARK);
    56	const GUARD = 'assertOutgoingPayloadVisible';
    57	
    58	function walk(dir) {
    59	  const out = [];
    60	  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    61	    const p = path.join(dir, e.name);
    62	    if (e.isDirectory()) out.push(...walk(p));
    63	    // `.js` and `.mjs` are executable too, and scanning only `.ts` meant a direct Bot API fetch in
    64	    // either was invisible while this printed categorical confinement (pass 40 F3).
    65	    else if (e.isFile() && /\.(ts|js|mjs|cjs)$/.test(p)) out.push(p);
    66	  }
    67	  return out;
    68	}
    69	
    70	const parse = (f, text) => ts.createSourceFile(f, text, ts.ScriptTarget.Latest, true);
    71	
    72	/**
    73	 * Does this expression denote a Telegram Bot API URL? Checks the expression's own text, then — if it
    74	 * is a bare identifier or a call to a local helper — the text of that binding's local declaration.
    75	 */
    76	function denotesBotApiUrl(node, sf) {
    77	  if (!node) return false;
    78	  if (hasHostMark(node.getText(sf))) return true;
    79	
    80	  // Review pass 37 finding 4: a URL built by CONCATENATION — `api('getUpdates') + '?limit=5'` —
    81	  // is a binary expression, and the live tree already contained two. The lint printed
    82	  // "confined" while direct Bot API fetches existed in src/. Recurse through `+`.
    83	  if (ts.isBinaryExpression(node) && node.operatorToken.kind === ts.SyntaxKind.PlusToken) {
    84	    return denotesBotApiUrl(node.left, sf) || denotesBotApiUrl(node.right, sf);
    85	  }
    86	  if (ts.isParenthesizedExpression(node)) return denotesBotApiUrl(node.expression, sf);
    87	
    88	  const nameOf = (n) => (ts.isIdentifier(n) ? n.text
    89	    : ts.isCallExpression(n) && ts.isIdentifier(n.expression) ? n.expression.text
    90	      : null);
    91	  const name = nameOf(node);
    92	  if (!name) return false;
    93	
    94	  let found = false;
    95	  const seek = (n) => {
    96	    if (found) return;
    97	    if (ts.isVariableDeclaration(n) && n.name.getText(sf) === name && n.initializer) {
    98	      if (hasHostMark(n.initializer.getText(sf))) found = true;
    99	    }
   100	    ts.forEachChild(n, seek);
   101	  };
   102	  seek(sf);
   103	  return found;
   104	}
   105	
   106	/**
   107	 * A call that reaches the network. Review pass 36 finding 4: the first version matched ONLY a bare
   108	 * identifier `fetch`, so `globalThis.fetch(...)` — an ordinary way to write the same call — was
   109	 * invisible to a lint whose headline claim is "exactly one file". A property access whose final name
   110	 * is `fetch` counts too.
   111	 *
   112	 * Still NOT covered, said plainly rather than left for the next reading to find: a fetch bound to a
   113	 * DIFFERENT name (`const send = fetch; send(url)`) or reached through a computed member. Catching
   114	 * those needs alias resolution this does not do. The claim below is written to match this scope.
   115	 */
   116	function isFetchCall(n) {
   117	  if (!ts.isCallExpression(n)) return false;
   118	  const e = n.expression;
   119	  if (ts.isIdentifier(e)) return e.text === 'fetch';
   120	  if (ts.isPropertyAccessExpression(e)) {
   121	    // `fetch.call(...)` / `fetch.apply(...)` are direct invocations of fetch, and `x['fetch']` is a
   122	    // property access spelled differently (pass 40 F3).
   123	    if (e.name.text === 'call' || e.name.text === 'apply') return isFetchTarget(e.expression);
   124	    return e.name.text === 'fetch';
   125	  }
   126	  if (ts.isElementAccessExpression(e)) {
   127	    const a = e.argumentExpression;
   128	    return !!a && ts.isStringLiteralLike(a) && a.text === 'fetch';
   129	  }
   130	  return false;
   131	}
   132	
   133	/** Is this expression the `fetch` function itself (for `.call`/`.apply` forms)? */
   134	function isFetchTarget(e) {
   135	  if (ts.isIdentifier(e)) return e.text === 'fetch';
   136	  if (ts.isPropertyAccessExpression(e)) return e.name.text === 'fetch';
   137	  return false;
   138	}
   139	
   140	const violations = [];
   141	let doorSeen = false;
   142	
   143	for (const file of walk(SRC)) {
   144	  const text = fs.readFileSync(file, 'utf-8');
   145	  // Case-INSENSITIVE prefilter: it was lowercase-only, so an upper-case host skipped the file
   146	  // entirely and the recogniser's case-insensitivity never ran (pass 39 F5).
   147	  if (!text.toLowerCase().includes('api.telegram.org')) continue;
   148	  const sf = parse(file, text);
   149	  const isDoor = path.resolve(file) === DOOR;
   150	
   151	  const visit = (n) => {
   152	    if (isFetchCall(n) && ts.isCallExpression(n)) {
   153	      if (denotesBotApiUrl(n.arguments[0], sf)) {
   154	        if (isDoor) doorSeen = true;
   155	        else {
   156	          violations.push({
   157	            file,
   158	            line: sf.getLineAndCharacterOfPosition(n.getStart(sf)).line + 1,
   159	            snippet: n.arguments[0] ? n.arguments[0].getText(sf).replace(/\s+/g, ' ').slice(0, 60) : '',
   160	          });
   161	        }
   162	      }
   163	    }
   164	    ts.forEachChild(n, visit);
   165	  };
   166	  visit(sf);
   167	}
   168	
   169	if (!fs.existsSync(DOOR)) {
   170	  console.error('[telegram-egress] FAIL — the door itself is missing: src/messaging/telegram-egress.ts');
   171	  process.exit(1);
   172	}
   173	
   174	// The door must guard BEFORE it reaches the network. Positions, not statement order: the `fetch` may
   175	// sit inside a nested expression, and an index-based comparison silently selected the wrong function
   176	// when this was tried on the previous lint (review pass 35).
   177	{
   178	  const text = fs.readFileSync(DOOR, 'utf-8');
   179	  const sf = parse(DOOR, text);
   180	  const posOf = (name) => {
   181	    let at = -1;
   182	    const seek = (n) => {
   183	      if (at < 0 && ts.isCallExpression(n) && ts.isIdentifier(n.expression) && n.expression.text === name) {
   184	        at = n.getStart(sf);
   185	      }
