   456	    it('reads only the fields the discriminator declares — a discarded member cannot vouch', async () => {
   457	      // Pass 47 finding 2. Telegram reads `type`, extracts that variant's declared fields, and DISCARDS
   458	      // every other member of the object. The previous walk descended every object-valued property, so a
   459	      // member the server throws away could make an invisible payload look visible.
   460	      const f = arm();
   461	      await expect(telegramFetch(api('sendRichMessage'), post({
   462	        chat_id: 1,
   463	        rich_message: { blocks: [{ type: 'paragraph', text: {
   464	          type: 'bold',
   465	          text: '\u200b',
   466	          // `bold` consumes `text` alone. Everything below is discarded by the server.
   467	          caption: { text: 'LOOKS VISIBLE BUT IS DISCARDED' },
   468	          summary: 'ALSO DISCARDED',
   469	        } }] },
   470	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   471	      expect(f, 'a member the server discards must not license a send').not.toHaveBeenCalled();
   472	
   473	      // Same at block level: `paragraph` consumes `text`, so a stray sibling cannot vouch either.
   474	      const f2 = arm();
   475	      await expect(telegramFetch(api('sendRichMessage'), post({
   476	        chat_id: 1,
   477	        rich_message: { blocks: [{ type: 'paragraph', text: '\u200b', credit: 'DISCARDED ON A PARAGRAPH' }] },
   478	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   479	      expect(f2).not.toHaveBeenCalled();
   480	
   481	      // ...but a field the variant DOES declare still counts: `pullquote` reads text AND credit.
   482	      const f3 = arm();
   483	      await telegramFetch(api('sendRichMessage'), post({
   484	        chat_id: 1,
   485	        rich_message: { blocks: [{ type: 'pullquote', text: '\u200b', credit: 'a real credit line' }] },
   486	      }));
   487	      expect(f3, 'pullquote declares credit — it renders').toHaveBeenCalledTimes(1);
   488	    });
