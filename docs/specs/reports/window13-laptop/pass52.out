   490	    it('does not let a LaTeX source vouch in the markdown or html arms either', async () => {
   491	      // Pass 48 finding 1. The OPAQUE treatment for formulas reached only the explicit block variant, so
   492	      // the SAME formula written in markdown or html still had its raw source counted as visible. One
   493	      // repair, one of three representations — the sweep failure this window has now recorded four times.
   494	      // Syntax from the live reference: markdown `$inline$`, `$$block$$`, a ```math fence; html <tg-math>.
   495	      const f = arm();
   496	      await telegramFetch(api('sendRichMessage'), post({
   497	        chat_id: 1, rich_message: { markdown: '\u200b $\\hspace{1cm}$' },
   498	      }));
   499	      expect(f, 'a formula renders — this is not PROVEN invisible').toHaveBeenCalledTimes(1);
   500	
   501	      // The direction that matters: strip the formula and the rest must still be judged on its own.
   502	      const f2 = arm();
   503	      await expect(telegramFetch(api('sendRichMessage'), post({
   504	        chat_id: 1, rich_message: { markdown: '\u200b\u200b' },
   505	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   506	      expect(f2).not.toHaveBeenCalled();
   507	
   508	      // ...and the html arm carries the same grammar under a different tag.
   509	      const f3 = arm();
   510	      await telegramFetch(api('sendRichMessage'), post({
   511	        chat_id: 1, rich_message: { html: '<b>\u200b</b><tg-math>x^2</tg-math>' },
   512	      }));
   513	      expect(f3).toHaveBeenCalledTimes(1);
   514	
   515	      // A formula written out of NOTHING is not an undecidable formula — it is the original incident
   516	      // wearing one. Removing formula regions without this line would have ALLOWED a payload the
   517	      // previous code refused; the negative control for this repair is what caught it.
   518	      const f4 = arm();
   519	      await expect(telegramFetch(api('sendRichMessage'), post({
   520	        chat_id: 1, rich_message: { html: '<tg-math>\u200b</tg-math>' },
   521	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   522	      expect(f4, 'an invisible body inside a formula tag renders nothing').not.toHaveBeenCalled();
   523	
   524	      const f5 = arm();
   525	      await expect(telegramFetch(api('sendRichMessage'), post({
   526	        chat_id: 1, rich_message: { markdown: '$\u200b$' },
   527	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   528	      expect(f5).not.toHaveBeenCalled();
   529	
   530	      // Pass 49 finding 2: the empty-body test above reached the markdown and html arms and NOT the
   531	      // explicit structured discriminators, so the identical formula written as a block or an inline
   532	      // wrapper was allowed while the markdown spelling was refused. All three now share one function.
   533	      // The fix stops the formula VOUCHING, which is what finding 2 named. It does NOT refuse a
   534	      // structure whose only content is that formula: an empty-bodied formula yields no leaves at all,
   535	      // and the no-leaf rule allows. That is the separate stated-open item — this walk cannot yet tell
   536	      // "understood, and renders nothing" apart from "not understood", and both return the same state.
   537	      // Asserted as it ACTUALLY behaves, because a test written to the behaviour I wish it had would be
   538	      // a red test I would then be tempted to satisfy by weakening something real.
   539	      const f6 = arm();
   540	      await telegramFetch(api('sendRichMessage'), post({
   541	        chat_id: 1, rich_message: { blocks: [{ type: 'mathematical_expression', expression: '\u200b' }] },
   542	      }));
   543	      expect(f6, 'formula-only: no leaves, so the no-leaf rule allows — the residual, pinned honestly')
   544	        .toHaveBeenCalledTimes(1);
   545	
   546	      const f7 = arm();
   547	      await expect(telegramFetch(api('sendRichMessage'), post({
   548	        chat_id: 1,
   549	        rich_message: { blocks: [{ type: 'paragraph', text: [
   550	          { type: 'bold', text: '\u200b' },
   551	          { type: 'mathematical_expression', expression: '' },
   552	        ] }] },
   553	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   554	      expect(f7, 'an inline formula with an empty body cannot vouch either').not.toHaveBeenCalled();
   555	
   556	      // ...and a real formula in either structured position still delivers.
   557	      const f8 = arm();
   558	      await telegramFetch(api('sendRichMessage'), post({
   559	        chat_id: 1,
   560	        rich_message: { blocks: [
   561	          { type: 'paragraph', text: '\u200b' },
   562	          { type: 'mathematical_expression', expression: 'E = mc^2' },
   563	        ] },
   564	      }));
   565	      expect(f8).toHaveBeenCalledTimes(1);
   566	    });
