   400	type StructuredScan = { leaves: StructuredLeaf[]; undecidable: boolean };
   401	
   402	const NOTHING: StructuredScan = { leaves: [], undecidable: false };
   403	const OPAQUE: StructuredScan = { leaves: [], undecidable: true };
   404	
   405	function mergeScans(parts: StructuredScan[]): StructuredScan {
   406	  const leaves: StructuredLeaf[] = [];
