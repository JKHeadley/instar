   372	
   373	/**
   374	 * Standard topic styles for visual organization in Telegram forum.
   375	 * Colors are the 6 values Telegram's Bot API accepts for icon_color.
   376	 * Emojis prefix topic names for at-a-glance scanning.
   377	 */
   378	export const TOPIC_STYLE = {
   379	  /** Green — core infrastructure (Lifeline) */
   380	  SYSTEM:  { color: 9367192,  emoji: '🛡️' },
   381	  /** Purple — automated recurring jobs */
   382	  JOB:     { color: 13338331, emoji: '⚙️' },
   383	  /** Green — interactive user sessions */
   384	  SESSION: { color: 9367192,  emoji: '💬' },
   385	  /** Blue — informational (Dashboard, Updates) */
   386	  INFO:    { color: 7322096,  emoji: '📢' },
   387	  /** Yellow — needs user attention */
   388	  ALERT:   { color: 16766590, emoji: '🔔' },
   389	} as const;
   390	
   391	/**
   392	 * Keyword → emoji mapping for smart topic emoji selection.
   393	 * First match wins, so more specific patterns come first.
   394	 * Falls back to 💬 for unmatched names.
   395	 */
   396	const TOPIC_EMOJI_KEYWORDS: Array<{ keywords: string[]; emoji: string }> = [
   397	  { keywords: ['debug', 'bug', 'fix', 'issue', 'error'],   emoji: '🐛' },
   398	  { keywords: ['deploy', 'release', 'ship', 'launch'],      emoji: '🚀' },
   399	  { keywords: ['test', 'testing', 'qa', 'cypress', 'jest'], emoji: '🧪' },
   400	  { keywords: ['review', 'pr', 'code review'],              emoji: '👀' },
   401	  { keywords: ['research', 'explore', 'investigate'],        emoji: '🔍' },
   402	  { keywords: ['design', 'ui', 'ux', 'frontend', 'css'],    emoji: '🎨' },
   403	  { keywords: ['doc', 'docs', 'readme', 'write', 'draft'],  emoji: '📝' },
   404	  { keywords: ['build', 'ci', 'pipeline', 'compile'],       emoji: '🏗️' },
   405	  { keywords: ['security', 'auth', 'permission', 'access'], emoji: '🔒' },
   406	  { keywords: ['perf', 'performance', 'speed', 'optimize'],  emoji: '⚡' },
   407	  { keywords: ['data', 'database', 'db', 'sql', 'prisma'],  emoji: '🗄️' },
   408	  { keywords: ['api', 'endpoint', 'route', 'server'],       emoji: '🔌' },
   409	  { keywords: ['monitor', 'metric', 'observ', 'dashboard'], emoji: '📊' },
   410	  { keywords: ['alert', 'incident', 'urgent', 'critical'],  emoji: '🚨' },
   411	  { keywords: ['brainstorm', 'idea', 'think', 'plan'],      emoji: '💡' },
   412	  { keywords: ['migrate', 'migration', 'upgrade'],          emoji: '🔄' },
   413	  { keywords: ['config', 'setting', 'env'],                 emoji: '⚙️' },
   414	  { keywords: ['email', 'mail', 'newsletter', 'outreach'],  emoji: '📧' },
   415	  { keywords: ['chat', 'talk', 'conversation', 'discuss'],  emoji: '💬' },
   416	  { keywords: ['learn', 'study', 'tutorial', 'course'],     emoji: '📚' },
   417	  { keywords: ['money', 'payment', 'billing', 'cost'],      emoji: '💰' },
   418	  { keywords: ['clean', 'cleanup', 'refactor', 'tidy'],     emoji: '🧹' },
   419	];
   420	
   421	/**
   422	 * Select an appropriate emoji for a topic based on its name.
   423	 * Matches keywords case-insensitively. Falls back to 💬 for unmatched names.
   424	 */
   425	export function selectTopicEmoji(topicName: string): string {
   426	  const lower = topicName.toLowerCase();
   427	  for (const entry of TOPIC_EMOJI_KEYWORDS) {
   428	    if (entry.keywords.some(kw => lower.includes(kw))) {
   429	      return entry.emoji;
   430	    }
   431	  }
   432	  return TOPIC_STYLE.SESSION.emoji; // 💬 default
   433	}
   434	
   435	/** Tracks a pending message for stall detection */
   436	interface PendingMessage {
   437	  topicId: number;
   438	  sessionName: string;
   439	  messageText: string;
   440	  injectedAt: number; // Date.now()
   441	  alerted: boolean;
   442	}
   443	
   444	/** Tracks an agent promise that expects follow-through */
   445	interface PendingPromise {
   446	  topicId: number;
   447	  sessionName: string;
   448	  promiseText: string;
   449	  promisedAt: number;
   450	  alerted: boolean;
   451	}
   452	
   453	export class TelegramAdapter implements MessagingAdapter {
   454	  readonly platform = 'telegram';
   455	
   456	  private config: TelegramConfig;
   457	  private handler: ((message: Message) => Promise<void>) | null = null;
   458	  private polling = false;
   459	
   460	  /** True when this adapter is actively polling for messages (false in send-only mode). */
   461	  get isPolling(): boolean { return this.polling; }
   462	  private pollTimeout: ReturnType<typeof setTimeout> | null = null;
   463	  private lastUpdateId = 0;
   464	  private startedAt: Date | null = null;
   465	  private consecutivePollErrors = 0;
   466	  // Diagnostics surfaced via getStatus() so health probes can explain WHY polling stopped.
   467	  private lastPollError: string | null = null;
   468	  private fatalPollReason: '401' | 'network' | 'no-usable-bot-token' | null = null;
   469	  private pollStoppedAt: Date | null = null;
   470	  private pending401Retry = false;
   471	
   472	  // Forum detection — if the chat is not a forum, skip all topic operations
   473	  private notAForum = false;
   474	  private notAForumWarned = false;
   475	
   476	  // Topic-session registry (persisted to disk)
   477	  private topicToSession: Map<number, string> = new Map();
   478	  private sessionToTopic: Map<string, number> = new Map();
   479	  private topicToName: Map<number, string> = new Map();
   480	  private topicToPurpose: Map<number, string> = new Map();
   481	  private registryPath: string;
   482	  private messageLogPath: string;
   483	  /** Durable append-seam dedupe, seeded from the bounded JSONL on first use. */
   484	  private loggedMessageKeys = new Set<string>();
   485	  private messageLogDedupeSeeded = false;
   486	  private offsetPath: string;
   487	  private stateDir: string;
   488	  /** Per-bot state root. Equals stateDir for the primary bot; a namespaced sub-dir for
   489	   *  non-primary adapters (multi-instance isolation — spec MENTOR-LIVE-READINESS §Fix 2b).
   490	   *  Only the per-bot state files (registry/messages/offset/attention) live here; shared
   491	   *  config lookups stay on stateDir. */
   492	  private botStateDir: string;
   493	  /** When true, start() skips ensureLifelineTopic() — a non-primary bot must not create a
   494	   *  second Lifeline topic in the chat. */
   495	  private suppressLifelineAutoCreate: boolean;
   496	  /** Pre-dispatch hook for the agent-to-agent Telegram comms primitive (spec
   497	   *  MENTOR-LIVE-READINESS §Fix 2b). When set, the text-dispatch path calls this BEFORE
   498	   *  onTopicMessage / this.handler. If it returns {handled:true}, normal dispatch is
   499	   *  skipped (the hook routed the message to a role-handler OR dropped it as an a2a
   500	   *  security event). If {handled:false}, normal user flow continues. Other message types
   501	   *  (voice/photo/document) cannot carry the [a2a:…] marker and bypass the hook.
   502	   *  See installAgentMessageHook for the production binding. */
   503	  private agentMessageHook?: AgentMessageHook;
   504	  /** Optional coherence-journal seam (COHERENCE-JOURNAL-SPEC §3.3). The adapter
   505	   *  holds no StateManager, so the emergency-stop path's stopAutonomousTopic call
   506	   *  cannot reach the wired journal on its own. server.ts injects this seam so the
   507	   *  sentinel emergency-stop emits the autonomous-run `stopped` event like every
   508	   *  other stop funnel. Undefined → the stop stays silent (best-effort, never blocks). */
   509	  private coherenceJournalSeam?: AutonomousJournalSeam;
   510	
   511	  // Attention queue (persisted to disk)
   512	  private attentionItemToTopic: Map<string, number> = new Map();
   513	  private attentionTopicToItem: Map<number, string> = new Map();
   514	  private attentionItems: Map<string, AttentionItem> = new Map();
   515	  private attentionFilePath: string;
   516	  // Per-source forum-topic circuit breaker (2026-05-28 topic-flood lockdown).
   517	  private attentionTopicGuard!: AttentionTopicGuard;
   518	  // LAST-RESORT auto-topic ceiling enforced inside createForumTopic itself
   519	  // (2026-06-05 flood lesson — covers every caller, not just attention items).
   520	  private topicCreationGuard!: AttentionTopicGuard;
   521	  // bucket -> the single reused "notices coalesced" topic for that bucket.
   522	  private floodNoticeTopicByBucket: Map<string, number> = new Map();
   523	  // bucket -> in-flight createForumTopic promise, so concurrent coalesced items
   524	  // for one bucket share ONE topic creation (no double-create race).
   525	  private floodNoticePending: Map<string, Promise<number | null>> = new Map();
   526	  private attentionSuppressedLogPath!: string;
   527	  // ── Agent-Health lane (the calm self-health notice lane) ──────────────────
   528	  /** Resolved lane config (defaults applied in the constructor). */
   529	  private agentHealthLaneCfg!: { enabled: boolean; topicName: string; maxTrackedKeys: number; dedupWindowMs: number };
   530	  /** The single reused lane topic id (created lazily, once). */
