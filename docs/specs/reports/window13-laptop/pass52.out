   568	    it('requires the SOURCE to reference a media entry — a declaration does not vouch', async () => {
   569	      // Pass 48 finding 2, and it was mine from one increment earlier: treating any non-empty `media`
   570	      // array as proof recreated the discarded-member-vouching defect one layer ABOVE the discriminator
   571	      // table, in the very change that closed it below. The API defines the array as media SPECIFIED IN
   572	      // the source using tg://photo?id= / tg://video?id= / tg://audio?id= links.
   573	      const f = arm();
   574	      await expect(telegramFetch(api('sendRichMessage'), post({
   575	        chat_id: 1,
   576	        rich_message: { markdown: '\u200b', media: [{ id: 'never-referenced', media: { type: 'photo' } }] },
   577	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   578	      expect(f, 'an unreferenced declaration renders nothing').not.toHaveBeenCalled();
   579	
   580	      // A referenced entry DOES render, and must not be refused.
   581	      const f2 = arm();
   582	      await telegramFetch(api('sendRichMessage'), post({
   583	        chat_id: 1,
   584	        rich_message: {
   585	          markdown: '![](tg://photo?id=pic1)\u200b',
   586	          media: [{ id: 'pic1', media: { type: 'photo' } }],
   587	        },
   588	      }));
   589	      expect(f2, 'the photo the source references is the content').toHaveBeenCalledTimes(1);
   590	
   591	      // Pass 50: the reference must sit in an EMBEDDING position, not merely appear in the source.
   592	      //
   593	      // My first test for this asserted the wrong thing — a bare `tg://photo?id=x` sitting in ordinary
   594	      // text IS visible, because the URL's own characters render. Probing the matcher directly rather
   595	      // than trusting my mental model gave the real cases: positions where the id appears and NOTHING
   596	      // renders. An HTML comment, and an attribute that embeds nothing.
   597	      const fComment = arm();
   598	      await expect(telegramFetch(api('sendRichMessage'), post({
   599	        chat_id: 1,
   600	        rich_message: {
   601	          html: '<!-- tg://photo?id=pic1 --><b>\u200b</b>',
   602	          media: [{ id: 'pic1', media: { type: 'photo' } }],
   603	        },
   604	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   605	      expect(fComment, 'an id in a comment embeds nothing').not.toHaveBeenCalled();
   606	
   607	      const fAttr = arm();
   608	      await expect(telegramFetch(api('sendRichMessage'), post({
   609	        chat_id: 1,
   610	        rich_message: {
   611	          html: '<a title="tg://photo?id=pic1">\u200b</a>',
   612	          media: [{ id: 'pic1', media: { type: 'photo' } }],
   613	        },
   614	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   615	      expect(fAttr, 'only src embeds — a title attribute renders no photo').not.toHaveBeenCalled();
   616	
   617	      // ...and the genuinely embedded form still delivers.
   618	      const fHtml = arm();
   619	      await telegramFetch(api('sendRichMessage'), post({
   620	        chat_id: 1,
   621	        rich_message: {
   622	          html: '<img src="tg://photo?id=pic1"/><b>\u200b</b>',
   623	          media: [{ id: 'pic1', media: { type: 'photo' } }],
   624	        },
   625	      }));
   626	      expect(fHtml, 'an embedded photo renders').toHaveBeenCalledTimes(1);
   627	
   628	      // A reference to an id that was never declared is not a rendered photo either.
   629	      const f3 = arm();
   630	      await expect(telegramFetch(api('sendRichMessage'), post({
   631	        chat_id: 1,
   632	        rich_message: { markdown: '![](tg://photo?id=ghost)\u200b', media: [{ id: 'pic1', media: {} }] },
   633	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   634	      expect(f3).not.toHaveBeenCalled();
   635	    });
