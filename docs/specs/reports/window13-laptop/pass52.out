  5891	 * Callers may opt out per-call by passing `params._isPlainRetry = true`
  5892	 * (internal flag for the 400 retry path).
  5893	 */
  5894	export function applyTelegramFormatter(
  5895	  method: string,
  5896	  params: Record<string, unknown>,
  5897	  configMode: FormatMode | undefined,
  5898	): {
  5899	  outgoingParams: Record<string, unknown>;
  5900	  originalParams: Record<string, unknown>;
  5901	  didFormat: boolean;
  5902	  isPlainRetry: boolean;
  5903	} {
  5904	  const isPlainRetry = (params as { _isPlainRetry?: boolean })._isPlainRetry === true;
  5905	  // Per-call mode override — internal callers that already produce Telegram
  5906	  // HTML (e.g. the attention-queue creator) tag their send with
  5907	  // `_formatMode: 'html'` so the formatter's markdown converter does not
  5908	  // re-process their bytes. Spec: trusted-internal-callers list.
  5909	  const callerMode = (params as { _formatMode?: FormatMode })._formatMode;
  5910	  // Strip internal flags before sending to Bot API.
  5911	  const stripped: Record<string, unknown> = { ...params };
  5912	  delete (stripped as { _isPlainRetry?: boolean })._isPlainRetry;
  5913	  delete (stripped as { _idempotencyKey?: unknown })._idempotencyKey;
  5914	  delete (stripped as { _formatMode?: FormatMode })._formatMode;
  5915	
  5916	  const isSendMethod = method === 'sendMessage' || method === 'editMessageText';
  5917	  // Default 'markdown' (post-cutover): unformatted GitHub-flavored markdown
  5918	  // → Telegram HTML on every outbound send. Agents that need to roll back
  5919	  // set `telegramFormatMode: 'legacy-passthrough'` in `.instar/config.json`.
  5920	  const mode: FormatMode = callerMode ?? configMode ?? 'markdown';
  5921	
  5922	  if (
  5923	    !isSendMethod ||
  5924	    mode === 'legacy-passthrough' ||
  5925	    isPlainRetry ||
  5926	    typeof stripped.text !== 'string'
  5927	  ) {
  5928	    return {
  5929	      outgoingParams: stripped,
  5930	      originalParams: params,
  5931	      didFormat: false,
  5932	      isPlainRetry,
  5933	    };
  5934	  }
