   195	      `[telegram-egress] FAIL — the door does not check before it sends.\n`
   196	      + `  ${GUARD} at ${g}, fetch at ${f} in src/messaging/telegram-egress.ts.\n`
   197	      + `  Every sender now relies on this one call. If it does not run first, nothing is checked.`,
   198	    );
   199	    process.exit(1);
   200	  }
   201	  // The door's own URL is a PARAMETER, so it is correctly unrecognisable to the URL test — the door
   202	  // is the door by identity, not by what its argument looks like. `doorSeen` therefore proves nothing
   203	  // here, and the first run of this lint failed on exactly that mistake.
   204	  //
   205	  // The real hazard is silent blindness: if `denotesBotApiUrl` ever stops recognising a Bot API URL,
   206	  // every file passes and the boundary evaporates with a clean green line. So test the RECOGNISER on
   207	  // known-positive and known-negative sources before trusting its verdict on real files. A lint that
   208	  // cannot demonstrate it can still see is not entitled to report clean.
   209	  const canaries = [
   210	    ['inline template', 'const r = fetch(`https://api.telegram.org/bot${t}/sendMessage`, {});', true],
   211	    ['local variable', 'const u = `https://api.telegram.org/bot${t}/sendMessage`; fetch(u, {});', true],
   212	    ['local helper', "const api = (m) => `https://api.telegram.org/bot${t}/${m}`; fetch(api('sendMessage'), {});", true],
   213	    ['concatenated helper + query', "const api = (m) => `https://api.telegram.org/bot${t}/${m}`; fetch(api('getUpdates') + '?x=1', {});", true],
   214	    ['upper-case host', 'fetch(`https://API.TELEGRAM.ORG/bot${t}/sendMessage`, {});', true],
   215	    ['unrelated host', 'fetch(`https://example.invalid/x`, {});', false],
   216	    ['peer mesh call', 'const u = `${peer.url}/sessions`; fetch(u, {});', false],
   217	    ['property-access fetch', 'globalThis.fetch(`https://api.telegram.org/bot${t}/sendMessage`, {});', true],
   218	  ];
