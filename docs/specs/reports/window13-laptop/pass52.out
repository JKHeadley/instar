  5943	    outgoing.parse_mode = result.parseMode;
  5944	  } else {
  5945	    // legacy-passthrough returns parseMode undefined; fall back to caller's
  5946	    // explicit parse_mode if any (preserved above via ...stripped).
  5947	  }
  5948	  return {
  5949	    outgoingParams: outgoing,
  5950	    originalParams: params,
  5951	    didFormat: true,
  5952	    isPlainRetry: false,
  5953	  };
