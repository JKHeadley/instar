   684	  // Markdown image syntax, or an HTML tag whose attribute carries the reference.
   685	  return new RegExp(
   686	    // The id must END where the declared one ends. `id=${idPattern}[^)]*` was a PREFIX match, so a
   687	    // declared `pic1` vouched for a reference to `pic1EXTRA` — a different, undeclared media that
   688	    // renders nothing. Terminated by a parameter separator, a quote, a closing paren, or end-of-input.
   689	    `!\\[[^\\]]*\\]\\(\\s*tg://(?:photo|video|audio)\\?id=${idPattern}(?=[&)\\s"']|$)[^)]*\\)`
   690	    // `src` ONLY. An earlier version accepted ANY attribute, so `<a title="tg://photo?id=x">` — which
   691	    // embeds nothing — counted as a rendered photo. Narrowed after probing the attribute case directly.
   692	    + `|<[a-z-]+\\b[^>]*\\bsrc\\s*=\\s*["']tg://(?:photo|video|audio)\\?id=${idPattern}(?=[&"']|$)[^"']*["']`,
   693	    'i',
   694	  );
   695	}
   696	
   697	function sourceRendersMedia(source: string, media: unknown): boolean {
   698	  if (DIRECT_MEDIA_URL.test(source) || EMOJI_MEDIA.test(source)) return true;
   699	  if (!Array.isArray(media) || media.length === 0) return false;
   700	  for (const entry of media) {
   701	    if (entry === null || typeof entry !== 'object') continue;
   702	    const id = (entry as { id?: unknown }).id;
   703	    if (typeof id !== 'string' || id.length === 0) continue;
   704	    const escaped = id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
   705	    if (mediaEmbedPattern(escaped).test(source)) return true;
   706	  }
   707	  return false;
   708	}
   709	
   710	function richSourceScan(source: unknown, mode: 'Markdown' | 'HTML', media: unknown): StructuredScan {
   711	  if (typeof source !== 'string') return NOTHING;
   712	  const formula = mode === 'Markdown' ? MARKDOWN_FORMULA : HTML_FORMULA;
   713	  // A formula's source is removed from the visibility test — its characters are LaTeX instructions, not
   714	  // glyphs, so they must not vouch for the rest of the message.
   715	  //
   716	  // But removal alone would have been a REGRESSION, and the negative control for this repair is what
   717	  // caught it: an invisible body wrapped in a formula tag was REFUSED before (the tag stripped, the
   718	  // zero-width body judged and found invisible) and would have been ALLOWED after, because an empty leaf
   719	  // plus a blanket "a formula is undecidable" waives everything. An invisible payload wrapped in a
   720	  // formula tag is not an undecidable formula — it is the original incident wearing one.

