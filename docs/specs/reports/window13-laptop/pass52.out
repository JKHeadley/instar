   920	  /**
   921	   * Register all Telegram commands with the shared CommandRouter (Phase 1a).
   922	   * Each command delegates back to the existing handler logic.
   923	   */
   924	  private registerSharedCommands(): void {
   925	    if (!this.sharedCommandRouter) return;
   926	
   927	    // Attention topic interceptor
   928	    this.sharedCommandRouter.addInterceptor(async (ctx) => {
   929	      const topicId = parseInt(ctx.channelId, 10);
   930	      if (this.isAttentionTopic(topicId)) {
   931	        return this.handleAttentionCommand(topicId, ctx.rawText);
   932	      }
   933	      return false;
   934	    });
   935	
   936	    this.sharedCommandRouter.register('flush', async (ctx) => {
   937	      const topicId = parseInt(ctx.channelId, 10);
   938	      if (this.batcher && this.batcher.isEnabled()) {
   939	        const flushed = await this.batcher.flushAll();
   940	        if (flushed > 0) {
   941	          await this.sendToTopic(topicId, `Flushed ${flushed} batched notification${flushed === 1 ? '' : 's'}.`).catch(() => {});
   942	        } else {
   943	          await this.sendToTopic(topicId, 'No batched notifications to flush.').catch(() => {});
   944	        }
   945	      } else if (this.onFlushNotifications) {
   946	        this.onFlushNotifications(topicId).catch(err => {
   947	          console.error('[telegram] Flush notifications failed:', err);
   948	          this.sendToTopic(topicId, 'Failed to flush notifications.').catch(() => {});
   949	        });
   950	      } else {
   951	        await this.sendToTopic(topicId, 'Notification batching is not enabled.').catch(() => {});
   952	      }
   953	      return true;
   954	    }, { description: 'Flush batched notifications' });
   955	
   956	    this.sharedCommandRouter.register('sessions', async (ctx) => {
   957	      const topicId = parseInt(ctx.channelId, 10);
   958	      const filterUnclaimed = ctx.args.includes('unclaimed');
   959	      if (!this.onListSessions) {
   960	        await this.sendToTopic(topicId, 'Session listing not available.').catch(() => {});
   961	        return true;
   962	      }
   963	      const sessions = this.onListSessions();
   964	      if (sessions.length === 0) {
   965	        await this.sendToTopic(topicId, 'No sessions running.').catch(() => {});
   966	        return true;
   967	      }
   968	      const lines: string[] = [];
   969	      for (const s of sessions) {
   970	        const linkedTopic = this.getTopicForSession(s.tmuxSession);
   971	        const claimed = linkedTopic !== null;
   972	        if (filterUnclaimed && claimed) continue;
   973	        const status = s.alive ? '\u2705' : '\u274c';
   974	        const claimTag = claimed ? ` (topic ${linkedTopic})` : ' \u{1f7e1} unclaimed';
   975	        lines.push(`${status} ${s.name}${claimTag}`);
   976	      }
   977	      if (lines.length === 0) {
   978	        await this.sendToTopic(topicId, filterUnclaimed ? 'No unclaimed sessions.' : 'No sessions.').catch(() => {});
   979	      } else {
   980	        await this.sendToTopic(topicId, lines.join('\n')).catch(() => {});

