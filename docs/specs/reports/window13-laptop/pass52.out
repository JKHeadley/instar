   825	  constructor(
   826	    config: TelegramConfig,
   827	    stateDir: string,
   828	    opts?: { subDir?: string; suppressLifelineAutoCreate?: boolean },
   829	  ) {
   830	    if (config.chatId && !/^-?\d+$/.test(String(config.chatId))) {
   831	      throw new Error(
   832	        `Invalid Telegram chatId "${config.chatId}". Chat IDs must be numeric (e.g., -1001234567890). ` +
   833	        `Update messaging.config.chatId in your instar.config.json with a valid numeric ID.`,
   834	      );
   835	    }
   836	    // HARDENED (v1.3.270 boot-crash incident): when the secrets merge fails, the
   837	    // externalized token arrives as the truthy `{ secret: true }` placeholder OBJECT.
   838	    // Polling with it stringified into the bot URL 404-zombies forever. Normalize a
   839	    // non-string token to '' — the well-defined TOKENLESS state every guard in this
   840	    // adapter already handles (standby/relay) — and say so loudly.
   841	    if (config.token != null && typeof config.token !== 'string') {
   842	      console.warn(
   843	        '[telegram] Bot token is not a string (unresolved secret placeholder — secret store unavailable at boot?). ' +
   844	        'Running TOKENLESS this boot: no polling, sends only via relay if available. A restart after the secret store recovers restores full service.',
   845	      );
   846	      config = { ...config, token: '' };
   847	    }
   848	    this.config = config;
   849	    this.stateDir = stateDir;
   850	    this.suppressLifelineAutoCreate = opts?.suppressLifelineAutoCreate ?? false;
   851	    // Multi-instance isolation: a non-primary adapter (e.g. the mentor bot) namespaces its
   852	    // per-bot state under {stateDir}/{subDir}/ so two adapters never clobber each other's
   853	    // poll-offset / registry / message-log / attention files (the reviewer-flagged
   854	    // collision that makes poll()'s cross-token detection fire continuously). The PRIMARY
   855	    // bot passes no subDir → botStateDir === stateDir → paths are byte-for-byte unchanged.
   856	    this.botStateDir = opts?.subDir ? path.join(stateDir, opts.subDir) : stateDir;
   857	    if (opts?.subDir) {
   858	      fs.mkdirSync(this.botStateDir, { recursive: true });
   859	    }
   860	    this.registryPath = path.join(this.botStateDir, 'topic-session-registry.json');
   861	    this.messageLogPath = path.join(this.botStateDir, 'telegram-messages.jsonl');
   862	    this.offsetPath = path.join(this.botStateDir, 'telegram-poll-offset.json');
   863	    this.attentionFilePath = path.join(this.botStateDir, 'state', 'attention-items.json');
   864	    this.attentionSuppressedLogPath = path.join(this.botStateDir, 'state', 'attention-suppressed.jsonl');
   865	    this.attentionTopicGuard = new AttentionTopicGuard(config.attentionTopicGuard ?? {});
   866	    // Backstop ceiling: looser than the attention guard by design (the
   867	    // attention guard SHAPES politely per-source; this is the absolute bound
   868	    // a mis-wired or future caller cannot dodge). Config can tighten/loosen.
   869	    this.topicCreationGuard = new AttentionTopicGuard({
   870	      windowMs: 10 * 60 * 1000,
   871	      maxTopicsPerSource: 8,
   872	      maxTopicsGlobal: 12,
   873	      ...(config.topicCreationBudget ?? {}),
   874	    });
   875	    const alc = config.agentHealthLane ?? {};
   876	    this.agentHealthLaneCfg = {
   877	      enabled: alc.enabled !== false,
   878	      topicName: (typeof alc.topicName === 'string' && alc.topicName.trim()) ? alc.topicName : '🩺 Agent Health',
   879	      maxTrackedKeys: Number.isFinite(alc.maxTrackedKeys) && (alc.maxTrackedKeys as number) > 0 ? Math.floor(alc.maxTrackedKeys as number) : 256,
   880	      dedupWindowMs: Number.isFinite(alc.dedupWindowMs) && (alc.dedupWindowMs as number) > 0 ? (alc.dedupWindowMs as number) : 30 * 60 * 1000,
   881	    };
   882	    this.attentionRoutingMode = config.attentionRouting?.mode === 'per-item' ? 'per-item' : 'single-topic';
   883	    this.loadRegistry();
   884	    this.loadOffset();
   885	    this.loadAttentionItems();
   886	
