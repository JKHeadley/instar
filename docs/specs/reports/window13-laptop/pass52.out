   442	      // — so every test of the SENT bytes passed either way, which is precisely why no reading caught
   443	      // it and why this test counts reads instead of contents.
   444	      const f = arm();
   445	      let reads = 0;
   446	      const init: RequestInit = { method: 'POST', headers: { 'content-type': 'application/json' } };
   447	      Object.defineProperty(init, 'body', {
   448	        enumerable: true,
   449	        get() { reads += 1; return JSON.stringify({ chat_id: 1, text: 'visible' }); },
   450	      });
   451	      await telegramFetch(api('sendMessage'), init);
   452	      expect(f).toHaveBeenCalledTimes(1);
   453	      expect(reads, 'a getter with side effects must not run twice').toBe(1);
   454	    });
