   746	  /**
   747	   * Send a consent prompt to the owner DM with two inline buttons
   748	   * (approve / decline). The buttons carry callback_data of the form
   749	   * `tc:g:<nonce>` / `tc:d:<nonce>` (well under Telegram's 64-byte
   750	   * callback_data limit — `tc:g:` is 5 chars + a 32-hex nonce = 37).
   751	   * Returns the message id on success, null on failure (no owner,
   752	   * owner hasn't DM'd the bot, network error) — fire-and-forget.
   753	   */
   754	  async sendOwnerConsentPrompt(text: string, nonce: string): Promise<number | null> {
   755	    const owner = this.getOwnerUserId();
   756	    if (!owner) {
   757	      console.warn('[telegram] sendOwnerConsentPrompt called but no ownerUserId is configured');
   758	      return null;
   759	    }
   760	    try {
   761	      const result = await this.apiCall('sendMessage', {
   762	        chat_id: owner,
   763	        text,
   764	        reply_markup: {
   765	          inline_keyboard: [[
   766	            { text: 'Yes, use a backup', callback_data: `tc:g:${nonce}` },
   767	            { text: 'No, keep waiting', callback_data: `tc:d:${nonce}` },
   768	          ]],
   769	        },
   770	      }) as { message_id: number };
   771	      return result.message_id;
   772	    } catch (err) {
   773	      const msg = err instanceof Error ? err.message : String(err);
   774	      console.warn(`[telegram] sendOwnerConsentPrompt failed: ${msg}`);
   775	      return null;
   776	    }
   777	  }
