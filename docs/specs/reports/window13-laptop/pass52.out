     1	/**
     2	 * Telegram Messaging Adapter — send/receive messages via Telegram Bot API.
     3	 *
     4	 * Uses long polling to receive messages. Supports forum topics
     5	 * (each user gets a topic thread). Includes topic-session registry,
     6	 * message logging, voice transcription, photo handling, stall detection,
     7	 * auth gating, and delivery confirmation.
     8	 *
     9	 * No external dependencies — uses native fetch for Telegram API calls.
    10	 */
    11	
    12	import fs from 'node:fs';
    13	import { assertTelegramPayloadVisible, InvisiblePayloadRefusedError } from './invisible-payload.js';
    14	import { telegramFetch } from './telegram-egress.js';
    15	import path from 'node:path';
    16	import type { MessagingAdapter, Message, OutgoingMessage, UserChannel, IntelligenceProvider, IngressPosition } from '../core/types.js';
    17	import { DegradationReporter } from '../monitoring/DegradationReporter.js';
    18	import { NotificationBatcher, NotificationTier } from './NotificationBatcher.js';
    19	import type { ContentValidationConfig } from './TopicContentValidator.js';
    20	import { validateTopicContent, getTopicPurpose, classifyContent } from './TopicContentValidator.js';
    21	import { SHARED_INFRA_FLAGS } from './shared/FeatureFlags.js';
    22	import { MessageLogger, type LogEntry as SharedLogEntry } from './shared/MessageLogger.js';
    23	import type { MessageProvenance } from './shared/MessageProvenance.js';
    24	import { SessionChannelRegistry } from './shared/SessionChannelRegistry.js';
    25	import { StallDetector, type StallEvent } from './shared/StallDetector.js';
    26	import { CommandRouter } from './shared/CommandRouter.js';
    27	import { AuthGate } from './shared/AuthGate.js';
    28	import { MessagingEventBus } from './shared/MessagingEventBus.js';
    29	import { CallbackRegistry, isAllowedButtonKey } from '../core/CallbackRegistry.js';
    30	import type { DetectedPrompt } from '../monitoring/PromptGate.js';
    31	import { sanitizeForPrompt } from '../monitoring/SessionRecovery.js';
    32	import { formatForTelegram, type FormatMode } from './TelegramMarkdownFormatter.js';
    33	import { readJsonlTailLastLines } from '../utils/jsonl-tail.js';
    34	import {
    35	  recordFormatApplied,
    36	  recordFormatLintIssue,
    37	  recordFormatFallbackPlainRetry,
    38	} from './telegramFormatMetrics.js';
    39	import { SafeFsExecutor } from '../core/SafeFsExecutor.js';
    40	import { pickDashboardPin } from '../core/dashboardPin.js';
    41	import { stopAutonomousTopic, type AutonomousJournalSeam } from '../core/AutonomousSessions.js';
    42	import { AttentionTopicGuard, TopicFloodBudgetError, type AttentionTopicGuardConfig } from './AttentionTopicGuard.js';
    43	import { buildStallAlertDecisionContext } from './shared/StallAlertDecisionContext.js';
    44	import { DP_TELEGRAM_STALL_CONFIRM } from '../data/provenanceCoverage.js';
    45	
    46	export const TELEGRAM_STALL_CONFIRM_PROMPT_ID = 'telegram-stall-confirm-v1';
    47	
    48	export interface TelegramConfig {
    49	  /** Bot token from @BotFather */
    50	  token: string;
    51	  /** Forum chat ID (the supergroup where topics live) */
    52	  chatId: string;
    53	  /** Polling interval in ms */
    54	  pollIntervalMs?: number;
    55	  /** Authorized Telegram user IDs (only these users' messages are processed) */
    56	  authorizedUserIds?: number[];
    57	  /**
    58	   * Owner principal — the single Telegram user id who controls
    59	   * security-sensitive decisions for this instance (notably the
    60	   * consent gate for Tier-2 relay tunnels — see
    61	   * specs/dev-infrastructure/tunnel-failure-resilience.md).
    62	   *
    63	   * Why a separate field from `authorizedUserIds`: that set is the
    64	   * "who may interact with the bot" allowlist (multiple users may
    65	   * legitimately use the bot for routine interaction), while
    66	   * `ownerUserId` is the principal who alone may approve actions
    67	   * with cross-user security impact (relay activation, credential
    68	   * exposure, etc.). The GPT external review on the tunnel spec
    69	   * specifically flagged that the consent gate must NOT trust the
    70	   * broader authorizedUserIds set.
    71	   *
    72	   * `sendToOwnerDM()` uses this id as the private-chat target.
    73	   * Defaults to `promptGate?.ownerId` for back-compat when unset.
    74	   */
    75	  ownerUserId?: number;
    76	  /** Voice transcription provider: 'groq' or 'openai' (auto-detects if not set) */
    77	  voiceProvider?: string;
    78	  /** Stall detection timeout in minutes (default: 5, 0 to disable) */
    79	  stallTimeoutMinutes?: number;
    80	  /** Promise follow-through timeout in minutes (default: 10, 0 to disable) */
    81	  promiseTimeoutMinutes?: number;
    82	  /** Lifeline topic thread ID — the always-available channel. Auto-recreated if deleted. */
    83	  lifelineTopicId?: number;
    84	  /** Dashboard topic thread ID — auto-broadcasts tunnel URL on startup. */
    85	  dashboardTopicId?: number;
    86	  /** Dashboard PIN (for including in broadcast messages). */
    87	  dashboardPin?: string;
    88	  /** Content validation configuration — validates outbound messages against topic purpose */
    89	  contentValidation?: ContentValidationConfig;
    90	  /** Prompt Gate configuration for Telegram relay */
    91	  promptGate?: {
    92	    /** Telegram user ID of the session owner (only this user can respond to prompts) */
    93	    ownerId?: number;
    94	    /** Timeout in seconds for relay responses (default: 300 = 5 min) */
    95	    relayTimeoutSeconds?: number;
    96	  };
    97	  /**
    98	   * Hot-reloadable accessor for the Telegram format mode. Returning a falsy
    99	   * value or `'legacy-passthrough'` preserves pre-PR2 behavior (byte-for-byte
   100	   * passthrough, caller-supplied parse_mode honored). See
   101	   * docs/specs/TELEGRAM-MARKDOWN-RENDERER-SPEC.md.
   102	   */
   103	  getFormatMode?: () => FormatMode | undefined;
   104	  /** Hot-reloadable accessor for lint-strict mode. */
   105	  getLintStrict?: () => boolean | undefined;
   106	  /**
   107	   * Per-source forum-topic circuit breaker. Caps how many NEW topics a single
   108	   * attention `sourceContext` may spawn in a rolling window; past the budget,
   109	   * items coalesce into one running notice topic instead of a wall of topics.
   110	   * Defaults to DEFAULT_ATTENTION_TOPIC_GUARD (enabled) — the 2026-05-28
   111	   * topic-flood lockdown. See AttentionTopicGuard.
   112	   */
   113	  attentionTopicGuard?: Partial<AttentionTopicGuardConfig>;
   114	  /**
   115	   * The LAST-RESORT ceiling on automatic forum-topic creation, enforced INSIDE
   116	   * `createForumTopic` itself — the one place topics are born — so it covers
   117	   * EVERY caller, current and future, regardless of what source labels they
   118	   * pass (the 2026-06-05 flood dodged the attention guard's per-source budget
   119	   * by giving every item a unique sourceContext; only the global ceiling
   120	   * caught it after 8 leaked topics). Origins `user` and `system` are exempt
   121	   * (operator-initiated topics and bounded create-once system topics);
   122	   * everything else — including any caller that doesn't say — is counted.
   123	   * Per-label budget + global ceiling, same engine as the attention guard.
   124	   * Defaults are deliberately LOOSER than the attention guard (this is the
   125	   * backstop, not the shaper): per-label 8, global 12, 10-min window.
   126	   */
   127	  topicCreationBudget?: Partial<AttentionTopicGuardConfig>;
   128	  /**
   129	   * The calm "Agent Health" lane. Routine self-health/housekeeping notices
   130	   * (attention items with `lane:'agent-health'`) are collected into ONE named,
   131	   * low-key topic that never spawns topic-after-topic — the antidote to a feature
   132	   * hijacking Telegram with a wall of "stale but unkillable"-style notices. Only
   133	   * items that explicitly opt in (`lane:'agent-health'`) are affected; every other
   134	   * item is unchanged. Enabled by default; set `enabled:false` for pre-lane
   135	   * behavior.
   136	   */
   137	  agentHealthLane?: {
