   116	/**
   117	 * The Telegram API methods whose `text` parameter IS the body a reader reads.
   118	 *
   119	 * DERIVED, not asserted (2026-08-10, window 12). Every `apiCall('<method>')` in `src/` was
   120	 * enumerated and each method inspected for a reader-visible `text` param. `sendMessage` and
   121	 * `editMessageText` carry one; `answerCallbackQuery` also carries `text`, and is deliberately
   122	 * EXCLUDED — it renders a transient toast, and an empty one legitimately just dismisses the
   123	 * spinner, so refusing it would be an over-refusal rather than a protection.
   124	 */
   125	export const READER_VISIBLE_TELEGRAM_PARAMS: Readonly<Record<string, string | readonly string[]>> = {
   126	  sendMessage: 'text',
   127	  // `editMessageText` also accepts `rich_message`, and a method can carry reader-visible content in
   128	  // MORE THAN ONE field — which this map could not express until review pass 43. Checking only `text`
   129	  // meant an edit carrying its content as `rich_message` returned silently and was sent unexamined.
   130	  //
   131	  // Worth recording how this was nearly missed: I judged `rich_message` a fabricated field because it
   132	  // is absent from the Bot API I know, and only fetching the live documentation showed it was added
   133	  // after my knowledge. Dismissing it would have discarded a real bypass on the strength of stale
   134	  // memory — the same defect as trusting a stale claim, pointed the other way.
   135	  //
   136	  // ORDERED BY THE METHOD'S OWN PRECEDENCE, highest first, and that order is load-bearing. The handler
   137	  // branches on whether the `rich_message` key is PRESENT and only otherwise reads `text` — an empty
   138	  // `rich_message` is a 400, not a fall-through. Listing `text` first (as this did until window 13) made
   139	  // the two read as equal alternatives, which is exactly what the waiver below then assumed.
   140	  editMessageText: ['rich_message', 'text'],
   141	  // The dedicated rich-message methods. Absent from this table they were REFUSED as unclassified,
   142	  // which was the safe direction but would have broken a legitimate send the moment one was used.
   143	  // `rich_message` ONLY. Mapping `text` here too was a phantom field (pass 47): these methods do not
   144	  // accept it, and the egress waives its unreadable-body refusal when ANY mapped field arrives in the
   145	  // query — so `?text=visible` on a method that ignores `text`, plus an unreadable body, waived the
   146	  // refusal. A field map that is too WIDE is not harmlessly cautious; it hands the waiver a key the
   147	  // method never reads.
   148	  sendRichMessage: 'rich_message',
   149	  sendRichMessageDraft: 'rich_message',
   150	  // Swept in 2026-08-10 after a second-pass reviewer pointed out the same class on a different
   151	  // PARAM. A forum topic's `name` is as reader-visible as a message body, and an invisibly-titled
   152	  // topic is worse than an invisible message — it persists in the topic list, unfindable. The two
   153	  // routes that create topics validate `name.trim().length >= 1`, and `trim()` does NOT remove
   154	  // zero-width characters (they are format controls, not whitespace), so a name of two ZERO WIDTH
   155	  // SPACEs measures length 2 and passes. Verified by execution, not by reading the spec.
   156	  //
   157	  // Including these is the PATTERN swept rather than the case fixed — the failure this branch
   158	  // recorded three times is closing the instance in front of you and leaving its siblings open.
   159	  createForumTopic: 'name',
   160	  editForumTopic: 'name',
   161	};
   162	
   163	/** The method names alone, derived from the map above so the two can never disagree. */
   164	export const BODY_CARRYING_TELEGRAM_METHODS: ReadonlySet<string> = new Set(
   165	  Object.keys(READER_VISIBLE_TELEGRAM_PARAMS),
   166	);
   167	
   168	/**
   169	 * Telegram methods deliberately classified as carrying NO reader-visible field.
   170	 *
   171	 * Added 2026-08-10 on a round-3 convergence finding, and it closes the last version of this window's
   172	 * defining hole. Before it, the classification was open-world: a method in the map was guarded, and
   173	 * EVERYTHING ELSE was silently unguarded — so a future `sendPhoto` with a caption, or a `sendPoll` with a
   174	 * question, would join the codebase completely unclassified and no check would say a word. Unclassified
   175	 * members silently escaping a population is the exact shape that has produced this branch's every repeat
   176	 * failure.
   177	 *
   178	 * With both lists present the world is CLOSED: every Telegram method a sender calls is either guarded or
   179	 * explicitly declared bodyless. That closure is now enforced by `src/messaging/telegram-egress.ts`,
   180	 * which REFUSES a method in neither list — "review required", not "assumed safe".
   181	 *
   182	 * It used to be enforced by `scripts/lint-telegram-send-funnel-guarded.mjs`, which is deleted. Review
   183	 * pass 36 finding 3 caught the gap that left: for one commit the lists existed, this comment claimed
   184	 * they were enforced, and nothing enforced them — an unknown method passed the door undecided.
   185	 *
   186	 * Each entry is a claim that the method shows a reader nothing they could be deprived of:
   187	 *   answerCallbackQuery      a transient toast; an empty one legitimately dismisses the spinner
   188	 *   sendChatAction           the "typing…" indicator; no text at all
   189	 *   getUpdates/getMe/getFile/getChat/getChatMember   reads; nothing outbound
   190	 *   deleteWebhook/deleteMessage                      removals; no body
   191	 *   closeForumTopic/reopenForumTopic/pinChatMessage/unpinAllForumTopicMessages
   192	 *                            topic + message state changes; they carry ids, not prose
   193	 */
   194	export const NO_READER_VISIBLE_FIELD_TELEGRAM_METHODS: ReadonlySet<string> = new Set([
   195	  'answerCallbackQuery',
   196	  'sendChatAction',
   197	  'getUpdates',
   198	  'getMe',
   199	  'getFile',
   200	  'getChat',
   201	  'getChatMember',
   202	  'deleteWebhook',
   203	  'deleteMessage',
   204	  'closeForumTopic',
   205	  'reopenForumTopic',
   206	  'pinChatMessage',
   207	  'unpinAllForumTopicMessages',
   208	]);
   209	
   210	/**
   211	 * The refusal, at the CALLER's representation. This no longer runs in either funnel — the egress door
   212	 * checks the wire payload instead, and the funnel calls were removed as double-cover (pass 36 finding
   213	 * 6 caught this description outliving them). Its one live caller is the tokenless-relay branch in
   214	 * `TelegramAdapter`, whose send never reaches the Telegram host from this process.
   215	 *
   216	 * Historically both senders called this as the FIRST statement of their private `apiCall`, the only place every send
   217	 * provably passes through. That lint is DELETED; `scripts/lint-telegram-egress-boundary.mjs` confines
   218	 * egress to one door instead, and the door itself refuses an unclassified method (pass 37 finding 8:
   219	 * this still named the deleted lint as its enforcer).
   220	 *
   221	 * ── Why here and nowhere else ──────────────────────────────────────────────────────────────────
   222	 * This guard was placed on one HTTP route at review pass 9 and called "fixed at the point of
   223	 * sending"; pass 27 falsified that with a second route; it was moved to a second door and called
   224	 * "both doors"; pass 28 falsified THAT with a third. It was then moved into `sendToTopic` and
   225	 * called "the single chokepoint every Telegram send passes through" — and pass 29 falsified that
   226	 * by execution, because `send()` (the interface method a router calls) reaches the API without
   227	 * touching `sendToTopic` at all. FOUR enumerations, four over-claims, one habit: asserting the
   228	 * shape of a set instead of deriving it.
   229	 *
   230	 * The derived population is 16 `apiCall('sendMessage')` sites across TWO classes — 14 in the
   231	 * adapter across 9 methods, 2 in the lifeline, which has its own private funnel and had no guard
   232	 * whatsoever. The refusal in `sendToTopic` was REMOVED when this was added rather than kept as a
   233	 * belt-and-braces second copy: pass 23 established that two pieces of code closing the same case
   234	 * MASK each other's tests — break either alone and nothing reds. One way it works, one way to
   235	 * break it.
   236	 *
   237	 * Throwing is the established contract of both funnels (each already throws on a non-ok response),
   238	 * and a caller that swallows the error drops an invisible message, which is the correct outcome —
   239	 * the incident this exists for was a "reply lost" escalation raised for content that never existed.
   240	 */
   241	/** The structured record of one refusal. Carried ON the error so any catcher can log it too. */
   242	export interface InvisiblePayloadRefusal {
   243	  guard: 'invisible-payload';
   244	  outcome: 'refused';
   245	  method: string;
   246	  field: string;
   247	  /** WHY it was refused, in the predicate's own terms — never the payload itself. */
   248	  rule:
   249	    | 'no-content-codepoint'
   250	    | 'no-content-codepoint-after-format'
