  5865	 * there is no description), exactly one copy renders. Pure for testability;
  5866	 * blocks are UNESCAPED — the caller escapes each before splicing into HTML.
  5867	 */
  5868	export function attentionBodyBlocks(
  5869	  summary: string | null | undefined,
  5870	  description: string | null | undefined,
  5871	  descriptionSlice: number,
  5872	): string[] {
  5873	  const s = (summary ?? '').trim();
  5874	  const d = (description ?? '').trim();
  5875	  if (!d) return s ? [s] : [];
  5876	  const dSliced = d.slice(0, descriptionSlice);
  5877	  if (s && d.startsWith(s)) return [dSliced];
  5878	  // Leading \n preserves the original blank-line separation when joined by '\n'.
  5879	  return s ? [s, `\n${dSliced}`] : [dSliced];
  5880	}
