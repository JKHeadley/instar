   285	      await telegramFetch(`${api('sendMessage')}?chat_id=1&text=hello`, init);
   286	      const sentBody = (f.mock.calls[0][1] as { body: unknown }).body;
   287	      expect(sentBody, 'a later read must not become the wire body').toBeNull();
