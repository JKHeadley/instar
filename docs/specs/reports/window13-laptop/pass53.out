   246	    it('sends the bytes it CHECKED, not whatever the caller mutates afterwards', async () => {
   247	      // Pass 40 F2: the door read init.body, checked that value, then handed the caller's original
   248	      // mutable object to fetch — so a getter could show visible content to the check and invisible
   249	      // content to the network, falsifying this file's central claim.
   250	      const f = arm();
   251	      let reads = 0;
   252	      const init: RequestInit = { method: 'POST' };
   253	      Object.defineProperty(init, 'body', {
   254	        configurable: true,
   255	        get() { reads += 1; return reads === 1 ? JSON.stringify({ chat_id: 1, text: 'visible' }) : JSON.stringify({ chat_id: 1, text: '\u200b' }); },
   256	      });
   257	      await telegramFetch(api('sendMessage'), init);
   258	      const sent = JSON.parse((f.mock.calls[0][1] as { body: string }).body);
   259	      expect(sent.text, 'the wire body must be the one that was inspected').toBe('visible');
   260	    });
