   262	    it('freezes a MUTABLE body at capture, not just reads it once', async () => {
   263	      // Pass 41: reading once was not enough. A string IS its bytes, but URLSearchParams and FormData are
   264	      // captured by REFERENCE — so a caller mutating the same object after the check still changed what
   265	      // went on the wire. The value inspected and the value sent must be the same immutable bytes.
   266	      const f = arm();
   267	      const body = new URLSearchParams({ chat_id: '1', text: 'visible' });
   268	      const p = telegramFetch(api('sendMessage'), { method: 'POST', body });
   269	      body.set('text', '\u200b');       // mutate the very object the caller handed us
   270	      await p;
   271	      const sent = new URLSearchParams((f.mock.calls[0][1] as { body: string }).body);
   272	      expect(sent.get('text'), 'the wire body must be what was inspected').toBe('visible');
   273	    });
