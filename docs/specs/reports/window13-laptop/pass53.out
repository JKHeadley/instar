   205	  // The real hazard is silent blindness: if `denotesBotApiUrl` ever stops recognising a Bot API URL,
   206	  // every file passes and the boundary evaporates with a clean green line. So test the RECOGNISER on
   207	  // known-positive and known-negative sources before trusting its verdict on real files. A lint that
   208	  // cannot demonstrate it can still see is not entitled to report clean.
   209	  const canaries = [
   210	    ['inline template', 'const r = fetch(`https://api.telegram.org/bot${t}/sendMessage`, {});', true],
   211	    ['local variable', 'const u = `https://api.telegram.org/bot${t}/sendMessage`; fetch(u, {});', true],
   212	    ['local helper', "const api = (m) => `https://api.telegram.org/bot${t}/${m}`; fetch(api('sendMessage'), {});", true],
   213	    ['concatenated helper + query', "const api = (m) => `https://api.telegram.org/bot${t}/${m}`; fetch(api('getUpdates') + '?x=1', {});", true],
   214	    ['upper-case host', 'fetch(`https://API.TELEGRAM.ORG/bot${t}/sendMessage`, {});', true],
   215	    ['unrelated host', 'fetch(`https://example.invalid/x`, {});', false],
   216	    ['peer mesh call', 'const u = `${peer.url}/sessions`; fetch(u, {});', false],
   217	    ['property-access fetch', 'globalThis.fetch(`https://api.telegram.org/bot${t}/sendMessage`, {});', true],
   218	  ];
   219	  for (const [label, code, expected] of canaries) {
   220	    const csf = parse('canary.ts', code);
   221	    let saw = false;
   222	    const seek = (n) => {
   223	      if (isFetchCall(n) && denotesBotApiUrl(n.arguments[0], csf)) saw = true;
   224	      ts.forEachChild(n, seek);
   225	    };
   226	    seek(csf);
   227	    if (saw !== expected) {
   228	      console.error(
   229	        `[telegram-egress] FAIL — the URL recogniser is wrong on a ${label} canary `
   230	        + `(expected ${expected}, got ${saw}).\n`
   231	        + '  Every verdict this lint produces depends on that recogniser, so it reports nothing until\n'
   232	        + '  it can prove it still sees. Fix `denotesBotApiUrl`, not the canary.',
   233	      );
   234	      process.exit(1);
   235	    }
   236	  }
   237	  void doorSeen;
   238	}
   239	
   240	if (violations.length > 0) {
   241	  console.error('[telegram-egress] FAIL — Telegram Bot API reached outside the single door:\n');
   242	  for (const v of violations) {
   243	    console.error(`  ${path.relative(ROOT, v.file)}:${v.line}  fetch(${v.snippet})`);
   244	  }
   245	  console.error(
   246	    '\n  Import `telegramFetch` from src/messaging/telegram-egress.ts and call it instead of `fetch`.'
   247	    + '\n  Every Bot API send carrying a body must pass one door, so that "is the payload checked" is a'
   248	    + '\n  question about one function rather than about every sender that exists now or later.',
   249	  );
   250	  process.exit(1);
   251	}
   252	
   253	console.log(
   254	  'lint-telegram-egress-boundary: clean — Telegram Bot API egress is confined to '
   255	  + 'src/messaging/telegram-egress.ts, which checks the serialised body before sending.',
   256	);

