   334	 * KNOWN OVER-REFUSAL, named rather than discovered (pass 36 finding 5). The HTML branch strips every
   335	 * TAG-SHAPED substring without establishing that Telegram would accept it as a tag. If a payload
   336	 * carries malformed or unsupported tag-shaped text — which a reader WOULD see, because Telegram
   337	 * rejects the parse and falls back to sending the source — plus one invisible text node, the
   338	 * extraction is non-empty and invisible, so this refuses a message that would have been readable.
   339	 * The refusal is terminal, so that message is lost rather than downgraded.
   340	 *
   341	 * It is not fixed here for the same reason the under-refusals below are not: deciding it requires
   342	 * Telegram's own parse result, and every regex approximation of that parser has produced errors in
   343	 * BOTH directions (passes 34, 35, 36). It rides CMT-1260 with them.
   344	 *
   345	 * ── THE ROOT OF EVERY FINDING SINCE PASS 48, named here because it is one root and not five ────────
   346	 *
   347	 * Passes 48-51 produced six findings and every one of them was the same shape in a different place:
   348	 * this reduction counted bytes as content that Telegram treats as markup or does not render. A formula's
   349	 * LaTeX source. A media id mentioned rather than embedded, then matched as a prefix. An HTML tag inside
   350	 * a Markdown source. Each was repaired where it was found, and the next reading found the next one.
   351	 *
   352	 * They share a root: this function SUBTRACTS known markup and treats whatever survives as visible. That
   353	 * is an OPEN WORLD, and an open world cannot be complete — it can only ever remove the shapes someone
   354	 * thought of, which is exactly the sequence the last four readings recorded.
   355	 *
   356	 * **This file has already made the opposite move once, and it worked.** `CONTENT_RE` above was originally
   357	 * subtractive — it removed invisible classes and called the remainder content — and a reviewer produced
   358	 * six code points it missed on the first try. It was inverted to name what COUNTS, and the class closed.
   359	 * The same inversion is available here: extract only what is provably rendered text, and treat everything
   360	 * else as not-content by default.
   361	 *
   362	 * It is NOT done here, and the reason is a judgement rather than an oversight. Inverting this changes
   363	 * refusal semantics on a path where a wrong answer DESTROYS a real message, and the guard's own history
   364	 * says regex approximations of Telegram's parser have erred in both directions at passes 34, 35 and 36.
   365	 * The inversion wants the parse result, or a much narrower positive grammar, and it wants doing when it
   366	 * can be done carefully rather than at the end of a long session. Recorded as the structural next item,
   367	 * with the observation that its shape is already proven one screen above.
   368	 *
   369	 * KNOWN UNDER-REFUSALS, accepted deliberately. A character reference (`&#8203;`) is counted as its
   370	 * SOURCE characters, so a payload made only of encoded invisibles passes. Emphasis delimiters count as
   371	 * content, so `*\u200b*` passes. Each is a payload that reaches a reader as nothing — the very harm this
   372	 * file exists to prevent — and each is allowed anyway, because refusing them requires a rendering model
   373	 * this code cannot supply, and a wrong model destroys real messages in the other direction. Closing them
   374	 * needs Telegram's own parse result, not a better regex. Tracked as CMT-1260.
   375	 */
   376	/**
   377	 * Remove tags, tracking QUOTE STATE — because a regex is not a tokenizer, which is the exact sentence
   378	 * review pass 52 used.
   379	 *
   380	 * The previous `/<[^>]*>/g` stopped at the first `>` byte even when that byte sat inside a quoted
   381	 * attribute value. So a tag carrying `title="a > b VISIBLE"` had its opening consumed only as far as
   382	 * that inner `>`, and the remaining attribute source stayed in the leaf and counted as visible content —
   383	 * while Telegram parses the whole quoted attribute as markup and renders only the text node.
   384	 *
   385	 * A scanner rather than a cleverer pattern, deliberately: the nested-quantifier regex that would handle
   386	 * quoted attributes is also the shape that backtracks catastrophically on hostile input, and this runs on
   387	 * every outbound message.
   388	 */
   389	function stripTags(text: string): string {
   390	  let out = '';
   391	  let i = 0;
   392	  while (i < text.length) {
   393	    if (text[i] !== '<') { out += text[i]; i += 1; continue; }
   394	    // Inside a tag: consume until an UNQUOTED '>'. An unterminated tag consumes the remainder, which
   395	    // matches the previous behaviour for that case and keeps the function total.
   396	    let j = i + 1;
   397	    let quote: string | null = null;
   398	    while (j < text.length) {
   399	      const ch = text[j];
   400	      if (quote !== null) {
   401	        if (ch === quote) quote = null;
   402	      } else if (ch === '"' || ch === "'") {
   403	        quote = ch;
   404	      } else if (ch === '>') {
   405	        break;
   406	      }
   407	      j += 1;
   408	    }
   409	    i = j + 1;
   410	  }
   411	  return out;
   412	}
   413	
   414	export function readerVisibleText(text: string, parseMode?: unknown): string {
   415	  const mode = typeof parseMode === 'string' ? parseMode.toLowerCase() : '';
   416	  if (mode === 'html') {
   417	    return stripTags(text);
   418	  }
   419	  if (mode === 'markdown' || mode === 'markdownv2') {
   420	    // Rich Markdown may carry ARBITRARY HTML, and Telegram parses those tags as Rich HTML. So a tag
   421	    // name or an attribute is markup here exactly as it is in the html arm, and counting those bytes as
   422	    // content let `<b>\u200b</b>` in a markdown source vouch for a message that renders nothing.
   423	    //
   424	    // Worth naming: I read that sentence in the live reference EARLIER IN THIS WINDOW, while deriving
   425	    // the formula syntax from the same page, and did not apply it. Having the fact is not the same as
   426	    // having used it — which is the window's subject pointed at my own reading rather than my own code.
   427	    text = stripTags(text);
   428	    // The optional `!` is IMAGE syntax, not content. Without it the reduction left a bare bang behind,
   429	    // and one visible-looking character is all this check needs to be talked out of a refusal — an
   430	    // image whose destination carried the payload passed on the strength of its own punctuation.
   431	    // Found by writing the negative control for pass 48 finding 2, not by a reading.
   432	    return text.replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1');
   433	  }
   434	  return text;
   435	}
   436	
   437	/**
   438	 * The post-format check: what is about to go on the wire must still carry content once rendered.
   439	 *
   440	 * NOTE (review pass 36 finding 6): this WAS a second call beside a pre-format one in both funnels.
   441	 * Those were removed when the egress door landed — execution showed the door refuses every payload
   442	 * they caught, and two copies of one case mask each other's tests. The paragraph below describes the
   443	 * historical pairing and is kept for the reasoning, not as a description of the current call graph.
   444	 * The only surviving pre-format call is the tokenless-relay guard, which the door cannot reach.
   445	 *
   446	 * They close
   447	 * different cases — the first refuses a payload that never had content, the second refuses one whose
   448	 * content stopped being reader-visible when the representation changed — and each is proven to red on
   449	 * its own.
   450	 */
   451	type StructuredLeaf = { text: string; mode: string };
   452	
   453	/**
   454	 * The result of reading a structured field. `leaves` are the literals Telegram will actually render.
   455	 * `undecidable` means the structure carries content this guard cannot inspect — a photograph, a custom
   456	 * emoji, a LaTeX formula — so ABSENCE of a visible leaf no longer proves the reader receives nothing.
   457	 *
   458	 * The two are separate on purpose. Collapsing "I found nothing" into "there is nothing" is what makes a
   459	 * guard refuse a valid photo message, and collapsing "I cannot read this" into "this is visible" is what
   460	 * lets an invisible one through. Neither collapse is available here.
   461	 */
   462	type StructuredScan = { leaves: StructuredLeaf[]; undecidable: boolean };
   463	
   464	const NOTHING: StructuredScan = { leaves: [], undecidable: false };
   465	const OPAQUE: StructuredScan = { leaves: [], undecidable: true };
   466	
   467	function mergeScans(parts: StructuredScan[]): StructuredScan {
   468	  const leaves: StructuredLeaf[] = [];
   469	  let undecidable = false;
   470	  for (const p of parts) {
   471	    leaves.push(...p.leaves);
   472	    undecidable = undecidable || p.undecidable;
   473	  }
   474	  return { leaves, undecidable };
   475	}
   476	
   477	/**
   478	 * RichText variants that carry their rendered content in a nested `text` (itself a RichText).
   479	 *
   480	 * Every other member of such an object is DISCARDED by Telegram, which is the whole point of this table:
   481	 * a `url` variant renders its `text` and uses `url` only as the destination, so a walk must descend
   482	 * `text` and nothing else.
   483	 */
   484	const RICH_TEXT_NESTED_TEXT: ReadonlySet<string> = new Set([
   485	  'bold', 'italic', 'underline', 'strikethrough', 'spoiler', 'date_time', 'mention', 'hashtag',
   486	  'cashtag', 'bot_command', 'code', 'text_mention', 'url', 'email_address', 'bank_card_number',
   487	  'subscript', 'superscript', 'marked', 'phone_number', 'reference', 'reference_link', 'anchor_link',
   488	]);
   489	
   490	/** RichText variants that render content this guard cannot read from the request. */
   491	const RICH_TEXT_OPAQUE: ReadonlySet<string> = new Set(['custom_emoji', 'mathematical_expression']);
   492	
   493	/** RichText variants that render NOTHING. `anchor` consumes only `name`, a jump target. */
   494	const RICH_TEXT_RENDERS_NOTHING: ReadonlySet<string> = new Set(['anchor']);
   495	
   496	/** Block variants and the RichText-valued fields Telegram reads from each. */
   497	const BLOCK_RICH_TEXT_FIELDS: Readonly<Record<string, readonly string[]>> = {
   498	  heading: ['text'],
   499	  paragraph: ['text'],
   500	  pre: ['text'],
   501	  footer: ['text'],
   502	  thinking: ['text'],
   503	  pullquote: ['text', 'credit'],
   504	  blockquote: ['credit'],
   505	  details: ['summary'],
   506	  table: ['caption'],
   507	};
   508	
   509	/** Block variants whose children are themselves blocks, and the field holding them. */
   510	const BLOCK_CHILD_BLOCK_FIELDS: Readonly<Record<string, readonly string[]>> = {
   511	  blockquote: ['blocks'],
   512	  collage: ['blocks'],
   513	  slideshow: ['blocks'],
   514	  details: ['blocks'],
   515	};
   516	
   517	/** Block variants carrying a PageBlockCaption (`{text, credit}`, both RichText). */
   518	const BLOCK_CAPTION_VARIANTS: ReadonlySet<string> = new Set([
   519	  'collage', 'slideshow', 'map', 'animation', 'audio', 'photo', 'video', 'voice_note',
   520	]);
   521	
   522	/**
   523	 * Block variants that render something unreadable here — media, a map, a formula, a rule.
   524	 *
   525	 * `divider` is here and NOT below, per review pass 48. The first version of this table called a divider
   526	 * non-rendering alongside an anchor; the API defines it as a rule corresponding to `<hr/>`, which a
   527	 * reader sees. The runtime outcome happened to be the same either way, which is exactly why it was worth
   528	 * fixing: the stated-open work of refusing a structure PROVEN to render nothing depends on this
   529	 * distinction meaning what it says, and a false member would have made that repair silently wrong.
   530	 */
   531	const BLOCK_OPAQUE: ReadonlySet<string> = new Set([
   532	  'mathematical_expression', 'map', 'animation', 'audio', 'photo', 'video', 'voice_note', 'divider',
   533	]);
   534	
   535	/** The one block variant that renders nothing: an anchor, which is a jump target. */
   536	const BLOCK_RENDERS_NOTHING: ReadonlySet<string> = new Set(['anchor']);
   537	
   538	// A cyclic or adversarial structure must terminate, but the bound is NOT a content limit — pass 46 found
   539	// 16 truncates real documents, since every wrapper adds a level and a list inside a table inside a
   540	// quotation reaches that quickly. Set well past any plausible document.
   541	const STRUCTURE_DEPTH_BOUND = 200;
   542	
   543	/**
   544	 * Read a RichText value, by Telegram's grammar rather than by key name.
   545	 *
   546	 * WHERE THIS TABLE COMES FROM, since the last four repairs all failed on this exact point. Not from my
   547	 * model of the API — that has an end date and was wrong twice in one day. Not from the prose reference —
   548	 * it truncated three times. It is transcribed from the Bot API server's own request parser, which is the
   549	 * code that decides what Telegram reads: `Client::get_rich_text`, `Client::get_input_page_block`,
   550	 * `Client::get_page_block_caption`, `Client::get_page_block_table_cell`, `Client::get_input_rich_message`.
   551	 *
   552	 * THE UNION: a bare STRING (the literal), an ARRAY (the sequence), or an OBJECT carrying a `type`
   553	 * discriminator. There is no `texts` key and no `richTextPlain` type value anywhere on the wire — those
   554	 * are internal class names, and a previous version of this file asserted them as the grammar.
   555	 *
   556	 * WHY THE PREVIOUS WALK WAS WRONG, and it is the same misunderstanding one level deeper rather than a new
   557	 * bug. It descended EVERY object-valued property. Telegram reads `type`, extracts only that variant's
   558	 * declared fields, and DISCARDS every other member:
   559	 *
   560	 *     { "type": "bold", "text": {"type":"anchor","name":"x"}, "caption": {"text":"LOOKS VISIBLE"} }
   561	 *
   562	 * `bold` consumes `text` alone. `caption` is discarded. The old walk found "LOOKS VISIBLE", called the
   563	 * payload visible, and allowed it — while the reader received an anchor, which renders as nothing. Three
   564	 * previous repairs answered a reviewer by adding a key name; a key name cannot fix a SHAPE.
   565	 *
   566	 * WHAT IS DELIBERATELY NOT COLLECTED: `url`, `email_address`, `phone_number`, `anchor_name`, `name`. A
   567	 * link's DESTINATION is not what a reader sees — its label is, and the label is the nested `text`.
   568	 * Counting a destination as content is precisely how the original incident shipped: a payload whose only
   569	 * visible characters lived inside a URL. This now falls out of the table rather than being a rule applied
   570	 * beside it.
   571	 *
   572	 * A `mathematical_expression` is LaTeX SOURCE. Its source characters are not its rendered glyphs — a
   573	 * spacing-only expression is all letters and paints nothing — so it is marked OPAQUE rather than counted
   574	 * as visible. That is the honest position: this guard cannot decide a formula, it can only decline to let
   575	 * one vouch for an otherwise-invisible message.
   576	 */
   577	/**
   578	 * A formula, judged the one way this guard honestly can.
   579	 *
   580	 * ONE definition, used by all three representations — the markdown arm, the html arm, and the explicit
   581	 * structured discriminator at both inline and block level. It exists as a function rather than three
   582	 * matching lines because the last five repairs in this file were each applied to one representation of
   583	 * a class and not its siblings, and a shared definition is the only version of "swept" that cannot
   584	 * rot back apart.
   585	 *
   586	 * A formula body carrying content is UNDECIDABLE: its characters are LaTeX instructions, so this cannot
   587	 * tell whether they paint a glyph, and refusing would destroy real formula messages. A body carrying no
   588	 * content renders nothing and is DECIDED — it must not vouch for the message around it.
   589	 */
   590	function formulaScan(expression: unknown): StructuredScan {
   591	  if (typeof expression !== 'string') return NOTHING;
   592	  return hasNoVisibleCharacters(expression) ? NOTHING : OPAQUE;
   593	}
   594	
   595	function richTextScan(value: unknown, depth = 0): StructuredScan {
   596	  if (depth > STRUCTURE_DEPTH_BOUND || value === null || value === undefined) return NOTHING;
   597	
   598	  // The bare-string arm. `{"text": ["hello", {"type":"bold",...}]}` puts "hello" in an array element,
   599	  // under no key at all — the arm every key-based version of this walk returned early on.
   600	  if (typeof value === 'string') return { leaves: [{ text: value, mode: '' }], undecidable: false };
   601	  if (typeof value !== 'object') return NOTHING;
   602	  if (Array.isArray(value)) {
   603	    return mergeScans(value.map((v) => richTextScan(v, depth + 1)));
   604	  }
   605	
   606	  const type = (value as { type?: unknown }).type;
   607	  // An object with no string `type` is rejected by Telegram with 400 before anything renders. It cannot
   608	  // be a silent invisible send, and it must not be allowed to vouch for one either.
   609	  if (typeof type !== 'string') return NOTHING;
   610	  if (RICH_TEXT_RENDERS_NOTHING.has(type)) return NOTHING;
   611	  // A formula is opaque only when its own body carries content — the SAME test the markdown and html
   612	  // arms apply. Review pass 49 finding 2: that test was added there and not here, so `$\u200b$` written
   613	  // as markdown was refused while the identical formula written as a structured discriminator was
   614	  // allowed. Fifth instance this window of a repair applied to one representation of its own class.
   615	  if (type === 'mathematical_expression') return formulaScan((value as { expression?: unknown }).expression);
   616	  if (RICH_TEXT_OPAQUE.has(type)) return OPAQUE;
   617	  if (RICH_TEXT_NESTED_TEXT.has(type)) {
   618	    return richTextScan((value as { text?: unknown }).text, depth + 1);
   619	  }
   620	  // An unsupported discriminator is a 400 from Telegram's parser — a loud failure, not a silent one.
   621	  return NOTHING;
   622	}
   623	
   624	/** A PageBlockCaption is `{text, credit}`, both RichText. Nothing else in it is read. */
   625	function captionScan(value: unknown, depth: number): StructuredScan {
   626	  if (depth > STRUCTURE_DEPTH_BOUND || value === null || typeof value !== 'object') return NOTHING;
   627	  const obj = value as Record<string, unknown>;
   628	  return mergeScans([richTextScan(obj.text, depth + 1), richTextScan(obj.credit, depth + 1)]);
   629	}
   630	
   631	/** A block-level element, read by its own `type` discriminator. */
   632	function blockScan(value: unknown, depth = 0): StructuredScan {
   633	  if (depth > STRUCTURE_DEPTH_BOUND || value === null) return NOTHING;
   634	  if (Array.isArray(value)) return mergeScans(value.map((v) => blockScan(v, depth + 1)));
   635	  if (typeof value !== 'object') return NOTHING;
   636	
   637	  const obj = value as Record<string, unknown>;
   638	  const type = obj.type;
   639	  if (typeof type !== 'string') return NOTHING;
   640	  if (BLOCK_RENDERS_NOTHING.has(type)) return NOTHING;
   641	
   642	  const parts: StructuredScan[] = [];
   643	  // A media block, a map or a formula RENDERS — the message is not arriving as nothing — but what it
   644	  // renders cannot be inspected here. Its caption is still read, because a caption that is present and
   645	  // invisible is worth knowing about even when the block itself carries the message.
   646	  // Same as the inline layer: a formula vouches only if its own body carries content. Everything else
   647	  // in BLOCK_OPAQUE renders something whose content genuinely cannot be read from the request.
   648	  if (type === 'mathematical_expression') parts.push(formulaScan(obj.expression));
   649	  else if (BLOCK_OPAQUE.has(type)) parts.push(OPAQUE);
   650	  for (const field of BLOCK_RICH_TEXT_FIELDS[type] ?? []) parts.push(richTextScan(obj[field], depth + 1));
   651	  for (const field of BLOCK_CHILD_BLOCK_FIELDS[type] ?? []) parts.push(blockScan(obj[field], depth + 1));
   652	  if (BLOCK_CAPTION_VARIANTS.has(type)) parts.push(captionScan(obj.caption, depth + 1));
   653	  if (type === 'list') {
   654	    const items = obj.items;
   655	    if (Array.isArray(items)) {
   656	      for (const item of items) {
   657	        if (item !== null && typeof item === 'object') {
   658	          parts.push(blockScan((item as Record<string, unknown>).blocks, depth + 1));
   659	        }
   660	      }
   661	    }
   662	  }
   663	  if (type === 'table') {
   664	    const rows = obj.cells;
   665	    if (Array.isArray(rows)) {
   666	      for (const row of rows) {
   667	        if (!Array.isArray(row)) continue;
   668	        for (const cell of row) {
   669	          if (cell !== null && typeof cell === 'object') {
   670	            parts.push(richTextScan((cell as Record<string, unknown>).text, depth + 1));
   671	          }
   672	        }
   673	      }
   674	    }
   675	  }
   676	  // An unsupported block type is a 400 before render; it contributes nothing either way.
   677	  return mergeScans(parts);
   678	}
   679	
   680	/**
   681	 * Read a structured reader-visible field — in practice the rich-message container.
   682	 *
   683	 * THE CONTAINER IS A PRIORITY UNION, not a merge, and this is a bypass I found by reading the parser
   684	 * rather than one a reading handed me. Telegram takes `blocks` if the object has it, ELSE `markdown`,
   685	 * ELSE `html`, and ignores the others entirely. The previous walk collected all three, so a container
   686	 * pairing invisible `blocks` with a visible `html` sibling read as visible here and rendered as nothing
   687	 * there. Same shape as the discriminator bug, one layer up.
   688	 *
   689	 * `media` is read only on the markdown and html arms — and its PRESENCE proves nothing. The API defines
   690	 * the array as "media that ARE SPECIFIED IN the markdown or html fields using `tg://photo?id=`,
   691	 * `tg://video?id=` and `tg://audio?id=` links", so an entry is a declaration the source must reference
   692	 * by id in order for anything to render. Review pass 48 caught the first version of this treating any
   693	 * non-empty array as proof — which recreated the discarded-member-vouching defect one layer ABOVE the
   694	 * discriminator table, in the very increment that closed it below. It is now a reference check.
   695	 */
   696	
   697	/**
   698	 * Formula regions in a rich markdown or html source. Their content is raw LaTeX, so its characters are
   699	 * not its glyphs — a spacing-only expression is all letters and paints nothing.
   700	 *
   701	 * Pass 48 finding 1: the OPAQUE treatment reached only the explicit `mathematical_expression` block, so
   702	 * the same formula written in the markdown or html arm still had its SOURCE counted as visible content.
   703	 * One repair, one of three representations — the sweep failure this window has now recorded four times.
   704	 *
   705	 * Syntax from the live Bot API reference: markdown carries `$inline$`, `$$block$$` and a ```math fence;
   706	 * html carries `<tg-math>`.
   707	 */
   708	// Each alternative CAPTURES its body, because the delimiters are not the formula. Testing the whole
   709	// region for content counted `$`, `` ` `` and the tag name itself — so every formula looked renderable
   710	// and the empty-formula case slipped straight back through. Caught by running the control, not by
   711	// reading the regex.
   712	const MARKDOWN_FORMULA = /\$\$([\s\S]*?)\$\$|```math([\s\S]*?)```|\$([^$\n]*)\$/g;
   713	const HTML_FORMULA = /<tg-math\b[^>]*>([\s\S]*?)<\/tg-math>/gi;
   714	
   715	/**
   716	 * Does the source actually put MEDIA in front of a reader? Two documented ways, and the difference
   717	 * between them is the whole of pass 48 finding 2.
   718	 *
   719	 *   A DIRECT url — `![](https://…/photo.jpg)` in markdown, `<img src="https://…">` in html. The API
   720	 *   says media blocks support HTTP and HTTPS URLs, so this renders on its own and declares nothing.
   721	 *
   722	 *   A DECLARED entry, referenced by id — `tg://photo?id=<id>`, `tg://video?id=<id>`, `tg://audio?id=<id>`.
   723	 *   Here the `media` array is the declaration and the SOURCE is the reference. An entry nobody
   724	 *   references renders nothing, and a reference to an id nobody declared renders nothing either. Only
   725	 *   the pair is content.
   726	 *
   727	 * A custom emoji is media too — `tg://emoji?id=` in either arm — and needs no declaration.
   728	 */
   729	// `img`, `video` and `audio`. Pass 52 recorded — and pointedly did NOT count — that recognising image
   730	// syntax alone over-refuses a video- or audio-only rich HTML message. It went uncounted because it
   731	// destroys visible sends rather than leaking invisible ones, which is precisely the direction I had said
   732	// this class fails in; I then shipped an instance of it. Widened, because an over-refusal here is a real
   733	// message lost.
   734	const DIRECT_MEDIA_URL = /!\[[^\]]*\]\(\s*https?:\/\/[^)]*\)|<(?:img|video|audio)\b[^>]*\bsrc\s*=\s*["']https?:\/\/[^"']*["']/i;
   735	const EMOJI_MEDIA = /!\[[^\]]*\]\(\s*tg:\/\/emoji\?id=[^)]*\)|<(?:img|tg-emoji)\b[^>]*tg:\/\/emoji\?id=[^>]*>|<tg-emoji\b[^>]*\bemoji-id\s*=/i;
   736	
   737	/**
   738	 * A media reference must sit in an EMBEDDING POSITION, not merely appear in the source.
   739	 *
   740	 * Review pass 50: the first version matched the bare `tg://photo?id=<id>` URL anywhere in the text, so a
   741	 * mention of that URL — in a paragraph, inside an invisible run, in a code span — counted as rendered
   742	 * media and waived the refusal for a message that renders nothing.
   743	 *
   744	 * Worth recording that I half-saw this. When writing it I judged a plain substring match too weak
   745	 * BECAUSE an attacker controls the source and could plant the id in invisible text, tightened it to a
   746	 * bare-URL regex, and stopped one step short of requiring the syntax that actually embeds. Tightening
   747	 * an insufficient check by one notch reads like addressing the concern and is not the same as closing
   748	 * it — the attack I had specifically imagined still worked against the tightened version.
   749	 */
   750	function mediaEmbedPattern(idPattern: string): RegExp {
   751	  // Markdown image syntax, or an HTML tag whose attribute carries the reference.
   752	  return new RegExp(
   753	    // The id must END where the declared one ends. `id=${idPattern}[^)]*` was a PREFIX match, so a
   754	    // declared `pic1` vouched for a reference to `pic1EXTRA` — a different, undeclared media that
   755	    // renders nothing. Terminated by a parameter separator, a quote, a closing paren, or end-of-input.
   756	    `!\\[[^\\]]*\\]\\(\\s*tg://(?:photo|video|audio)\\?id=${idPattern}(?=[&)\\s"']|$)[^)]*\\)`
   757	    // `src` ONLY. An earlier version accepted ANY attribute, so `<a title="tg://photo?id=x">` — which
   758	    // embeds nothing — counted as a rendered photo. Narrowed after probing the attribute case directly.
   759	    + `|<[a-z-]+\\b[^>]*\\bsrc\\s*=\\s*["']tg://(?:photo|video|audio)\\?id=${idPattern}(?=[&"']|$)[^"']*["']`,
   760	    'i',
   761	  );
   762	}
   763	
   764	function sourceRendersMedia(source: string, media: unknown): boolean {
   765	  if (DIRECT_MEDIA_URL.test(source) || EMOJI_MEDIA.test(source)) return true;
   766	  if (!Array.isArray(media) || media.length === 0) return false;
   767	  for (const entry of media) {
   768	    if (entry === null || typeof entry !== 'object') continue;
   769	    const id = (entry as { id?: unknown }).id;
   770	    if (typeof id !== 'string' || id.length === 0) continue;
   771	    const escaped = id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
   772	    if (mediaEmbedPattern(escaped).test(source)) return true;
   773	  }
   774	  return false;
   775	}
   776	
   777	function richSourceScan(source: unknown, mode: 'Markdown' | 'HTML', media: unknown): StructuredScan {
   778	  if (typeof source !== 'string') return NOTHING;
   779	  const formula = mode === 'Markdown' ? MARKDOWN_FORMULA : HTML_FORMULA;
   780	  // A formula's source is removed from the visibility test — its characters are LaTeX instructions, not
   781	  // glyphs, so they must not vouch for the rest of the message.
   782	  //
   783	  // But removal alone would have been a REGRESSION, and the negative control for this repair is what
   784	  // caught it: an invisible body wrapped in a formula tag was REFUSED before (the tag stripped, the
   785	  // zero-width body judged and found invisible) and would have been ALLOWED after, because an empty leaf
   786	  // plus a blanket "a formula is undecidable" waives everything. An invisible payload wrapped in a
   787	  // formula tag is not an undecidable formula — it is the original incident wearing one.
   788	  //
   789	  // So a formula grants the waiver only when its own SOURCE carries content. That is the honest line: a
   790	  // formula written out of real characters may render anything and cannot be judged here, while one
   791	  // written out of nothing renders nothing and is decided.
   792	  let carriesRenderableFormula = false;
   793	  const withoutFormulas = source.replace(formula, (_region: string, ...groups: unknown[]) => {
   794	    const body = groups.find((g): g is string => typeof g === 'string');
   795	    // The SAME judgement the structured discriminators use, through the same function.
   796	    if (formulaScan(body).undecidable) carriesRenderableFormula = true;
   797	    return '';
   798	  });
   799	
   800	  return {
   801	    leaves: [{ text: withoutFormulas, mode }],
   802	    undecidable: carriesRenderableFormula || sourceRendersMedia(source, media),
   803	  };
   804	}
   805	
   806	function structuredFieldScan(value: unknown): StructuredScan {
   807	  if (value === null || typeof value !== 'object') return NOTHING;
   808	  if (Array.isArray(value)) return blockScan(value, 0);
   809	
   810	  const obj = value as Record<string, unknown>;
   811	  if ('blocks' in obj) return blockScan(obj.blocks, 0);
   812	  if ('markdown' in obj) return richSourceScan(obj.markdown, 'Markdown', obj.media);
   813	  if ('html' in obj) return richSourceScan(obj.html, 'HTML', obj.media);
   814	  // Telegram answers 400 "Rich message must be non-empty" — a loud failure, and not this guard's case.
   815	  return NOTHING;
   816	}
   817	
   818	/**
   819	 * Every reader-visible field a method may carry, IN THE METHOD'S OWN PRECEDENCE ORDER, highest first.
   820	 *
   821	 * The order is load-bearing, not cosmetic. A method carrying more than one such field does not treat them
   822	 * as equal alternatives — it picks one and never reads the others. `editMessageText` takes `rich_message`
   823	 * whenever the key is present at all (an empty one is a 400, not a fall-through) and only otherwise reads
   824	 * `text`.
   825	 */
   826	export function readerVisibleFieldsFor(method: string): readonly string[] {
   827	  const f = READER_VISIBLE_TELEGRAM_PARAMS[method];
   828	  if (f === undefined) return [];
   829	  return typeof f === 'string' ? [f] : f;
   830	}
   831	
   832	/**
   833	 * The ONE field this method will actually read, given what the request carries.
   834	 *
   835	 * Checking every present field instead was an over-refusal in the same place the waiver was an
   836	 * under-refusal: an edit carrying a visible `rich_message` beside a leftover invisible `text` was refused
   837	 * for content Telegram discards. The reader receives exactly one of these fields; that is the one to judge.
   838	 */
   839	export function effectiveReaderVisibleField(
   840	  method: string,
   841	  params: Record<string, unknown>,
   842	): string | undefined {
   843	  for (const field of readerVisibleFieldsFor(method)) {
   844	    const v = params?.[field];
   845	    if (v !== undefined && v !== null) return field;
   846	  }
   847	  return undefined;
   848	}
   849	
   850	export function assertOutgoingPayloadVisible(method: string, params: Record<string, unknown>): void {
   851	  const field = effectiveReaderVisibleField(method, params);
   852	  if (field !== undefined) assertOneOutgoingField(method, params, field);
   853	}
   854	
   855	function assertOneOutgoingField(method: string, params: Record<string, unknown>, field: string): void {
   856	  const raw = params?.[field];
   857	
   858	  // A structured field carries its content in leaves, not in the field itself (pass 44). If ANY leaf is
   859	  // visible the payload is visible. If the structure yields NO leaves at all, this cannot decide what a
   860	  // reader receives and allows — the same undecidable line the empty-extraction case takes.
   861	  //
   862	  // `undecidable` is the third answer, and it is not the same as finding nothing. A photo block, a custom
   863	  // emoji or a LaTeX formula RENDERS something this guard cannot read, so a message pairing one with an
   864	  // invisible caption is not proven invisible and must not be refused. Before this distinction existed
   865	  // the two collapsed together and a photo with a zero-width caption was destroyed on the way out.
   866	  if (raw !== null && typeof raw === 'object') {
   867	    const { leaves, undecidable } = structuredFieldScan(raw);
   868	    if (undecidable) return;
   869	    if (leaves.length === 0) return;
   870	    if (leaves.some((leaf) => !hasNoVisibleCharacters(readerVisibleText(leaf.text, leaf.mode)))) return;
   871	    emitInvisiblePayloadRefusal({
   872	      guard: 'invisible-payload',
   873	      outcome: 'refused',
   874	      method,
   875	      field,
   876	      rule: 'no-content-codepoint-after-format',
   877	      valueLength: leaves.reduce((n, l) => n + l.text.length, 0),
   878	      engine: process.version,
   879	      unicode: process.versions.unicode ?? 'unknown',
   880	    });
   881	    throw new InvisiblePayloadRefusedError(
   882	      `refused: ${method} ${field} carries no reader-visible content AFTER formatting (its structured `
   883	      + 'content has text leaves and none of them renders as anything a reader can see).',
   884	      {
   885	        guard: 'invisible-payload',
   886	        outcome: 'refused',
   887	        method,
   888	        field,
   889	        rule: 'no-content-codepoint-after-format',
   890	        valueLength: leaves.reduce((n, l) => n + l.text.length, 0),
   891	        engine: process.version,
   892	        unicode: process.versions.unicode ?? 'unknown',
   893	      },
   894	    );
   895	  }
   896	
   897	  const value = raw;
   898	  if (typeof value !== 'string') return;
   899	  const visible = readerVisibleText(value, (params as { parse_mode?: unknown })?.parse_mode);
   900	  if (!hasNoVisibleCharacters(visible)) return;
   901	
   902	  // THE UNDECIDABLE CASE, and the line that separates it from the decided one (review pass 34 finding 1).
   903	  //
   904	  // An extraction that is EMPTY means the payload had no text nodes at all — it is pure markup. Such a
   905	  // payload has two possible fates and this code cannot tell which: valid markup renders as nothing (a
   906	  // real invisible send), while MALFORMED markup is rejected by Telegram and falls back to a plain-text
   907	  // send in which the tags are shown to the reader. Deciding between them needs Telegram's own parser.
   908	  //
   909	  // An extraction that is NON-EMPTY but carries no visible character is DECIDED: text nodes exist and
   910	  // they contain nothing a reader can see. That is the pass-33 case — a link whose label is a zero-width
   911	  // space — and it stays refused.
   912	  //
   913	  // Where it cannot decide, it ALLOWS, because this guard's own policy is that an over-refusal destroys a
   914	  // real message. Refusing pure markup outright killed a deliverable one: `<b><i>` renders as visible
   915	  // text after the fallback, and the first version of this check threw before the fallback could run.
   916	  // The honest cost is stated rather than hidden: a payload of VALID markup with no text nodes is not
   917	  // refused by this arm.
   918	  if (visible.length === 0 && value.length > 0) return;
   919	
   920	  const decision: InvisiblePayloadRefusal = {
   921	    guard: 'invisible-payload',
   922	    outcome: 'refused',
   923	    method,
   924	    field,
   925	    rule: 'no-content-codepoint-after-format',
   926	    valueLength: value.length,
   927	    engine: process.version,
   928	    unicode: process.versions.unicode ?? 'unknown',
   929	  };
   930	  try { refusalSink(decision); } catch { /* a broken sink never becomes a delivery */ }
   931	  throw new InvisiblePayloadRefusedError(
   932	    `refused: ${method} ${field} carries no reader-visible content AFTER formatting (its content `
   933	    + 'characters survive only inside markup such as a link destination or a tag attribute, which a '
   934	    + 'reader never sees).',
   935	    decision,
   936	  );
   937	}
   938	
   939	export function assertTelegramPayloadVisible(method: string, params: Record<string, unknown>): void {
   940	  const field = effectiveReaderVisibleField(method, params);
   941	  if (field !== undefined) assertOnePreFormatField(method, params, field);
   942	}
   943	
   944	function assertOnePreFormatField(method: string, params: Record<string, unknown>, field: string): void {
   945	  const value = params?.[field];
   946	  if (typeof value !== 'string') return;
   947	  if (!hasNoVisibleCharacters(value)) return;
   948	
   949	  const decision: InvisiblePayloadRefusal = {
   950	    guard: 'invisible-payload',
   951	    outcome: 'refused',
   952	    method,
   953	    field,
   954	    rule: 'no-content-codepoint',
   955	    valueLength: value.length,
   956	    engine: process.version,
   957	    unicode: process.versions.unicode ?? 'unknown',
   958	  };
   959	  // The decision is recorded BEFORE the throw, so a caller that swallows the error cannot also
   960	  // swallow the record — which is the whole point of the requirement.
   961	  try {
   962	    refusalSink(decision);
   963	  } catch {
   964	    // A broken sink must never convert a refusal into a delivery.
   965	  }
   966	  throw new InvisiblePayloadRefusedError(
   967	    `refused: ${method} ${field} contains no visible characters (only whitespace, zero-width or `
   968	    + 'ignorable marks, control/unassigned/private-use code points, or blank glyphs). An invisible '
   969	    + 'message cannot inform a reader, and delivering it would produce a '
   970	    + '"reply lost" escalation for content that never existed.',
   971	    decision,
   972	  );
   973	}

