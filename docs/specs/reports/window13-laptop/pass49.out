    21	describe('telegram egress boundary — the single door', () => {
    22	  describe('the method comes from the URL, not from a caller label', () => {
    23	    it('reads the method Telegram itself dispatches on', () => {
    24	      expect(methodFromTelegramUrl(api('sendMessage'))).toBe('sendMessage');
    25	      expect(methodFromTelegramUrl(api('editMessageText'))).toBe('editMessageText');
    26	    });
    27	
    28	    it('does not claim a method for a non-Bot-API URL', () => {
    29	      // The file-download host carries no body and no reader-visible field.
    30	      expect(methodFromTelegramUrl(`https://api.telegram.org/file/bot${TOKEN}/photo.jpg`)).toBeNull();
    31	      expect(methodFromTelegramUrl('http://127.0.0.1:4042/internal/telegram-forward')).toBeNull();
    32	    });
    33	  });
    34	
    35	  describe('refusal', () => {
    36	    it('refuses an invisible body and never reaches the network', async () => {
    37	      const f = arm();
    38	      await expect(telegramFetch(api('sendMessage'), post({ chat_id: 1, text: '​​' })))
    39	        .rejects.toThrow(InvisiblePayloadRefusedError);
    40	      expect(f, 'a refused payload must not be sent').not.toHaveBeenCalled();
    41	    });
    42	
    43	    it('refuses a link whose label is invisible — the payload the earlier guards missed', async () => {
    44	      const f = arm();
    45	      await expect(telegramFetch(api('sendMessage'), post({
    46	        chat_id: 1, text: '<a href="https://example.com/x">​</a>', parse_mode: 'HTML',
    47	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
    48	      expect(f).not.toHaveBeenCalled();
    49	    });
    50	
    51	    it('refuses an invisible forum-topic name, which is a different field', async () => {
    52	      const f = arm();
    53	      await expect(telegramFetch(api('createForumTopic'), post({ chat_id: 1, name: 'ㅤ' })))
    54	        .rejects.toThrow(InvisiblePayloadRefusedError);
