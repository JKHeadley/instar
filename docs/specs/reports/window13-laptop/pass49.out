  5814	          const retryAfter = errorData?.parameters?.retry_after ?? 5;
  5815	          console.warn(`[telegram] Rate limited on ${method}, waiting ${retryAfter}s (retry ${retryCount + 1}/3)...`);
  5816	          await new Promise(resolve => setTimeout(resolve, retryAfter * 1000));
