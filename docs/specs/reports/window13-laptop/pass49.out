   381	type StructuredLeaf = { text: string; mode: string };
   382	
   383	/**
   384	 * The result of reading a structured field. `leaves` are the literals Telegram will actually render.
   385	 * `undecidable` means the structure carries content this guard cannot inspect — a photograph, a custom
   386	 * emoji, a LaTeX formula — so ABSENCE of a visible leaf no longer proves the reader receives nothing.
   387	 *
   388	 * The two are separate on purpose. Collapsing "I found nothing" into "there is nothing" is what makes a
   389	 * guard refuse a valid photo message, and collapsing "I cannot read this" into "this is visible" is what
   390	 * lets an invisible one through. Neither collapse is available here.
   391	 */
   392	type StructuredScan = { leaves: StructuredLeaf[]; undecidable: boolean };
   393	
   394	const NOTHING: StructuredScan = { leaves: [], undecidable: false };
   395	const OPAQUE: StructuredScan = { leaves: [], undecidable: true };
   396	
   397	function mergeScans(parts: StructuredScan[]): StructuredScan {
   398	  const leaves: StructuredLeaf[] = [];
   399	  let undecidable = false;
   400	  for (const p of parts) {
   401	    leaves.push(...p.leaves);
   402	    undecidable = undecidable || p.undecidable;
   403	  }
   404	  return { leaves, undecidable };
   405	}
