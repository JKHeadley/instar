   359	const PRIORITY_EMOJI: Record<string, string> = {
   360	  URGENT: '\ud83d\udd34',  // 🔴

 succeeded in 0ms:
     1	/**
     2	 * invisible-payload.ts — the single definition of "this message has nothing a human can see".
     3	 *
     4	 * Extracted 2026-08-09 because review pass 9 found the regression test had its OWN copy of the
     5	 * predicate: deleting the guard from the route would have left the test green. A test that cannot
     6	 * fail when the thing it guards is removed is the *alive-but-inert* shape in test form — it reports
     7	 * identically whether or not the protection exists. One definition, imported by both.
     8	 *
     9	 * The rule itself is Unicode's, not a hand-written list. An earlier version enumerated five code
    10	 * points and pass 8 immediately produced five more it missed (U+200E, U+2061, U+FE0F, U+00AD,
    11	 * U+180E), so "invisible payloads are refused" was true of the incident and false as a claim.
    12	 * `Default_Ignorable_Code_Point` is the standard's own category for characters that render as
    13	 * nothing; `Cf` is format controls.
    14	 *
    15	 * Earned from a live incident: a peer agent's relay accepted a send whose entire body was one
    16	 * ZERO-WIDTH SPACE, failed with a 500 carrying an EMPTY error body, burned nine retries across
    17	 * 4h17m, and emitted a user-facing "I had a reply for you but couldn't deliver it" notice. There
    18	 * was no reply.
    19	 *
    20	 * **What this does NOT decide:** whether a visible message is *worth* sending. It answers exactly
    21	 * one question — is there anything here a reader could see — and a message consisting of a single
    22	 * full stop passes, correctly.
    23	 */
    24	
    25	/**
    26	 * CONTENT is defined POSITIVELY: a letter, a number, punctuation, or a symbol.
    27	 *
    28	 * ── Why positive, after a round-6 convergence finding proved the subtractive version wrong ──────
    29	 * The original predicate SUBTRACTED a list of invisible classes (whitespace + Default_Ignorable + Cf)
    30	 * and treated everything remaining as visible. That is an OPEN WORLD, and an open world cannot be
    31	 * complete: an external reviewer named the gap and execution confirmed it — a payload consisting only
    32	 * of a C0 control (U+0001, U+0007, U+001B), an unassigned code point (U+0378), a private-use code
    33	 * point (U+E000), a noncharacter (U+FFFE), a lone combining mark (U+0301), or a lone surrogate
    34	 * (U+D800) ALL PASSED as "visible" and would have been delivered. Every one renders as nothing or as
    35	 * tofu — the exact harm of the incident this guard exists for, on a wider input surface.
    36	 *
    37	 * Subtracting the invisible is the same mistake as enumerating the senders: you can only ever remove
    38	 * the shapes you thought of. Naming what COUNTS closes the world — anything not named is not content,
    39	 * including whatever Unicode adds next.
    40	 *
    41	 * `L` letters, `N` numbers, `P` punctuation (so a lone full stop is a legitimate message, as it always
    42	 * was), `S` symbols (so emoji count).
    43	 *
    44	 * **ALL marks (`M`) are content, and the road here is worth recording because I was wrong twice.**
    45	 * The first version excluded every mark. Review pass 30 proved that over-refuses real text and I admitted
    46	 * `Mc`/`Me`, justifying the split by ADVANCE WIDTH — spacing and enclosing marks occupy width, nonspacing
    47	 * marks do not.
    48	 *
    49	 * **That justification was false, and review pass 31 refuted it by measurement.** I re-measured on this
    50	 * host rather than concede on assertion: at 40pt, `Mn` U+20D0 COMBINING LEFT HARPOON ABOVE advances
    51	 * **18.400** and `Mn` U+0301 COMBINING ACUTE advances **15.078**. Nonspacing marks are NOT zero-advance,
    52	 * so General Category was never an advance-width predicate — it was a plausible story fitted to two
    53	 * examples. (I do not reproduce the reviewer's `Me` = 0.000 figure; mine measures 42.695. That
    54	 * discrepancy is beside the point — the half that refutes MY claim reproduces.)
    55	 *
    56	 * So the split is gone rather than re-justified. Unicode classes `M` as GRAPHIC; a mark renders, on its
    57	 * base or on a dotted-circle placeholder. Admitting all of `M` is also the SAFE direction: this guard
    58	 * exists to stop invisible sends, and every over-refusal it makes destroys a real message.
    59	 *
    60	 * `L` letters, `N` numbers, `P` punctuation (so a lone full stop is a legitimate message, as it always
    61	 * was), `S` symbols (so emoji count), `M` marks. Deliberately NOT content: separators (`Z`) and every
    62	 * control/format/unassigned/private-use/surrogate category (`C`).
    63	 */
    64	const CONTENT_RE = /[\p{L}\p{N}\p{P}\p{S}\p{M}]/u;
    65	/**
    66	 * ...EXCEPT code points Unicode itself classes as rendering to nothing.
    67	 *
    68	 * Admitting all of `M` was caught within one test run by the fixtures already in this file: U+FE0F
    69	 * VARIATION SELECTOR-16 is `Mn` and renders NOTHING — it modifies a neighbour's presentation. Widening
    70	 * by category alone would have re-opened the original hole through a side door.
    71	 *
    72	 * `Default_Ignorable_Code_Point` is the standard's own answer to "renders as nothing", so the rule is:
    73	 * a letter, number, punctuation mark, symbol or mark is content UNLESS the standard says it is
    74	 * ignorable. One principled subtraction from a positive base, not a hand-list of exceptions.
    75	 */
    76	const IGNORABLE_RE = /\p{Default_Ignorable_Code_Point}/u;
    77	
    78	/**
    79	 * Code points that are CATEGORY-POSITIVE but render BLANK — the positive predicate's own false positives.
    80	 *
    81	 * Found at convergence round 10, and confirmed by execution: each of these is a letter (`Lo`) or a symbol
    82	 * (`So`) by General_Category, so `CONTENT_RE` accepted it, and each renders as empty space in ordinary
    83	 * clients. A message of one HANGUL FILLER is the incident all over again, wearing a letter's category.
    84	 *
    85	 * **Honest about what this is.** The positive definition closed the open world of non-printing CATEGORIES;
    86	 * this is a small subtraction from inside the positive set, and a subtraction has a tail — a future
    87	 * category-positive blank code point would pass until it is added here. That residual is accepted
    88	 * deliberately and stated in the spec rather than papered over: the structural fix is the vendored,
    89	 * generated table (CMT-1261 — it was CMT-1246 criterion (d), which shipped without it), which derives blankness rather than listing it. Fixtures pin every member.
    90	 */
    91	const BLANK_GLYPHS = new Set([
    92	  'ㅤ',  // HANGUL FILLER (Lo)
    93	  'ᅟ',  // HANGUL CHOSEONG FILLER (Lo)
    94	  'ᅠ',  // HANGUL JUNGSEONG FILLER (Lo)
    95	  'ﾠ',  // HALFWIDTH HANGUL FILLER (Lo)
    96	  '⠀',  // BRAILLE PATTERN BLANK (So)
    97	]);
    98	
    99	/**
   100	 * True when `text` carries nothing a reader could receive as content. Callers refuse such a payload
   101	 * rather than sending it.
   102	 *
   103	 * The name is kept for its callers and its history; the precise claim is the MECHANICALLY-VISIBLE one:
   104	 * the string contains at least one letter, number, punctuation mark, symbol OR MARK that is not
   105	 * `Default_Ignorable` and not a known blank glyph. (Corrected at review pass 33 finding 5: this
   106	 * sentence still listed only L/N/P/S after marks were admitted — the account of a repair going stale
   107	 * one function below the repair itself.)
   108	 */
   109	export function hasNoVisibleCharacters(text: string): boolean {
   110	  for (const ch of text) {
   111	    if (CONTENT_RE.test(ch) && !IGNORABLE_RE.test(ch) && !BLANK_GLYPHS.has(ch)) return false;
   112	  }
   113	  return true;
   114	}
   115	
   116	/**
   117	 * The Telegram API methods whose `text` parameter IS the body a reader reads.
   118	 *
   119	 * DERIVED, not asserted (2026-08-10, window 12). Every `apiCall('<method>')` in `src/` was
   120	 * enumerated and each method inspected for a reader-visible `text` param. `sendMessage` and
   121	 * `editMessageText` carry one; `answerCallbackQuery` also carries `text`, and is deliberately
   122	 * EXCLUDED — it renders a transient toast, and an empty one legitimately just dismisses the
   123	 * spinner, so refusing it would be an over-refusal rather than a protection.
   124	 */
   125	export const READER_VISIBLE_TELEGRAM_PARAMS: Readonly<Record<string, string | readonly string[]>> = {
   126	  sendMessage: 'text',
   127	  // `editMessageText` also accepts `rich_message`, and a method can carry reader-visible content in
   128	  // MORE THAN ONE field — which this map could not express until review pass 43. Checking only `text`
   129	  // meant an edit carrying its content as `rich_message` returned silently and was sent unexamined.
   130	  //
   131	  // Worth recording how this was nearly missed: I judged `rich_message` a fabricated field because it
   132	  // is absent from the Bot API I know, and only fetching the live documentation showed it was added
   133	  // after my knowledge. Dismissing it would have discarded a real bypass on the strength of stale
   134	  // memory — the same defect as trusting a stale claim, pointed the other way.
   135	  //
   136	  // ORDERED BY THE METHOD'S OWN PRECEDENCE, highest first, and that order is load-bearing. The handler
   137	  // branches on whether the `rich_message` key is PRESENT and only otherwise reads `text` — an empty
   138	  // `rich_message` is a 400, not a fall-through. Listing `text` first (as this did until window 13) made
   139	  // the two read as equal alternatives, which is exactly what the waiver below then assumed.
   140	  editMessageText: ['rich_message', 'text'],
   141	  // The dedicated rich-message methods. Absent from this table they were REFUSED as unclassified,
   142	  // which was the safe direction but would have broken a legitimate send the moment one was used.
   143	  // `rich_message` ONLY. Mapping `text` here too was a phantom field (pass 47): these methods do not
   144	  // accept it, and the egress waives its unreadable-body refusal when ANY mapped field arrives in the
   145	  // query — so `?text=visible` on a method that ignores `text`, plus an unreadable body, waived the
   146	  // refusal. A field map that is too WIDE is not harmlessly cautious; it hands the waiver a key the
   147	  // method never reads.
   148	  sendRichMessage: 'rich_message',
   149	  sendRichMessageDraft: 'rich_message',
   150	  // Swept in 2026-08-10 after a second-pass reviewer pointed out the same class on a different
   151	  // PARAM. A forum topic's `name` is as reader-visible as a message body, and an invisibly-titled
   152	  // topic is worse than an invisible message — it persists in the topic list, unfindable. The two
   153	  // routes that create topics validate `name.trim().length >= 1`, and `trim()` does NOT remove
   154	  // zero-width characters (they are format controls, not whitespace), so a name of two ZERO WIDTH
   155	  // SPACEs measures length 2 and passes. Verified by execution, not by reading the spec.
   156	  //
   157	  // Including these is the PATTERN swept rather than the case fixed — the failure this branch
   158	  // recorded three times is closing the instance in front of you and leaving its siblings open.
   159	  createForumTopic: 'name',
   160	  editForumTopic: 'name',
   161	};
   162	
   163	/** The method names alone, derived from the map above so the two can never disagree. */
   164	export const BODY_CARRYING_TELEGRAM_METHODS: ReadonlySet<string> = new Set(
   165	  Object.keys(READER_VISIBLE_TELEGRAM_PARAMS),
   166	);
   167	
   168	/**
   169	 * Telegram methods deliberately classified as carrying NO reader-visible field.
   170	 *
   171	 * Added 2026-08-10 on a round-3 convergence finding, and it closes the last version of this window's
   172	 * defining hole. Before it, the classification was open-world: a method in the map was guarded, and
   173	 * EVERYTHING ELSE was silently unguarded — so a future `sendPhoto` with a caption, or a `sendPoll` with a
   174	 * question, would join the codebase completely unclassified and no check would say a word. Unclassified
   175	 * members silently escaping a population is the exact shape that has produced this branch's every repeat
   176	 * failure.
   177	 *
   178	 * With both lists present the world is CLOSED: every Telegram method a sender calls is either guarded or
   179	 * explicitly declared bodyless. That closure is now enforced by `src/messaging/telegram-egress.ts`,
   180	 * which REFUSES a method in neither list — "review required", not "assumed safe".
   181	 *
   182	 * It used to be enforced by `scripts/lint-telegram-send-funnel-guarded.mjs`, which is deleted. Review
   183	 * pass 36 finding 3 caught the gap that left: for one commit the lists existed, this comment claimed
   184	 * they were enforced, and nothing enforced them — an unknown method passed the door undecided.
   185	 *
   186	 * Each entry is a claim that the method shows a reader nothing they could be deprived of:
   187	 *   answerCallbackQuery      a transient toast; an empty one legitimately dismisses the spinner
   188	 *   sendChatAction           the "typing…" indicator; no text at all
   189	 *   getUpdates/getMe/getFile/getChat/getChatMember   reads; nothing outbound
   190	 *   deleteWebhook/deleteMessage                      removals; no body
   191	 *   closeForumTopic/reopenForumTopic/pinChatMessage/unpinAllForumTopicMessages
   192	 *                            topic + message state changes; they carry ids, not prose
   193	 */
   194	export const NO_READER_VISIBLE_FIELD_TELEGRAM_METHODS: ReadonlySet<string> = new Set([
   195	  'answerCallbackQuery',
   196	  'sendChatAction',
   197	  'getUpdates',
   198	  'getMe',
   199	  'getFile',
   200	  'getChat',
   201	  'getChatMember',
   202	  'deleteWebhook',
   203	  'deleteMessage',
   204	  'closeForumTopic',
   205	  'reopenForumTopic',
   206	  'pinChatMessage',
   207	  'unpinAllForumTopicMessages',
   208	]);
   209	
   210	/**
   211	 * The refusal, at the CALLER's representation. This no longer runs in either funnel — the egress door
   212	 * checks the wire payload instead, and the funnel calls were removed as double-cover (pass 36 finding
   213	 * 6 caught this description outliving them). Its one live caller is the tokenless-relay branch in
   214	 * `TelegramAdapter`, whose send never reaches the Telegram host from this process.
   215	 *
   216	 * Historically both senders called this as the FIRST statement of their private `apiCall`, the only place every send
   217	 * provably passes through. That lint is DELETED; `scripts/lint-telegram-egress-boundary.mjs` confines
   218	 * egress to one door instead, and the door itself refuses an unclassified method (pass 37 finding 8:
   219	 * this still named the deleted lint as its enforcer).
   220	 *
   221	 * ── Why here and nowhere else ──────────────────────────────────────────────────────────────────
   222	 * This guard was placed on one HTTP route at review pass 9 and called "fixed at the point of
   223	 * sending"; pass 27 falsified that with a second route; it was moved to a second door and called
   224	 * "both doors"; pass 28 falsified THAT with a third. It was then moved into `sendToTopic` and
   225	 * called "the single chokepoint every Telegram send passes through" — and pass 29 falsified that
   226	 * by execution, because `send()` (the interface method a router calls) reaches the API without
   227	 * touching `sendToTopic` at all. FOUR enumerations, four over-claims, one habit: asserting the
   228	 * shape of a set instead of deriving it.
   229	 *
   230	 * The derived population is 16 `apiCall('sendMessage')` sites across TWO classes — 14 in the
   231	 * adapter across 9 methods, 2 in the lifeline, which has its own private funnel and had no guard
   232	 * whatsoever. The refusal in `sendToTopic` was REMOVED when this was added rather than kept as a
   233	 * belt-and-braces second copy: pass 23 established that two pieces of code closing the same case
   234	 * MASK each other's tests — break either alone and nothing reds. One way it works, one way to
   235	 * break it.
   236	 *
   237	 * Throwing is the established contract of both funnels (each already throws on a non-ok response),
   238	 * and a caller that swallows the error drops an invisible message, which is the correct outcome —
   239	 * the incident this exists for was a "reply lost" escalation raised for content that never existed.
   240	 */
   241	/** The structured record of one refusal. Carried ON the error so any catcher can log it too. */
   242	export interface InvisiblePayloadRefusal {
   243	  guard: 'invisible-payload';
   244	  outcome: 'refused';
   245	  method: string;
   246	  field: string;
   247	  /** WHY it was refused, in the predicate's own terms — never the payload itself. */
   248	  rule:
   249	    | 'no-content-codepoint'
   250	    | 'no-content-codepoint-after-format'
   251	    /** The egress door refused a Bot API method nobody has classified (pass 36 finding 3). */
   252	    | 'unclassified-method'
   253	    /** The egress door could not read the request's parameters, so it could not decide (pass 36 finding 1). */
   254	    | 'unreadable-request';
   255	  /** Length only. The payload is invisible, but it is still user content and is never logged. */
   256	  valueLength: number;
   257	  /** The predicate is engine-resolved, so the engine is part of the decision (see multi-machine posture). */
   258	  engine: string;
   259	  unicode: string;
   260	}
   261	
   262	/** Error type carrying the structured decision, so a caller that catches can record it as well. */
   263	export class InvisiblePayloadRefusedError extends Error {
   264	  readonly decision: InvisiblePayloadRefusal;
   265	  constructor(message: string, decision: InvisiblePayloadRefusal) {
   266	    super(message);
   267	    this.name = 'InvisiblePayloadRefusedError';
   268	    this.decision = decision;
   269	  }
   270	}
   271	
   272	/**
   273	 * Where refusal decisions are emitted. Defaults to one structured line on stderr.
   274	 *
   275	 * `docs/signal-vs-authority.md` is explicit: *"Authorities must log their decisions in a structured form:
   276	 * which signals they received, what the conversation context was, which rule they applied, and what the
   277	 * outcome was. This is how over-blocks and under-blocks become detectable instead of just frustrating."*
   278	 * This guard IS blocking authority, and it logged nothing — raised at convergence round 4, not acted on,
   279	 * and raised again at round 11. Seeing a finding and not acting on it is worse than not seeing it.
   280	 *
   281	 * A console sink rather than a file sink deliberately: this function is called from CLI commands and setup
   282	 * wizards as well as the server, and a shared pure module that opens a log file on a CLI path would be a
   283	 * worse defect than the one it fixes. Injectable so a host with a real audit trail can route it there.
   284	 */
   285	let refusalSink: (decision: InvisiblePayloadRefusal) => void = (decision) => {
   286	  console.warn(`[invisible-payload] ${JSON.stringify(decision)}`);
   287	};
   288	
   289	/** Route refusal decisions to a host-provided audit trail. Returns the previous sink. */
   290	/**
   291	 * Record a refusal that did NOT come from the predicate — the egress door's own "I cannot decide"
   292	 * cases. Review pass 37 finding 6: those threw bare errors, so the one refusal class that means
   293	 * "something is here I do not understand" was the only one invisible to the decision stream, while
   294	 * tests and the spec both claimed every refusal is recorded.
   295	 */
   296	export function emitInvisiblePayloadRefusal(decision: InvisiblePayloadRefusal): void {
   297	  try { refusalSink(decision); } catch { /* a broken sink never becomes a delivery */ }
   298	}
   299	
   300	export function setInvisiblePayloadRefusalSink(
   301	  sink: (decision: InvisiblePayloadRefusal) => void,
   302	): (decision: InvisiblePayloadRefusal) => void {
   303	  const previous = refusalSink;
   304	  refusalSink = sink;
   305	  return previous;
   306	}
   307	
   308	/**
   309	 * What a READER actually receives, given a Telegram parse mode.
   310	 *
   311	 * Review pass 33 finding 1, proven by execution before repair: the guard ran on the PRE-FORMAT source
   312	 * while the formatter then changed the representation. A payload whose only content characters sat in a
   313	 * link DESTINATION passed — `[<zero-width>](https://example.com/x)` — and went on the wire as
   314	 * `<a href="https://example.com/x">\u200b</a>` with `parse_mode: HTML`. Tags stripped, the reader
   315	 * received one zero-width space. The original incident's exact harm, through the one door nobody had
   316	 * looked at, inside the guard built to close that harm.
   317	 *
   318	 * The reasoning that failed is worth naming: "the source contains a visible code point, therefore the
   319	 * reader receives content" does not survive a representation change. Whatever transforms the message
   320	 * last is what decides what a reader sees.
   321	 *
   322	 * This extraction is DELIBERATELY SMALLER than a renderer, and review pass 35 is why. An earlier version
   323	 * grew toward modelling Telegram's two parsers — decoding character references, consuming emphasis
   324	 * delimiters — and every approximation error became an OVER-refusal: `~` is not a delimiter in legacy
   325	 * Markdown, and `zwnj`/`nbsp`/`shy`/`apos` are not entities Telegram's HTML mode resolves, so payloads
   326	 * whose visible content was literal punctuation were being judged empty. An over-refusal destroys a real
   327	 * message. Rather than chase a parser with regexes, this keeps only the two transforms that are true of
   328	 * Telegram's rendering when the markup is VALID — and that qualification is load-bearing, because
   329	 * review pass 36 finding 5 showed the previous sentence ("without qualification") was false:
   330	 *
   331	 *   HTML     — a tag is markup; its attributes are never shown.
   332	 *   Markdown — a link displays its LABEL; the destination is not shown.
   333	 *
   334	 * KNOWN OVER-REFUSAL, named rather than discovered (pass 36 finding 5). The HTML branch strips every
   335	 * TAG-SHAPED substring without establishing that Telegram would accept it as a tag. If a payload
   336	 * carries malformed or unsupported tag-shaped text — which a reader WOULD see, because Telegram
   337	 * rejects the parse and falls back to sending the source — plus one invisible text node, the
   338	 * extraction is non-empty and invisible, so this refuses a message that would have been readable.
   339	 * The refusal is terminal, so that message is lost rather than downgraded.
   340	 *
   341	 * It is not fixed here for the same reason the under-refusals below are not: deciding it requires
   342	 * Telegram's own parse result, and every regex approximation of that parser has produced errors in
   343	 * BOTH directions (passes 34, 35, 36). It rides CMT-1260 with them.
   344	 *
   345	 * KNOWN UNDER-REFUSALS, accepted deliberately. A character reference (`&#8203;`) is counted as its
   346	 * SOURCE characters, so a payload made only of encoded invisibles passes. Emphasis delimiters count as
   347	 * content, so `*\u200b*` passes. Each is a payload that reaches a reader as nothing — the very harm this
   348	 * file exists to prevent — and each is allowed anyway, because refusing them requires a rendering model
   349	 * this code cannot supply, and a wrong model destroys real messages in the other direction. Closing them
   350	 * needs Telegram's own parse result, not a better regex. Tracked as CMT-1260.
   351	 */
   352	export function readerVisibleText(text: string, parseMode?: unknown): string {
   353	  const mode = typeof parseMode === 'string' ? parseMode.toLowerCase() : '';
   354	  if (mode === 'html') {
   355	    return text.replace(/<[^>]*>/g, '');
   356	  }
   357	  if (mode === 'markdown' || mode === 'markdownv2') {
   358	    // The optional `!` is IMAGE syntax, not content. Without it the reduction left a bare bang behind,
   359	    // and one visible-looking character is all this check needs to be talked out of a refusal — an
   360	    // image whose destination carried the payload passed on the strength of its own punctuation.

