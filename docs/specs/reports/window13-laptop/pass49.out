   541	/**
   542	 * Telegram setup — instar-native readline backstop (v1.2.15 flow).
   543	 *
   544	 * Drives the entire setup from instar
   545	 * with readline + the Telegram Bot API. No LLM session is involved.
   546	 * See spec wizard-telegram-native.md for the original rationale.
   547	 */
   548	async function runTelegramSetup(options: GeminiDriverOptions): Promise<Partial<WizardAnswers>> {
   549	  console.log();
   550	  console.log(pc.bold('  Telegram setup'));
   551	  console.log(pc.dim('  This takes about 2 minutes. I\'ll walk you through each step.'));
   552	  console.log();
   553	  console.log(pc.bold('  Step 1 of 3 — Create a bot'));
   554	  console.log('  • Open https://web.telegram.org/a/ in your browser');
   555	  console.log('  • Search for @BotFather and start a chat');
   556	  console.log('  • Send /newbot and follow the prompts:');
   557	  console.log('      – Display name (e.g. "Instar Codey")');
   558	  console.log('      – Username (must end with "bot", e.g. "instar_codey_bot")');
   559	  console.log('  • BotFather will reply with a token like 1234567890:AAH...');
   560	  console.log();
   561	
   562	  let token = '';
   563	  let botUsername = '';
   564	  for (let attempt = 0; attempt < 5; attempt++) {
   565	    const input = (await askUser('  Paste the bot token here: ')).trim();
   566	    if (!input) {
   567	      console.log(pc.yellow('  That looked blank — paste the token from BotFather (the long string).'));
   568	      continue;
   569	    }
   570	    console.log(pc.dim('  Verifying token with Telegram…'));
   571	    const verified = await telegramGetMe(input);
   572	    if (!verified.ok) {
   573	      console.log(pc.yellow(`  Telegram rejected that token: ${verified.error}. Try pasting it again.`));
   574	      continue;
   575	    }
   576	    token = input;
   577	    botUsername = verified.username;
   578	    console.log(pc.green(`  ✓ Bot verified: @${botUsername}`));
   579	    break;
   580	  }
   581	  if (!token) {
   582	    console.log(pc.yellow('  Skipping Telegram for now. You can finish setup by chatting your agent later.'));
   583	    return { telegramConfigured: false };
   584	  }
   585	
   586	  console.log();
   587	  console.log(pc.bold('  Step 2 of 3 — Connect a chat'));
   588	  console.log(`  • In Telegram, create a new group (or open an existing one)`);
   589	  console.log(`  • Add @${botUsername} as a member`);
   590	  console.log('  • Send any message in the group ("hi" works)');
   591	  console.log();
   592	  await askUser('  Press Enter once you\'ve done that > ');
   593	
   594	  let chatId = '';
   595	  let chatName = '';
   596	  for (let attempt = 0; attempt < 4; attempt++) {
   597	    console.log(pc.dim('  Fetching the chat ID from Telegram…'));
   598	    const updates = await telegramGetUpdates(token);
   599	    if (!updates.ok) {
   600	      console.log(pc.yellow(`  Couldn't reach Telegram: ${updates.error}.`));
   601	      const retry = (await askUser('  Press Enter to try again, type "skip" to skip > ')).toLowerCase().trim();
   602	      if (retry === 'skip') break;
   603	      continue;
   604	    }
   605	    // Prefer group/supergroup chats. Fall back to most recent chat
   606	    // of any type — that's still useful (private DM with the bot
   607	    // works too).
   608	    const groupHit = updates.chats.find((c) => c.type === 'group' || c.type === 'supergroup');
   609	    const hit = groupHit ?? updates.chats[updates.chats.length - 1];
   610	    if (hit) {
   611	      chatId = hit.id;
   612	      chatName = hit.name;
   613	      console.log(pc.green(`  ✓ Chat found: "${chatName}" (id ${chatId})`));
   614	      break;
   615	    }
   616	    console.log(pc.yellow('  No recent messages found yet. Make sure you sent a message in the group AFTER adding the bot.'));
   617	    const retry = (await askUser('  Press Enter to try again, type "skip" to skip > ')).toLowerCase().trim();
   618	    if (retry === 'skip') break;
   619	  }
   620	  if (!chatId) {
   621	    console.log(pc.yellow('  Skipping chat-ID detection. Your bot token is saved; you can add the chat ID later.'));
   622	    // Still save the token — partial config is better than none.
   623	    writeTelegramConfig(options.projectDir, { token, chatId: '' });
   624	    return { telegramConfigured: false };
   625	  }
   626	
   627	  console.log();
   628	  console.log(pc.bold('  Step 3 of 3 — Saving config'));
   629	  const written = writeTelegramConfig(options.projectDir, { token, chatId });
   630	  if (!written) {
   631	    console.log(pc.red('  Couldn\'t write to .instar/config.json. Your bot is created but not wired up yet.'));
   632	    return { telegramConfigured: false };
   633	  }
   634	  console.log(pc.green('  ✓ Telegram is set up.'));
   635	  console.log(pc.dim(`  Your agent will message you in "${chatName}" once the server starts.`));
   636	  return { telegramConfigured: true };
   637	}
   638	
   639	interface TelegramVerifyResult {
   640	  ok: boolean;
   641	  username: string;
   642	  error: string;
   643	}
   644	
   645	async function telegramGetMe(token: string): Promise<TelegramVerifyResult> {
   646	  try {
