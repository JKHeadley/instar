   278	/**
   279	 * Send to the Telegram Bot API. The ONLY place in this codebase permitted to call `fetch` on the Bot
   280	 * API host; `scripts/lint-telegram-egress-boundary.mjs` enforces that.
   281	 *
   282	 * Refuses rather than forwards whenever it cannot decide: an unknown method (whether it carries
   283	 * reader-visible content is unknown, so "no field" cannot be told apart from "not checked"), an
   284	 * unparseable body, and a body shape that cannot be read without consuming it.
   285	 */
   286	export async function telegramFetch(
   287	  url: string | URL,
   288	  init: RequestInit = {},
   289	): Promise<Response> {
   290	  // The TYPE said `string`; the RUNTIME is what ships. Native `fetch` also accepts `URL` and `Request`
   291	  // objects, and JavaScript callers are not bound by the signature — review pass 38 finding 3. A `URL`
   292	  // is normalised to its string form and checked exactly like any other. A `Request` is REFUSED: its
   293	  // body lives on the object rather than in `init`, so no parameter collection is possible and
   294	  // forwarding it would be the unchecked door this module exists to close.
   295	  if (typeof url !== 'string' && !(url instanceof URL)) {
   296	    // Emitted BEFORE the throw (pass 39 F7): this refusal sat upstream of both emit sites, so the one
   297	    // shape that arrives already-opaque produced no record at all and a catcher could erase it entirely.
   298	    emitInvisiblePayloadRefusal({
   299	      guard: 'invisible-payload',
   300	      outcome: 'refused',
   301	      method: '(request-object)',
   302	      field: '(unreadable)',
   303	      rule: 'unreadable-request',
   304	      valueLength: 0,
   305	      engine: process.version,
   306	      unicode: process.versions.unicode ?? 'unknown',
   307	    });
   308	    throw new TelegramEgressError(
   309	      'telegram egress: a Request object carries its own body, which cannot be inspected here. Pass a '
   310	      + 'URL string (or URL) with the parameters in `init`.',
   311	    );
   312	  }
   313	  const href = typeof url === 'string' ? url : url.href;
   314	  // Read the body ONCE, and FREEZE it. Reading once was not enough (pass 41): for a string the value IS
   315	  // the bytes, but `URLSearchParams` and `FormData` are captured by REFERENCE, so a caller could mutate
   316	  // the same object after the check and change what goes on the wire. Serialise those to a string here,
   317	  // so the value inspected below and the value sent at the end are the same immutable bytes.
   318	  const rawBody = init.body;
   319	  const checkedBody: RequestInit['body'] = rawBody instanceof URLSearchParams
   320	    ? rawBody.toString()
   321	    : (typeof FormData !== 'undefined' && rawBody instanceof FormData)
   322	      ? new URLSearchParams(
   323	        [...(rawBody as unknown as Iterable<[string, unknown]>)]
   324	          .filter((e): e is [string, string] => typeof e[1] === 'string'),
   325	      ).toString()
   326	      : rawBody;
   327	
   328	  let method = methodFromTelegramUrl(href);
   329	
   330	  // F1 (pass 39): when the path carries NO method, Telegram falls back to the first `method` ARGUMENT.
   331	  // The door returned null for those and skipped every check, so a request to the token root carrying
   332	  // `method=sendMessage&text=<invisible>` dispatched normally and was never inspected. Recover the
   333	  // method from the parameters in exactly the case Telegram does.
   334	  if (method === null && isBotApiRoot(href)) {
   335	    const { params } = collectParams(href, checkedBody);
   336	    const fromParams = typeof params.method === 'string' ? params.method : null;
   337	    if (fromParams !== null) {
   338	      method = CANONICAL_METHOD.get(fromParams.toLowerCase()) ?? fromParams;
   339	    } else {
   340	      // A Bot API root request whose method cannot be determined is undecidable, not benign.
   341	      emitInvisiblePayloadRefusal({
   342	        guard: 'invisible-payload',
   343	        outcome: 'refused',
   344	        method: '(unresolved)',
   345	        field: '(unknown)',
   346	        rule: 'unclassified-method',
   347	        valueLength: 0,
   348	        engine: process.version,
   349	        unicode: process.versions.unicode ?? 'unknown',
   350	      });
   351	      throw new TelegramEgressError(
   352	        'telegram egress: this is a Bot API request whose method is in neither the path nor a `method` '
   353	        + 'parameter, so what it will do cannot be determined and its payload cannot be checked.',
   354	      );
   355	    }
   356	  }
   357	
   358	  if (method !== null) {
   359	    // CLOSED WORLD. `assertOutgoingPayloadVisible` returns silently for a method it has no field for,
   360	    // which is right for a method KNOWN to carry no reader-visible field and wrong for one nobody has
   361	    // classified. Only this door can tell those apart, so only this door can refuse.
   362	    if (!CANONICAL_METHOD.has(method.toLowerCase())) {
   363	      // Recorded before it is thrown (pass 37 finding 6): "I do not understand this request" is the
   364	      // refusal class most worth seeing in the decision stream, and it was the only one absent from it.
   365	      emitInvisiblePayloadRefusal({
   366	        guard: 'invisible-payload',
   367	        outcome: 'refused',
   368	        method,
   369	        field: '(unknown)',
   370	        rule: 'unclassified-method',
   371	        valueLength: 0,
   372	        engine: process.version,
   373	        unicode: process.versions.unicode ?? 'unknown',
   374	      });
   375	      throw new TelegramEgressError(
   376	        `telegram egress: "${method}" is not a classified Bot API method, so whether it carries `
   377	        + 'reader-visible content is unknown and this request cannot be checked. Add it to '
   378	        + 'READER_VISIBLE_TELEGRAM_PARAMS (with its field) or to '
   379	        + 'NO_READER_VISIBLE_FIELD_TELEGRAM_METHODS (deliberately, having read the Bot API docs).',
   380	      );
   381	    }
   382	
   383	    const { params, uncheckable } = collectParams(href, checkedBody);
   384	    // F6 (pass 39): an unreadable body is only undecidable if the reader-visible field is not ALREADY
   385	    // supplied by the query — and query values win, so when one is present the body cannot change what
   386	    // Telegram sends. Refusing anyway destroyed a decidable, deliverable message.
   387	    // EVERY reader-visible field, not just the first: a method can carry more than one (pass 43), and
   388	    // an unreadable body is only harmless if the query already supplies ALL of them.
   389	    // The reader-visible fields of a method are ALTERNATIVES, not simultaneous requirements — a send
   390	    // carries `text` OR the rich structure. Requiring the query to supply ALL of them (pass 44) treated
   391	    // an either-or as an and, so my repair for one over-refusal introduced another one layer up.
   392	    //
   393	    // But ANY of them (pass 45's repair) was wrong in the other direction, and this is the third place
   394	    // today the same shape has bitten: the alternatives are a PRIORITY union, not a free choice.
   395	    // `editMessageText` reads `rich_message` whenever that key is present ANYWHERE in the request and
   396	    // only otherwise reads `text`. So a visible `?text=` in the query beside an UNREADABLE body waived
   397	    // the refusal — and the body was free to carry the `rich_message` that actually got sent.
   398	    //
   399	    // The waiver therefore requires the query to supply the method's HIGHEST-PRECEDENCE field. Nothing a
   400	    // body can carry outranks it, and a same-key body value loses to the query one, so what Telegram
   401	    // sends is the value just checked. For a single-field method this is exactly the previous rule.
   402	    const fields = readerVisibleFieldsFor(method);
   403	    const fieldSuppliedByQuery = fields.length > 0 && typeof params[fields[0]] === 'string';
   404	    if (uncheckable !== null && !fieldSuppliedByQuery) {
   405	      emitInvisiblePayloadRefusal({
   406	        guard: 'invisible-payload',
   407	        outcome: 'refused',
   408	        method,
   409	        field: '(unreadable)',
   410	        rule: 'unreadable-request',
   411	        valueLength: 0,
   412	        engine: process.version,
   413	        unicode: process.versions.unicode ?? 'unknown',
   414	      });
   415	      throw new TelegramEgressError(
   416	        `telegram egress: ${method} was given ${uncheckable}, so its payload cannot be checked for `
   417	        + 'reader-visible content. Pass parameters as JSON, form encoding, or query string.',
   418	      );
   419	    }
   420	    assertOutgoingPayloadVisible(method, params);
   421	  }
   422	
   423	  // F2 (pass 40): the door read `init.body`, checked THAT value, and then handed the caller's original
   424	  // mutable object to `fetch`. A getter, or any mutation between the read and the send, could show
   425	  // visible content to the check and different content to the network — which falsifies the claim this
   426	  // file makes about checking the exact bytes that go on the wire.
   427	  //
   428	  // So send a request built from the body that was actually inspected. `checkedBody` is read once,
   429	  // above, and reused here; the caller's object can no longer decide what leaves.
   430	  // Build the outgoing init EXPLICITLY. Spreading `init` re-reads `body` — a SECOND read (pass 42) — and
   431	  // when the captured value was `undefined` no override followed, so whatever that second read returned
   432	  // is what went on the wire. `body` is now always set from the captured value, never re-read.
   433	  const outgoing: RequestInit = { ...init };
   434	  outgoing.body = checkedBody ?? null;
   435	  return fetch(href, outgoing);
   436	}

