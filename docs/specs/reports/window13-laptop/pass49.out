   618	
   619	/**
   620	 * Does the source actually put MEDIA in front of a reader? Two documented ways, and the difference
   621	 * between them is the whole of pass 48 finding 2.
   622	 *
   623	 *   A DIRECT url — `![](https://…/photo.jpg)` in markdown, `<img src="https://…">` in html. The API
   624	 *   says media blocks support HTTP and HTTPS URLs, so this renders on its own and declares nothing.
   625	 *
   626	 *   A DECLARED entry, referenced by id — `tg://photo?id=<id>`, `tg://video?id=<id>`, `tg://audio?id=<id>`.
   627	 *   Here the `media` array is the declaration and the SOURCE is the reference. An entry nobody
   628	 *   references renders nothing, and a reference to an id nobody declared renders nothing either. Only
   629	 *   the pair is content.
   630	 *
   631	 * A custom emoji is media too — `tg://emoji?id=` in either arm — and needs no declaration.
   632	 */
   633	const DIRECT_MEDIA_URL = /!\[[^\]]*\]\(\s*https?:\/\/[^)]*\)|<img\b[^>]*\bsrc\s*=\s*["']https?:\/\/[^"']*["']/i;
   634	const EMOJI_MEDIA = /tg:\/\/emoji\?id=/i;
   635	
   636	function sourceRendersMedia(source: string, media: unknown): boolean {
   637	  if (DIRECT_MEDIA_URL.test(source) || EMOJI_MEDIA.test(source)) return true;
   638	  if (!Array.isArray(media) || media.length === 0) return false;
   639	  for (const entry of media) {
   640	    if (entry === null || typeof entry !== 'object') continue;
   641	    const id = (entry as { id?: unknown }).id;
   642	    if (typeof id !== 'string' || id.length === 0) continue;
   643	    const ref = new RegExp(`tg://(?:photo|video|audio)\\?id=${id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\w-])`);
   644	    if (ref.test(source)) return true;
   645	  }
   646	  return false;
   647	}
   648	
   649	function richSourceScan(source: unknown, mode: 'Markdown' | 'HTML', media: unknown): StructuredScan {
   650	  if (typeof source !== 'string') return NOTHING;
   651	  const formula = mode === 'Markdown' ? MARKDOWN_FORMULA : HTML_FORMULA;
   652	  // A formula's source is removed from the visibility test — its characters are LaTeX instructions, not
   653	  // glyphs, so they must not vouch for the rest of the message.
   654	  //
   655	  // But removal alone would have been a REGRESSION, and the negative control for this repair is what
   656	  // caught it: an invisible body wrapped in a formula tag was REFUSED before (the tag stripped, the
   657	  // zero-width body judged and found invisible) and would have been ALLOWED after, because an empty leaf
   658	  // plus a blanket "a formula is undecidable" waives everything. An invisible payload wrapped in a
   659	  // formula tag is not an undecidable formula — it is the original incident wearing one.
   660	  //
   661	  // So a formula grants the waiver only when its own SOURCE carries content. That is the honest line: a
   662	  // formula written out of real characters may render anything and cannot be judged here, while one
   663	  // written out of nothing renders nothing and is decided.
   664	  let carriesRenderableFormula = false;
   665	  const withoutFormulas = source.replace(formula, (_region: string, ...groups: unknown[]) => {
   666	    const body = groups.find((g): g is string => typeof g === 'string') ?? '';
   667	    if (!hasNoVisibleCharacters(body)) carriesRenderableFormula = true;
   668	    return '';
   669	  });
   670	
   671	  return {
   672	    leaves: [{ text: withoutFormulas, mode }],
   673	    undecidable: carriesRenderableFormula || sourceRendersMedia(source, media),
   674	  };
   675	}
   676	
   677	function structuredFieldScan(value: unknown): StructuredScan {
   678	  if (value === null || typeof value !== 'object') return NOTHING;
   679	  if (Array.isArray(value)) return blockScan(value, 0);
   680	
   681	  const obj = value as Record<string, unknown>;
   682	  if ('blocks' in obj) return blockScan(obj.blocks, 0);
   683	  if ('markdown' in obj) return richSourceScan(obj.markdown, 'Markdown', obj.media);
   684	  if ('html' in obj) return richSourceScan(obj.html, 'HTML', obj.media);
   685	  // Telegram answers 400 "Rich message must be non-empty" — a loud failure, and not this guard's case.
   686	  return NOTHING;
   687	}
   688	
   689	/**
   690	 * Every reader-visible field a method may carry, IN THE METHOD'S OWN PRECEDENCE ORDER, highest first.
   691	 *
   692	 * The order is load-bearing, not cosmetic. A method carrying more than one such field does not treat them
   693	 * as equal alternatives — it picks one and never reads the others. `editMessageText` takes `rich_message`
   694	 * whenever the key is present at all (an empty one is a 400, not a fall-through) and only otherwise reads
   695	 * `text`.
   696	 */
   697	export function readerVisibleFieldsFor(method: string): readonly string[] {
   698	  const f = READER_VISIBLE_TELEGRAM_PARAMS[method];
   699	  if (f === undefined) return [];
   700	  return typeof f === 'string' ? [f] : f;
   701	}
   702	
   703	/**
   704	 * The ONE field this method will actually read, given what the request carries.
   705	 *
   706	 * Checking every present field instead was an over-refusal in the same place the waiver was an
   707	 * under-refusal: an edit carrying a visible `rich_message` beside a leftover invisible `text` was refused
   708	 * for content Telegram discards. The reader receives exactly one of these fields; that is the one to judge.
   709	 */
   710	export function effectiveReaderVisibleField(
   711	  method: string,
   712	  params: Record<string, unknown>,
   713	): string | undefined {
   714	  for (const field of readerVisibleFieldsFor(method)) {
   715	    const v = params?.[field];
   716	    if (v !== undefined && v !== null) return field;
   717	  }
   718	  return undefined;
   719	}
   720	
   721	export function assertOutgoingPayloadVisible(method: string, params: Record<string, unknown>): void {
   722	  const field = effectiveReaderVisibleField(method, params);
   723	  if (field !== undefined) assertOneOutgoingField(method, params, field);
   724	}
   725	
   726	function assertOneOutgoingField(method: string, params: Record<string, unknown>, field: string): void {
   727	  const raw = params?.[field];
   728	
   729	  // A structured field carries its content in leaves, not in the field itself (pass 44). If ANY leaf is
   730	  // visible the payload is visible. If the structure yields NO leaves at all, this cannot decide what a
   731	  // reader receives and allows — the same undecidable line the empty-extraction case takes.
   732	  //
   733	  // `undecidable` is the third answer, and it is not the same as finding nothing. A photo block, a custom
   734	  // emoji or a LaTeX formula RENDERS something this guard cannot read, so a message pairing one with an
   735	  // invisible caption is not proven invisible and must not be refused. Before this distinction existed
   736	  // the two collapsed together and a photo with a zero-width caption was destroyed on the way out.
   737	  if (raw !== null && typeof raw === 'object') {
   738	    const { leaves, undecidable } = structuredFieldScan(raw);
   739	    if (undecidable) return;
   740	    if (leaves.length === 0) return;
   741	    if (leaves.some((leaf) => !hasNoVisibleCharacters(readerVisibleText(leaf.text, leaf.mode)))) return;
   742	    emitInvisiblePayloadRefusal({
   743	      guard: 'invisible-payload',
   744	      outcome: 'refused',
   745	      method,
   746	      field,
   747	      rule: 'no-content-codepoint-after-format',
   748	      valueLength: leaves.reduce((n, l) => n + l.text.length, 0),
   749	      engine: process.version,
   750	      unicode: process.versions.unicode ?? 'unknown',
   751	    });
   752	    throw new InvisiblePayloadRefusedError(
   753	      `refused: ${method} ${field} carries no reader-visible content AFTER formatting (its structured `
   754	      + 'content has text leaves and none of them renders as anything a reader can see).',
   755	      {
   756	        guard: 'invisible-payload',
   757	        outcome: 'refused',
   758	        method,
   759	        field,
   760	        rule: 'no-content-codepoint-after-format',

 succeeded in 0ms:
