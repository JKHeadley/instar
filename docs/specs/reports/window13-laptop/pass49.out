   902	        stallTimeoutMinutes: config.stallTimeoutMinutes,
   903	        promiseTimeoutMinutes: config.promiseTimeoutMinutes,
   904	      });
   905	    }
   906	    if (SHARED_INFRA_FLAGS.useSharedCommandRouter) {
   907	      this.sharedCommandRouter = new CommandRouter('telegram');
   908	      this.registerSharedCommands();
   909	    }
   910	    if (SHARED_INFRA_FLAGS.useSharedAuthGate) {
