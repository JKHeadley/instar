   641	   * wired. Mirrors the exact `sendToTopic` branch condition (no usable string
   642	   * bot token + a relay available). Callers use this to skip work the HOLDER
   643	   * will do anyway: e.g. the `/telegram/reply` route skips its LOCAL tone gate
   644	   * for a relayed reply, because (a) the reply is already the agent's finalized
   645	   * output, (b) the Telegram-owning holder runs ITS tone gate on receipt, and
   646	   * (c) running the standby's tone gate adds a serial LLM call to every
   647	   * cross-machine reply — which, under a rate-limited circuit, waits up to
   648	   * `MessagingToneGate` rateLimitWaitMs (120s) BEFORE the relay even starts.
   649	   * That double-gate + pre-relay stall is a real robustness defect on the
   650	   * standby reply path.
   651	   */
   652	  willRelay(): boolean {
   653	    const hasUsableBotToken = typeof this.config.token === 'string' && this.config.token.length > 0;
   654	    return !hasUsableBotToken && this.outboundRelay !== null;
   655	  }
