   332	    it('walks the REAL RichText grammar — the WIRE discriminators, not internal class names', async () => {
   333	      // Pass 47 finding 4: the previous version of this test used `richTexts`, `richTextBold`,
   334	      // `richTextPlain` and block type `math`. Those are internal class names that never appear on the
   335	      // wire — Telegram's parser rejects every one of them — so the test proved only that a key-blind
   336	      // walk finds nested strings, while its title claimed it exercised the grammar. The values below are
   337	      // transcribed from the server's own request parser: a SEQUENCE is a bare array (there is no `texts`
   338	      // key anywhere in the API), a literal is a bare string, and the wrappers are `bold`, `italic`,
   339	      // `url`, `mathematical_expression`.
   340	      const f = arm();
   341	      await expect(telegramFetch(api('sendRichMessage'), post({
   342	        chat_id: 1,
   343	        rich_message: {
   344	          blocks: [
   345	            { type: 'paragraph', text: [
   346	              { type: 'bold', text: { type: 'italic', text: '\u200b' } },
   347	              { type: 'url', url: 'https://example.com/VISIBLE-IN-URL-ONLY', text: '\u200b' },
   348	            ] },
   349	            // an anchor's name is a jump TARGET, not rendered text (pass 46) — it must NOT count
   350	            { type: 'anchor', name: 'VISIBLE-LOOKING-TARGET' },
   351	          ],
   352	        },
   353	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   354	      expect(f, 'a URL destination is not what a reader sees — the label is').not.toHaveBeenCalled();
   355	
   356	      // one visible literal three wrappers deep is enough to deliver
   357	      const f2 = arm();
   358	      await telegramFetch(api('sendRichMessage'), post({
   359	        chat_id: 1,
   360	        rich_message: { blocks: [{ type: 'paragraph', text: [
   361	          { type: 'bold', text: '\u200b' },
   362	          { type: 'italic', text: { type: 'underline', text: 'hello' } },
   363	        ] }] },
   364	      }));
   365	      expect(f2).toHaveBeenCalledTimes(1);
   366	
   367	      // a media-only rich message legitimately carries no text and must NOT be refused
   368	      const f3 = arm();
   369	      await telegramFetch(api('sendRichMessage'), post({
   370	        chat_id: 1,
   371	        rich_message: { blocks: [{ type: 'photo', photo: { file_id: 'abc' } }, { type: 'divider' }] },
   372	      }));
   373	      expect(f3, 'a photo-only rich message is valid and text-free').toHaveBeenCalledTimes(1);
   374	
   375	      // block carriers the inline layer does not have: a details summary, and table cells
   376	      const f4 = arm();
   377	      await expect(telegramFetch(api('sendRichMessage'), post({
   378	        chat_id: 1,
   379	        rich_message: { blocks: [
   380	          { type: 'details', summary: '\u200b', blocks: [{ type: 'paragraph', text: '\u200b' }] },
   381	          { type: 'table', caption: '\u200b', cells: [[{ text: '\u200b' }, { text: '\u200b' }]] },
   382	        ] },
   383	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   384	      expect(f4).not.toHaveBeenCalled();
   385	
   386	      // ...and the same shape delivers the moment one cell renders
   387	      const f5 = arm();
   388	      await telegramFetch(api('sendRichMessage'), post({
   389	        chat_id: 1,
   390	        rich_message: { blocks: [
   391	          { type: 'table', caption: '\u200b', cells: [[{ text: '\u200b' }, { text: 'total' }]] },
   392	        ] },
   393	      }));
   394	      expect(f5).toHaveBeenCalledTimes(1);
   395	    });
