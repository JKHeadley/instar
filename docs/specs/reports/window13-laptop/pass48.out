   110	   * Defaults to DEFAULT_ATTENTION_TOPIC_GUARD (enabled) — the 2026-05-28
   111	   * topic-flood lockdown. See AttentionTopicGuard.
   112	   */
   113	  attentionTopicGuard?: Partial<AttentionTopicGuardConfig>;
   114	  /**
   115	   * The LAST-RESORT ceiling on automatic forum-topic creation, enforced INSIDE
   116	   * `createForumTopic` itself — the one place topics are born — so it covers
   117	   * EVERY caller, current and future, regardless of what source labels they
   118	   * pass (the 2026-06-05 flood dodged the attention guard's per-source budget
   119	   * by giving every item a unique sourceContext; only the global ceiling
   120	   * caught it after 8 leaked topics). Origins `user` and `system` are exempt
   121	   * (operator-initiated topics and bounded create-once system topics);
   122	   * everything else — including any caller that doesn't say — is counted.
   123	   * Per-label budget + global ceiling, same engine as the attention guard.
   124	   * Defaults are deliberately LOOSER than the attention guard (this is the
   125	   * backstop, not the shaper): per-label 8, global 12, 10-min window.
   126	   */
   127	  topicCreationBudget?: Partial<AttentionTopicGuardConfig>;
   128	  /**
   129	   * The calm "Agent Health" lane. Routine self-health/housekeeping notices
   130	   * (attention items with `lane:'agent-health'`) are collected into ONE named,
   131	   * low-key topic that never spawns topic-after-topic — the antidote to a feature
   132	   * hijacking Telegram with a wall of "stale but unkillable"-style notices. Only
   133	   * items that explicitly opt in (`lane:'agent-health'`) are affected; every other
   134	   * item is unchanged. Enabled by default; set `enabled:false` for pre-lane
   135	   * behavior.
   136	   */
   137	  agentHealthLane?: {
   138	    enabled?: boolean;
   139	    /** Display name of the lane topic. Default '🩺 Agent Health'. */
   140	    topicName?: string;
   141	    /** Bounded ring of recently-seen entity keys (memory cap). Default 256. */
   142	    maxTrackedKeys?: number;
   143	    /** Suppress a same-key re-escalation posted within this window. Default 30 min. */
   144	    dedupWindowMs?: number;
   145	  };
   146	  /**
   147	   * Attention-item routing (2026-07-09 single-alerts-topic directive). In
   148	   * 'single-topic' mode — the DEFAULT — EVERY attention item, all priorities
   149	   * included (HIGH/URGENT too), is posted as one message into the single
   150	   * durable "🔔 Attention" hub topic instead of spawning a forum topic per
   151	   * item. 'per-item' restores the legacy topic-per-item behavior (still
   152	   * shaped by attentionTopicGuard + topicCreationBudget). The agent-health
   153	   * lane is unaffected in either mode.
   154	   */
   155	  attentionRouting?: {
   156	    mode?: 'single-topic' | 'per-item';
   157	  };
   158	  /**
   159	   * Hot-reloadable accessor for the durable Attention hub topic id created at
   160	   * boot (StateManager key 'agent-attention-topic'). server.ts injects
   161	   * `() => state.get('agent-attention-topic') ?? null`; when absent or null,
   162	   * single-topic mode finds-or-creates the hub itself — never a per-item
   163	   * topic.
   164	   */
   165	  getAttentionHubTopicId?: () => number | null | undefined;
   166	}
