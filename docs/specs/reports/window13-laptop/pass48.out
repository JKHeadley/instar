   390	const NOTHING: StructuredScan = { leaves: [], undecidable: false };
   391	const OPAQUE: StructuredScan = { leaves: [], undecidable: true };
   392	
   393	function mergeScans(parts: StructuredScan[]): StructuredScan {
   394	  const leaves: StructuredLeaf[] = [];
   395	  let undecidable = false;
   396	  for (const p of parts) {
   397	    leaves.push(...p.leaves);
   398	    undecidable = undecidable || p.undecidable;
   399	  }
   400	  return { leaves, undecidable };
   401	}
   402	
   403	/**
   404	 * RichText variants that carry their rendered content in a nested `text` (itself a RichText).
   405	 *
   406	 * Every other member of such an object is DISCARDED by Telegram, which is the whole point of this table:
   407	 * a `url` variant renders its `text` and uses `url` only as the destination, so a walk must descend
   408	 * `text` and nothing else.
   409	 */
   410	const RICH_TEXT_NESTED_TEXT: ReadonlySet<string> = new Set([
   411	  'bold', 'italic', 'underline', 'strikethrough', 'spoiler', 'date_time', 'mention', 'hashtag',
   412	  'cashtag', 'bot_command', 'code', 'text_mention', 'url', 'email_address', 'bank_card_number',
   413	  'subscript', 'superscript', 'marked', 'phone_number', 'reference', 'reference_link', 'anchor_link',
   414	]);
   415	
   416	/** RichText variants that render content this guard cannot read from the request. */
