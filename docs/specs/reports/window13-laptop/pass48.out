   397	    it('honours the METHOD\'s field precedence — a lower field cannot waive an unreadable body', async () => {
   398	      // The third instance today of one shape: alternatives that are really a PRIORITY union. Telegram's
   399	      // editMessageText handler branches on whether `rich_message` is PRESENT and only otherwise reads
   400	      // `text`. So a visible `?text=` beside an unreadable body waived the refusal while the body was
   401	      // free to carry the rich_message that actually got sent.
   402	      const f = arm();
   403	      await expect(telegramFetch(api('editMessageText') + '?chat_id=1&message_id=9&text=LOOKS%20VISIBLE', {
   404	        method: 'POST',
   405	        body: new ReadableStream(),
   406	      })).rejects.toThrow(TelegramEgressError);
   407	      expect(f, 'text is outranked by rich_message — it cannot vouch for an unreadable body').not.toHaveBeenCalled();
   408	
   409	      // The HIGHEST-precedence field still waives, because nothing a body carries can outrank it.
   410	      const f2 = arm();
   411	      await telegramFetch(
   412	        api('editMessageText') + '?chat_id=1&message_id=9&rich_message=' + encodeURIComponent(JSON.stringify({ markdown: 'hello' })),
   413	        { method: 'POST', body: new ReadableStream() },
   414	      );
   415	      expect(f2, 'rich_message is what the method reads — checked, and it wins').toHaveBeenCalledTimes(1);
   416	    });
   417	
   418	    it('judges the ONE field the method will read — not every field present', async () => {
   419	      // The over-refusal that sat beside the under-refusal above. An edit carrying a visible rich_message
   420	      // beside a leftover invisible `text` was refused for content Telegram discards.
   421	      const f = arm();
   422	      await telegramFetch(api('editMessageText'), post({
   423	        chat_id: 1, message_id: 9,
   424	        rich_message: { blocks: [{ type: 'paragraph', text: 'the real content' }] },
   425	        text: '\u200b',
   426	      }));
   427	      expect(f, 'rich_message is read; the leftover text is discarded').toHaveBeenCalledTimes(1);
   428	
   429	      // ...and the same shape refuses when the field that WINS is the invisible one.
   430	      const f2 = arm();
   431	      await expect(telegramFetch(api('editMessageText'), post({
   432	        chat_id: 1, message_id: 9,
   433	        rich_message: { blocks: [{ type: 'paragraph', text: '\u200b' }] },
   434	        text: 'VISIBLE BUT NEVER READ',
   435	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   436	      expect(f2).not.toHaveBeenCalled();
   437	    });
