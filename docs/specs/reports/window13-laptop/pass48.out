   340	 *
   341	 * It is not fixed here for the same reason the under-refusals below are not: deciding it requires
   342	 * Telegram's own parse result, and every regex approximation of that parser has produced errors in
   343	 * BOTH directions (passes 34, 35, 36). It rides CMT-1260 with them.
   344	 *
   345	 * KNOWN UNDER-REFUSALS, accepted deliberately. A character reference (`&#8203;`) is counted as its
   346	 * SOURCE characters, so a payload made only of encoded invisibles passes. Emphasis delimiters count as
   347	 * content, so `*\u200b*` passes. Each is a payload that reaches a reader as nothing — the very harm this
   348	 * file exists to prevent — and each is allowed anyway, because refusing them requires a rendering model
   349	 * this code cannot supply, and a wrong model destroys real messages in the other direction. Closing them
   350	 * needs Telegram's own parse result, not a better regex. Tracked as CMT-1260.
   351	 */
   352	export function readerVisibleText(text: string, parseMode?: unknown): string {
   353	  const mode = typeof parseMode === 'string' ? parseMode.toLowerCase() : '';
   354	  if (mode === 'html') {
   355	    return text.replace(/<[^>]*>/g, '');
   356	  }
   357	  if (mode === 'markdown' || mode === 'markdownv2') {
   358	    return text.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1');
   359	  }
   360	  return text;
   361	}
   362	
   363	/**
   364	 * The post-format check: what is about to go on the wire must still carry content once rendered.
   365	 *
   366	 * NOTE (review pass 36 finding 6): this WAS a second call beside a pre-format one in both funnels.
   367	 * Those were removed when the egress door landed — execution showed the door refuses every payload
   368	 * they caught, and two copies of one case mask each other's tests. The paragraph below describes the
   369	 * historical pairing and is kept for the reasoning, not as a description of the current call graph.
   370	 * The only surviving pre-format call is the tokenless-relay guard, which the door cannot reach.
   371	 *
   372	 * They close
   373	 * different cases — the first refuses a payload that never had content, the second refuses one whose
   374	 * content stopped being reader-visible when the representation changed — and each is proven to red on
   375	 * its own.
   376	 */
   377	type StructuredLeaf = { text: string; mode: string };
   378	
   379	/**
   380	 * The result of reading a structured field. `leaves` are the literals Telegram will actually render.
   381	 * `undecidable` means the structure carries content this guard cannot inspect — a photograph, a custom
   382	 * emoji, a LaTeX formula — so ABSENCE of a visible leaf no longer proves the reader receives nothing.
   383	 *
   384	 * The two are separate on purpose. Collapsing "I found nothing" into "there is nothing" is what makes a
   385	 * guard refuse a valid photo message, and collapsing "I cannot read this" into "this is visible" is what
   386	 * lets an invisible one through. Neither collapse is available here.
   387	 */
   388	type StructuredScan = { leaves: StructuredLeaf[]; undecidable: boolean };
   389	
   390	const NOTHING: StructuredScan = { leaves: [], undecidable: false };
   391	const OPAQUE: StructuredScan = { leaves: [], undecidable: true };
   392	
   393	function mergeScans(parts: StructuredScan[]): StructuredScan {
   394	  const leaves: StructuredLeaf[] = [];
   395	  let undecidable = false;
   396	  for (const p of parts) {
   397	    leaves.push(...p.leaves);
   398	    undecidable = undecidable || p.undecidable;
   399	  }
   400	  return { leaves, undecidable };
   401	}
   402	
   403	/**
   404	 * RichText variants that carry their rendered content in a nested `text` (itself a RichText).
   405	 *
   406	 * Every other member of such an object is DISCARDED by Telegram, which is the whole point of this table:
   407	 * a `url` variant renders its `text` and uses `url` only as the destination, so a walk must descend
   408	 * `text` and nothing else.
   409	 */
   410	const RICH_TEXT_NESTED_TEXT: ReadonlySet<string> = new Set([
   411	  'bold', 'italic', 'underline', 'strikethrough', 'spoiler', 'date_time', 'mention', 'hashtag',
   412	  'cashtag', 'bot_command', 'code', 'text_mention', 'url', 'email_address', 'bank_card_number',
   413	  'subscript', 'superscript', 'marked', 'phone_number', 'reference', 'reference_link', 'anchor_link',
   414	]);
   415	
   416	/** RichText variants that render content this guard cannot read from the request. */
   417	const RICH_TEXT_OPAQUE: ReadonlySet<string> = new Set(['custom_emoji', 'mathematical_expression']);
   418	
   419	/** RichText variants that render NOTHING. `anchor` consumes only `name`, a jump target. */
   420	const RICH_TEXT_RENDERS_NOTHING: ReadonlySet<string> = new Set(['anchor']);
   421	
   422	/** Block variants and the RichText-valued fields Telegram reads from each. */
   423	const BLOCK_RICH_TEXT_FIELDS: Readonly<Record<string, readonly string[]>> = {
   424	  heading: ['text'],
   425	  paragraph: ['text'],
   426	  pre: ['text'],
   427	  footer: ['text'],
   428	  thinking: ['text'],
   429	  pullquote: ['text', 'credit'],
   430	  blockquote: ['credit'],
   431	  details: ['summary'],
   432	  table: ['caption'],
   433	};
   434	
   435	/** Block variants whose children are themselves blocks, and the field holding them. */
   436	const BLOCK_CHILD_BLOCK_FIELDS: Readonly<Record<string, readonly string[]>> = {
   437	  blockquote: ['blocks'],
   438	  collage: ['blocks'],
   439	  slideshow: ['blocks'],
   440	  details: ['blocks'],
   441	};
   442	
   443	/** Block variants carrying a PageBlockCaption (`{text, credit}`, both RichText). */
   444	const BLOCK_CAPTION_VARIANTS: ReadonlySet<string> = new Set([
   445	  'collage', 'slideshow', 'map', 'animation', 'audio', 'photo', 'video', 'voice_note',
   446	]);
   447	
   448	/** Block variants that render something unreadable here — media, a map, a formula. */
   449	const BLOCK_OPAQUE: ReadonlySet<string> = new Set([
   450	  'mathematical_expression', 'map', 'animation', 'audio', 'photo', 'video', 'voice_note',
   451	]);
   452	
   453	/** Block variants that render nothing: a rule, and a jump target. */
   454	const BLOCK_RENDERS_NOTHING: ReadonlySet<string> = new Set(['divider', 'anchor']);
   455	
   456	// A cyclic or adversarial structure must terminate, but the bound is NOT a content limit — pass 46 found
   457	// 16 truncates real documents, since every wrapper adds a level and a list inside a table inside a
   458	// quotation reaches that quickly. Set well past any plausible document.
   459	const STRUCTURE_DEPTH_BOUND = 200;
   460	
   461	/**
   462	 * Read a RichText value, by Telegram's grammar rather than by key name.
   463	 *
   464	 * WHERE THIS TABLE COMES FROM, since the last four repairs all failed on this exact point. Not from my
   465	 * model of the API — that has an end date and was wrong twice in one day. Not from the prose reference —
   466	 * it truncated three times. It is transcribed from the Bot API server's own request parser, which is the
   467	 * code that decides what Telegram reads: `Client::get_rich_text`, `Client::get_input_page_block`,
   468	 * `Client::get_page_block_caption`, `Client::get_page_block_table_cell`, `Client::get_input_rich_message`.
   469	 *
   470	 * THE UNION: a bare STRING (the literal), an ARRAY (the sequence), or an OBJECT carrying a `type`
   471	 * discriminator. There is no `texts` key and no `richTextPlain` type value anywhere on the wire — those
   472	 * are internal class names, and a previous version of this file asserted them as the grammar.
   473	 *
   474	 * WHY THE PREVIOUS WALK WAS WRONG, and it is the same misunderstanding one level deeper rather than a new
   475	 * bug. It descended EVERY object-valued property. Telegram reads `type`, extracts only that variant's
   476	 * declared fields, and DISCARDS every other member:
   477	 *
   478	 *     { "type": "bold", "text": {"type":"anchor","name":"x"}, "caption": {"text":"LOOKS VISIBLE"} }
   479	 *
   480	 * `bold` consumes `text` alone. `caption` is discarded. The old walk found "LOOKS VISIBLE", called the
   481	 * payload visible, and allowed it — while the reader received an anchor, which renders as nothing. Three
   482	 * previous repairs answered a reviewer by adding a key name; a key name cannot fix a SHAPE.
   483	 *
   484	 * WHAT IS DELIBERATELY NOT COLLECTED: `url`, `email_address`, `phone_number`, `anchor_name`, `name`. A
   485	 * link's DESTINATION is not what a reader sees — its label is, and the label is the nested `text`.
   486	 * Counting a destination as content is precisely how the original incident shipped: a payload whose only
   487	 * visible characters lived inside a URL. This now falls out of the table rather than being a rule applied
   488	 * beside it.
   489	 *
   490	 * A `mathematical_expression` is LaTeX SOURCE. Its source characters are not its rendered glyphs — a
   491	 * spacing-only expression is all letters and paints nothing — so it is marked OPAQUE rather than counted
   492	 * as visible. That is the honest position: this guard cannot decide a formula, it can only decline to let
   493	 * one vouch for an otherwise-invisible message.
   494	 */
   495	function richTextScan(value: unknown, depth = 0): StructuredScan {
   496	  if (depth > STRUCTURE_DEPTH_BOUND || value === null || value === undefined) return NOTHING;
   497	
   498	  // The bare-string arm. `{"text": ["hello", {"type":"bold",...}]}` puts "hello" in an array element,
   499	  // under no key at all — the arm every key-based version of this walk returned early on.
   500	  if (typeof value === 'string') return { leaves: [{ text: value, mode: '' }], undecidable: false };
   501	  if (typeof value !== 'object') return NOTHING;
   502	  if (Array.isArray(value)) {
   503	    return mergeScans(value.map((v) => richTextScan(v, depth + 1)));
   504	  }
   505	
   506	  const type = (value as { type?: unknown }).type;
   507	  // An object with no string `type` is rejected by Telegram with 400 before anything renders. It cannot
   508	  // be a silent invisible send, and it must not be allowed to vouch for one either.
   509	  if (typeof type !== 'string') return NOTHING;
   510	  if (RICH_TEXT_RENDERS_NOTHING.has(type)) return NOTHING;
   511	  if (RICH_TEXT_OPAQUE.has(type)) return OPAQUE;
   512	  if (RICH_TEXT_NESTED_TEXT.has(type)) {
   513	    return richTextScan((value as { text?: unknown }).text, depth + 1);
   514	  }
   515	  // An unsupported discriminator is a 400 from Telegram's parser — a loud failure, not a silent one.
   516	  return NOTHING;
   517	}
   518	
   519	/** A PageBlockCaption is `{text, credit}`, both RichText. Nothing else in it is read. */
   520	function captionScan(value: unknown, depth: number): StructuredScan {
   521	  if (depth > STRUCTURE_DEPTH_BOUND || value === null || typeof value !== 'object') return NOTHING;
   522	  const obj = value as Record<string, unknown>;
   523	  return mergeScans([richTextScan(obj.text, depth + 1), richTextScan(obj.credit, depth + 1)]);
   524	}
   525	
   526	/** A block-level element, read by its own `type` discriminator. */
   527	function blockScan(value: unknown, depth = 0): StructuredScan {
   528	  if (depth > STRUCTURE_DEPTH_BOUND || value === null) return NOTHING;
   529	  if (Array.isArray(value)) return mergeScans(value.map((v) => blockScan(v, depth + 1)));
   530	  if (typeof value !== 'object') return NOTHING;
   531	
   532	  const obj = value as Record<string, unknown>;
   533	  const type = obj.type;
   534	  if (typeof type !== 'string') return NOTHING;
   535	  if (BLOCK_RENDERS_NOTHING.has(type)) return NOTHING;
   536	
   537	  const parts: StructuredScan[] = [];
   538	  // A media block, a map or a formula RENDERS — the message is not arriving as nothing — but what it
   539	  // renders cannot be inspected here. Its caption is still read, because a caption that is present and
   540	  // invisible is worth knowing about even when the block itself carries the message.
   541	  if (BLOCK_OPAQUE.has(type)) parts.push(OPAQUE);
   542	  for (const field of BLOCK_RICH_TEXT_FIELDS[type] ?? []) parts.push(richTextScan(obj[field], depth + 1));
   543	  for (const field of BLOCK_CHILD_BLOCK_FIELDS[type] ?? []) parts.push(blockScan(obj[field], depth + 1));
   544	  if (BLOCK_CAPTION_VARIANTS.has(type)) parts.push(captionScan(obj.caption, depth + 1));
   545	  if (type === 'list') {
   546	    const items = obj.items;
   547	    if (Array.isArray(items)) {
   548	      for (const item of items) {
   549	        if (item !== null && typeof item === 'object') {
   550	          parts.push(blockScan((item as Record<string, unknown>).blocks, depth + 1));
   551	        }
   552	      }
   553	    }
   554	  }
   555	  if (type === 'table') {
   556	    const rows = obj.cells;
   557	    if (Array.isArray(rows)) {
   558	      for (const row of rows) {
   559	        if (!Array.isArray(row)) continue;
   560	        for (const cell of row) {
   561	          if (cell !== null && typeof cell === 'object') {
   562	            parts.push(richTextScan((cell as Record<string, unknown>).text, depth + 1));
   563	          }
   564	        }
   565	      }
   566	    }
   567	  }
   568	  // An unsupported block type is a 400 before render; it contributes nothing either way.
   569	  return mergeScans(parts);
   570	}
   571	
   572	/**
   573	 * Read a structured reader-visible field — in practice the rich-message container.
   574	 *
   575	 * THE CONTAINER IS A PRIORITY UNION, not a merge, and this is a bypass I found by reading the parser
   576	 * rather than one a reading handed me. Telegram takes `blocks` if the object has it, ELSE `markdown`,
   577	 * ELSE `html`, and ignores the others entirely. The previous walk collected all three, so a container
   578	 * pairing invisible `blocks` with a visible `html` sibling read as visible here and rendered as nothing
   579	 * there. Same shape as the discriminator bug, one layer up.
   580	 *
   581	 * `media` is read only on the markdown and html arms. Media renders, so its presence is OPAQUE rather
   582	 * than ignorable — otherwise an image-only markdown message would be refused as invisible.
   583	 */
   584	function structuredFieldScan(value: unknown): StructuredScan {
   585	  if (value === null || typeof value !== 'object') return NOTHING;
   586	  if (Array.isArray(value)) return blockScan(value, 0);
   587	
   588	  const obj = value as Record<string, unknown>;
   589	  const mediaPresent = Array.isArray(obj.media) && obj.media.length > 0;
   590	  if ('blocks' in obj) return blockScan(obj.blocks, 0);
   591	  if ('markdown' in obj) {
   592	    const md = obj.markdown;
   593	    const leaves = typeof md === 'string' ? [{ text: md, mode: 'Markdown' }] : [];
   594	    return { leaves, undecidable: mediaPresent };
   595	  }
   596	  if ('html' in obj) {
   597	    const html = obj.html;
   598	    const leaves = typeof html === 'string' ? [{ text: html, mode: 'HTML' }] : [];
   599	    return { leaves, undecidable: mediaPresent };
   600	  }
   601	  // Telegram answers 400 "Rich message must be non-empty" — a loud failure, and not this guard's case.
   602	  return NOTHING;
   603	}
   604	
   605	/**
   606	 * Every reader-visible field a method may carry, IN THE METHOD'S OWN PRECEDENCE ORDER, highest first.
   607	 *
   608	 * The order is load-bearing, not cosmetic. A method carrying more than one such field does not treat them
   609	 * as equal alternatives — it picks one and never reads the others. `editMessageText` takes `rich_message`
   610	 * whenever the key is present at all (an empty one is a 400, not a fall-through) and only otherwise reads
   611	 * `text`.
   612	 */
   613	export function readerVisibleFieldsFor(method: string): readonly string[] {
   614	  const f = READER_VISIBLE_TELEGRAM_PARAMS[method];
   615	  if (f === undefined) return [];
   616	  return typeof f === 'string' ? [f] : f;
   617	}
   618	
   619	/**
   620	 * The ONE field this method will actually read, given what the request carries.
   621	 *
   622	 * Checking every present field instead was an over-refusal in the same place the waiver was an
   623	 * under-refusal: an edit carrying a visible `rich_message` beside a leftover invisible `text` was refused
   624	 * for content Telegram discards. The reader receives exactly one of these fields; that is the one to judge.
   625	 */
   626	export function effectiveReaderVisibleField(
   627	  method: string,
   628	  params: Record<string, unknown>,
   629	): string | undefined {
   630	  for (const field of readerVisibleFieldsFor(method)) {
   631	    const v = params?.[field];
   632	    if (v !== undefined && v !== null) return field;
   633	  }
   634	  return undefined;
   635	}
   636	
   637	export function assertOutgoingPayloadVisible(method: string, params: Record<string, unknown>): void {
   638	  const field = effectiveReaderVisibleField(method, params);
   639	  if (field !== undefined) assertOneOutgoingField(method, params, field);
   640	}
   641	
   642	function assertOneOutgoingField(method: string, params: Record<string, unknown>, field: string): void {
   643	  const raw = params?.[field];
   644	
   645	  // A structured field carries its content in leaves, not in the field itself (pass 44). If ANY leaf is
   646	  // visible the payload is visible. If the structure yields NO leaves at all, this cannot decide what a
   647	  // reader receives and allows — the same undecidable line the empty-extraction case takes.
   648	  //
   649	  // `undecidable` is the third answer, and it is not the same as finding nothing. A photo block, a custom
   650	  // emoji or a LaTeX formula RENDERS something this guard cannot read, so a message pairing one with an
   651	  // invisible caption is not proven invisible and must not be refused. Before this distinction existed
   652	  // the two collapsed together and a photo with a zero-width caption was destroyed on the way out.
   653	  if (raw !== null && typeof raw === 'object') {
   654	    const { leaves, undecidable } = structuredFieldScan(raw);
   655	    if (undecidable) return;
   656	    if (leaves.length === 0) return;
   657	    if (leaves.some((leaf) => !hasNoVisibleCharacters(readerVisibleText(leaf.text, leaf.mode)))) return;
   658	    emitInvisiblePayloadRefusal({
   659	      guard: 'invisible-payload',
   660	      outcome: 'refused',
   661	      method,
   662	      field,
   663	      rule: 'no-content-codepoint-after-format',
   664	      valueLength: leaves.reduce((n, l) => n + l.text.length, 0),
   665	      engine: process.version,
   666	      unicode: process.versions.unicode ?? 'unknown',
   667	    });
   668	    throw new InvisiblePayloadRefusedError(
   669	      `refused: ${method} ${field} carries no reader-visible content AFTER formatting (its structured `
   670	      + 'content has text leaves and none of them renders as anything a reader can see).',
   671	      {
   672	        guard: 'invisible-payload',
   673	        outcome: 'refused',
   674	        method,
   675	        field,
   676	        rule: 'no-content-codepoint-after-format',
   677	        valueLength: leaves.reduce((n, l) => n + l.text.length, 0),
   678	        engine: process.version,
   679	        unicode: process.versions.unicode ?? 'unknown',
   680	      },
   681	    );
   682	  }
   683	
   684	  const value = raw;
   685	  if (typeof value !== 'string') return;
   686	  const visible = readerVisibleText(value, (params as { parse_mode?: unknown })?.parse_mode);
   687	  if (!hasNoVisibleCharacters(visible)) return;
   688	
   689	  // THE UNDECIDABLE CASE, and the line that separates it from the decided one (review pass 34 finding 1).
   690	  //
   691	  // An extraction that is EMPTY means the payload had no text nodes at all — it is pure markup. Such a
   692	  // payload has two possible fates and this code cannot tell which: valid markup renders as nothing (a
   693	  // real invisible send), while MALFORMED markup is rejected by Telegram and falls back to a plain-text
   694	  // send in which the tags are shown to the reader. Deciding between them needs Telegram's own parser.
   695	  //
   696	  // An extraction that is NON-EMPTY but carries no visible character is DECIDED: text nodes exist and
   697	  // they contain nothing a reader can see. That is the pass-33 case — a link whose label is a zero-width
   698	  // space — and it stays refused.
   699	  //
   700	  // Where it cannot decide, it ALLOWS, because this guard's own policy is that an over-refusal destroys a
   701	  // real message. Refusing pure markup outright killed a deliverable one: `<b><i>` renders as visible
   702	  // text after the fallback, and the first version of this check threw before the fallback could run.
   703	  // The honest cost is stated rather than hidden: a payload of VALID markup with no text nodes is not
   704	  // refused by this arm.
   705	  if (visible.length === 0 && value.length > 0) return;
   706	
   707	  const decision: InvisiblePayloadRefusal = {
   708	    guard: 'invisible-payload',
   709	    outcome: 'refused',
   710	    method,
   711	    field,
   712	    rule: 'no-content-codepoint-after-format',
   713	    valueLength: value.length,
   714	    engine: process.version,
   715	    unicode: process.versions.unicode ?? 'unknown',
   716	  };
   717	  try { refusalSink(decision); } catch { /* a broken sink never becomes a delivery */ }
   718	  throw new InvisiblePayloadRefusedError(
   719	    `refused: ${method} ${field} carries no reader-visible content AFTER formatting (its content `
   720	    + 'characters survive only inside markup such as a link destination or a tag attribute, which a '
   325	      const f3 = arm();
   326	      await expect(telegramFetch(api('editMessageText'), post({
   327	        chat_id: 1, message_id: 9, rich_message: { html: '<b>\u200b</b>' },
   328	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   329	      expect(f3).not.toHaveBeenCalled();
   330	    });
