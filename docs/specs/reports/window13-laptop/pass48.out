   210	/**
   211	 * The refusal, at the CALLER's representation. This no longer runs in either funnel — the egress door
   212	 * checks the wire payload instead, and the funnel calls were removed as double-cover (pass 36 finding
   213	 * 6 caught this description outliving them). Its one live caller is the tokenless-relay branch in
   214	 * `TelegramAdapter`, whose send never reaches the Telegram host from this process.
   215	 *
   216	 * Historically both senders called this as the FIRST statement of their private `apiCall`, the only place every send
   217	 * provably passes through. That lint is DELETED; `scripts/lint-telegram-egress-boundary.mjs` confines
   218	 * egress to one door instead, and the door itself refuses an unclassified method (pass 37 finding 8:
   219	 * this still named the deleted lint as its enforcer).
   220	 *
   221	 * ── Why here and nowhere else ──────────────────────────────────────────────────────────────────
   222	 * This guard was placed on one HTTP route at review pass 9 and called "fixed at the point of
   223	 * sending"; pass 27 falsified that with a second route; it was moved to a second door and called
   224	 * "both doors"; pass 28 falsified THAT with a third. It was then moved into `sendToTopic` and
   225	 * called "the single chokepoint every Telegram send passes through" — and pass 29 falsified that
   226	 * by execution, because `send()` (the interface method a router calls) reaches the API without
   227	 * touching `sendToTopic` at all. FOUR enumerations, four over-claims, one habit: asserting the
   228	 * shape of a set instead of deriving it.
   229	 *
   230	 * The derived population is 16 `apiCall('sendMessage')` sites across TWO classes — 14 in the
   231	 * adapter across 9 methods, 2 in the lifeline, which has its own private funnel and had no guard
   232	 * whatsoever. The refusal in `sendToTopic` was REMOVED when this was added rather than kept as a
   233	 * belt-and-braces second copy: pass 23 established that two pieces of code closing the same case
   234	 * MASK each other's tests — break either alone and nothing reds. One way it works, one way to
   235	 * break it.
   236	 *
   237	 * Throwing is the established contract of both funnels (each already throws on a non-ok response),
   238	 * and a caller that swallows the error drops an invisible message, which is the correct outcome —
   239	 * the incident this exists for was a "reply lost" escalation raised for content that never existed.
   240	 */
   241	/** The structured record of one refusal. Carried ON the error so any catcher can log it too. */
   242	export interface InvisiblePayloadRefusal {
   243	  guard: 'invisible-payload';
   244	  outcome: 'refused';
   245	  method: string;
   246	  field: string;
   247	  /** WHY it was refused, in the predicate's own terms — never the payload itself. */
   248	  rule:
   249	    | 'no-content-codepoint'
   250	    | 'no-content-codepoint-after-format'
   251	    /** The egress door refused a Bot API method nobody has classified (pass 36 finding 3). */
   252	    | 'unclassified-method'
   253	    /** The egress door could not read the request's parameters, so it could not decide (pass 36 finding 1). */
   254	    | 'unreadable-request';
   255	  /** Length only. The payload is invisible, but it is still user content and is never logged. */
   256	  valueLength: number;
   257	  /** The predicate is engine-resolved, so the engine is part of the decision (see multi-machine posture). */
   258	  engine: string;
   259	  unicode: string;
   260	}
   261	
   262	/** Error type carrying the structured decision, so a caller that catches can record it as well. */
   263	export class InvisiblePayloadRefusedError extends Error {
   264	  readonly decision: InvisiblePayloadRefusal;
   265	  constructor(message: string, decision: InvisiblePayloadRefusal) {
   266	    super(message);
   267	    this.name = 'InvisiblePayloadRefusedError';
   268	    this.decision = decision;
   269	  }
   270	}
   271	
   272	/**
   273	 * Where refusal decisions are emitted. Defaults to one structured line on stderr.
   274	 *
   275	 * `docs/signal-vs-authority.md` is explicit: *"Authorities must log their decisions in a structured form:
   276	 * which signals they received, what the conversation context was, which rule they applied, and what the
   277	 * outcome was. This is how over-blocks and under-blocks become detectable instead of just frustrating."*
   278	 * This guard IS blocking authority, and it logged nothing — raised at convergence round 4, not acted on,
   279	 * and raised again at round 11. Seeing a finding and not acting on it is worse than not seeing it.
   280	 *
   281	 * A console sink rather than a file sink deliberately: this function is called from CLI commands and setup
   282	 * wizards as well as the server, and a shared pure module that opens a log file on a CLI path would be a
   283	 * worse defect than the one it fixes. Injectable so a host with a real audit trail can route it there.
   284	 */
   285	let refusalSink: (decision: InvisiblePayloadRefusal) => void = (decision) => {
   286	  console.warn(`[invisible-payload] ${JSON.stringify(decision)}`);
   287	};
   288	
   289	/** Route refusal decisions to a host-provided audit trail. Returns the previous sink. */
   290	/**
   291	 * Record a refusal that did NOT come from the predicate — the egress door's own "I cannot decide"
   292	 * cases. Review pass 37 finding 6: those threw bare errors, so the one refusal class that means
   293	 * "something is here I do not understand" was the only one invisible to the decision stream, while
   294	 * tests and the spec both claimed every refusal is recorded.
   295	 */
   296	export function emitInvisiblePayloadRefusal(decision: InvisiblePayloadRefusal): void {
   297	  try { refusalSink(decision); } catch { /* a broken sink never becomes a delivery */ }
   298	}
   299	
   300	export function setInvisiblePayloadRefusalSink(
   301	  sink: (decision: InvisiblePayloadRefusal) => void,
   302	): (decision: InvisiblePayloadRefusal) => void {
   303	  const previous = refusalSink;
   304	  refusalSink = sink;
   305	  return previous;
   306	}
