   171	/** Parameters Telegram will read, gathered from BOTH places it accepts them. */
   172	function collectParams(url: string, body: RequestInit['body']): {
   173	  params: Record<string, unknown>;
   174	  uncheckable: string | null;
   175	} {
   176	  const params: Record<string, unknown> = {};
   177	
   178	  // The query string is a first-class way to pass Bot API parameters. The first version of this door
   179	  // ignored it completely, so `sendMessage?text=<invisible>` was never examined.
   180	  //
   181	  // Two corrections from review pass 37. The FRAGMENT never goes on the wire — `fetch` strips it — so
   182	  // reading it as payload let visible fragment text mask an invisible query value (finding 2). And
   183	  // Telegram appends URL arguments BEFORE body arguments while its accessor returns the FIRST match,
   184	  // so on a conflict the QUERY value is the one that gets sent; the first version let the body
   185	  // overwrite it and inspected a value Telegram would never use (finding 1). Query is therefore
   186	  // collected LAST here, with `queryKeys` marking what must not be overwritten.
   187	  let search = '';
   188	  try {
   189	    search = new URL(url.trim()).search;
   190	  } catch {
   191	    const q = url.indexOf('?');
   192	    const h = url.indexOf('#');
   193	    if (q >= 0) search = h > q ? url.slice(q, h) : url.slice(q);
   194	  }
   195	  const queryParams = new URLSearchParams(search);
   196	
   197	  /**
   198	   * Overlay the query LAST: on a conflicting key, the value Telegram sends is the query's.
   199	   *
   200	   * And take the FIRST occurrence of a repeated key, not the last. Telegram's accessor returns the
   201	   * first match; iterating `URLSearchParams` yields every occurrence, so assigning in loop order left
   202	   * the LAST one in the object. Measured before this fix, both directions were wrong:
   203	   * `?text=<invisible>&text=visible` was SENT while Telegram would have sent the invisible value, and
   204	   * `?text=visible&text=<invisible>` was REFUSED while Telegram would have sent the visible one. One
   205	   * bypass and one destroyed message from a single line. `URLSearchParams.get` returns the first.
   206	   */
   207	  const done = (uncheckable: string | null) => {
   208	    for (const k of new Set(queryParams.keys())) {
   209	      const first = queryParams.get(k);
   210	      if (first !== null) params[k] = first;
   211	    }
   212	    return { params, uncheckable };
   213	  };
   214	
   215	  if (body === null || body === undefined) return done(null);
   216	
   217	  if (typeof body === 'string') {
   218	    if (body.length === 0) return done(null);
   219	    try {
   220	      const parsed: unknown = JSON.parse(body);
   221	      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
   222	        // `JSON.parse` keeps the LAST of a duplicated key; Telegram's parser preserves order and its
   223	        // accessor returns the FIRST. Rather than reimplement a JSON parser to recover the first, this
   224	        // REFUSES a body with duplicate top-level keys — the value Telegram would use cannot be
   225	        // determined here, and an undecidable request is a closed door (pass 38 finding 1).
   226	        // `JSON.stringify` never emits duplicates, so no ordinary sender is affected.
   227	        const dup = duplicateTopLevelJsonKey(body);
   228	        if (dup !== null) {
   229	          return done(`a JSON body with a duplicated "${dup}" key, whose effective value is ambiguous`);
   230	        }
   231	        Object.assign(params, parsed as Record<string, unknown>);
   232	        return done(null);
   233	      }
   234	      return done('a JSON body that is not an object');
   235	    } catch {
   236	      // Form encoding is a supported Bot API encoding, not a mistake. Accept it when it looks like
   237	      // one, and refuse anything else rather than guess.
   238	      if (/^[^=&\s]+=/.test(body)) {
   239	        // Same first-match rule as the query above — a repeated key in a form body resolves to its
   240	        // FIRST value at Telegram, so it must here too.
   241	        const form = new URLSearchParams(body);
   242	        for (const k of new Set(form.keys())) {
   243	          const first = form.get(k);
   244	          if (first !== null) params[k] = first;
   245	        }
   246	        return done(null);
   247	      }
   248	      return done('a body that is neither JSON nor form encoding');
   249	    }
   250	  }
   251	
   252	  if (body instanceof URLSearchParams) {
   253	    for (const k of new Set(body.keys())) {
   254	      const first = body.get(k);
   255	      if (first !== null) params[k] = first;
   256	    }
   257	    return done(null);
   258	  }
   259	
   260	  // F5: FormData is ITERABLE without consuming it, so it is read rather than refused. The previous
   261	  // version grouped it with one-shot streams under "cannot read without consuming", which was false
   262	  // and rejected legitimate multipart sends carrying visible text.
   263	  if (typeof FormData !== 'undefined' && body instanceof FormData) {
   264	    // First occurrence wins here too (pass 38 finding 1: the repair covered query and form encoding
   265	    // and skipped this one, so multipart still resolved a repeated key to its LAST value).
   266	    for (const [k, v] of body as unknown as Iterable<[string, unknown]>) {
   267	      if (typeof v === 'string' && !(k in params)) params[k] = v;
   268	    }
   269	    return done(null);
   270	  }
   271	
   272	  // Blob, ArrayBuffer, TypedArray, ReadableStream. These are not parameter encodings the Bot API
   273	  // accepts for a reader-visible field, and a stream genuinely is one-shot — reading it here would
   274	  // consume the one the caller is about to send. Refused, which is the safe direction.
   275	  return done(`a ${body.constructor?.name ?? 'non-string'} body`);
   276	}
