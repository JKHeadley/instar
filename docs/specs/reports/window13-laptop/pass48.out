   439	    it('reads only the fields the discriminator declares — a discarded member cannot vouch', async () => {
   440	      // Pass 47 finding 2. Telegram reads `type`, extracts that variant's declared fields, and DISCARDS
   441	      // every other member of the object. The previous walk descended every object-valued property, so a
   442	      // member the server throws away could make an invisible payload look visible.
   443	      const f = arm();
   444	      await expect(telegramFetch(api('sendRichMessage'), post({
   445	        chat_id: 1,
   446	        rich_message: { blocks: [{ type: 'paragraph', text: {
   447	          type: 'bold',
   448	          text: '\u200b',
   449	          // `bold` consumes `text` alone. Everything below is discarded by the server.
   450	          caption: { text: 'LOOKS VISIBLE BUT IS DISCARDED' },
   451	          summary: 'ALSO DISCARDED',
   452	        } }] },
   453	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   454	      expect(f, 'a member the server discards must not license a send').not.toHaveBeenCalled();
   455	
   456	      // Same at block level: `paragraph` consumes `text`, so a stray sibling cannot vouch either.
   457	      const f2 = arm();
   458	      await expect(telegramFetch(api('sendRichMessage'), post({
   459	        chat_id: 1,
   460	        rich_message: { blocks: [{ type: 'paragraph', text: '\u200b', credit: 'DISCARDED ON A PARAGRAPH' }] },
   461	      }))).rejects.toThrow(InvisiblePayloadRefusedError);
   462	      expect(f2).not.toHaveBeenCalled();
   463	
   464	      // ...but a field the variant DOES declare still counts: `pullquote` reads text AND credit.
   465	      const f3 = arm();
   466	      await telegramFetch(api('sendRichMessage'), post({
   467	        chat_id: 1,
   468	        rich_message: { blocks: [{ type: 'pullquote', text: '\u200b', credit: 'a real credit line' }] },
   469	      }));
   470	      expect(f3, 'pullquote declares credit — it renders').toHaveBeenCalledTimes(1);
   471	    });
