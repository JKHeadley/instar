   297	    // shape that arrives already-opaque produced no record at all and a catcher could erase it entirely.
   298	    emitInvisiblePayloadRefusal({
   299	      guard: 'invisible-payload',
   300	      outcome: 'refused',
   301	      method: '(request-object)',
   302	      field: '(unreadable)',
   303	      rule: 'unreadable-request',
   304	      valueLength: 0,
   305	      engine: process.version,
   306	      unicode: process.versions.unicode ?? 'unknown',
   307	    });
   308	    throw new TelegramEgressError(
   309	      'telegram egress: a Request object carries its own body, which cannot be inspected here. Pass a '
   310	      + 'URL string (or URL) with the parameters in `init`.',
   311	    );
   312	  }
   313	  const href = typeof url === 'string' ? url : url.href;
   314	  // Read the body ONCE, and FREEZE it. Reading once was not enough (pass 41): for a string the value IS
   315	  // the bytes, but `URLSearchParams` and `FormData` are captured by REFERENCE, so a caller could mutate
   316	  // the same object after the check and change what goes on the wire. Serialise those to a string here,
   317	  // so the value inspected below and the value sent at the end are the same immutable bytes.
   318	  const rawBody = init.body;
