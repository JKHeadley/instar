    67	/**
    68	 * Recover the API method from the URL rather than trusting a caller-supplied label.
    69	 *
    70	 * A caller passing the wrong method name would select the wrong reader-visible field, and the check
    71	 * would silently examine nothing. The URL is what Telegram dispatches on, so it is the only
    72	 * description of the request that cannot disagree with the request.
    73	 *
    74	 * Returns the CANONICAL spelling when the method is known, so a case variant cannot slip past a
    75	 * case-sensitive field map; returns the raw spelling when unknown, which `telegramFetch` refuses.
    76	 */
    77	export function methodFromTelegramUrl(url: string): string | null {
    78	  // Parse rather than pattern-match the raw text. Review pass 37 finding 3: a regex anchored to the
    79	  // literal host missed spellings `fetch` normalises before dispatch — an explicit `:443`, leading
    80	  // whitespace, a percent-encoded or upper-case host. Telegram received those requests; the door
    81	  // returned null and skipped every check. Whatever `fetch` will send is what must be inspected, so
    82	  // the parser `fetch` uses is the one that decides.
    83	  let parsed: URL;
    84	  try {
    85	    parsed = new URL(url.trim());
    86	  } catch {
    87	    return null;
    88	  }
    89	  if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') return null;
    90	  // A terminal dot is the DNS root and denotes the SAME host; `new URL()` preserves it while an exact
    91	  // string compare rejects it, so the request reached Telegram and the door returned null (pass 39 F2).
    92	  const host = parsed.hostname.toLowerCase().replace(/\.$/, '');
    93	  if (host !== BOT_API_HOST) return null;
    94	  let pathname = parsed.pathname;
    95	  try { pathname = decodeURIComponent(pathname); } catch { /* malformed escape: judge the raw form */ }
    96	
    97	  // Model Telegram's extraction rather than pattern-matching a shape: it strips an optional `test`
    98	  // segment and treats the ENTIRE remaining path as the method name (pass 40 F1/F4). The previous regex
    99	  // consumed only an alphabetic PREFIX, and its optional group backtracked so that `/bot<token>/test/`
   100	  // resolved to the method `test` — which then refused as unclassified, hiding the root case entirely.
   101	  const afterToken = /^\/bot[^/]+\/(.*)$/.exec(pathname);
   102	  if (!afterToken) return null;
   103	  let rest = afterToken[1].replace(/^test(?:\/|$)/, '').replace(/\/+$/, '');
   104	  if (rest === '') return null;
   105	  return CANONICAL_METHOD.get(rest.toLowerCase()) ?? rest;
   106	}
   107	
   108	/** A Bot API URL whose path carries a token but NO method segment — the shape Telegram resolves from a
   109	 *  `method` argument instead. */
   110	export function isBotApiRoot(url: string): boolean {
   111	  let parsed: URL;
   112	  try { parsed = new URL(url.trim()); } catch { return false; }
   113	  if (parsed.hostname.toLowerCase().replace(/\.$/, '') !== BOT_API_HOST) return false;
   114	  let pathname = parsed.pathname;
   115	  try { pathname = decodeURIComponent(pathname); } catch { /* judge the raw form */ }
   116	  // The test-environment form `/bot<token>/test/` is ALSO a root: Telegram strips the `test` segment
   117	  // and then resolves the method from a parameter exactly as it does for production (pass 40 F1 — the
   118	  // tests covered test-paths-with-a-method and production-roots-with-a-parameter, never the
   119	  // intersection, which is where the bypass lived).
   120	  return /^\/bot[^/]+\/(?:test\/?)?$/.test(pathname);
   121	}
