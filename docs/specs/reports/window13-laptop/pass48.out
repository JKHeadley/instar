   191	
   192	interface TelegramUpdate {
   193	  update_id: number;
   194	  message?: {
   195	    message_id: number;
   196	    // `is_bot` distinguishes a bot-sent message from a human user typing the same text —
   197	    // the structural half of the a2a spoof defense (a human typing an [a2a:…] marker has
   198	    // is_bot:false). `sender_chat` is present for group bot-as-channel relays.
   199	    from: { id: number; first_name: string; username?: string; is_bot?: boolean };
   200	    sender_chat?: { id: number; type?: string; username?: string };
   201	    chat: { id: number };
   202	    message_thread_id?: number;
   203	    text?: string;
   204	    date: number;
   205	    reply_to_message?: {
   206	      message_id: number;
   207	      forum_topic_created?: { name: string };
   208	    };
   209	    voice?: {
   210	      file_id: string;
   211	      file_unique_id: string;
   212	      duration: number;
   213	      mime_type?: string;
   214	      file_size?: number;
   215	    };
   216	    photo?: Array<{
   217	      file_id: string;
   218	      file_unique_id: string;
   219	      width: number;
   220	      height: number;
   221	      file_size?: number;
   222	    }>;
   223	    caption?: string;
   224	    document?: {
   225	      file_id: string;
   226	      file_unique_id: string;
   227	      file_name?: string;
   228	      mime_type?: string;
   229	      file_size?: number;
   230	    };
   231	    forum_topic_created?: { name: string };
   232	    forum_topic_edited?: { name?: string };
   233	  };
   234	  callback_query?: {
   235	    id: string;
   236	    from: { id: number; first_name: string; username?: string };
   237	    message?: {
   238	      message_id: number;
   239	      chat: { id: number };
   240	      message_thread_id?: number;
   241	    };
   242	    data?: string;
   243	  };
   244	}
   245	
   246	interface LogEntry {
   247	  messageId: number;
   248	  topicId: number | null;
   249	  text: string;
   250	  fromUser: boolean;
   251	  timestamp: string;
   252	  sessionName: string | null;
   253	  senderName?: string;
   254	  senderUsername?: string;
   255	  telegramUserId?: number;
   256	  /**
   257	   * Forwarded provenance (BIAS-TO-ACTION-SPEC D10). Persisted EXPLICITLY on
   258	   * genuine inbound rows as `false` (NOT omitted) so the standing-authorization
   259	   * resolver can PROVE a row is non-forwarded — a forwarded operator message
   260	   * carries third-party content and must never count as a grant. A legacy row
   261	   * with no `forwarded` field is forwarded-UNKNOWN and does not count (fail-safe).
   262	   */
   263	  forwarded?: boolean;
   264	  /** Structural origin, stamped at the send/receive seam. */
   265	  provenance: MessageProvenance;
   266	}
   267	
   268	/**
   269	 * Pre-dispatch hook for the agent-to-agent Telegram comms primitive. Adapter calls this
   270	 * BEFORE normal onTopicMessage / this.handler dispatch on text messages. Returns
   271	 * {handled:true} → dispatch is skipped (hook routed or dropped the a2a event);
   272	 * {handled:false} → fall through to normal user flow. Spec: MENTOR-LIVE-READINESS §Fix 2b.
   273	 */
   274	export interface AgentMessageHookInput {
   275	  /** Raw message text (the body the marker parser inspects). */
   276	  text: string;
   277	  /** Telegram topic id (or GENERAL_TOPIC_ID fallback). */
   278	  topicId: number;
   279	  /** msg.from.is_bot (per Telegram's update shape). False for human users — the structural
   280	   *  half of the a2a spoof defense. */
   281	  senderIsBot: boolean;
   282	  /** msg.sender_chat.id (when present — group bot-as-channel relay). */
   283	  senderChatId?: string;
   284	  /** Effective bot identity: sender_chat.id ?? from.id, stringified. */
   285	  senderBotId?: string;
   286	  /** Wall-clock now (ms) — passed in for testability. */
   287	  now: number;
   288	}
   289	
   290	export type AgentMessageHook = (input: AgentMessageHookInput) => Promise<{ handled: boolean }>;
   291	
   292	export interface AttentionItem {
   293	  id: string;
   294	  title: string;
   295	  summary: string;
   296	  description?: string;
   297	  category: string;
   298	  priority: 'URGENT' | 'HIGH' | 'NORMAL' | 'LOW';
   299	  status: 'OPEN' | 'ACKNOWLEDGED' | 'IN_PROGRESS' | 'DONE' | 'WONT_DO';
   300	  sourceContext?: string;
   301	  createdAt: string;
   302	  updatedAt: string;
   303	  topicId?: number;
   304	  /**
   305	   * True when the topic-flood guard coalesced this item into a shared "notices
   306	   * coalesced" topic instead of giving it its own. Such items are NOT registered
   307	   * in the per-item topic maps and are managed via /attention (PATCH / dashboard),
   308	   * not per-topic /ack — so resolving one never closes the shared notice topic.
   309	   */
   310	  coalesced?: boolean;
   311	  /**
   312	   * Routing lane. When `'agent-health'`, this is a routine SELF-HEALTH /
   313	   * housekeeping notice about the agent's OWN internal state (a stale-looking
   314	   * session, a peer it can't reach, etc.) rather than something the USER must act
   315	   * on. Such items are routed into ONE calm, persistently-named "🩺 Agent Health"
   316	   * topic from the very first item — they never spawn their own per-item topic
   317	   * (even under budget, even if mis-tagged HIGH), and same-entity re-escalations
   318	   * are suppression-deduped so the lane stays quiet. Absent ⇒ today's behavior.
   319	   */
   320	  lane?: 'agent-health';
   321	  /**
   322	   * Stable per-entity key for Agent-Health-lane suppression dedup (e.g. a session
   323	   * id). Decoupled from `id` (which may carry a per-episode suffix) so the same
   324	   * entity re-escalating within the dedup window is suppressed rather than
   325	   * reposted. Falls back to `sourceContext`, then `id`, when unset.
   326	   */
   327	  healthKey?: string;
   328	  /**
   329	   * calm-alerting M-P2 (Near-Silent Notifications): true ⇒ the hub post for
   330	   * this item is sent with `disable_notification` — visible in the topic, the
   331	   * store, and the dashboard, but it does not buzz. The item's lifecycle is
   332	   * otherwise identical. Absent ⇒ today's notifying behavior.
   333	   */
   334	  silent?: boolean;
   335	  /** WS4.1 (MULTI-MACHINE-SEAMLESSNESS-SPEC §WS4.1): the machine this item
   336	   *  belongs to. Stamped at read time in GET /attention (the store stays
   337	   *  machine-agnostic); absent on a single-machine install. */
   338	  machineId?: string;
   339	  /** Display nickname of `machineId`, resolved from the pool registry at read
   340	   *  time. */
   341	  machineNickname?: string;
   342	}
   343	
   344	/**
   345	 * Telegram General topic convention:
   346	 * - Incoming: messages in General have message_thread_id=1 (or undefined in older API)
   347	 * - Internal: we use GENERAL_TOPIC_ID (1) as the sentinel
   348	 * - Outgoing: we OMIT message_thread_id for General (don't send 1, don't send 0)
   349	 *
   350	 * The isGeneralTopic() helper should be used instead of raw `topicId === 1` checks
   351	 * to keep the convention in one place.
   352	 */
   353	const GENERAL_TOPIC_ID = 1;
   354	
   355	function isGeneralTopic(topicId: number): boolean {
   356	  return topicId <= GENERAL_TOPIC_ID;
   357	}
   358	
   359	const PRIORITY_EMOJI: Record<string, string> = {
   360	  URGENT: '\ud83d\udd34',  // 🔴
   361	  HIGH: '\ud83d\udfe0',     // 🟠
   362	  NORMAL: '\ud83d\udd35',   // 🔵
   363	  LOW: '\u26aa',             // ⚪
   364	};
   365	
   366	const PRIORITY_COLOR: Record<string, number> = {
   367	  URGENT: 16478047,   // red
   368	  HIGH: 16749490,     // orange
   369	  NORMAL: 7322096,    // blue
   370	  LOW: 13338331,      // purple
   371	};
   372	
   373	/**
   374	 * Standard topic styles for visual organization in Telegram forum.
   375	 * Colors are the 6 values Telegram's Bot API accepts for icon_color.
   376	 * Emojis prefix topic names for at-a-glance scanning.
   377	 */
   378	export const TOPIC_STYLE = {
   379	  /** Green — core infrastructure (Lifeline) */
   380	  SYSTEM:  { color: 9367192,  emoji: '🛡️' },
