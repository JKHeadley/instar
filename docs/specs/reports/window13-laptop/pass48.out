   364	      // refusal class most worth seeing in the decision stream, and it was the only one absent from it.
   365	      emitInvisiblePayloadRefusal({
   366	        guard: 'invisible-payload',
   367	        outcome: 'refused',
   368	        method,
   369	        field: '(unknown)',
   370	        rule: 'unclassified-method',
   371	        valueLength: 0,
   372	        engine: process.version,
   373	        unicode: process.versions.unicode ?? 'unknown',
