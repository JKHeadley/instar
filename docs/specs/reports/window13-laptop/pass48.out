   338	      method = CANONICAL_METHOD.get(fromParams.toLowerCase()) ?? fromParams;
   339	    } else {
   340	      // A Bot API root request whose method cannot be determined is undecidable, not benign.
   341	      emitInvisiblePayloadRefusal({
   342	        guard: 'invisible-payload',
   343	        outcome: 'refused',
   344	        method: '(unresolved)',
   345	        field: '(unknown)',
   346	        rule: 'unclassified-method',
   347	        valueLength: 0,
   348	        engine: process.version,
   349	        unicode: process.versions.unicode ?? 'unknown',
   350	      });
