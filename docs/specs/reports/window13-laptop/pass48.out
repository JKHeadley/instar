   327	
   328	  let method = methodFromTelegramUrl(href);
   329	
   330	  // F1 (pass 39): when the path carries NO method, Telegram falls back to the first `method` ARGUMENT.
   331	  // The door returned null for those and skipped every check, so a request to the token root carrying
   332	  // `method=sendMessage&text=<invisible>` dispatched normally and was never inspected. Recover the
   333	  // method from the parameters in exactly the case Telegram does.
   334	  if (method === null && isBotApiRoot(href)) {
