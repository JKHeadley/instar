   210	/**
   211	 * The refusal, at the CALLER's representation. This no longer runs in either funnel — the egress door
   212	 * checks the wire payload instead, and the funnel calls were removed as double-cover (pass 36 finding
   213	 * 6 caught this description outliving them). Its one live caller is the tokenless-relay branch in
   214	 * `TelegramAdapter`, whose send never reaches the Telegram host from this process.
   215	 *
     1	/**
     2	 * The single door to the Telegram Bot API for anything carrying a reader-visible body.
     3	 *
     4	 * WHY THIS EXISTS, in the order the reasons were learned:
     5	 *
     6	 * Review passes 29 through 35 each found the same shape by a different route. A guard was placed on
     7	 * one send path and the path was called guarded; a second egress existed (pass 29); the guard ran
     8	 * before a formatter that changed the representation (pass 33); the lint that policed the guard could
     9	 * not prove its own claims about call resolution or method classification (passes 34, 35). Six
    10	 * patterns, one class: the guarantee was distributed across senders, so proving it meant proving a
    11	 * property of every sender, and every proof was weaker than it read.
    12	 *
    13	 * A boundary does not have that problem. If exactly one function may reach the network, then "is the
    14	 * payload checked" stops being a question about six call sites and becomes a question about one.
    15	 *
    16	 * WHAT IT CHECKS, and why here rather than earlier. It reads the request as Telegram will read it —
    17	 * the query string and the serialised body, the exact bytes about to go on the wire. Every earlier
    18	 * placement checked a representation that something later could still change: the caller's text, then
    19	 * the formatter's output, then the object handed to fetch. This is the last one.
    20	 *
    21	 * WHAT PASS 36 FOUND, because moving a boundary is not the same as closing a class:
    22	 *
    23	 *   1. The door checked ONLY a non-empty string body. Telegram accepts parameters in the URL query,
    24	 *      as form encoding, and as multipart — so a reader-visible method sent any of those other ways
    25	 *      reached the network unchecked. The door was one encoding wide.
    26	 *   2. Method and host recognition were case-SENSITIVE while Telegram's dispatch is not. `sendmessage`
    27	 *      is dispatched by Telegram and missed the field map, which returns silently on an unknown key.
    28	 *   3. Moving the boundary DELETED the closed-world method check the previous per-sender lint
    29	 *      performed. A newly-used reader-visible method passed through the approved door, received no
    30	 *      decision, and left while the lint stayed clean — a guard that nothing guards, which is the
    31	 *      exact defect this file's own header claimed to have eliminated.
    32	 *
    33	 * All three share one root: the door treated what it could not check as fine. The rule below is the
    34	 * opposite, and it is the only rule here that matters — AN UNCHECKABLE REQUEST IS A CLOSED DOOR.
    35	 *
    36	 * WHAT THIS DOOR DOES NOT COVER, decided rather than missed (review pass 38 finding 4). A non-Bot URL
    37	 * that REDIRECTS into a Bot API method is classified once, on the initial URL, and `fetch` follows the
    38	 * redirect without a second decision. Manual redirect handling would close it and would also break the
    39	 * file-download callers that legitimately redirect.
    40	 *
    41	 * It is left open because it is outside this guard's purpose: the guarantee is that THIS AGENT does not
    42	 * send a message a reader receives as nothing. A redirect crossing into the Bot API requires an actor
    43	 * who already controls a response this agent fetches — at which point the invisible-payload guard is not
    44	 * the control that matters. Stated so the next reader can disagree with the judgment rather than
    45	 * discover the gap.
    46	 */
    47	import {
    48	  assertOutgoingPayloadVisible,
    49	  emitInvisiblePayloadRefusal,
    50	  READER_VISIBLE_TELEGRAM_PARAMS,
    51	  readerVisibleFieldsFor,
    52	  NO_READER_VISIBLE_FIELD_TELEGRAM_METHODS,
    53	} from './invisible-payload.js';
    54	
    55	/**
    56	 * Any Bot API URL — `api.telegram.org/bot<token>/<method>`. Case-INSENSITIVE: a hostname is
    57	 * case-insensitive by RFC and Telegram accepts method names in any case. A matcher stricter than the
    58	 * dispatcher it models produces requests Telegram honours and this file never sees.
    59	 */
    60	const BOT_API_HOST = 'api.telegram.org';
    61	/** Lowercased method → canonical spelling, so lookup matches Telegram's case-insensitive dispatch. */
    62	const CANONICAL_METHOD: ReadonlyMap<string, string> = new Map(
    63	  [...Object.keys(READER_VISIBLE_TELEGRAM_PARAMS), ...NO_READER_VISIBLE_FIELD_TELEGRAM_METHODS]
    64	    .map((m) => [m.toLowerCase(), m] as const),
    65	);
    66	
    67	/**
    68	 * Recover the API method from the URL rather than trusting a caller-supplied label.
    69	 *
    70	 * A caller passing the wrong method name would select the wrong reader-visible field, and the check
    71	 * would silently examine nothing. The URL is what Telegram dispatches on, so it is the only
    72	 * description of the request that cannot disagree with the request.
    73	 *
    74	 * Returns the CANONICAL spelling when the method is known, so a case variant cannot slip past a
    75	 * case-sensitive field map; returns the raw spelling when unknown, which `telegramFetch` refuses.
    76	 */
    77	export function methodFromTelegramUrl(url: string): string | null {
    78	  // Parse rather than pattern-match the raw text. Review pass 37 finding 3: a regex anchored to the
    79	  // literal host missed spellings `fetch` normalises before dispatch — an explicit `:443`, leading
    80	  // whitespace, a percent-encoded or upper-case host. Telegram received those requests; the door
    81	  // returned null and skipped every check. Whatever `fetch` will send is what must be inspected, so
    82	  // the parser `fetch` uses is the one that decides.
    83	  let parsed: URL;
    84	  try {
    85	    parsed = new URL(url.trim());
    86	  } catch {
    87	    return null;
    88	  }
    89	  if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') return null;
    90	  // A terminal dot is the DNS root and denotes the SAME host; `new URL()` preserves it while an exact
    91	  // string compare rejects it, so the request reached Telegram and the door returned null (pass 39 F2).
    92	  const host = parsed.hostname.toLowerCase().replace(/\.$/, '');
    93	  if (host !== BOT_API_HOST) return null;
    94	  let pathname = parsed.pathname;
    95	  try { pathname = decodeURIComponent(pathname); } catch { /* malformed escape: judge the raw form */ }
    96	
    97	  // Model Telegram's extraction rather than pattern-matching a shape: it strips an optional `test`
    98	  // segment and treats the ENTIRE remaining path as the method name (pass 40 F1/F4). The previous regex
    99	  // consumed only an alphabetic PREFIX, and its optional group backtracked so that `/bot<token>/test/`
   100	  // resolved to the method `test` — which then refused as unclassified, hiding the root case entirely.
   101	  const afterToken = /^\/bot[^/]+\/(.*)$/.exec(pathname);
   102	  if (!afterToken) return null;
   103	  let rest = afterToken[1].replace(/^test(?:\/|$)/, '').replace(/\/+$/, '');
   104	  if (rest === '') return null;
   105	  return CANONICAL_METHOD.get(rest.toLowerCase()) ?? rest;
   106	}
   107	
   108	/** A Bot API URL whose path carries a token but NO method segment — the shape Telegram resolves from a
   109	 *  `method` argument instead. */
   110	export function isBotApiRoot(url: string): boolean {
   111	  let parsed: URL;
   112	  try { parsed = new URL(url.trim()); } catch { return false; }
   113	  if (parsed.hostname.toLowerCase().replace(/\.$/, '') !== BOT_API_HOST) return false;
   114	  let pathname = parsed.pathname;
   115	  try { pathname = decodeURIComponent(pathname); } catch { /* judge the raw form */ }
   116	  // The test-environment form `/bot<token>/test/` is ALSO a root: Telegram strips the `test` segment
   117	  // and then resolves the method from a parameter exactly as it does for production (pass 40 F1 — the
   118	  // tests covered test-paths-with-a-method and production-roots-with-a-parameter, never the
   119	  // intersection, which is where the bypass lived).
   120	  return /^\/bot[^/]+\/(?:test\/?)?$/.test(pathname);
   121	}
   122	
   123	export class TelegramEgressError extends Error {
   124	  constructor(message: string) {
   125	    super(message);
   170	
   171	/** Parameters Telegram will read, gathered from BOTH places it accepts them. */
   172	function collectParams(url: string, body: RequestInit['body']): {
   173	  params: Record<string, unknown>;
   174	  uncheckable: string | null;
   175	} {
   176	  const params: Record<string, unknown> = {};
   177	
   178	  // The query string is a first-class way to pass Bot API parameters. The first version of this door
   179	  // ignored it completely, so `sendMessage?text=<invisible>` was never examined.
   180	  //
   181	  // Two corrections from review pass 37. The FRAGMENT never goes on the wire — `fetch` strips it — so
   182	  // reading it as payload let visible fragment text mask an invisible query value (finding 2). And
   183	  // Telegram appends URL arguments BEFORE body arguments while its accessor returns the FIRST match,
   184	  // so on a conflict the QUERY value is the one that gets sent; the first version let the body
   185	  // overwrite it and inspected a value Telegram would never use (finding 1). Query is therefore
   186	  // collected LAST here, with `queryKeys` marking what must not be overwritten.
   187	  let search = '';
   188	  try {
   189	    search = new URL(url.trim()).search;
   190	  } catch {
   191	    const q = url.indexOf('?');
   192	    const h = url.indexOf('#');
   193	    if (q >= 0) search = h > q ? url.slice(q, h) : url.slice(q);
   194	  }
   195	  const queryParams = new URLSearchParams(search);
   196	
   197	  /**
   198	   * Overlay the query LAST: on a conflicting key, the value Telegram sends is the query's.
   199	   *
   200	   * And take the FIRST occurrence of a repeated key, not the last. Telegram's accessor returns the
   201	   * first match; iterating `URLSearchParams` yields every occurrence, so assigning in loop order left
   202	   * the LAST one in the object. Measured before this fix, both directions were wrong:
   203	   * `?text=<invisible>&text=visible` was SENT while Telegram would have sent the invisible value, and
   204	   * `?text=visible&text=<invisible>` was REFUSED while Telegram would have sent the visible one. One
   205	   * bypass and one destroyed message from a single line. `URLSearchParams.get` returns the first.
   206	   */
   207	  const done = (uncheckable: string | null) => {
   208	    for (const k of new Set(queryParams.keys())) {
   209	      const first = queryParams.get(k);
   210	      if (first !== null) params[k] = first;
   211	    }
   212	    return { params, uncheckable };
   213	  };
   214	
   215	  if (body === null || body === undefined) return done(null);
   216	
   217	  if (typeof body === 'string') {
   218	    if (body.length === 0) return done(null);
   219	    try {
   220	      const parsed: unknown = JSON.parse(body);
   221	      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
   222	        // `JSON.parse` keeps the LAST of a duplicated key; Telegram's parser preserves order and its
   223	        // accessor returns the FIRST. Rather than reimplement a JSON parser to recover the first, this
   224	        // REFUSES a body with duplicate top-level keys — the value Telegram would use cannot be
   225	        // determined here, and an undecidable request is a closed door (pass 38 finding 1).
   226	        // `JSON.stringify` never emits duplicates, so no ordinary sender is affected.
   227	        const dup = duplicateTopLevelJsonKey(body);
   228	        if (dup !== null) {
   229	          return done(`a JSON body with a duplicated "${dup}" key, whose effective value is ambiguous`);
   230	        }
   231	        Object.assign(params, parsed as Record<string, unknown>);
   232	        return done(null);
   233	      }
   234	      return done('a JSON body that is not an object');
   235	    } catch {
   236	      // Form encoding is a supported Bot API encoding, not a mistake. Accept it when it looks like
   237	      // one, and refuse anything else rather than guess.
   238	      if (/^[^=&\s]+=/.test(body)) {
   239	        // Same first-match rule as the query above — a repeated key in a form body resolves to its
   240	        // FIRST value at Telegram, so it must here too.
   241	        const form = new URLSearchParams(body);
   242	        for (const k of new Set(form.keys())) {
   243	          const first = form.get(k);
   244	          if (first !== null) params[k] = first;
   245	        }
   246	        return done(null);
   247	      }
   248	      return done('a body that is neither JSON nor form encoding');
   249	    }
   250	  }
   251	
   252	  if (body instanceof URLSearchParams) {
   253	    for (const k of new Set(body.keys())) {
   254	      const first = body.get(k);
   255	      if (first !== null) params[k] = first;
   256	    }
   257	    return done(null);
   258	  }
   259	
   260	  // F5: FormData is ITERABLE without consuming it, so it is read rather than refused. The previous
   261	  // version grouped it with one-shot streams under "cannot read without consuming", which was false
   262	  // and rejected legitimate multipart sends carrying visible text.
   263	  if (typeof FormData !== 'undefined' && body instanceof FormData) {
   264	    // First occurrence wins here too (pass 38 finding 1: the repair covered query and form encoding
   265	    // and skipped this one, so multipart still resolved a repeated key to its LAST value).
   266	    for (const [k, v] of body as unknown as Iterable<[string, unknown]>) {
   267	      if (typeof v === 'string' && !(k in params)) params[k] = v;
   268	    }
   269	    return done(null);
   270	  }
   271	
   272	  // Blob, ArrayBuffer, TypedArray, ReadableStream. These are not parameter encodings the Bot API
   273	  // accepts for a reader-visible field, and a stream genuinely is one-shot — reading it here would
   274	  // consume the one the caller is about to send. Refused, which is the safe direction.
   275	  return done(`a ${body.constructor?.name ?? 'non-string'} body`);
   276	}
