   130	/**
   131	 * Name a duplicated TOP-LEVEL key in a JSON object body, or null. Deliberately a scanner rather than a
   132	 * parser: it only needs to answer "is the effective value ambiguous here", and a wrong answer in the
   133	 * ambiguous direction costs a refusal rather than a delivery.
   134	 */
   135	function duplicateTopLevelJsonKey(body: string): string | null {
   136	  const seen = new Set<string>();
   137	  let depth = 0;
   138	  let inString = false;
   139	  let escaped = false;
   140	  let key: string | null = null;
   141	  let buf = '';
   142	  for (let i = 0; i < body.length; i += 1) {
   143	    const c = body[i];
   144	    if (inString) {
   145	      // Compare DECODED keys: `text` and `\u0074ext` are the SAME key to `JSON.parse` and to Telegram,
   146	      // and the first version appended raw source characters, so an escaped spelling read as distinct
   147	      // and the duplicate went undetected (pass 39 F3).
   148	      if (escaped) {
   149	        escaped = false;
   150	        if (c === 'u') { buf += JSON.parse(`"\\u${body.slice(i + 1, i + 5)}"`); i += 4; continue; }
   151	        buf += ({ n: '\n', t: '\t', r: '\r', b: '\b', f: '\f' } as Record<string, string>)[c] ?? c;
   152	        continue;
   153	      }
   154	      if (c === '\\') { escaped = true; continue; }
   155	      if (c === '"') { inString = false; key = buf; buf = ''; continue; }
   156	      buf += c;
   157	      continue;
   158	    }
   159	    if (c === '"') { inString = true; buf = ''; continue; }
   160	    if (c === '{' || c === '[') { depth += 1; continue; }
   161	    if (c === '}' || c === ']') { depth -= 1; continue; }
   162	    if (c === ':' && depth === 1 && key !== null) {
   163	      if (seen.has(key)) return key;
   164	      seen.add(key);
   165	      key = null;
   166	    }
   167	  }
   168	  return null;
   169	}
