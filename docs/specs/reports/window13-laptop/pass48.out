   287	  url: string | URL,
   288	  init: RequestInit = {},
   289	): Promise<Response> {
   290	  // The TYPE said `string`; the RUNTIME is what ships. Native `fetch` also accepts `URL` and `Request`
   291	  // objects, and JavaScript callers are not bound by the signature — review pass 38 finding 3. A `URL`
   292	  // is normalised to its string form and checked exactly like any other. A `Request` is REFUSED: its
   293	  // body lives on the object rather than in `init`, so no parameter collection is possible and
   294	  // forwarding it would be the unchecked door this module exists to close.
   295	  if (typeof url !== 'string' && !(url instanceof URL)) {
