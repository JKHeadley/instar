   109	export function hasNoVisibleCharacters(text: string): boolean {
   110	  for (const ch of text) {
   111	    if (CONTENT_RE.test(ch) && !IGNORABLE_RE.test(ch) && !BLANK_GLYPHS.has(ch)) return false;
   112	  }
   113	  return true;
   114	}
