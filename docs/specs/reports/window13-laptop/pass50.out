   326	  url: string | URL,
   327	  init: RequestInit = {},
   328	): Promise<Response> {
   329	  // The TYPE said `string`; the RUNTIME is what ships. Native `fetch` also accepts `URL` and `Request`
   330	  // objects, and JavaScript callers are not bound by the signature — review pass 38 finding 3. A `URL`
   331	  // is normalised to its string form and checked exactly like any other. A `Request` is REFUSED: its
   332	  // body lives on the object rather than in `init`, so no parameter collection is possible and
   333	  // forwarding it would be the unchecked door this module exists to close.
   334	  if (typeof url !== 'string' && !(url instanceof URL)) {
