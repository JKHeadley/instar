   439	    // body can carry outranks it, and a same-key body value loses to the query one, so what Telegram
   440	    // sends is the value just checked. For a single-field method this is exactly the previous rule.
   441	    const fields = readerVisibleFieldsFor(method);
   442	    const fieldSuppliedByQuery = fields.length > 0 && typeof params[fields[0]] === 'string';
   443	    if (uncheckable !== null && !fieldSuppliedByQuery) {
   444	      emitInvisiblePayloadRefusal({
   445	        guard: 'invisible-payload',
   446	        outcome: 'refused',
   447	        method,
   448	        field: '(unreadable)',
   449	        rule: 'unreadable-request',
   450	        valueLength: 0,
   451	        engine: process.version,
   452	        unicode: process.versions.unicode ?? 'unknown',
   453	      });
