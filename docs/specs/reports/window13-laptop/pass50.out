   338	      guard: 'invisible-payload',
   339	      outcome: 'refused',
   340	      method: '(request-object)',
   341	      field: '(unreadable)',
   342	      rule: 'unreadable-request',
   343	      valueLength: 0,
   344	      engine: process.version,
   345	      unicode: process.versions.unicode ?? 'unknown',
   346	    });
