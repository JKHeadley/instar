   403	      // refusal class most worth seeing in the decision stream, and it was the only one absent from it.
   404	      emitInvisiblePayloadRefusal({
   405	        guard: 'invisible-payload',
   406	        outcome: 'refused',
   407	        method,
   408	        field: '(unknown)',
   409	        rule: 'unclassified-method',
   410	        valueLength: 0,
   411	        engine: process.version,
   412	        unicode: process.versions.unicode ?? 'unknown',
   413	      });
