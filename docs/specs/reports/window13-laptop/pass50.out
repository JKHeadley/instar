  1321	  async sendToTopic(
  1322	    topicId: number,
  1323	    text: string,
  1324	    options?: {
  1325	      silent?: boolean;
  1326	      skipStallClear?: boolean;
  1327	      /** Kind metadata (messageKind/senderClass/advisoryAck…) forwarded to
  1328	       *  the holder on a RELAYED send so the kind survives the cross-machine
  1329	       *  hop (spec outbound-jargon-filepath-gap §2.5). Direct sends ignore it
  1330	       *  — the local route already consumed it. */
  1331	      kindMetadata?: Record<string, unknown>;
  1332	      /** Conversational agent reply vs server-generated outbound traffic. */
  1333	      provenance?: Exclude<MessageProvenance, 'user'>;
  1334	      /** 'html' = the caller already produced ESCAPED Telegram HTML (e.g. the
  1335	       *  attention-hub post) — the send carries `parse_mode: 'HTML'` +
  1336	       *  `_formatMode: 'html'` so applyTelegramFormatter's markdown converter
  1337	       *  does not re-escape the tags into literal `<b>`/`<i>` text (the
  1338	       *  2026-07-11 attention-hub rendering bug). Direct sends only; a relayed
  1339	       *  (tokenless-standby) send keeps today's default formatting. */
  1340	      formatMode?: 'html';
  1341	    },
  1342	  ): Promise<SendResult> {
  1343	    // NOT the chokepoint, and this comment is the correction of a claim that stood here.
  1344	    //
  1345	    // It read "THE CHOKEPOINT. Every Telegram send passes through here." Review pass 29 falsified
  1346	    // that by execution: `send()` — the MessagingAdapter interface method a router calls — reaches
  1347	    // the API without entering this function. Derived population: 14 `apiCall('sendMessage')` sites
  1348	    // in this class across 9 methods, of which this one accounted for 4.
  1349	    //
  1350	    // THERE ARE TWO EGRESS MECHANISMS IN THIS CLASS, not one, and that is the correction that cost
  1351	    // the most to learn. `apiCall` is the only path to `fetch` — but the tokenless-standby branch
  1352	    // below relays the body to another machine's router and never enters `apiCall` at all. Guarding
  1353	    // only the API funnel left that branch uncovered; an independent second-pass reviewer proved it
  1354	    // by execution, which makes the relay the FIFTH falsification of "every send passes through
  1355	    // here" — found inside the change that retired the phrase.
  1356	    //
  1357	    // So the refusal is applied per EGRESS, not per function: `apiCall` covers the API path and the
  1358	    // relay call site covers the relay path. That is not the duplication review pass 23 warns about
  1359	    // (two copies closing the SAME case, masking each other's tests) — these close DIFFERENT cases,
  1360	    // and each has its own test that reds when only its own guard is removed.
  1361	    const params: Record<string, unknown> = {
  1362	      chat_id: this.config.chatId,
  1363	      text,
  1364	    };
  1365	    if (!isGeneralTopic(topicId)) {
  1366	      params.message_thread_id = topicId;
  1367	    }
  1368	    if (options?.silent) {
  1369	      params.disable_notification = true;
  1370	    }
  1371	
  1372	    let result: { message_id: number };
  1373	    // A pool standby's bot token is externalized and arrives UNRESOLVED as a non-string
  1374	    // placeholder (e.g. `{ secret: true }`), not null — which is truthy, so the old
  1375	    // `!this.config.token` check thought a token existed and attempted a doomed direct API
  1376	    // send (the moved session's reply 200'd internally but never reached Telegram). The only
  1377	    // usable token is a non-empty string; anything else (placeholder/null/empty) means
  1378	    // "no usable token" → relay through the Telegram-owning router (bug #7).
  1379	    const hasUsableBotToken = typeof this.config.token === 'string' && this.config.token.length > 0;
  1380	    if (!hasUsableBotToken && this.outboundRelay) {
  1381	      // Tokenless standby (bug #7): relay the send through the Telegram-owning router
  1382	      // instead of calling the API with no token. The rest of this method's bookkeeping
  1383	      // (log, stall-clear, promise-tracking) then runs identically on the relayed id.
  1384	      //
  1385	      // EGRESS 2 of 2. This never reaches `apiCall`, so the funnel refusal cannot see it. Refusing
  1386	      // here keeps the guarantee whole and — equally important — keeps the failure HONEST: the far
  1387	      // end does refuse an invisible body, but with a 400, and `isRelayRefusal` recognises only 422,
  1388	      // so relying on it would surface a CONTENT refusal as `relay failed … router unreachable`.
  1389	      // That conflation of "refused" with "could not reach" is the exact bug TelegramRelay's own
  1390	      // header records having fixed.
  1391	      // THE ONE SURVIVING PER-SENDER GUARD, and the reason CMT-1246's criterion (b) — "every
  1392	      // per-sender call is DELETED" — cannot be met literally without opening a hole.
  1393	      //
  1394	      // The egress door (src/messaging/telegram-egress.ts) owns every other path because every other
  1395	      // path reaches api.telegram.org from THIS process. This one does not: it hands the message to
  1396	      // another machine, which sends it. The door cannot see a request this process never makes.
  1397	      //
  1398	      // Criterion (b) was written before that was understood. It is satisfied everywhere the door can
  1399	      // reach — seven of eight calls deleted — and this one stays, deliberately and named, rather than
  1400	      // deleted to make a checklist come out even.
  1401	      assertTelegramPayloadVisible('sendMessage', { text });
