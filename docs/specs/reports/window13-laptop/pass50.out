   348	      'telegram egress: a Request object carries its own body, which cannot be inspected here. Pass a '
   349	      + 'URL string (or URL) with the parameters in `init`.',
   350	    );
   351	  }
   352	  const href = typeof url === 'string' ? url : url.href;
   353	  // Read the body ONCE, and FREEZE it. Reading once was not enough (pass 41): for a string the value IS
   354	  // the bytes, but `URLSearchParams` and `FormData` are captured by REFERENCE, so a caller could mutate
   355	  // the same object after the check and change what goes on the wire. Serialise those to a string here,
   356	  // so the value inspected below and the value sent at the end are the same immutable bytes.
   357	  const rawBody = init.body;
   358	  const checkedBody: RequestInit['body'] = rawBody instanceof URLSearchParams
   359	    ? rawBody.toString()
   360	    : (typeof FormData !== 'undefined' && rawBody instanceof FormData)
   361	      ? new URLSearchParams(
   362	        [...(rawBody as unknown as Iterable<[string, unknown]>)]
   363	          .filter((e): e is [string, string] => typeof e[1] === 'string'),
   364	      ).toString()
