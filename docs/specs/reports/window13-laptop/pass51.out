  1560	   * asking:
  1561	   *   - 'user'   — a human asked for this topic (operator command, inbound
  1562	   *                conversation). Exempt: humans are self-rate-limiting.
  1563	   *   - 'system' — a bounded, create-once-then-reuse infrastructure topic
  1564	   *                (Lifeline, Dashboard, Updates, the flood-notice topic
  1565	   *                itself). Exempt: cardinality is fixed by design.
  1566	   *   - 'auto'   — anything a feature decided to create on its own. Counted.
  1567	   *                THIS IS THE DEFAULT — a caller that doesn't declare an
  1568	   *                origin is budgeted, so a future mis-wired feature is
  1569	   *                bounded without having to know this mechanism exists.
  1570	   * Past the budget this throws TopicFloodBudgetError — the same failure
  1571	   * shape as a Telegram 429, which every caller already survives.
  1572	   */
  1573	  async createForumTopic(
  1574	    name: string,
  1575	    iconColor?: number,
  1576	    opts?: { origin?: 'user' | 'system' | 'auto'; label?: string; bounded?: boolean },
  1577	  ): Promise<{ topicId: number; name: string }> {
  1578	    if (this.notAForum) {
  1579	      throw new Error('Chat is not a forum — topic creation skipped');
  1580	    }
  1581	
  1582	    const origin = opts?.origin ?? 'auto';
  1583	    // ── Universal last-resort flood ceiling (2026-07-04 conservatism pass) ──
  1584	    // The ONLY topics exempt from the ceiling are (a) a topic the HUMAN
  1585	    // explicitly asked for (`origin: 'user'`) and (b) a topic a caller declares
  1586	    // is cardinality-BOUNDED by design (`bounded: true` — a create-once-then-
  1587	    // reuse system topic like Lifeline/Dashboard/Updates/Agent-Health/the flood-
  1588	    // notice surface itself). EVERYTHING ELSE — including a bare `origin:
  1589	    // 'system'` — rides the ceiling. This closes the origin:'system' bypass that
  1590	    // let a per-item stream (e.g. HIGH/URGENT attention items) or any future
  1591	    // mis-wired caller dodge the "universal" budget entirely by simply declaring
  1592	    // itself 'system'. Structure over willpower: the ceiling can no longer be
  1593	    // sidestepped with a label. (Operator directive 2026-07-01: "be extremely
  1594	    // conservative with what messages get sent to Telegram … messages should NOT
  1595	    // create their own topics … applies to ALL aspects of INSTAR".)
  1596	    const exemptFromCeiling = origin === 'user' || opts?.bounded === true;
  1597	    if (!exemptFromCeiling) {
  1598	      const label = opts?.label ?? (origin === 'system' ? 'unlabeled-system' : 'unlabeled-auto');
  1599	      const decision = this.topicCreationGuard.decide(label, undefined);
  1600	      if (decision.action === 'coalesce') {
  1601	        console.warn(
  1602	          `[telegram] topic-creation budget: REFUSED ${origin} topic "${name}" ` +
  1603	          `(label=${label}, bucket=${decision.bucket}, #${decision.suppressedCount} in episode) — ` +
  1604	          `the last-resort flood ceiling. If this label is legitimate at this volume, ` +
  1605	          `raise messaging[].config.topicCreationBudget; if it is a bounded create-once ` +
  1606	          `system topic, pass { bounded: true }.`,
  1607	        );
  1608	        throw new TopicFloodBudgetError(name, label, decision.bucket);
  1609	      }
  1610	    }
  1611	
  1612	    const params: Record<string, unknown> = {
  1613	      chat_id: this.config.chatId,
  1614	      name,
  1615	    };
  1616	    if (iconColor !== undefined) {
  1617	      params.icon_color = iconColor;
  1618	    }
  1619	
  1620	    try {
  1621	      const result = await this.apiCall('createForumTopic', params) as {
  1622	        message_thread_id: number;
  1623	        name: string;
  1624	      };
  1625	
  1626	      this.topicToName.set(result.message_thread_id, name);
  1627	      this.saveRegistry();
  1628	
  1629	      console.log(`[telegram] Created forum topic: "${name}" (ID: ${result.message_thread_id})`);
  1630	      return { topicId: result.message_thread_id, name: result.name };
  1631	    } catch (err) {
  1632	      const errStr = String(err);
  1633	      if (errStr.includes('not a forum') || errStr.includes('FORUM_REQUIRED')) {
  1634	        this.notAForum = true;
  1635	        if (!this.notAForumWarned) {
  1636	          this.notAForumWarned = true;
  1637	          console.warn('[telegram] ⚠️ Chat is not a forum-enabled supergroup. Forum topics (Lifeline, Dashboard, per-session) will not be created. Messaging will use the General Topic. To enable topics, convert your Telegram group to a supergroup with Topics enabled in group settings.');
  1638	        }
  1639	      }
  1640	      throw err;
  1641	    }
  1642	  }
