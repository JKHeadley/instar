   425	    // Stage B: startup coherence check. Guards against respawning into a
   426	    // half-written shadow install where the bundled package.json advertises
   427	    // a version but the code is broken or missing. The getInstarVersion()
   428	    // helper is the same one used below; if it returns '0.0.0' (its error
   429	    // fallback), the install is incoherent — exit code 2 so launchd throttles
   430	    // respawn rather than tight-looping.
   431	    if (this.lifelineVersion === '0.0.0') {
   432	      console.error(pc.red('[Lifeline] startup coherence check failed: package.json missing or unreadable. Exiting with code 2 for launchd throttle.'));
   433	      process.exit(2);
   434	    }
   435	
   436	    // Acquire exclusive lock — prevent multiple lifeline instances
