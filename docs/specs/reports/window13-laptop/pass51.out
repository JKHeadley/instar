   893	  /**
   894	   * Unified restart initiator: checks rate limit, writes history, then
   895	   * calls the orchestrator. Used by both the watchdog tick (bucket=watchdog)
   896	   * and the version-skew handler (bucket=versionSkew).
   897	   */
   898	  private initiateRestart(
   899	    bucket: RestartBucket,
   900	    reason: string,
   901	    context?: Record<string, unknown>,
   902	  ): void {
   903	    const outcome = readRateLimitState(this.projectConfig.stateDir);
   904	    const dec = decideRateLimit(outcome, bucket);
   905	    if (!dec.allowed) {
   906	      console.log(`[Lifeline] restart suppressed by rate limit: ${dec.reason} (bucket=${bucket} reason=${reason})`);
   907	      return;
   908	    }
   909	    // Storm escalation signal (fires in addition to the normal restart
   910	    // signal so the operator sees that self-heal is not converging).
   911	    if (dec.stormActive || isRestartStorm(outcome.kind === 'ok' ? outcome.state : null)) {
   912	      DegradationReporter.getInstance().report({
   913	        feature: 'TelegramLifeline.restartStorm',
   914	        primary: 'Rate-limited self-restarts within ceiling',
   915	        fallback: 'Continuing to restart — underlying cause unresolved',
   916	        reason: `>= 6 restarts within the last hour; latest bucket=${bucket} reason=${reason}`,
   917	        impact: 'Operator should investigate; self-heal is not converging.',
   918	      });
   919	    }
   920	    // Write the history entry BEFORE calling process.exit so the new lifeline
   921	    // sees the rate-limit state on startup. Best-effort — failure here still
   922	    // lets the restart proceed (orchestrator is authoritative).
   923	    try {
   924	      const prior = outcome.kind === 'ok' ? outcome.state : null;
   925	      writeRateLimitState(this.projectConfig.stateDir, reason, bucket, prior);
   926	    } catch (err) {
   927	      console.error(`[Lifeline] failed to write rate-limit state: ${err}`);
   928	    }
   929	    if (!this.orchestrator) {
   930	      console.error('[Lifeline] initiateRestart called before orchestrator was installed');
   931	      return;
   932	    }
   933	    void this.orchestrator.requestRestart({ reason, bucket, context });
   934	  }
