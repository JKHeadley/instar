  3197	  /**
  3198	   * Download a file from Telegram by file_id.
  3199	   */
  3200	  private async downloadFile(fileId: string, destPath: string): Promise<void> {
  3201	    const maxRetries = 3;
  3202	    let lastError: Error | undefined;
  3203	
  3204	    for (let attempt = 1; attempt <= maxRetries; attempt++) {
  3205	      try {
  3206	        const fileInfo = await this.apiCall('getFile', { file_id: fileId }) as { file_path: string };
  3207	        const fileUrl = `https://api.telegram.org/file/bot${this.config.token}/${fileInfo.file_path}`;
  3208	
  3209	        const controller = new AbortController();
  3210	        const timer = setTimeout(() => controller.abort(), 60_000);
  3211	        try {
  3212	          const response = await telegramFetch(fileUrl, { signal: controller.signal });
  3213	          if (!response.ok) throw new Error(`Download failed: ${response.status}`);
  3214	          const buffer = Buffer.from(await response.arrayBuffer());
  3215	          fs.writeFileSync(destPath, buffer);
  3216	          return; // Success
  3217	        } finally {
  3218	          clearTimeout(timer);
  3219	        }
  3220	      } catch (err) {
  3221	        lastError = err instanceof Error ? err : new Error(String(err));
  3222	        if (attempt < maxRetries) {
  3223	          const delay = attempt * 1000;
  3224	          console.warn(`[telegram] File download attempt ${attempt}/${maxRetries} failed, retrying in ${delay}ms...`);
  3225	          await new Promise(resolve => setTimeout(resolve, delay));
  5340	      // Build inline keyboard buttons with just the number/key (compact)
