   497	 * link's DESTINATION is not what a reader sees — its label is, and the label is the nested `text`.
   498	 * Counting a destination as content is precisely how the original incident shipped: a payload whose only
   499	 * visible characters lived inside a URL. This now falls out of the table rather than being a rule applied
   500	 * beside it.
   501	 *
   502	 * A `mathematical_expression` is LaTeX SOURCE. Its source characters are not its rendered glyphs — a
   503	 * spacing-only expression is all letters and paints nothing — so it is marked OPAQUE rather than counted
   504	 * as visible. That is the honest position: this guard cannot decide a formula, it can only decline to let
   505	 * one vouch for an otherwise-invisible message.
   506	 */
   507	/**
   508	 * A formula, judged the one way this guard honestly can.
   509	 *
   510	 * ONE definition, used by all three representations — the markdown arm, the html arm, and the explicit
   511	 * structured discriminator at both inline and block level. It exists as a function rather than three
   512	 * matching lines because the last five repairs in this file were each applied to one representation of
   513	 * a class and not its siblings, and a shared definition is the only version of "swept" that cannot
   514	 * rot back apart.
   515	 *
   516	 * A formula body carrying content is UNDECIDABLE: its characters are LaTeX instructions, so this cannot
   517	 * tell whether they paint a glyph, and refusing would destroy real formula messages. A body carrying no
   518	 * content renders nothing and is DECIDED — it must not vouch for the message around it.
   519	 */
   520	function formulaScan(expression: unknown): StructuredScan {
   521	  if (typeof expression !== 'string') return NOTHING;
   522	  return hasNoVisibleCharacters(expression) ? NOTHING : OPAQUE;
   523	}
   524	
   525	function richTextScan(value: unknown, depth = 0): StructuredScan {
   526	  if (depth > STRUCTURE_DEPTH_BOUND || value === null || value === undefined) return NOTHING;
   527	
   528	  // The bare-string arm. `{"text": ["hello", {"type":"bold",...}]}` puts "hello" in an array element,
   529	  // under no key at all — the arm every key-based version of this walk returned early on.
   530	  if (typeof value === 'string') return { leaves: [{ text: value, mode: '' }], undecidable: false };
   531	  if (typeof value !== 'object') return NOTHING;
   532	  if (Array.isArray(value)) {
   533	    return mergeScans(value.map((v) => richTextScan(v, depth + 1)));
   534	  }
   535	
   536	  const type = (value as { type?: unknown }).type;
   537	  // An object with no string `type` is rejected by Telegram with 400 before anything renders. It cannot
   538	  // be a silent invisible send, and it must not be allowed to vouch for one either.
   539	  if (typeof type !== 'string') return NOTHING;
   540	  if (RICH_TEXT_RENDERS_NOTHING.has(type)) return NOTHING;
   541	  // A formula is opaque only when its own body carries content — the SAME test the markdown and html
   542	  // arms apply. Review pass 49 finding 2: that test was added there and not here, so `$\u200b$` written
   543	  // as markdown was refused while the identical formula written as a structured discriminator was
   544	  // allowed. Fifth instance this window of a repair applied to one representation of its own class.
   545	  if (type === 'mathematical_expression') return formulaScan((value as { expression?: unknown }).expression);
   546	  if (RICH_TEXT_OPAQUE.has(type)) return OPAQUE;
   547	  if (RICH_TEXT_NESTED_TEXT.has(type)) {
   548	    return richTextScan((value as { text?: unknown }).text, depth + 1);
   549	  }
   550	  // An unsupported discriminator is a 400 from Telegram's parser — a loud failure, not a silent one.
   551	  return NOTHING;
   552	}
   553	
   554	/** A PageBlockCaption is `{text, credit}`, both RichText. Nothing else in it is read. */
   555	function captionScan(value: unknown, depth: number): StructuredScan {
   556	  if (depth > STRUCTURE_DEPTH_BOUND || value === null || typeof value !== 'object') return NOTHING;
   557	  const obj = value as Record<string, unknown>;
   558	  return mergeScans([richTextScan(obj.text, depth + 1), richTextScan(obj.credit, depth + 1)]);
   559	}
