   396	
   397	function mergeScans(parts: StructuredScan[]): StructuredScan {
   398	  const leaves: StructuredLeaf[] = [];
   399	  let undecidable = false;
   400	  for (const p of parts) {
   401	    leaves.push(...p.leaves);
   402	    undecidable = undecidable || p.undecidable;
