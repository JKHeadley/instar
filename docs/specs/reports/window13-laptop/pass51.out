   251	    /** The egress door refused a Bot API method nobody has classified (pass 36 finding 3). */
   252	    | 'unclassified-method'
   253	    /** The egress door could not read the request's parameters, so it could not decide (pass 36 finding 1). */
   254	    | 'unreadable-request';
   255	  /** Length only. The payload is invisible, but it is still user content and is never logged. */
   256	  valueLength: number;
   257	  /** The predicate is engine-resolved, so the engine is part of the decision (see multi-machine posture). */
   258	  engine: string;
   259	  unicode: string;
   260	}
   261	
   262	/** Error type carrying the structured decision, so a caller that catches can record it as well. */
   263	export class InvisiblePayloadRefusedError extends Error {
   264	  readonly decision: InvisiblePayloadRefusal;
   265	  constructor(message: string, decision: InvisiblePayloadRefusal) {
   266	    super(message);
   267	    this.name = 'InvisiblePayloadRefusedError';
   268	    this.decision = decision;
   269	  }
   270	}
   271	
   272	/**
   273	 * Where refusal decisions are emitted. Defaults to one structured line on stderr.
   274	 *
   275	 * `docs/signal-vs-authority.md` is explicit: *"Authorities must log their decisions in a structured form:
   276	 * which signals they received, what the conversation context was, which rule they applied, and what the
   277	 * outcome was. This is how over-blocks and under-blocks become detectable instead of just frustrating."*
   278	 * This guard IS blocking authority, and it logged nothing — raised at convergence round 4, not acted on,
   279	 * and raised again at round 11. Seeing a finding and not acting on it is worse than not seeing it.
   280	 *
   281	 * A console sink rather than a file sink deliberately: this function is called from CLI commands and setup
   282	 * wizards as well as the server, and a shared pure module that opens a log file on a CLI path would be a
   283	 * worse defect than the one it fixes. Injectable so a host with a real audit trail can route it there.
   284	 */
   285	let refusalSink: (decision: InvisiblePayloadRefusal) => void = (decision) => {
   286	  console.warn(`[invisible-payload] ${JSON.stringify(decision)}`);
   287	};
   288	
   289	/** Route refusal decisions to a host-provided audit trail. Returns the previous sink. */
   290	/**
   291	 * Record a refusal that did NOT come from the predicate — the egress door's own "I cannot decide"
   292	 * cases. Review pass 37 finding 6: those threw bare errors, so the one refusal class that means
   293	 * "something is here I do not understand" was the only one invisible to the decision stream, while
   294	 * tests and the spec both claimed every refusal is recorded.
   295	 */
   296	export function emitInvisiblePayloadRefusal(decision: InvisiblePayloadRefusal): void {
   297	  try { refusalSink(decision); } catch { /* a broken sink never becomes a delivery */ }
   298	}
   299	
   300	export function setInvisiblePayloadRefusalSink(
   301	  sink: (decision: InvisiblePayloadRefusal) => void,
   302	): (decision: InvisiblePayloadRefusal) => void {
   303	  const previous = refusalSink;
   304	  refusalSink = sink;
   305	  return previous;
   306	}
   307	
   308	/**
   309	 * What a READER actually receives, given a Telegram parse mode.
   310	 *
   311	 * Review pass 33 finding 1, proven by execution before repair: the guard ran on the PRE-FORMAT source
   312	 * while the formatter then changed the representation. A payload whose only content characters sat in a
   313	 * link DESTINATION passed — `[<zero-width>](https://example.com/x)` — and went on the wire as
   314	 * `<a href="https://example.com/x">\u200b</a>` with `parse_mode: HTML`. Tags stripped, the reader
   315	 * received one zero-width space. The original incident's exact harm, through the one door nobody had
   316	 * looked at, inside the guard built to close that harm.
   317	 *
   318	 * The reasoning that failed is worth naming: "the source contains a visible code point, therefore the
   319	 * reader receives content" does not survive a representation change. Whatever transforms the message
   320	 * last is what decides what a reader sees.
   321	 *
   322	 * This extraction is DELIBERATELY SMALLER than a renderer, and review pass 35 is why. An earlier version
   323	 * grew toward modelling Telegram's two parsers — decoding character references, consuming emphasis
   324	 * delimiters — and every approximation error became an OVER-refusal: `~` is not a delimiter in legacy
   325	 * Markdown, and `zwnj`/`nbsp`/`shy`/`apos` are not entities Telegram's HTML mode resolves, so payloads
   326	 * whose visible content was literal punctuation were being judged empty. An over-refusal destroys a real
   327	 * message. Rather than chase a parser with regexes, this keeps only the two transforms that are true of
   328	 * Telegram's rendering when the markup is VALID — and that qualification is load-bearing, because
   329	 * review pass 36 finding 5 showed the previous sentence ("without qualification") was false:
   330	 *
   331	 *   HTML     — a tag is markup; its attributes are never shown.
   332	 *   Markdown — a link displays its LABEL; the destination is not shown.
   333	 *
   334	 * KNOWN OVER-REFUSAL, named rather than discovered (pass 36 finding 5). The HTML branch strips every
   335	 * TAG-SHAPED substring without establishing that Telegram would accept it as a tag. If a payload
   336	 * carries malformed or unsupported tag-shaped text — which a reader WOULD see, because Telegram
   337	 * rejects the parse and falls back to sending the source — plus one invisible text node, the
   338	 * extraction is non-empty and invisible, so this refuses a message that would have been readable.
   339	 * The refusal is terminal, so that message is lost rather than downgraded.
   340	 *
   341	 * It is not fixed here for the same reason the under-refusals below are not: deciding it requires
   342	 * Telegram's own parse result, and every regex approximation of that parser has produced errors in
   343	 * BOTH directions (passes 34, 35, 36). It rides CMT-1260 with them.
   344	 *
   345	 * KNOWN UNDER-REFUSALS, accepted deliberately. A character reference (`&#8203;`) is counted as its
   346	 * SOURCE characters, so a payload made only of encoded invisibles passes. Emphasis delimiters count as
   347	 * content, so `*\u200b*` passes. Each is a payload that reaches a reader as nothing — the very harm this
   348	 * file exists to prevent — and each is allowed anyway, because refusing them requires a rendering model
   349	 * this code cannot supply, and a wrong model destroys real messages in the other direction. Closing them
   350	 * needs Telegram's own parse result, not a better regex. Tracked as CMT-1260.
   351	 */
   352	export function readerVisibleText(text: string, parseMode?: unknown): string {
   353	  const mode = typeof parseMode === 'string' ? parseMode.toLowerCase() : '';
   354	  if (mode === 'html') {
   355	    return text.replace(/<[^>]*>/g, '');
   356	  }
   357	  if (mode === 'markdown' || mode === 'markdownv2') {
   358	    // The optional `!` is IMAGE syntax, not content. Without it the reduction left a bare bang behind,
   359	    // and one visible-looking character is all this check needs to be talked out of a refusal — an
   360	    // image whose destination carried the payload passed on the strength of its own punctuation.
   361	    // Found by writing the negative control for pass 48 finding 2, not by a reading.
   362	    return text.replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1');
   363	  }
   364	  return text;
   365	}
   366	
   367	/**
   368	 * The post-format check: what is about to go on the wire must still carry content once rendered.
   369	 *
   370	 * NOTE (review pass 36 finding 6): this WAS a second call beside a pre-format one in both funnels.
   371	 * Those were removed when the egress door landed — execution showed the door refuses every payload
   372	 * they caught, and two copies of one case mask each other's tests. The paragraph below describes the
   373	 * historical pairing and is kept for the reasoning, not as a description of the current call graph.
   374	 * The only surviving pre-format call is the tokenless-relay guard, which the door cannot reach.
   375	 *
   376	 * They close
   377	 * different cases — the first refuses a payload that never had content, the second refuses one whose
   378	 * content stopped being reader-visible when the representation changed — and each is proven to red on
   379	 * its own.
   380	 */
   381	type StructuredLeaf = { text: string; mode: string };
   382	
   383	/**
   384	 * The result of reading a structured field. `leaves` are the literals Telegram will actually render.
   385	 * `undecidable` means the structure carries content this guard cannot inspect — a photograph, a custom
   386	 * emoji, a LaTeX formula — so ABSENCE of a visible leaf no longer proves the reader receives nothing.
   387	 *
   388	 * The two are separate on purpose. Collapsing "I found nothing" into "there is nothing" is what makes a
   389	 * guard refuse a valid photo message, and collapsing "I cannot read this" into "this is visible" is what
   390	 * lets an invisible one through. Neither collapse is available here.
   391	 */
   392	type StructuredScan = { leaves: StructuredLeaf[]; undecidable: boolean };
   393	
   394	const NOTHING: StructuredScan = { leaves: [], undecidable: false };
   395	const OPAQUE: StructuredScan = { leaves: [], undecidable: true };
   396	
   397	function mergeScans(parts: StructuredScan[]): StructuredScan {
   398	  const leaves: StructuredLeaf[] = [];
   399	  let undecidable = false;
   400	  for (const p of parts) {
   401	    leaves.push(...p.leaves);
   402	    undecidable = undecidable || p.undecidable;
   403	  }
   404	  return { leaves, undecidable };
   405	}
   406	
   407	/**
   408	 * RichText variants that carry their rendered content in a nested `text` (itself a RichText).
   409	 *
   410	 * Every other member of such an object is DISCARDED by Telegram, which is the whole point of this table:
   411	 * a `url` variant renders its `text` and uses `url` only as the destination, so a walk must descend
   412	 * `text` and nothing else.
   413	 */
   414	const RICH_TEXT_NESTED_TEXT: ReadonlySet<string> = new Set([
   415	  'bold', 'italic', 'underline', 'strikethrough', 'spoiler', 'date_time', 'mention', 'hashtag',
   416	  'cashtag', 'bot_command', 'code', 'text_mention', 'url', 'email_address', 'bank_card_number',
   417	  'subscript', 'superscript', 'marked', 'phone_number', 'reference', 'reference_link', 'anchor_link',
   418	]);
   419	
   420	/** RichText variants that render content this guard cannot read from the request. */
   421	const RICH_TEXT_OPAQUE: ReadonlySet<string> = new Set(['custom_emoji', 'mathematical_expression']);
   422	
   423	/** RichText variants that render NOTHING. `anchor` consumes only `name`, a jump target. */
   424	const RICH_TEXT_RENDERS_NOTHING: ReadonlySet<string> = new Set(['anchor']);
   425	
   426	/** Block variants and the RichText-valued fields Telegram reads from each. */
   427	const BLOCK_RICH_TEXT_FIELDS: Readonly<Record<string, readonly string[]>> = {
   428	  heading: ['text'],
   429	  paragraph: ['text'],
   430	  pre: ['text'],
   431	  footer: ['text'],
   432	  thinking: ['text'],
   433	  pullquote: ['text', 'credit'],
   434	  blockquote: ['credit'],
   435	  details: ['summary'],
   436	  table: ['caption'],
   437	};
   438	
   439	/** Block variants whose children are themselves blocks, and the field holding them. */
   440	const BLOCK_CHILD_BLOCK_FIELDS: Readonly<Record<string, readonly string[]>> = {
   441	  blockquote: ['blocks'],
   442	  collage: ['blocks'],
   443	  slideshow: ['blocks'],
   444	  details: ['blocks'],
   445	};
   446	
   447	/** Block variants carrying a PageBlockCaption (`{text, credit}`, both RichText). */
   448	const BLOCK_CAPTION_VARIANTS: ReadonlySet<string> = new Set([
   449	  'collage', 'slideshow', 'map', 'animation', 'audio', 'photo', 'video', 'voice_note',
   450	]);
   451	
   452	/**
   453	 * Block variants that render something unreadable here — media, a map, a formula, a rule.
   454	 *
   455	 * `divider` is here and NOT below, per review pass 48. The first version of this table called a divider
   456	 * non-rendering alongside an anchor; the API defines it as a rule corresponding to `<hr/>`, which a
   457	 * reader sees. The runtime outcome happened to be the same either way, which is exactly why it was worth
   458	 * fixing: the stated-open work of refusing a structure PROVEN to render nothing depends on this
   459	 * distinction meaning what it says, and a false member would have made that repair silently wrong.
   460	 */
   461	const BLOCK_OPAQUE: ReadonlySet<string> = new Set([
   462	  'mathematical_expression', 'map', 'animation', 'audio', 'photo', 'video', 'voice_note', 'divider',
   463	]);
   464	
   465	/** The one block variant that renders nothing: an anchor, which is a jump target. */
   466	const BLOCK_RENDERS_NOTHING: ReadonlySet<string> = new Set(['anchor']);
   467	
   468	// A cyclic or adversarial structure must terminate, but the bound is NOT a content limit — pass 46 found
   469	// 16 truncates real documents, since every wrapper adds a level and a list inside a table inside a
   470	// quotation reaches that quickly. Set well past any plausible document.
   471	const STRUCTURE_DEPTH_BOUND = 200;
   472	
   473	/**
   474	 * Read a RichText value, by Telegram's grammar rather than by key name.
   475	 *
   476	 * WHERE THIS TABLE COMES FROM, since the last four repairs all failed on this exact point. Not from my
   477	 * model of the API — that has an end date and was wrong twice in one day. Not from the prose reference —
   478	 * it truncated three times. It is transcribed from the Bot API server's own request parser, which is the
   479	 * code that decides what Telegram reads: `Client::get_rich_text`, `Client::get_input_page_block`,
   480	 * `Client::get_page_block_caption`, `Client::get_page_block_table_cell`, `Client::get_input_rich_message`.
   481	 *
   482	 * THE UNION: a bare STRING (the literal), an ARRAY (the sequence), or an OBJECT carrying a `type`
   483	 * discriminator. There is no `texts` key and no `richTextPlain` type value anywhere on the wire — those
   484	 * are internal class names, and a previous version of this file asserted them as the grammar.
   485	 *
   486	 * WHY THE PREVIOUS WALK WAS WRONG, and it is the same misunderstanding one level deeper rather than a new
   487	 * bug. It descended EVERY object-valued property. Telegram reads `type`, extracts only that variant's
   488	 * declared fields, and DISCARDS every other member:
   489	 *
   490	 *     { "type": "bold", "text": {"type":"anchor","name":"x"}, "caption": {"text":"LOOKS VISIBLE"} }
   491	 *
   492	 * `bold` consumes `text` alone. `caption` is discarded. The old walk found "LOOKS VISIBLE", called the
   493	 * payload visible, and allowed it — while the reader received an anchor, which renders as nothing. Three
   494	 * previous repairs answered a reviewer by adding a key name; a key name cannot fix a SHAPE.
   495	 *
   496	 * WHAT IS DELIBERATELY NOT COLLECTED: `url`, `email_address`, `phone_number`, `anchor_name`, `name`. A
   497	 * link's DESTINATION is not what a reader sees — its label is, and the label is the nested `text`.
   498	 * Counting a destination as content is precisely how the original incident shipped: a payload whose only
   499	 * visible characters lived inside a URL. This now falls out of the table rather than being a rule applied
   500	 * beside it.
   501	 *
   502	 * A `mathematical_expression` is LaTeX SOURCE. Its source characters are not its rendered glyphs — a
   503	 * spacing-only expression is all letters and paints nothing — so it is marked OPAQUE rather than counted
   504	 * as visible. That is the honest position: this guard cannot decide a formula, it can only decline to let
   505	 * one vouch for an otherwise-invisible message.
   506	 */
   507	/**
   508	 * A formula, judged the one way this guard honestly can.
   509	 *
   510	 * ONE definition, used by all three representations — the markdown arm, the html arm, and the explicit
   511	 * structured discriminator at both inline and block level. It exists as a function rather than three
   512	 * matching lines because the last five repairs in this file were each applied to one representation of
   513	 * a class and not its siblings, and a shared definition is the only version of "swept" that cannot
   514	 * rot back apart.
   515	 *
   516	 * A formula body carrying content is UNDECIDABLE: its characters are LaTeX instructions, so this cannot
   517	 * tell whether they paint a glyph, and refusing would destroy real formula messages. A body carrying no
   518	 * content renders nothing and is DECIDED — it must not vouch for the message around it.
   519	 */
   520	function formulaScan(expression: unknown): StructuredScan {
   521	  if (typeof expression !== 'string') return NOTHING;
   522	  return hasNoVisibleCharacters(expression) ? NOTHING : OPAQUE;
   523	}
   524	
   525	function richTextScan(value: unknown, depth = 0): StructuredScan {
   526	  if (depth > STRUCTURE_DEPTH_BOUND || value === null || value === undefined) return NOTHING;
   527	
   528	  // The bare-string arm. `{"text": ["hello", {"type":"bold",...}]}` puts "hello" in an array element,
   529	  // under no key at all — the arm every key-based version of this walk returned early on.
   530	  if (typeof value === 'string') return { leaves: [{ text: value, mode: '' }], undecidable: false };
   531	  if (typeof value !== 'object') return NOTHING;
   532	  if (Array.isArray(value)) {
   533	    return mergeScans(value.map((v) => richTextScan(v, depth + 1)));
   534	  }
   535	
   536	  const type = (value as { type?: unknown }).type;
   537	  // An object with no string `type` is rejected by Telegram with 400 before anything renders. It cannot
   538	  // be a silent invisible send, and it must not be allowed to vouch for one either.
   539	  if (typeof type !== 'string') return NOTHING;
   540	  if (RICH_TEXT_RENDERS_NOTHING.has(type)) return NOTHING;
   541	  // A formula is opaque only when its own body carries content — the SAME test the markdown and html
   542	  // arms apply. Review pass 49 finding 2: that test was added there and not here, so `$\u200b$` written
   543	  // as markdown was refused while the identical formula written as a structured discriminator was
   544	  // allowed. Fifth instance this window of a repair applied to one representation of its own class.
   545	  if (type === 'mathematical_expression') return formulaScan((value as { expression?: unknown }).expression);
   546	  if (RICH_TEXT_OPAQUE.has(type)) return OPAQUE;
   547	  if (RICH_TEXT_NESTED_TEXT.has(type)) {
   548	    return richTextScan((value as { text?: unknown }).text, depth + 1);
   549	  }
   550	  // An unsupported discriminator is a 400 from Telegram's parser — a loud failure, not a silent one.
   551	  return NOTHING;
   552	}
   553	
   554	/** A PageBlockCaption is `{text, credit}`, both RichText. Nothing else in it is read. */
   555	function captionScan(value: unknown, depth: number): StructuredScan {
   556	  if (depth > STRUCTURE_DEPTH_BOUND || value === null || typeof value !== 'object') return NOTHING;
   557	  const obj = value as Record<string, unknown>;
   558	  return mergeScans([richTextScan(obj.text, depth + 1), richTextScan(obj.credit, depth + 1)]);
   559	}
   560	
   561	/** A block-level element, read by its own `type` discriminator. */
   562	function blockScan(value: unknown, depth = 0): StructuredScan {
   563	  if (depth > STRUCTURE_DEPTH_BOUND || value === null) return NOTHING;
   564	  if (Array.isArray(value)) return mergeScans(value.map((v) => blockScan(v, depth + 1)));
   565	  if (typeof value !== 'object') return NOTHING;
   566	
   567	  const obj = value as Record<string, unknown>;
   568	  const type = obj.type;
   569	  if (typeof type !== 'string') return NOTHING;
   570	  if (BLOCK_RENDERS_NOTHING.has(type)) return NOTHING;
   571	
   572	  const parts: StructuredScan[] = [];
   573	  // A media block, a map or a formula RENDERS — the message is not arriving as nothing — but what it
   574	  // renders cannot be inspected here. Its caption is still read, because a caption that is present and
   575	  // invisible is worth knowing about even when the block itself carries the message.
   576	  // Same as the inline layer: a formula vouches only if its own body carries content. Everything else
   577	  // in BLOCK_OPAQUE renders something whose content genuinely cannot be read from the request.
   578	  if (type === 'mathematical_expression') parts.push(formulaScan(obj.expression));
   579	  else if (BLOCK_OPAQUE.has(type)) parts.push(OPAQUE);
   580	  for (const field of BLOCK_RICH_TEXT_FIELDS[type] ?? []) parts.push(richTextScan(obj[field], depth + 1));
   581	  for (const field of BLOCK_CHILD_BLOCK_FIELDS[type] ?? []) parts.push(blockScan(obj[field], depth + 1));
   582	  if (BLOCK_CAPTION_VARIANTS.has(type)) parts.push(captionScan(obj.caption, depth + 1));
   583	  if (type === 'list') {
   584	    const items = obj.items;
   585	    if (Array.isArray(items)) {
   586	      for (const item of items) {
   587	        if (item !== null && typeof item === 'object') {
   588	          parts.push(blockScan((item as Record<string, unknown>).blocks, depth + 1));
   589	        }
   590	      }
   591	    }
   592	  }
   593	  if (type === 'table') {
   594	    const rows = obj.cells;
   595	    if (Array.isArray(rows)) {
   596	      for (const row of rows) {
   597	        if (!Array.isArray(row)) continue;
   598	        for (const cell of row) {
   599	          if (cell !== null && typeof cell === 'object') {
   600	            parts.push(richTextScan((cell as Record<string, unknown>).text, depth + 1));
   601	          }
   602	        }
   603	      }
   604	    }
   605	  }
   606	  // An unsupported block type is a 400 before render; it contributes nothing either way.
   607	  return mergeScans(parts);
   608	}
   609	
   610	/**
   611	 * Read a structured reader-visible field — in practice the rich-message container.
   612	 *
   613	 * THE CONTAINER IS A PRIORITY UNION, not a merge, and this is a bypass I found by reading the parser
   614	 * rather than one a reading handed me. Telegram takes `blocks` if the object has it, ELSE `markdown`,
   615	 * ELSE `html`, and ignores the others entirely. The previous walk collected all three, so a container
   616	 * pairing invisible `blocks` with a visible `html` sibling read as visible here and rendered as nothing
   617	 * there. Same shape as the discriminator bug, one layer up.
   618	 *
   619	 * `media` is read only on the markdown and html arms — and its PRESENCE proves nothing. The API defines
   620	 * the array as "media that ARE SPECIFIED IN the markdown or html fields using `tg://photo?id=`,
   621	 * `tg://video?id=` and `tg://audio?id=` links", so an entry is a declaration the source must reference
   622	 * by id in order for anything to render. Review pass 48 caught the first version of this treating any
   623	 * non-empty array as proof — which recreated the discarded-member-vouching defect one layer ABOVE the
   624	 * discriminator table, in the very increment that closed it below. It is now a reference check.
   625	 */
   626	
   627	/**
   628	 * Formula regions in a rich markdown or html source. Their content is raw LaTeX, so its characters are
   629	 * not its glyphs — a spacing-only expression is all letters and paints nothing.
   630	 *
   631	 * Pass 48 finding 1: the OPAQUE treatment reached only the explicit `mathematical_expression` block, so
   632	 * the same formula written in the markdown or html arm still had its SOURCE counted as visible content.
   633	 * One repair, one of three representations — the sweep failure this window has now recorded four times.
   634	 *
   635	 * Syntax from the live Bot API reference: markdown carries `$inline$`, `$$block$$` and a ```math fence;
   636	 * html carries `<tg-math>`.
   637	 */
   638	// Each alternative CAPTURES its body, because the delimiters are not the formula. Testing the whole
   639	// region for content counted `$`, `` ` `` and the tag name itself — so every formula looked renderable
   640	// and the empty-formula case slipped straight back through. Caught by running the control, not by
   641	// reading the regex.
   642	const MARKDOWN_FORMULA = /\$\$([\s\S]*?)\$\$|```math([\s\S]*?)```|\$([^$\n]*)\$/g;
   643	const HTML_FORMULA = /<tg-math\b[^>]*>([\s\S]*?)<\/tg-math>/gi;
   644	
   645	/**
   646	 * Does the source actually put MEDIA in front of a reader? Two documented ways, and the difference
   647	 * between them is the whole of pass 48 finding 2.
   648	 *
   649	 *   A DIRECT url — `![](https://…/photo.jpg)` in markdown, `<img src="https://…">` in html. The API
   650	 *   says media blocks support HTTP and HTTPS URLs, so this renders on its own and declares nothing.
   651	 *
   652	 *   A DECLARED entry, referenced by id — `tg://photo?id=<id>`, `tg://video?id=<id>`, `tg://audio?id=<id>`.
   653	 *   Here the `media` array is the declaration and the SOURCE is the reference. An entry nobody
   654	 *   references renders nothing, and a reference to an id nobody declared renders nothing either. Only
   655	 *   the pair is content.
   656	 *
   657	 * A custom emoji is media too — `tg://emoji?id=` in either arm — and needs no declaration.
   658	 */
   659	const DIRECT_MEDIA_URL = /!\[[^\]]*\]\(\s*https?:\/\/[^)]*\)|<img\b[^>]*\bsrc\s*=\s*["']https?:\/\/[^"']*["']/i;
   660	const EMOJI_MEDIA = /!\[[^\]]*\]\(\s*tg:\/\/emoji\?id=[^)]*\)|<(?:img|tg-emoji)\b[^>]*tg:\/\/emoji\?id=[^>]*>|<tg-emoji\b[^>]*\bemoji-id\s*=/i;
   661	
   662	/**
   663	 * A media reference must sit in an EMBEDDING POSITION, not merely appear in the source.
   664	 *
   665	 * Review pass 50: the first version matched the bare `tg://photo?id=<id>` URL anywhere in the text, so a
   666	 * mention of that URL — in a paragraph, inside an invisible run, in a code span — counted as rendered
   667	 * media and waived the refusal for a message that renders nothing.
   668	 *
   669	 * Worth recording that I half-saw this. When writing it I judged a plain substring match too weak
   670	 * BECAUSE an attacker controls the source and could plant the id in invisible text, tightened it to a
