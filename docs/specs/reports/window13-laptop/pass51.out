  1062	      console.log(`[Lifeline] [poll-follows-lease] would ${action} polling (intent=${intentShouldPoll}, currentlyPolling=${this.polling}, dry-run)`);
  1063	      return;
  1064	    }
  1065	    // LIVE (dryRun:false) — apply. STOP is immediate; START flushes first.
  1066	    if (action === 'stop') {
