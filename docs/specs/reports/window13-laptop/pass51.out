   386	  /**
   387	   * Start the lifeline — begins Telegram polling and server supervision.
   388	   */
   389	  async start(): Promise<void> {
   390	    // Global safety net — the lifeline MUST NOT crash from non-fatal errors.
   391	    // A dead lifeline = permanently unreachable agent. ELOCKED from the agent
   392	    // registry is the most common culprit (concurrent lock contention).
   393	    process.on('uncaughtException', (err) => {
   394	      const msg = err instanceof Error ? err.message : String(err);
   395	      const code = (err as NodeJS.ErrnoException).code;
   396	      if (code === 'ELOCKED' || msg.includes('ELOCKED') || msg.includes('Lock file is already being held')) {
   397	        console.error(`[Lifeline] Caught uncaught ELOCKED — suppressing to keep lifeline alive: ${msg}`);
   398	        return; // Swallow — registry lock contention is never fatal
   399	      }
   400	      // For other uncaught exceptions, log but don't crash
   401	      console.error(`[Lifeline] Uncaught exception (non-fatal): ${msg}`);
   402	      if (err instanceof Error && err.stack) {
   403	        console.error(err.stack);
   404	      }
   405	    });
   406	    process.on('unhandledRejection', (reason) => {
   407	      const msg = reason instanceof Error ? reason.message : String(reason);
   408	      if (msg.includes('ELOCKED') || msg.includes('Lock file is already being held')) {
   409	        console.error(`[Lifeline] Caught unhandled ELOCKED rejection — suppressing: ${msg}`);
   410	        return;
   411	      }
   412	      console.error(`[Lifeline] Unhandled rejection (non-fatal): ${msg}`);
   413	    });
   414	
   415	    console.log(pc.bold(`Starting Telegram Lifeline for ${pc.cyan(this.projectConfig.projectName)}`));
   416	    console.log(`  Port: ${this.projectConfig.port}`);
   417	    console.log(`  State: ${this.projectConfig.stateDir}`);
   418	    console.log(`  Version: ${this.lifelineVersion}`);
