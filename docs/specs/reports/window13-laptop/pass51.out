   462	  // F2 (pass 40): the door read `init.body`, checked THAT value, and then handed the caller's original
   463	  // mutable object to `fetch`. A getter, or any mutation between the read and the send, could show
   464	  // visible content to the check and different content to the network — which falsifies the claim this
   465	  // file makes about checking the exact bytes that go on the wire.
   466	  //
   467	  // So send a request built from the body that was actually inspected. `checkedBody` is read once,
   468	  // above, and reused here; the caller's object can no longer decide what leaves.
   469	  // Build the outgoing init EXPLICITLY, SKIPPING `body`. Spreading `init` re-reads `body` — object
   470	  // spread invokes own getters — which is a SECOND read (pass 42).
   471	  //
   472	  // This paragraph claimed that repair for two passes while the line below it still spread `init`. The
   473	  // OUTCOME was safe, because the spread's value was immediately overwritten by the captured one, so no
   474	  // reading caught it by testing what gets sent. What was false was the claim: the comment said the
   475	  // spread had been replaced and it had not. Found by reading the code against its own description
   476	  // rather than by a reading — which is the only way this class is ever found, since every test of the
   477	  // sent bytes passes either way.
   478	  //
   479	  // A second read is not harmless even when discarded: a getter with side effects runs twice, and the
   480	  // next person to write `outgoing.body = x ?? init.body` inherits a hole the comment promised was shut.
   481	  const outgoing: RequestInit = {};
   482	  for (const key of Object.keys(init)) {
   483	    if (key === 'body') continue;
   484	    (outgoing as Record<string, unknown>)[key] = (init as Record<string, unknown>)[key];
   485	  }
   486	  outgoing.body = checkedBody ?? null;
   487	  return fetch(href, outgoing);
   488	}

