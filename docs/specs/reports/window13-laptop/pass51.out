  5859	/**
  5860	 * The summary/description blocks of an attention-item post, WITHOUT the
  5861	 * duplicated paragraph. Episode renderers (machine-coherence, rope probe)
  5862	 * conventionally build `description` as `${summary}\n\n${...}` — rendering
  5863	 * both repeated the same paragraph twice in every hub post (the 2026-07-11
  5864	 * attention-hub duplication bug). When description starts with summary (or
  5865	 * there is no description), exactly one copy renders. Pure for testability;
  5866	 * blocks are UNESCAPED — the caller escapes each before splicing into HTML.
  5867	 */
  5868	export function attentionBodyBlocks(
  5869	  summary: string | null | undefined,
  5870	  description: string | null | undefined,
  5871	  descriptionSlice: number,
  5872	): string[] {
  5873	  const s = (summary ?? '').trim();
  5874	  const d = (description ?? '').trim();
  5875	  if (!d) return s ? [s] : [];
  5876	  const dSliced = d.slice(0, descriptionSlice);
  5877	  if (s && d.startsWith(s)) return [dSliced];
  5878	  // Leading \n preserves the original blank-line separation when joined by '\n'.
  5879	  return s ? [s, `\n${dSliced}`] : [dSliced];
  5880	}
  5881	
  5882	/**
  5883	 * Shared formatter wire-up used by both TelegramAdapter.apiCall and
  5884	 * TelegramLifeline.apiCall. Pure function for testability.
  5885	 *
  5886	 * For non-send methods, or when mode is undefined / `'legacy-passthrough'`,
  5887	 * returns params unchanged. For `sendMessage` / `editMessageText` in a
  5888	 * formatting mode, runs the formatter on `params.text` and overrides
  5889	 * `params.parse_mode` with the formatter's output.
  5890	 *
  5891	 * Callers may opt out per-call by passing `params._isPlainRetry = true`
  5892	 * (internal flag for the 400 retry path).
  5893	 */
  5894	export function applyTelegramFormatter(
  5895	  method: string,
  5896	  params: Record<string, unknown>,
  5897	  configMode: FormatMode | undefined,
  5898	): {
  5899	  outgoingParams: Record<string, unknown>;
  5900	  originalParams: Record<string, unknown>;
  5901	  didFormat: boolean;
  5902	  isPlainRetry: boolean;
  5903	} {
  5904	  const isPlainRetry = (params as { _isPlainRetry?: boolean })._isPlainRetry === true;
  5905	  // Per-call mode override — internal callers that already produce Telegram
  5906	  // HTML (e.g. the attention-queue creator) tag their send with
  5907	  // `_formatMode: 'html'` so the formatter's markdown converter does not
  5908	  // re-process their bytes. Spec: trusted-internal-callers list.
  5909	  const callerMode = (params as { _formatMode?: FormatMode })._formatMode;
  5910	  // Strip internal flags before sending to Bot API.
  5911	  const stripped: Record<string, unknown> = { ...params };
  5912	  delete (stripped as { _isPlainRetry?: boolean })._isPlainRetry;
  5913	  delete (stripped as { _idempotencyKey?: unknown })._idempotencyKey;
  5914	  delete (stripped as { _formatMode?: FormatMode })._formatMode;
  5915	
  5916	  const isSendMethod = method === 'sendMessage' || method === 'editMessageText';
  5917	  // Default 'markdown' (post-cutover): unformatted GitHub-flavored markdown
  5918	  // → Telegram HTML on every outbound send. Agents that need to roll back
  5919	  // set `telegramFormatMode: 'legacy-passthrough'` in `.instar/config.json`.
  5920	  const mode: FormatMode = callerMode ?? configMode ?? 'markdown';
  5921	
  5922	  if (
  5923	    !isSendMethod ||
  5924	    mode === 'legacy-passthrough' ||
  5925	    isPlainRetry ||
  5926	    typeof stripped.text !== 'string'
  5927	  ) {
  5928	    return {
  5929	      outgoingParams: stripped,
  5930	      originalParams: params,
  5931	      didFormat: false,
  5932	      isPlainRetry,
  5933	    };
  5934	  }
  5935	
  5936	  const result = formatForTelegram(stripped.text as string, mode);
  5937	  recordFormatApplied(result.modeApplied);
  5938	  for (const issue of result.lintIssues) {
  5939	    recordFormatLintIssue(issue);
  5940	  }
  5941	  const outgoing: Record<string, unknown> = { ...stripped, text: result.text };
  5942	  if (result.parseMode !== undefined) {
  5943	    outgoing.parse_mode = result.parseMode;
  5944	  } else {
  5945	    // legacy-passthrough returns parseMode undefined; fall back to caller's
  5946	    // explicit parse_mode if any (preserved above via ...stripped).
  5947	  }
  5948	  return {
  5949	    outgoingParams: outgoing,
  5950	    originalParams: params,
  5951	    didFormat: true,
  5952	    isPlainRetry: false,
  5953	  };
  5954	}

