  5308	
  5309	  // ── Prompt Gate: Telegram Relay ───────────────────────────────────
  5310	
  5311	  /**
  5312	   * Relay a detected prompt to a Telegram topic with inline keyboard buttons.
  5313	   * For prompts with options: sends buttons. For questions: sends text asking for reply.
  5314	   * Returns the Telegram message ID of the relay message.
  5315	   */
  5316	  async relayPrompt(topicId: number, prompt: DetectedPrompt): Promise<number> {
  5317	    // First-use disclosure (once per topic)
  5318	    if (!this.promptGateDisclosureSent.has(topicId)) {
  5319	      await this.sendToTopic(topicId,
  5320	        'Prompt Gate is now active for this topic. Session prompts will appear here ' +
  5321	        'for you to respond to. Note: prompt text is sent through Telegram\'s servers. ' +
  5322	        'Avoid including credentials or sensitive data in your replies.'
  5323	      ).catch(() => {});
  5324	      this.promptGateDisclosureSent.add(topicId);
  5325	    }
  5326	
  5327	    const text = this.formatPromptMessage(prompt);
  5328	
  5329	    let result: { message_id: number };
  5330	
  5331	    if (prompt.options && prompt.options.length > 0) {
  5332	      // Add numbered options to the message body so full text is visible.
  5333	      // Labels are user content — HTML-escape since this whole message goes
  5334	      // through `_formatMode: 'html'` (formatPromptMessage emits HTML).
  5335	      const optionLines = prompt.options
  5336	        .map((opt, i) => `${i + 1}. ${this.escapeHtml(opt.label)}`)
  5337	        .join('\n');
  5338	      const fullText = `${text}\n\n${optionLines}`;
  5339	
  5340	      // Build inline keyboard buttons with just the number/key (compact)
  5341	      const keyboard = prompt.options.map((opt, i) => {
  5342	        const token = this.callbackRegistry.register({
  5343	          sessionName: prompt.sessionName,
  5344	          promptId: prompt.id,
  5345	          key: opt.key,
  5346	        });
  5347	        return {
  5348	          text: String(i + 1),
  5349	          callback_data: JSON.stringify({ id: token }),
  5350	        };
  5351	      });
  5352	
  5353	      // All buttons in a single row (they're just numbers now)
  5354	      result = await this.apiCall('sendMessage', {
  5355	        chat_id: this.config.chatId,
  5356	        message_thread_id: isGeneralTopic(topicId) ? undefined : topicId,
  5357	        text: fullText,
  5358	        reply_markup: { inline_keyboard: [keyboard] },
  5359	        parse_mode: 'HTML',
  5360	        _formatMode: 'html',
  5361	      }) as { message_id: number };
  5362	    } else {
  5363	      // No options — text reply expected (clarifying question)
  5364	      result = await this.apiCall('sendMessage', {
  5365	        chat_id: this.config.chatId,
  5366	        message_thread_id: isGeneralTopic(topicId) ? undefined : topicId,
  5367	        text,
  5368	        parse_mode: 'HTML',
  5369	        _formatMode: 'html',
  5370	      }) as { message_id: number };
  5371	    }
  5372	
  5373	    // Track pending reply for text-input prompts
  5374	    this.pendingPromptReply.set(topicId, {
  5375	      prompt,
  5376	      relayMessageId: result.message_id,
  5377	      createdAt: Date.now(),
  5378	    });
  5379	
  5380	    // Notify session manager to extend idle timeout (relay lease)
  5381	    if (this.onRelayLeaseStart) {
  5382	      this.onRelayLeaseStart(prompt.sessionName);
  5383	    }
  5384	
  5385	    console.log(`[prompt-gate] Relayed ${prompt.type} prompt to topic ${topicId} (msg ${result.message_id})`);
  5386	    return result.message_id;
  5387	  }
  5388	
  5389	  /**
  5390	   * Format a detected prompt into a Telegram HTML message body.
  5391	   */
  5392	  private formatPromptMessage(prompt: DetectedPrompt): string {
  5393	    // HTML output — caller sets `_formatMode: 'html'` so the markdown converter
  5394	    // does not re-process this. Summary is HTML-escaped to neutralize any user-
  5395	    // supplied `<`, `&`, etc.; markdown tokens in the summary stay literal.
  5396	    const escapedSummary = this.escapeHtml(prompt.summary);
  5397	
  5398	    switch (prompt.type) {
  5399	      case 'permission':
  5400	        return `\u{23F3} <b>Your agent is waiting — approve or decline:</b>\n\n"${escapedSummary}"`;
  5401	      case 'plan':
  5402	        return `\u{23F3} <b>Agent plan ready — do you want to proceed?</b>\n\n"${escapedSummary}"`;
  5403	      case 'question':
  5404	        return `\u{23F3} <b>Your agent has a question:</b>\n\n"${escapedSummary}"\n\nReply to this message with your answer.`;
  5405	      case 'confirmation':
  5406	        return `\u{23F3} <b>Your agent needs confirmation:</b>\n\n"${escapedSummary}"`;
  5407	      case 'selection':
  5408	        return `\u{23F3} <b>Your agent needs you to choose:</b>\n\n"${escapedSummary}"`;
  5409	      default:
  5410	        return `\u{23F3} <b>Session needs your input:</b>\n\n"${escapedSummary}"`;
  5411	    }
  5412	  }
  5413	
  5414	  /**
  5415	   * Handle a forwarded callback query from the Lifeline process.
  5416	   * In send-only mode the server doesn't poll for callbacks, so the
  5417	   * Lifeline forwards them via /internal/telegram-callback.
  5418	   */
  5419	  async handleForwardedCallback(query: any): Promise<void> {
  5420	    await this.processCallbackQuery(query);
  5421	  }
  5422	
  5423	  /**
  5424	   * Handle a Telegram callback query from an inline keyboard button press.
  5425	   */
  5426	  private async processCallbackQuery(query: NonNullable<TelegramUpdate['callback_query']>): Promise<void> {
  5427	    if (!query.data) {
  5428	      await this.apiCall('answerCallbackQuery', {
  5429	        callback_query_id: query.id,
  5430	        text: 'Invalid button data',
  5431	      }).catch(() => {});
  5432	      return;
  5433	    }
  5434	
  5435	    // ── Tunnel-consent buttons (separate, security-sensitive path) ────
  5436	    // callback_data shape: `tc:g:<nonce>` (grant) | `tc:d:<nonce>`
  5437	    // (decline). The owner-principal check is MANDATORY here — the
  5438	    // GPT external review's CRITICAL finding is that only the owner
  5439	    // may approve routing private traffic through a third-party relay.
  5440	    // We use getOwnerUserId() (the explicit owner principal), NOT the
  5441	    // broader authorizedUserIds set.
  5442	    if (query.data.startsWith('tc:')) {
  5443	      const owner = this.getOwnerUserId();
  5444	      if (owner && query.from.id !== owner) {
  5445	        await this.apiCall('answerCallbackQuery', {
  5446	          callback_query_id: query.id,
  5447	          text: 'Only the owner can approve this',
  5448	        }).catch(() => {});
  5449	        return; // do NOT consume — preserve for the real owner
  5450	      }
  5451	      const m = /^tc:([gd]):([0-9a-f]{32})$/.exec(query.data);
  5452	      if (!m) {
  5453	        await this.apiCall('answerCallbackQuery', {
  5454	          callback_query_id: query.id,
  5455	          text: 'Invalid consent button',
  5456	        }).catch(() => {});
  5457	        return;
  5458	      }
  5459	      const action: 'grant' | 'decline' = m[1] === 'g' ? 'grant' : 'decline';
  5460	      const nonce = m[2]!;
  5461	      let statusText = 'Got it';
  5462	      if (this.tunnelConsentHandler) {
  5463	        try {
  5464	          statusText = await this.tunnelConsentHandler(action, nonce);
  5465	        } catch {
  5466	          statusText = 'Could not process — try the dashboard';
  5467	        }
  5468	      }
  5469	      await this.apiCall('answerCallbackQuery', {
  5470	        callback_query_id: query.id,
  5471	        text: statusText,
  5472	      }).catch(() => {});
  5473	      // Clear the inline keyboard so the (now-consumed) button can't be
  5474	      // tapped again — the consent nonce is single-use on the manager
  5475	      // side, but removing the keyboard is the visible confirmation.
  5476	      // The prompt lives in the owner's private DM, so the edit must
  5477	      // target that chat — NOT config.chatId (the group/supergroup).
  5478	      if (query.message) {
  5479	        await this.editMessageWithRetry(
  5480	          query.message.message_id,
  5481	          action === 'grant' ? '✅ Backup approved.' : '❌ Backup declined.',
  5482	          3,
  5483	          query.message.chat?.id,
  5484	        ).catch(() => {});
  5485	      }
  5486	      return;
  5487	    }
  5488	
  5489	    // Authorization check: verify sender is the configured owner
  5490	    const ownerId = this.config.promptGate?.ownerId;
  5491	    if (ownerId && query.from.id !== ownerId) {
  5492	      await this.apiCall('answerCallbackQuery', {
  5493	        callback_query_id: query.id,
  5494	        text: 'Only the session owner can respond to prompts',
  5495	      }).catch(() => {});
  5496	      // Do NOT resolve the token — preserve it for the real owner
  5497	      return;
  5498	    }
  5499	
  5500	    // Parse callback data
  5501	    let tokenId: string;
  5502	    try {
  5503	      const data = JSON.parse(query.data);
  5504	      tokenId = data.id;
  5505	      if (!tokenId || typeof tokenId !== 'string') throw new Error('missing id');
  5506	    } catch {
  5507	      await this.apiCall('answerCallbackQuery', {
  5508	        callback_query_id: query.id,
  5509	        text: 'Invalid callback data',
  5510	      }).catch(() => {});
  5511	      return;
  5512	    }
  5513	
  5514	    // Resolve the token
  5515	    const context = this.callbackRegistry.resolve(tokenId);
  5516	
  5517	    if (!context) {
  5518	      // Stale button (server restarted, or entry pruned)
  5519	      await this.apiCall('answerCallbackQuery', {
  5520	        callback_query_id: query.id,
  5521	        text: 'Session expired \u2014 check the dashboard',
  5522	      }).catch(() => {});
  5523	      if (query.message) {
  5524	        await this.editMessageWithRetry(
  5525	          query.message.message_id,
  5526	          '\u274C Session expired before response received'
  5527	        );
  5528	      }
  5529	      return;
  5530	    }
  5531	
  5532	    // Validate the key against the allowlist
  5533	    if (!isAllowedButtonKey(context.key)) {
  5534	      console.warn(`[prompt-gate] Rejected non-allowlisted button key: ${context.key}`);
  5535	      await this.apiCall('answerCallbackQuery', {
  5536	        callback_query_id: query.id,
  5537	        text: 'Invalid response key',
  5538	      }).catch(() => {});
  5539	      return;
  5540	    }
  5541	
  5542	    // Answer the callback (removes loading spinner on button)
  5543	    await this.apiCall('answerCallbackQuery', {
  5544	      callback_query_id: query.id,
  5545	      text: 'Sent to session',
  5546	    }).catch(() => {});
  5547	
  5548	    // Update the message to show which option was chosen
  5549	    if (query.message) {
  5550	      await this.editMessageWithRetry(
  5551	        query.message.message_id,
  5552	        `\u2705 Responded: ${context.key}`
  5553	      );
  5554	    }
  5555	
  5556	    // Clear pending reply for this topic (if any)
  5557	    const topicId = query.message?.message_thread_id;
  5558	    if (topicId) {
  5559	      this.pendingPromptReply.delete(topicId);
  5560	    }
  5561	
  5562	    // Release relay lease
  5563	    if (this.onRelayLeaseEnd) {
  5564	      this.onRelayLeaseEnd(context.sessionName);
  5565	    }
  5566	
  5567	    // Inject the response into the session
  5568	    if (this.onPromptResponse) {
  5569	      const sent = this.onPromptResponse(context.sessionName, context.key);
  5570	      if (!sent) {
  5571	        console.warn(`[prompt-gate] Failed to send key "${context.key}" to session "${context.sessionName}"`);
  5572	      }
  5573	    } else {
  5574	      console.warn(`[prompt-gate] No onPromptResponse handler — cannot inject response`);
  5575	    }
  5576	
  5577	    console.log(`[prompt-gate] Callback resolved: session="${context.sessionName}" key="${context.key}"`);
  5578	  }
  5579	
  5580	  /**
  5581	   * Handle a text reply to a Prompt Gate relay message (for text-input prompts).
  5582	   * Returns true if the message was intercepted, false to fall through to normal routing.
  5583	   */
  5584	  private handlePendingPromptReply(
  5585	    topicId: number,
  5586	    msg: NonNullable<TelegramUpdate['message']>,
  5587	  ): boolean {
  5588	    const pending = this.pendingPromptReply.get(topicId);
  5589	    if (!pending) return false;
  5590	
  5591	    // Check timeout (2x relay timeout)
  5592	    const relayTimeoutMs = (this.config.promptGate?.relayTimeoutSeconds ?? 300) * 2000;
  5593	    if (Date.now() - pending.createdAt > relayTimeoutMs) {
