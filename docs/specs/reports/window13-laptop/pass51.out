  5744	  private async getUpdates(): Promise<TelegramUpdate[]> {
  5745	    const result = await this.apiCall('getUpdates', {
  5746	      offset: this.lastUpdateId + 1,
  5747	      timeout: 30,
  5748	      allowed_updates: ['message', 'callback_query'],
  5749	    });
  5750	
  5751	    return (result as TelegramUpdate[]) ?? [];
  5752	  }
  5753	
  5754	  private async apiCall(method: string, params: Record<string, unknown>, retryCount: number = 0): Promise<unknown> {
  5755	    // THE FUNNEL for this class. Nothing reaches the Telegram API from here without passing through
  5756	    // it, and the egress door below is where the content decision is made.
  5757	    //
  5758	    // This used to say the property was provable because "`fetch` is called once, below". That stopped
  5759	    // being true when the door landed — this method calls `telegramFetch`, and `fetch` lives in
  5760	    // `src/messaging/telegram-egress.ts`. Review pass 37 finding 8. The property is still provable,
  5761	    // but by `scripts/lint-telegram-egress-boundary.mjs` confining egress, not by counting calls here. See `assertTelegramPayloadVisible` for the
  5762	    // history; the short version is that "the point of sending", "both doors" and "the single
  5763	    // chokepoint every send passes through" were each falsified by the next reader.
  5764	    // Pre-format guard REMOVED (CMT-1246 criterion b). It closed the same case as the egress
  5765	    // door — proven by execution: with it gone every payload it caught is still refused, and
  5766	    // only the message changes. Two copies of one case mask each other's tests.
  5767	
  5768	    // PR2: run the formatter on sendMessage / editMessageText when a non-legacy
  5769	    // mode is configured. Legacy-passthrough (default) preserves the caller's
  5770	    // parse_mode byte-for-byte. See docs/specs/TELEGRAM-MARKDOWN-RENDERER-SPEC.md.
  5771	    const sendParams = applyTelegramFormatter(
  5772	      method,
  5773	      params,
  5774	      this.config.getFormatMode?.(),
  5775	    );
  5776	    // The formatter's output goes to the egress door below, which runs the content check on the
  5777	    // SERIALISED request (pass 33 finding 1: a formatter can remove the very evidence an earlier check
  5778	    // relied on, so the check belongs after every transform).
  5779	    //
  5780	    // There is no pre-format call above any more. This comment used to say there was — pass 36 finding
  5781	    // 6 — which is worth leaving noted: a comment describing a call that was deleted is what a
  5782	    // maintainer trusts instead of re-reading the code.
  5783	
  5784	    const url = `https://api.telegram.org/bot${this.config.token}/${method}`;
  5785	    const safeUrl = `https://api.telegram.org/bot[REDACTED]/${method}`;
  5786	
  5787	    // Long polling uses 30s timeout in params — give extra headroom
  5788	    const timeoutMs = method === 'getUpdates' ? 60_000 : 15_000;
  5789	    const controller = new AbortController();
  5790	    const timer = setTimeout(() => controller.abort(), timeoutMs);
  5791	
  5792	    let response: Response;
  5793	    try {
  5794	      // EGRESS. Goes through the shared door so the visibility check runs on the SERIALISED body —
  5795	      // the exact bytes Telegram receives, after every transform. See src/messaging/telegram-egress.ts.
  5796	      response = await telegramFetch(url, {
  5797	        method: 'POST',
  5798	        headers: { 'Content-Type': 'application/json' },
  5799	        body: JSON.stringify(sendParams.outgoingParams),
  5800	        signal: controller.signal,
  5801	      });
  5802	    } finally {
  5803	      clearTimeout(timer);
  5804	    }
  5805	
  5806	    if (!response.ok) {
  5807	      // Handle 429 Too Many Requests — respect Telegram's retry_after
  5808	      if (response.status === 429) {
  5809	        if (retryCount >= 3) {
  5810	          throw new Error(`Telegram API rate limited ${safeUrl} (429) after ${retryCount} retries`);
  5811	        }
  5812	        try {
  5813	          const errorData = await response.json() as { parameters?: { retry_after?: number } };
  5814	          const retryAfter = errorData?.parameters?.retry_after ?? 5;
  5815	          console.warn(`[telegram] Rate limited on ${method}, waiting ${retryAfter}s (retry ${retryCount + 1}/3)...`);
  5816	          await new Promise(resolve => setTimeout(resolve, retryAfter * 1000));
  5817	          return this.apiCall(method, params, retryCount + 1);
  5818	        } catch (retryErr) {
  5819	          if (retryErr instanceof Error && retryErr.message.includes('after')) throw retryErr;
  5820	          throw new Error(`Telegram API rate limited ${safeUrl} (429)`);
  5821	        }
  5822	      }
  5823	      const text = await response.text();
  5824	      // Plain-retry fallback on 400 for formatted sends. See spec
  5825	      // "Plain-retry fallback". Only applies to sendMessage — editMessageText
  5826	      // cannot be split/retried identically (TELEGRAM_EDIT_TOO_LONG).
  5827	      if (
  5828	        response.status === 400 &&
  5829	        method === 'sendMessage' &&
  5830	        sendParams.didFormat &&
  5831	        !sendParams.isPlainRetry
  5832	      ) {
  5833	        recordFormatFallbackPlainRetry();
  5834	        const retryParams: Record<string, unknown> = {
  5835	          ...sendParams.originalParams,
  5836	          parse_mode: undefined,
  5837	        };
  5838	        // Suffix idempotency key so downstream dedup treats this as fresh.
  5839	        if (typeof retryParams._idempotencyKey === 'string') {
  5840	          retryParams._idempotencyKey = `${retryParams._idempotencyKey}:fallback-plain`;
  5841	        }
  5842	        // Mark so we don't recurse.
  5843	        (retryParams as { _isPlainRetry?: boolean })._isPlainRetry = true;
  5844	        delete retryParams.parse_mode;
  5845	        return this.apiCall(method, retryParams, retryCount);
  5846	      }
  5847	      throw new Error(`Telegram API error ${safeUrl} (${response.status}): ${text}`);
  5848	    }
  5849	
  5850	    const data = await response.json() as { ok: boolean; result: unknown };
  5851	    if (!data.ok) {
  5852	      throw new Error(`Telegram API returned not ok: ${JSON.stringify(data)}`);
  5853	    }
  5854	
  5855	    return data.result;
  5856	  }
  5857	}
