  1008	      pollFollowsLease?: { enabled?: boolean; dryRun?: boolean };
  1009	      telegramPolling?: boolean;
  1010	      pollOverride?: string;
  1011	      developmentAgent?: boolean;
  1012	    }; developmentAgent?: boolean }).multiMachine;
