  1781	      if (currentName && !currentName.includes(TOPIC_STYLE.SYSTEM.emoji)) {
  1782	        await this.editForumTopic(this.config.lifelineTopicId, styledName, TOPIC_STYLE.SYSTEM.color);
  1783	      }
