   936	  // ── Stale Connection Flush ───────────────────────────────
   937	
   938	  /**
   939	   * Flush stale Telegram connections on startup.
   940	   * After a hard kill or sleep/wake, a previous long-poll getUpdates call may
   941	   * still be active on Telegram's side. This causes 409 Conflict errors until
   942	   * the old connection times out (~30s). We claim the polling slot immediately
   943	   * with a non-blocking getUpdates call (timeout=0), which invalidates any
   944	   * stale long-poll connection.
   945	   */
   946	  private async flushStaleConnection(): Promise<void> {
   947	    try {
   948	      // Clear any stale webhook that might exist
   949	      await this.apiCall('deleteWebhook', { drop_pending_updates: false });
   950	
   951	      // Non-blocking getUpdates claims the polling slot, invalidating stale connections
   952	      await this.apiCall('getUpdates', {
   953	        offset: this.lastUpdateId + 1,
   954	        timeout: 0,
   955	        allowed_updates: ['message', 'callback_query'],
   956	      });
   957	      console.log('[Lifeline] Stale connection flushed');
   958	    } catch (err) {
   959	      const errMsg = err instanceof Error ? err.message : String(err);
   960	      if (errMsg.includes('409') && errMsg.includes('Conflict')) {
   961	        // Stale connection detected — retry with exponential backoff.
   962	        // After a hard crash, the old long-poll connection can linger on Telegram's
   963	        // servers for up to 30s. One retry at 2s often isn't enough.
   964	        const maxRetries = 5;
   965	        const delays = [2000, 4000, 8000, 16000, 32000]; // Total: ~62s coverage
   966	
   967	        for (let i = 0; i < maxRetries; i++) {
   968	          console.log(`[Lifeline] 409 on flush — retry ${i + 1}/${maxRetries} in ${delays[i] / 1000}s`);
   969	          await new Promise(r => setTimeout(r, delays[i]));
   970	          try {
   971	            await this.apiCall('getUpdates', {
   972	              offset: this.lastUpdateId + 1,
   973	              timeout: 0,
   974	              allowed_updates: ['message', 'callback_query'],
   975	            });
   976	            console.log(`[Lifeline] Stale connection flushed (retry ${i + 1} succeeded)`);
   977	            return;
   978	          } catch (retryErr) {
   979	            const retryMsg = retryErr instanceof Error ? retryErr.message : String(retryErr);
   980	            if (!retryMsg.includes('409')) {
   981	              // Different error — not a stale connection issue anymore
   982	              console.warn(`[Lifeline] Flush retry ${i + 1} failed with non-409 error: ${retryMsg}`);
   983	              return;
   984	            }
   985	          }
   986	        }
   987	        console.warn('[Lifeline] Stale connection flush exhausted all retries — poll backoff will handle it');
   988	      } else {
   989	        console.warn(`[Lifeline] Stale connection flush failed: ${errMsg}`);
   990	      }
   991	    }
   992	  }
   993	
   994	  // ── Telegram Polling ──────────────────────────────────────
   995	
   996	  /**
   997	   * B1 (multimachine-lease-poll-robustness, Decisions 4/5/6) — reconcile the
   998	   * Telegram poll to the fenced-lease intent the server publishes. Runs on the
   999	   * existing 15s loop. Ships DRY-RUN by default (even on a dev agent): it reads
  1000	   * the intent, computes the start/stop/hold action, LOGS it, and writes the
  1001	   * lifeline-poll-active.json truth source for B5 — but it does NOT start/stop the
  1002	   * real poll until `pollFollowsLease.dryRun:false`. The live flip is gated on the
  1003	   * Phase-4 two-host proof (and Decision 12: B2+B5 live), so this can never
  1004	   * disturb the Phase-0 stabilization on the live agent.
