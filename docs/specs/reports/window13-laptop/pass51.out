    94	/**
    95	 * Acquire an exclusive lock file to prevent multiple lifeline instances.
    96	 * Returns true if lock acquired, false if another instance holds it.
    97	 *
    98	 * Handles three cases:
    99	 * 1. No lock file → acquire immediately
   100	 * 2. Lock held by dead process → take over (stale lock)
   101	 * 3. Lock held by alive process → check age. If the lock holder has been
   102	 *    running for >5 minutes but isn't responding (zombie after sleep/wake),
   103	 *    force-kill it and take over. This prevents permanently stuck lifelines
   104	 *    from blocking new instances after a crash.
   105	 */
   106	function acquireLockFile(lockPath: string): boolean {
   107	  try {
   108	    // Check if lock file exists and if the PID is still alive
   109	    if (fs.existsSync(lockPath)) {
   110	      const raw = fs.readFileSync(lockPath, 'utf-8');
   111	      const data = JSON.parse(raw);
   112	      if (data.pid && typeof data.pid === 'number') {
   113	        try {
   114	          // Signal 0 checks if process exists without killing it
   115	          process.kill(data.pid, 0);
   116	
   117	          // Process is alive — but is it actually functional?
   118	          // We have three "stuck" states to detect:
   119	          //   1. Zombie (Z) or stopped (T) — clearly dead-but-not-reaped.
   120	          //   2. Sleeping (S) for >5 min without responding to SIGTERM —
   121	          //      observed in the 2026-05-20 b2lead-insights incident: the
   122	          //      previous lifeline received SIGTERM via the CLI's pkill
   123	          //      fallback path and went to 'S' state but never exited,
   124	          //      holding the lock for >5 min until manual SIGKILL.
   125	          //   3. A live, healthy lifeline (R/S < 5 min) — DON'T touch it.
   126	          if (data.startedAt) {
   127	            const lockAge = Date.now() - new Date(data.startedAt).getTime();
   128	            const fiveMinutes = 5 * 60_000;
   129	            if (lockAge > fiveMinutes) {
   130	              // Check process state
   131	              const procInfo = spawnSync('/bin/ps', ['-p', String(data.pid), '-o', 'stat='], {
   132	                encoding: 'utf-8', timeout: 3000,
   133	              }).stdout?.trim() ?? '';
   134	
   135	              // Z (zombie) / T (stopped) — always recoverable.
   136	              const isZombieOrStopped = procInfo.includes('Z') || procInfo.includes('T');
   137	
   138	              // Sleeping process that is post-SIGTERM-but-not-exiting:
   139	              // if it received SIGTERM and is still alive after 5 min,
   140	              // it's wedged. We probe by sending SIGTERM ourselves (or
   141	              // detect 'S+' / sleep + signal-pending) and if it's still
   142	              // alive after the grace window, escalate. The presence of
   143	              // 'S' state alone for >5 min after the lock was written
   144	              // is the failure shape — a healthy lifeline writes the
   145	              // lock and starts running tasks within seconds, leaving
   146	              // 'R' or short 'S' bursts. Sustained 'S' for 5+ min with
   147	              // no progress is the wedged state we observed.
   148	              const isWedgedSleeping =
   149	                /^S/i.test(procInfo) && lockAge > fiveMinutes;
   150	
   151	              if (isZombieOrStopped) {
   152	                console.log(`[Lifeline] Lock holder PID ${data.pid} is zombie/stopped (state: ${procInfo}) — taking over`);
   153	                try { process.kill(data.pid, 'SIGKILL'); } catch { /* ignore */ }
   154	              } else if (isWedgedSleeping) {
   155	                // Try SIGTERM with a short grace window, then SIGKILL.
   156	                console.log(`[Lifeline] Lock holder PID ${data.pid} sleeping >5min after lock write (state: ${procInfo}) — sending SIGTERM`);
   157	                try { process.kill(data.pid, 'SIGTERM'); } catch { /* ignore */ }
   158	                // Synchronously poll for exit up to 3s, then SIGKILL.
   159	                const killDeadline = Date.now() + 3000;
   160	                let alive = true;
   161	                while (Date.now() < killDeadline) {
   162	                  try {
   163	                    process.kill(data.pid, 0);
   164	                    spawnSync('/bin/sleep', ['0.25'], { timeout: 500 });
   165	                  } catch {
   166	                    alive = false;
   167	                    break;
   168	                  }
   169	                }
   170	                if (alive) {
   171	                  console.log(`[Lifeline] PID ${data.pid} survived SIGTERM grace — SIGKILL`);
   172	                  try { process.kill(data.pid, 'SIGKILL'); } catch { /* ignore */ }
   173	                }
   174	              } else {
   175	                // Process is alive and not a zombie — another lifeline is truly running
   176	                return false;
   177	              }
   178	            } else {
   179	              // Lock is fresh — another lifeline is running
   180	              return false;
   181	            }
   182	          } else {
   183	            // No startedAt — legacy lock, respect it
   184	            return false;
   185	          }
   186	        } catch {
   187	          // Process is dead — stale lock, we can take over
   188	          console.log(`[Lifeline] Removing stale lock (PID ${data.pid} is dead)`);
   189	        }
   190	      }
   191	    }
   192	
   193	    // Write our PID
   194	    const tmpPath = `${lockPath}.${process.pid}.tmp`;
   195	    fs.writeFileSync(tmpPath, JSON.stringify({ pid: process.pid, startedAt: new Date().toISOString() }));
   196	    fs.renameSync(tmpPath, lockPath);
   197	    return true;
   198	  } catch (err) {
   199	    console.error(`[Lifeline] Lock acquisition failed: ${err}`);
   200	    return false;
   201	  }
   202	}
