  1789	      if (errStr.includes('thread not found') || errStr.includes('TOPIC_DELETED') ||
  1790	          errStr.includes('TOPIC_CLOSED') || errStr.includes('not found')) {
  1791	        console.log(`[telegram] Lifeline topic ${this.config.lifelineTopicId} was deleted — recreating`);
  1792	        try {
  1793	          const topic = await this.createForumTopic(styledName, TOPIC_STYLE.SYSTEM.color, { origin: 'system', bounded: true, label: 'lifeline' });
  1794	          this.config.lifelineTopicId = topic.topicId;
  1795	          this.persistLifelineTopicId(topic.topicId);
