  1014	    if (!enabled) return; // static-flag behavior unchanged
  1015	    const dryRun = mm?.pollFollowsLease?.dryRun !== false; // default DRY-RUN even on dev
  1016	
  1017	    const stateDir = this.projectConfig.stateDir;
  1018	    // Always publish the TRUTH (our real poll state) for B5 — safe, observe-only.
  1019	    try { writePollActive(stateDir, this.polling); } catch { /* advisory */ }
