   581	    (topicId: number, argText: string, userId: number) => Promise<{ ok: boolean; message: string }>
   582	  ) | null = null;
   583	
   584	  /**
   585	   * Local-model command handler. Called when a user posts
   586	   * `/local-model <provider> [model]` (or `/local-model off`) in a
   587	   * topic. The handler validates the provider/model is reachable,
   588	   * persists the per-topic local-model binding, and triggers a
   589	   * respawn so the new session spawns under Codex --oss
   590	   * --local-provider <provider>.
   591	   *
   592	   * Conversational counterpart of editing config.json — Justin's
   593	   * "every config change reachable via Telegram" rule.
   594	   *
   595	   * - provider = null + model = null → "show status" (no mutation).
   596	   * - provider = 'off' / 'none' → clear the topic's override (revert
   597	   *   to cloud Codex).
   598	   */
   599	  public onLocalModelCommand: (
   600	    (topicId: number, provider: string | null, model: string | null) => Promise<{ ok: boolean; message: string }>
   601	  ) | null = null;
   602	
   603	  // Message log callback — fires on every message logged (inbound and outbound).
   604	  // Used by TopicMemory to dual-write to SQLite for search and summarization.
   605	  // Includes sender identity fields (Phase 1C/1D — User-Agent Topology Spec).
   606	  public onMessageLogged: ((entry: { messageId: number; topicId: number | null; text: string; fromUser: boolean; timestamp: string; sessionName: string | null; senderName?: string; senderUsername?: string; telegramUserId?: number; forwarded?: boolean; provenance?: MessageProvenance }) => void) | null = null;
   607	
   608	  /**
   609	   * Scope-accretion ratification observer (spec autonomous-scope-accretion-
   610	   * completion.md R45): fired for every AUTHENTICATED inbound TEXT topic
   611	   * message on the server's own long-poll receive path — the trigger +
   612	   * confirmation matcher consumes ONLY messages the server itself received
   613	   * from Telegram (never any on-disk history file). Signal-only: fired
   614	   * fire-and-forget AFTER auth gating; a throwing observer never blocks
   615	   * message routing. Carries reply_to_message_id so a confirmation can be
   616	   * reply-anchored to the recorded server-authored enumeration (R38).
   617	   */
   618	  public onScopeAccretionInbound: ((evt: {
   619	    topicId: number;
   620	    text: string;
   621	    senderUid: string;
   622	    messageId: number;
   623	    replyToMessageId?: number;
   624	    at: number;
   625	  }) => void) | null = null;
   626	  /**
   627	   * Outbound relay for a TOKENLESS standby (bug #7). When this adapter has no bot
   628	   * token — a multi-machine pool standby serving a session moved to it — it cannot
   629	   * call the Telegram API directly. If this is wired, sendToTopic routes the send
   630	   * through it (the server wires it to POST the Telegram-OWNING router's
   631	   * /telegram/reply/:topicId), so a moved session's replies reach the user without
   632	   * the standby ever polling/sending on the shared bot (preserving the single-owner
   633	   * invariant that avoids the 409-poller-conflict incident). Returns the sent
   634	   * message's SendResult, or null if the relay could not deliver.
   635	   */
   636	  public outboundRelay: ((topicId: number, text: string, options?: { silent?: boolean; kindMetadata?: Record<string, unknown>; provenance?: Exclude<MessageProvenance, 'user'> }) => Promise<SendResult | null>) | null = null;
   637	
   638	  /**
   639	   * True when a `sendToTopic` will RELAY through the lease holder rather than
   640	   * send directly — i.e. this is a tokenless pool standby with `outboundRelay`
   641	   * wired. Mirrors the exact `sendToTopic` branch condition (no usable string
   642	   * bot token + a relay available). Callers use this to skip work the HOLDER
   643	   * will do anyway: e.g. the `/telegram/reply` route skips its LOCAL tone gate
   644	   * for a relayed reply, because (a) the reply is already the agent's finalized
   645	   * output, (b) the Telegram-owning holder runs ITS tone gate on receipt, and
   646	   * (c) running the standby's tone gate adds a serial LLM call to every
   647	   * cross-machine reply — which, under a rate-limited circuit, waits up to
   648	   * `MessagingToneGate` rateLimitWaitMs (120s) BEFORE the relay even starts.
   649	   * That double-gate + pre-relay stall is a real robustness defect on the
   650	   * standby reply path.
   651	   */
   652	  willRelay(): boolean {
   653	    const hasUsableBotToken = typeof this.config.token === 'string' && this.config.token.length > 0;
   654	    return !hasUsableBotToken && this.outboundRelay !== null;
   655	  }
