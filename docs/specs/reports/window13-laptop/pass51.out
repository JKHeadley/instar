  5613	    // Verify this is a reply-to the relay message
  5614	    if (msg.reply_to_message?.message_id !== pending.relayMessageId) {
  5615	      return false; // Not replying to the prompt — fall through
  5616	    }
  5617	
  5618	    // Intercept the reply
  5619	    this.pendingPromptReply.delete(topicId);
