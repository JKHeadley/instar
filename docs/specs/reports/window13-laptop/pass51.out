  1825	      }
  1826	      DegradationReporter.getInstance().report({
  1827	        feature: 'Telegram.Lifeline',
  1828	        primary: 'Verified lifeline topic for emergency agent communication',
  1829	        fallback: 'Using unverified (possibly stale) lifeline topic ID',
