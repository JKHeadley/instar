  1811	      // not trigger degradation on the first attempt — a brief retry on startup resolves them.
  1812	      let retryErr: unknown = err;
  1813	      try {
  1814	        await new Promise<void>(resolve => setTimeout(resolve, 3000));
  1815	        await this.apiCall('sendChatAction', {
  1816	          chat_id: this.config.chatId,
  1817	          message_thread_id: this.config.lifelineTopicId,
  1818	          action: 'typing',
  1819	        });
  1820	        console.log(`[telegram] Lifeline topic verified (retry succeeded): ${this.config.lifelineTopicId}`);
  1821	        return this.config.lifelineTopicId;
  1822	      } catch (e) {
  1823	        // @silent-fallback-ok — error assigned to retryErr, reported to DegradationReporter below
