   204	/** Execute a shell command safely, returning stdout. */
   205	function shellExec(cmd: string, timeout = 5000): string {
   206	  return spawnSync('/bin/sh', ['-c', cmd], { encoding: 'utf-8', timeout }).stdout ?? '';
   207	}
   208	
   209	function releaseLockFile(lockPath: string): void {
   210	  try {
   211	    if (fs.existsSync(lockPath)) {
   212	      const raw = fs.readFileSync(lockPath, 'utf-8');
   213	      const data = JSON.parse(raw);
   214	      // Only remove if we own it
   215	      if (data.pid === process.pid) {
   216	        SafeFsExecutor.safeUnlinkSync(lockPath, { operation: 'src/lifeline/TelegramLifeline.ts:146' });
   217	      }
   218	    }
   219	  } catch { /* best effort */ }
   220	}
