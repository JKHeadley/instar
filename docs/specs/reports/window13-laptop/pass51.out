  2047	      return { edited: false, messageId: result.messageId, warnings };
  2048	    } catch (err) {
  2049	      const detail = err instanceof Error ? err.message : String(err);
  2050	      console.error(`[telegram] Failed to broadcast dashboard URL: ${detail}`);
