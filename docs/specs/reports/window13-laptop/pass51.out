  5422	
  5423	  /**
  5424	   * Handle a Telegram callback query from an inline keyboard button press.
  5425	   */
  5426	  private async processCallbackQuery(query: NonNullable<TelegramUpdate['callback_query']>): Promise<void> {
  5427	    if (!query.data) {
  5428	      await this.apiCall('answerCallbackQuery', {
  5429	        callback_query_id: query.id,
  5430	        text: 'Invalid button data',
  5431	      }).catch(() => {});
  5432	      return;
  5433	    }
  5434	
  5435	    // ── Tunnel-consent buttons (separate, security-sensitive path) ────
  5436	    // callback_data shape: `tc:g:<nonce>` (grant) | `tc:d:<nonce>`
  5437	    // (decline). The owner-principal check is MANDATORY here — the
  5438	    // GPT external review's CRITICAL finding is that only the owner
  5439	    // may approve routing private traffic through a third-party relay.
  5440	    // We use getOwnerUserId() (the explicit owner principal), NOT the
  5441	    // broader authorizedUserIds set.
  5442	    if (query.data.startsWith('tc:')) {
  5443	      const owner = this.getOwnerUserId();
  5444	      if (owner && query.from.id !== owner) {
  5445	        await this.apiCall('answerCallbackQuery', {
  5446	          callback_query_id: query.id,
  5447	          text: 'Only the owner can approve this',
  5448	        }).catch(() => {});
  5449	        return; // do NOT consume — preserve for the real owner
  5450	      }
  5451	      const m = /^tc:([gd]):([0-9a-f]{32})$/.exec(query.data);
  5452	      if (!m) {
  5453	        await this.apiCall('answerCallbackQuery', {
  5454	          callback_query_id: query.id,
  5455	          text: 'Invalid consent button',
  5456	        }).catch(() => {});
  5457	        return;
  5458	      }
  5459	      const action: 'grant' | 'decline' = m[1] === 'g' ? 'grant' : 'decline';
  5460	      const nonce = m[2]!;
  5461	      let statusText = 'Got it';
  5462	      if (this.tunnelConsentHandler) {
  5463	        try {
  5464	          statusText = await this.tunnelConsentHandler(action, nonce);
  5465	        } catch {
  5466	          statusText = 'Could not process — try the dashboard';
  5467	        }
  5468	      }
  5469	      await this.apiCall('answerCallbackQuery', {
  5470	        callback_query_id: query.id,
  5471	        text: statusText,
  5472	      }).catch(() => {});
  5473	      // Clear the inline keyboard so the (now-consumed) button can't be
