  5653	  /**
  5654	   * Edit a Telegram message with retry on failure.
  5655	   * Uses exponential backoff (1s, 2s, 4s) for up to 3 attempts.
  5656	   */
  5657	  private async editMessageWithRetry(messageId: number, text: string, retries = 3, chatId?: number | string): Promise<void> {
  5658	    for (let attempt = 0; attempt < retries; attempt++) {
  5659	      try {
  5660	        await this.apiCall('editMessageText', {
  5661	          chat_id: chatId ?? this.config.chatId,
  5662	          message_id: messageId,
  5663	          text,
  5664	        });
  5665	        return;
  5666	      } catch (err) {
  5667	        if (attempt < retries - 1) {
  5668	          await new Promise(r => setTimeout(r, 1000 * Math.pow(2, attempt)));
  5669	        } else {
  5670	          console.warn(`[prompt-gate] Failed to edit message ${messageId} after ${retries} attempts: ${err}`);
  5671	        }
  5672	      }
  5673	    }
  5674	  }
  5675	
  5676	  /**
  5677	   * Clean up Prompt Gate state for a session (call when session ends).
  5678	   */
  5679	  cleanupPromptGate(sessionName: string): void {
  5680	    // Remove all callback registry entries for this session
  5681	    this.callbackRegistry.removeForSession(sessionName);
  5682	
  5683	    // Clear any pending replies for topics bound to this session
  5684	    for (const [topicId, pending] of this.pendingPromptReply) {
  5685	      if (pending.prompt.sessionName === sessionName) {
  5686	        this.pendingPromptReply.delete(topicId);
  5687	        // Update the relay message
  5688	        this.editMessageWithRetry(
  5689	          pending.relayMessageId,
  5690	          '\u274C Session ended before response received'
  5691	        ).catch(() => {});
  5692	      }
  5693	    }
  5694	  }
  5695	
  5696	  /**
  5697	   * Proactively prune expired relay prompts and send timeout messages.
  5698	   * Call periodically (e.g. every 60s) to handle cases where no new message
  5699	   * arrives to trigger the expiry check in handlePendingPromptReply.
  5700	   */
  5701	  async pruneExpiredRelays(): Promise<void> {
  5702	    const relayTimeoutMs = (this.config.promptGate?.relayTimeoutSeconds ?? 300) * 1000;
  5703	    const reminderMs = relayTimeoutMs; // Send reminder at 1x timeout
  5704	    const expiryMs = relayTimeoutMs * 2; // Expire at 2x timeout
  5705	    const now = Date.now();
  5706	
  5707	    for (const [topicId, pending] of this.pendingPromptReply) {
  5708	      const age = now - pending.createdAt;
  5709	
  5710	      if (age > expiryMs) {
  5711	        // Expired — update message and clean up
  5712	        this.pendingPromptReply.delete(topicId);
  5713	        this.editMessageWithRetry(
  5714	          pending.relayMessageId,
  5715	          '\u23f0 Prompt expired — no response received. Check the dashboard to respond manually.'
  5716	        ).catch(() => {});
  5717	
  5718	        // Release relay lease
  5719	        if (this.onRelayLeaseEnd) {
  5720	          this.onRelayLeaseEnd(pending.prompt.sessionName);
  5721	        }
  5722	
  5723	        // Clean up callback registry entries for this prompt
  5724	        this.callbackRegistry.removeForSession(pending.prompt.sessionName);
  5725	
  5726	        console.log(`[prompt-gate] Relay expired for topic ${topicId} (${Math.round(age / 1000)}s)`);
  5727	      } else if (age > reminderMs && !pending.reminderSent) {
  5728	        // Send reminder
  5729	        await this.sendToTopic(topicId,
  5730	          '\u23f3 Still waiting for your response on the prompt above.'
  5731	        ).catch(() => {});
  5732	        pending.reminderSent = true;
  5733	      }
  5734	    }
  5735	  }
