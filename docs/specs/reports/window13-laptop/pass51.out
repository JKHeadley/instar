  1802	            fallback: 'No lifeline topic — agent unreachable in emergencies',
  1803	            reason: `Lifeline topic deleted and recreation failed: ${recreateErr instanceof Error ? recreateErr.message : String(recreateErr)}`,
  1804	            impact: 'Agent cannot receive emergency commands or stall recovery signals.',
  1805	          });
