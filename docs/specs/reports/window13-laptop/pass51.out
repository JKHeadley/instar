  5228	          await this.handler(message);
  5229	        } catch (err) {
  5230	          console.error(`[telegram] Handler error: ${err}`);
  5231	        }
  5232	      }
  5233	    } catch (err) {
  5234	      console.error(`[telegram] Failed to download photo: ${err}`);
