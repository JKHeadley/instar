   714	  private promptGateDisclosureSent = new Set<number>(); // topicIds that have seen the disclosure
   715	
   716	  /**
   717	   * Tunnel-consent callback handler. Registered by TunnelManager via
   718	   * `setTunnelConsentHandler`. Receives the parsed action ('grant' |
   719	   * 'decline') + the nonce; returns a short status string for the
   720	   * answerCallbackQuery toast. The owner-principal check happens in
   721	   * processCallbackQuery BEFORE this is invoked, so the handler can
   722	   * trust the click came from the owner.
   723	   */
   724	  private tunnelConsentHandler: ((action: 'grant' | 'decline', nonce: string) => Promise<string>) | null = null;
   725	  /**
   726	   * UNIFIED-SESSION-LIFECYCLE bonus — fired when a Telegram forum topic is
   727	   * renamed. Wired in server.ts to update the bound session's display name
   728	   * (display `name` only — never the tmuxSession key or id). Fire-and-forget.
   729	   */
   730	  private topicRenamedHandler: ((topicId: number, newName: string) => void | Promise<void>) | null = null;
   731	
   732	  /** Wire the tunnel-consent callback handler (called by TunnelManager). */
   733	  setTunnelConsentHandler(fn: ((action: 'grant' | 'decline', nonce: string) => Promise<string>) | null): void {
   734	    this.tunnelConsentHandler = fn;
   735	  }
   736	
   737	  /**
   738	   * Wire the topic-renamed callback (UNIFIED-SESSION-LIFECYCLE bonus). Fires
   739	   * fire-and-forget when a Telegram forum topic is renamed; consumers update
   740	   * the bound session's display `name` only (never the tmuxSession key or id).
   741	   */
   742	  setTopicRenamedHandler(fn: ((topicId: number, newName: string) => void | Promise<void>) | null): void {
   743	    this.topicRenamedHandler = fn;
   744	  }
   745	
   746	  /**
   747	   * Send a consent prompt to the owner DM with two inline buttons
   748	   * (approve / decline). The buttons carry callback_data of the form
   749	   * `tc:g:<nonce>` / `tc:d:<nonce>` (well under Telegram's 64-byte
   750	   * callback_data limit — `tc:g:` is 5 chars + a 32-hex nonce = 37).
   751	   * Returns the message id on success, null on failure (no owner,
   752	   * owner hasn't DM'd the bot, network error) — fire-and-forget.
   753	   */
   754	  async sendOwnerConsentPrompt(text: string, nonce: string): Promise<number | null> {
   755	    const owner = this.getOwnerUserId();
   756	    if (!owner) {
   757	      console.warn('[telegram] sendOwnerConsentPrompt called but no ownerUserId is configured');
   758	      return null;
   759	    }
   760	    try {
   761	      const result = await this.apiCall('sendMessage', {
   762	        chat_id: owner,
   763	        text,
   764	        reply_markup: {
   765	          inline_keyboard: [[
   766	            { text: 'Yes, use a backup', callback_data: `tc:g:${nonce}` },
   767	            { text: 'No, keep waiting', callback_data: `tc:d:${nonce}` },
   768	          ]],
   769	        },
   770	      }) as { message_id: number };
   771	      return result.message_id;
   772	    } catch (err) {
   773	      const msg = err instanceof Error ? err.message : String(err);
   774	      console.warn(`[telegram] sendOwnerConsentPrompt failed: ${msg}`);
   775	      return null;
   776	    }
   777	  }
   778	
   779	  /** Callback to inject a response into a tmux session. Wired by server.ts. */
   780	  public onPromptResponse: ((sessionName: string, key: string) => boolean) | null = null;
   781	  /** Callback to inject text input into a tmux session. Wired by server.ts. */
   782	  public onPromptTextResponse: ((sessionName: string, text: string) => boolean) | null = null;
   783	  /** Callback when relay lease should extend idle timeout for a session */
   784	  public onRelayLeaseStart: ((sessionName: string) => void) | null = null;
   785	  /** Callback when relay lease is released (response received or timeout) */
   786	  public onRelayLeaseEnd: ((sessionName: string) => void) | null = null;
