   788	  /**
   789	   * Per-topic monotonic content version — bumped on every message logged for the
   790	   * topic. The live-tail streamer polls this (getTopicContentVersion) as its
   791	   * cheap change-detector: an unchanged version means the topic's tail content
   792	   * is byte-identical, so the streamer skips serializing it entirely (the
   793	   * 2026-06-05 event-loop-stall fix — building every topic's history every tick
   794	   * blocked the loop for seconds).
   795	   */
   796	  private topicContentVersion = new Map<number, number>();
   797	  /**
   798	   * In-memory recent-tail cache backing getTopicHistory — seeded lazily from the
   799	   * JSONL on a topic's first read, then maintained on every append. Bounds the
   800	   * cost of repeated history reads to O(limit) instead of a full synchronous
   801	   * re-read of the (up to 75k-line) message log per call. Holds the most recent
   802	   * TAIL_CACHE_LIMIT entries per topic, which covers every production caller
   803	   * (live-tail + handoff hash use 500, respawn history far less). Log rotation
   804	   * is irrelevant to it — rotation only drops OLD lines, and the cache only
   805	   * holds the newest.
   806	   */
   807	  private topicTailCache = new Map<number, LogEntry[]>();
   808	  /** One-time batch seed done (all live topics seeded in a single file pass). */
   809	  private tailCacheSeeded = false;
   810	  private static readonly TAIL_CACHE_LIMIT = 500;
   811	
   812	  // Shared infrastructure modules (Phase 1 extraction)
   813	  private sharedLogger: MessageLogger | null = null;
   814	  private sharedRegistry: SessionChannelRegistry | null = null;
   815	  private sharedStallDetector: StallDetector | null = null;
   816	  private sharedCommandRouter: CommandRouter | null = null;
   817	  private sharedAuthGate: AuthGate | null = null;
   818	  private eventBus: MessagingEventBus | null = null;
   819	
   820	  /** Get the event bus for external subscribers (Phase 1e). Returns null if flag is off. */
   821	  getEventBus(): MessagingEventBus | null {
   822	    return this.eventBus;
   823	  }
   824	
   825	  constructor(
   826	    config: TelegramConfig,
   827	    stateDir: string,
   828	    opts?: { subDir?: string; suppressLifelineAutoCreate?: boolean },
   829	  ) {
   830	    if (config.chatId && !/^-?\d+$/.test(String(config.chatId))) {
   831	      throw new Error(
   832	        `Invalid Telegram chatId "${config.chatId}". Chat IDs must be numeric (e.g., -1001234567890). ` +
   833	        `Update messaging.config.chatId in your instar.config.json with a valid numeric ID.`,
   834	      );
   835	    }
   836	    // HARDENED (v1.3.270 boot-crash incident): when the secrets merge fails, the
   837	    // externalized token arrives as the truthy `{ secret: true }` placeholder OBJECT.
   838	    // Polling with it stringified into the bot URL 404-zombies forever. Normalize a
   839	    // non-string token to '' — the well-defined TOKENLESS state every guard in this
   840	    // adapter already handles (standby/relay) — and say so loudly.
   841	    if (config.token != null && typeof config.token !== 'string') {
   842	      console.warn(
   843	        '[telegram] Bot token is not a string (unresolved secret placeholder — secret store unavailable at boot?). ' +
   844	        'Running TOKENLESS this boot: no polling, sends only via relay if available. A restart after the secret store recovers restores full service.',
   845	      );
   846	      config = { ...config, token: '' };
   847	    }
   848	    this.config = config;
   849	    this.stateDir = stateDir;
   850	    this.suppressLifelineAutoCreate = opts?.suppressLifelineAutoCreate ?? false;
   851	    // Multi-instance isolation: a non-primary adapter (e.g. the mentor bot) namespaces its
   852	    // per-bot state under {stateDir}/{subDir}/ so two adapters never clobber each other's
   853	    // poll-offset / registry / message-log / attention files (the reviewer-flagged
   854	    // collision that makes poll()'s cross-token detection fire continuously). The PRIMARY
   855	    // bot passes no subDir → botStateDir === stateDir → paths are byte-for-byte unchanged.
   856	    this.botStateDir = opts?.subDir ? path.join(stateDir, opts.subDir) : stateDir;
   857	    if (opts?.subDir) {
   858	      fs.mkdirSync(this.botStateDir, { recursive: true });
   859	    }
   860	    this.registryPath = path.join(this.botStateDir, 'topic-session-registry.json');
   861	    this.messageLogPath = path.join(this.botStateDir, 'telegram-messages.jsonl');
   862	    this.offsetPath = path.join(this.botStateDir, 'telegram-poll-offset.json');
   863	    this.attentionFilePath = path.join(this.botStateDir, 'state', 'attention-items.json');
   864	    this.attentionSuppressedLogPath = path.join(this.botStateDir, 'state', 'attention-suppressed.jsonl');
   865	    this.attentionTopicGuard = new AttentionTopicGuard(config.attentionTopicGuard ?? {});
   866	    // Backstop ceiling: looser than the attention guard by design (the
   867	    // attention guard SHAPES politely per-source; this is the absolute bound
   868	    // a mis-wired or future caller cannot dodge). Config can tighten/loosen.
   869	    this.topicCreationGuard = new AttentionTopicGuard({
   870	      windowMs: 10 * 60 * 1000,
   871	      maxTopicsPerSource: 8,
   872	      maxTopicsGlobal: 12,
   873	      ...(config.topicCreationBudget ?? {}),
   874	    });
   875	    const alc = config.agentHealthLane ?? {};
   876	    this.agentHealthLaneCfg = {
   877	      enabled: alc.enabled !== false,
   878	      topicName: (typeof alc.topicName === 'string' && alc.topicName.trim()) ? alc.topicName : '🩺 Agent Health',
   879	      maxTrackedKeys: Number.isFinite(alc.maxTrackedKeys) && (alc.maxTrackedKeys as number) > 0 ? Math.floor(alc.maxTrackedKeys as number) : 256,
   880	      dedupWindowMs: Number.isFinite(alc.dedupWindowMs) && (alc.dedupWindowMs as number) > 0 ? (alc.dedupWindowMs as number) : 30 * 60 * 1000,
   881	    };
   882	    this.attentionRoutingMode = config.attentionRouting?.mode === 'per-item' ? 'per-item' : 'single-topic';
   883	    this.loadRegistry();
   884	    this.loadOffset();
   885	    this.loadAttentionItems();
   886	
   887	    // Initialize Prompt Gate callback registry
   888	    const relayTimeoutMs = (config.promptGate?.relayTimeoutSeconds ?? 300) * 1000;
   889	    this.callbackRegistry = new CallbackRegistry({
   890	      maxEntries: 500,
   891	      maxAgeMs: relayTimeoutMs,
   892	      pruneIntervalMs: 60_000,
   893	    });
   894	    this.callbackRegistry.start();
   895	
   896	    // Initialize shared modules when feature flags are enabled
   897	    if (SHARED_INFRA_FLAGS.useSharedMessageLogger) {
   898	      this.sharedLogger = new MessageLogger({ logPath: this.messageLogPath });
   899	    }
   900	    if (SHARED_INFRA_FLAGS.useSharedStallDetector) {
   901	      this.sharedStallDetector = new StallDetector({
   902	        stallTimeoutMinutes: config.stallTimeoutMinutes,
   903	        promiseTimeoutMinutes: config.promiseTimeoutMinutes,
   904	      });
   905	    }
   906	    if (SHARED_INFRA_FLAGS.useSharedCommandRouter) {
   907	      this.sharedCommandRouter = new CommandRouter('telegram');
   908	      this.registerSharedCommands();
   909	    }
   910	    if (SHARED_INFRA_FLAGS.useSharedAuthGate) {
   911	      this.sharedAuthGate = new AuthGate({
   912	        authorizedUsers: (config.authorizedUserIds ?? []).map(id => id.toString()),
   913	      });
   914	    }
   915	    if (SHARED_INFRA_FLAGS.useEventEmitterPattern) {
   916	      this.eventBus = new MessagingEventBus('telegram');
   917	    }
   918	  }
   919	
   920	  /**
   921	   * Register all Telegram commands with the shared CommandRouter (Phase 1a).
   922	   * Each command delegates back to the existing handler logic.
   923	   */
   924	  private registerSharedCommands(): void {
   925	    if (!this.sharedCommandRouter) return;
   926	
   927	    // Attention topic interceptor
   928	    this.sharedCommandRouter.addInterceptor(async (ctx) => {
   929	      const topicId = parseInt(ctx.channelId, 10);
   930	      if (this.isAttentionTopic(topicId)) {
   931	        return this.handleAttentionCommand(topicId, ctx.rawText);
   932	      }
   933	      return false;
   934	    });
   935	
   936	    this.sharedCommandRouter.register('flush', async (ctx) => {
   937	      const topicId = parseInt(ctx.channelId, 10);
   938	      if (this.batcher && this.batcher.isEnabled()) {
   939	        const flushed = await this.batcher.flushAll();
   940	        if (flushed > 0) {
   941	          await this.sendToTopic(topicId, `Flushed ${flushed} batched notification${flushed === 1 ? '' : 's'}.`).catch(() => {});
   942	        } else {
   943	          await this.sendToTopic(topicId, 'No batched notifications to flush.').catch(() => {});
   944	        }
   945	      } else if (this.onFlushNotifications) {
   946	        this.onFlushNotifications(topicId).catch(err => {
   947	          console.error('[telegram] Flush notifications failed:', err);
   948	          this.sendToTopic(topicId, 'Failed to flush notifications.').catch(() => {});
   949	        });
   950	      } else {
   951	        await this.sendToTopic(topicId, 'Notification batching is not enabled.').catch(() => {});
   952	      }
   953	      return true;
   954	    }, { description: 'Flush batched notifications' });
   955	
   956	    this.sharedCommandRouter.register('sessions', async (ctx) => {
   957	      const topicId = parseInt(ctx.channelId, 10);
   958	      const filterUnclaimed = ctx.args.includes('unclaimed');
   959	      if (!this.onListSessions) {
   960	        await this.sendToTopic(topicId, 'Session listing not available.').catch(() => {});
   961	        return true;
   962	      }
   963	      const sessions = this.onListSessions();
   964	      if (sessions.length === 0) {
   965	        await this.sendToTopic(topicId, 'No sessions running.').catch(() => {});
   966	        return true;
   967	      }
   968	      const lines: string[] = [];
   969	      for (const s of sessions) {
   970	        const linkedTopic = this.getTopicForSession(s.tmuxSession);
   971	        const claimed = linkedTopic !== null;
   972	        if (filterUnclaimed && claimed) continue;
   973	        const status = s.alive ? '\u2705' : '\u274c';
   974	        const claimTag = claimed ? ` (topic ${linkedTopic})` : ' \u{1f7e1} unclaimed';
   975	        lines.push(`${status} ${s.name}${claimTag}`);
   976	      }
   977	      if (lines.length === 0) {
   978	        await this.sendToTopic(topicId, filterUnclaimed ? 'No unclaimed sessions.' : 'No sessions.').catch(() => {});
   979	      } else {
   980	        await this.sendToTopic(topicId, lines.join('\n')).catch(() => {});
   981	      }
   982	      return true;
   983	    }, { description: 'List sessions', platforms: ['telegram'] });
   984	
   985	    this.sharedCommandRouter.register(['claim', 'link'], async (ctx) => {
   986	      const topicId = parseInt(ctx.channelId, 10);
   987	      const sessionName = ctx.args;
   988	      if (!sessionName) {
   989	        await this.sendToTopic(topicId, `Please include a session name — e.g. /${ctx.command} my-session`).catch(() => {});
   990	        return true;
   991	      }
   992	      const existingSession = this.getSessionForTopic(topicId);
   993	      if (existingSession) {
   994	        await this.sendToTopic(topicId, `This topic is already linked to "${existingSession}". Use /unlink first.`).catch(() => {});
   995	        return true;
   996	      }
   997	      this.registerTopicSession(topicId, sessionName);
   998	      const verb = ctx.command === 'claim' ? 'Claimed' : 'Linked';
   999	      await this.sendToTopic(topicId, `${verb} session "${sessionName}" ${ctx.command === 'claim' ? 'into' : 'to'} this topic.`).catch(() => {});
  1000	      return true;
  1001	    }, { description: 'Link a session to this topic', platforms: ['telegram'] });
  1002	
  1003	    this.sharedCommandRouter.register('unlink', async (ctx) => {
  1004	      const topicId = parseInt(ctx.channelId, 10);
  1005	      const sessionName = this.getSessionForTopic(topicId);
  1006	      if (!sessionName) {
  1007	        await this.sendToTopic(topicId, 'No session linked to this topic.').catch(() => {});
  1008	        return true;
  1009	      }
  1010	      this.unregisterTopic(topicId);
  1011	      await this.sendToTopic(topicId, `Unlinked session "${sessionName}" from this topic.`).catch(() => {});
  1012	      return true;
  1013	    }, { description: 'Unlink session from topic', platforms: ['telegram'] });
  1014	
  1015	    this.sharedCommandRouter.register('interrupt', async (ctx) => {
  1016	      const topicId = parseInt(ctx.channelId, 10);
  1017	      const sessionName = this.getSessionForTopic(topicId);
  1018	      if (!sessionName) {
  1019	        await this.sendToTopic(topicId, 'No session linked to this topic.').catch(() => {});
  1020	        return true;
  1021	      }
  1022	      if (!this.onInterruptSession) {
  1023	        await this.sendToTopic(topicId, 'Interrupt not available (no handler registered).').catch(() => {});
  1024	        return true;
  1025	      }
  1026	      try {
  1027	        const success = await this.onInterruptSession(sessionName);
  1028	        this.clearStallForTopic(topicId);
  1029	        if (success) {
  1030	          await this.sendToTopic(topicId, `Nudged "${sessionName}" \u2014 it should resume shortly.`).catch(() => {});
  1031	        } else {
  1032	          await this.sendToTopic(topicId, `Failed to interrupt "${sessionName}" \u2014 session may not exist.`).catch(() => {});
  1033	        }
  1034	      } catch (err) {
  1035	        console.error(`[telegram] Interrupt failed:`, err);
  1036	        await this.sendToTopic(topicId, 'Couldn\'t interrupt the session. It may have already ended.').catch(() => {});
  1037	      }
  1038	      return true;
  1039	    }, { description: 'Send Escape to unstick a stalled session' });
  1040	
  1041	    this.sharedCommandRouter.register('restart', async (ctx) => {
  1042	      const topicId = parseInt(ctx.channelId, 10);
  1043	      const sessionName = this.getSessionForTopic(topicId);
  1044	      if (!sessionName) {
  1045	        await this.sendToTopic(topicId, 'No session linked to this topic.').catch(() => {});
  1046	        return true;
  1047	      }
  1048	      if (!this.onRestartSession) {
  1049	        await this.sendToTopic(topicId, 'Restart not available (no handler registered).').catch(() => {});
  1050	        return true;
  1051	      }
  1052	      this.clearStallForTopic(topicId);
  1053	      await this.sendToTopic(topicId, `Restarting "${sessionName}"...`).catch(() => {});
  1054	      try {
  1055	        await this.onRestartSession(sessionName, topicId);
  1056	        await this.sendToTopic(topicId, 'Session restarted.').catch(() => {});
  1057	      } catch (err) {
  1058	        console.error(`[telegram] Restart failed:`, err);
  1059	        await this.sendToTopic(topicId, 'Restart didn\'t work. The session may need to be recreated — try sending a new message.').catch(() => {});
  1060	      }
  1061	      return true;
  1062	    }, { description: 'Kill and respawn session' });
  1063	
  1064	    this.sharedCommandRouter.register('status', async (ctx) => {
  1065	      const topicId = parseInt(ctx.channelId, 10);
  1066	      const s = this.getStatus();
  1067	      const lines = [
  1068	        `Telegram adapter: ${s.started ? '\u2705 running' : '\u274c stopped'}`,
  1069	        `Uptime: ${s.uptime ? Math.round(s.uptime / 60000) + 'm' : 'n/a'}`,
  1070	        `Topic mappings: ${s.topicMappings}`,
  1071	        `Pending stall alerts: ${s.pendingStalls}`,
  1072	      ];
  1073	      await this.sendToTopic(topicId, lines.join('\n')).catch(() => {});
  1074	      return true;
  1075	    }, { description: 'Show adapter status' });
  1076	
  1077	    this.sharedCommandRouter.register(['switch-account', 'sa'], async (ctx) => {
  1078	      const topicId = parseInt(ctx.channelId, 10);
  1079	      if (!ctx.args) return false;
  1080	      if (this.onSwitchAccountRequest) {
  1081	        this.onSwitchAccountRequest(ctx.args, topicId).catch(err => {
  1082	          console.error('[telegram] Switch account failed:', err);
  1083	          this.sendToTopic(topicId, 'Account switch didn\'t work. Try again or use /quota to check status.').catch(() => {});
  1084	        });
  1085	      } else {
  1086	        await this.sendToTopic(topicId, 'Account switching not available.').catch(() => {});
  1087	      }
  1088	      return true;
  1089	    }, { description: 'Switch active Claude account' });
  1090	
  1091	    this.sharedCommandRouter.register(['quota', 'q'], async (ctx) => {
  1092	      const topicId = parseInt(ctx.channelId, 10);
  1093	      if (this.onQuotaStatusRequest) {
  1094	        this.onQuotaStatusRequest(topicId).catch(err => {
  1095	          console.error('[telegram] Quota status failed:', err);
  1096	          this.sendToTopic(topicId, 'Couldn\'t check quota right now. Try again in a moment.').catch(() => {});
  1097	        });
  1098	      } else {
  1099	        await this.sendToTopic(topicId, 'Quota status not available.').catch(() => {});
  1100	      }
  1101	      return true;
  1102	    }, { description: 'Show multi-account quota summary' });
  1103	
  1104	    this.sharedCommandRouter.register('login', async (ctx) => {
  1105	      const topicId = parseInt(ctx.channelId, 10);
  1106	      const email = ctx.args || null;
  1107	      if (this.onLoginRequest) {
  1108	        this.onLoginRequest(email, topicId).catch(err => {
  1109	          console.error('[telegram] Login flow failed:', err);
  1110	          this.sendToTopic(topicId, 'Login didn\'t complete. Try again, or the auth service may be temporarily unavailable.').catch(() => {});
  1111	        });
  1112	      } else {
  1113	        await this.sendToTopic(topicId, 'Login not available.').catch(() => {});
  1114	      }
  1115	      return true;
  1116	    }, { description: 'Seamless OAuth login from Telegram' });
  1117	  }
  1118	
  1119	  async start(): Promise<void> {
  1120	    if (this.polling) return;
  1121	    // HARDENED (v1.3.270 incident): without a usable bot token (empty/normalized
  1122	    // placeholder), getUpdates 404s forever — a zombie poll loop that looks alive
  1123	    // but never serves a message. Refuse to start polling and say why; send-only
  1124	    // paths (relay) keep working, and the supervisor's next restart recovers full
  1125	    // service once the secret store is readable again.
  1126	    if (typeof this.config.token !== 'string' || this.config.token.length === 0) {
  1127	      this.fatalPollReason = 'no-usable-bot-token';
  1128	      console.error(
  1129	        '[telegram] NOT starting long-polling: no usable bot token (unresolved secret placeholder or empty token). ' +
  1130	        'The secret store was likely unavailable at boot — restart after it recovers to restore polling.',
  1131	      );
  1132	      return;
  1133	    }
  1134	    this.polling = true;
  1135	    this.startedAt = new Date();
  1136	    this.consecutivePollErrors = 0;
  1137	    this.lastPollError = null;
  1138	    this.fatalPollReason = null;
  1139	    this.pollStoppedAt = null;
  1140	    this.pending401Retry = false;
  1141	
  1142	    // Ensure Lifeline topic exists (auto-recreate if deleted). A non-primary adapter
  1143	    // (e.g. the mentor bot) must NOT create a second Lifeline topic in the chat.
  1144	    if (!this.suppressLifelineAutoCreate) {
  1145	      await this.ensureLifelineTopic();
  1146	    }
  1147	
  1148	    console.log(`[telegram] Starting long-polling...`);
  1149	    this.poll();
  1150	
  1151	    // Resolve any topic names still using the fallback "topic-NNNN" pattern
  1152	    this.resolveUnknownTopicNames().catch(err => {
  1153	      console.warn(`[telegram] Topic name resolution failed: ${err}`);
  1154	    });
  1155	
  1156	    // Start notification batcher if configured
  1157	    if (this.batcher) {
  1158	      this.batcher.start();
  1159	      console.log('[telegram] Notification batcher started');
  1160	    }
  1161	
  1162	    // Start stall detection if configured
  1163	    if (this.sharedStallDetector) {
  1164	      // Phase 1c: Wire shared stall detector callbacks and start
  1165	      this.sharedStallDetector.setIsSessionAlive(this.onIsSessionAlive ? (name) => this.onIsSessionAlive!(name) : null);
  1166	      this.sharedStallDetector.setIsSessionActive(this.onIsSessionActive ? (name) => this.onIsSessionActive!(name) : null);
  1167	      this.sharedStallDetector.setOnStall(async (event, alive) => {
  1168	        await this.handleSharedStallEvent(event, alive);
  1169	      });
  1170	      this.sharedStallDetector.start();
  1171	    } else {
  1172	      const stallMinutes = this.config.stallTimeoutMinutes ?? 5;
  1173	      if (stallMinutes > 0) {
  1174	        this.stallCheckInterval = setInterval(() => this.checkForStalls(), 30_000);
  1175	      }
  1176	    }
  1177	  }
  1178	
  1179	  async stop(): Promise<void> {
  1180	    this.polling = false;
  1181	    if (this.pollTimeout) {
  1182	      clearTimeout(this.pollTimeout);
  1183	      this.pollTimeout = null;
  1184	    }
  1185	    if (this.sharedStallDetector) {
  1186	      this.sharedStallDetector.stop();
  1187	    }
  1188	    if (this.stallCheckInterval) {
  1189	      clearInterval(this.stallCheckInterval);
  1190	      this.stallCheckInterval = null;
  1191	    }
  1192	    // Flush and stop the batcher on shutdown
  1193	    if (this.batcher) {
  1194	      try {
  1195	        await this.batcher.flushAll();
  1196	      } catch (err) {
  1197	        console.error('[telegram] Failed to flush batcher on stop:', err);
  1198	      }
  1199	      this.batcher.stop();
  1200	    }
  1201	  }
  1202	
  1203	  // ── Channel Seamlessness Contract (spec §) — Telegram reference impl ──
  1204	
  1205	  /**
  1206	   * Stable provider-level identity for an inbound update — the Telegram
  1207	   * update_id. Used by the message-processing ledger so a redelivered update
  1208	   * (retry / reconnect / transfer-window overlap) is recognized and not
  1209	   * re-acted-on.
  1210	   */
  1211	  dedupeKey(rawEvent: unknown): string {
  1212	    const u = rawEvent as { update_id?: number } | undefined;
  1213	    if (u && typeof u.update_id === 'number') return `telegram:${u.update_id}`;
  1214	    // Fallback for already-normalized Message objects carrying the id in metadata.
  1215	    const m = rawEvent as { metadata?: { update_id?: number }; id?: string } | undefined;
  1216	    if (m?.metadata?.update_id != null) return `telegram:${m.metadata.update_id}`;
  1217	    return `telegram:${m?.id ?? 'unknown'}`;
  1218	  }
  1219	
  1220	  /** The durable resumable position — the long-poll update_id offset. */
  1221	  getIngressPosition(): IngressPosition {
  1222	    return { platform: 'telegram', cursor: this.lastUpdateId, capturedAt: new Date().toISOString() };
  1223	  }
  1224	
  1225	  /**
  1226	   * Stop the inbound loop deterministically and return the durable position
  1227	   * AFTER the stop (the persisted offset), so a handoff resumes from exactly
  1228	   * where this machine left off — never replaying or skipping.
  1229	   */
  1230	  async stopConsuming(): Promise<IngressPosition> {
  1231	    this.polling = false;
  1232	    if (this.pollTimeout) {
  1233	      clearTimeout(this.pollTimeout);
  1234	      this.pollTimeout = null;
  1235	    }
  1236	    this.saveOffset(); // durable — the position is the persisted offset, not the in-memory cursor
  1237	    return this.getIngressPosition();
  1238	  }
  1239	
  1240	  /** Resume the inbound loop from exactly the given position. */
  1241	  async resumeConsuming(position: IngressPosition): Promise<void> {
  1242	    if (position.platform !== 'telegram') {
  1243	      throw new Error(`resumeConsuming: wrong platform ${position.platform} for telegram adapter`);
  1244	    }
  1245	    const cursor = typeof position.cursor === 'number' ? position.cursor : Number(position.cursor);
  1246	    if (Number.isFinite(cursor) && cursor >= 0) {
  1247	      // Resume from exactly this offset (never lower than what we know, to avoid replay).
  1248	      this.lastUpdateId = Math.max(this.lastUpdateId, cursor);
  1249	      this.saveOffset();
  1250	    }
  1251	    if (!this.polling) {
  1252	      await this.start();
  1253	    }
  1254	  }
  1255	
  1256	  async send(message: OutgoingMessage): Promise<SendResult> {
  1257	    const topicId = message.channel?.identifier;
  1258	    const params: Record<string, unknown> = {
  1259	      chat_id: this.config.chatId,
  1260	      text: message.content,
  1261	      parse_mode: 'Markdown',
  1262	    };
  1263	
  1264	    if (topicId && !isGeneralTopic(parseInt(topicId, 10))) {
  1265	      params.message_thread_id = parseInt(topicId, 10);
  1266	    }
  1267	
  1268	    try {
  1269	      const result = await this.apiCall('sendMessage', params) as { message_id: number };
  1270	      return { messageId: result.message_id, topicId: topicId ? parseInt(topicId, 10) : undefined };
  1271	    } catch (err) {
  1272	      // Only retry without parse_mode on 400 errors (likely Markdown parse failures)
  1273	      const errMsg = err instanceof Error ? err.message : String(err);
  1274	      if (errMsg.includes('(400)') && params.parse_mode) {
  1275	        delete params.parse_mode;
  1276	        const result = await this.apiCall('sendMessage', params) as { message_id: number };
  1277	        return { messageId: result.message_id, topicId: topicId ? parseInt(topicId, 10) : undefined };
  1278	      }
  1279	      throw err;
  1280	    }
  1281	  }
  1282	
  1283	  /**
  1284	   * Log an inbound user message that arrived via an external path (e.g. Lifeline
  1285	   * forwarding through /internal/telegram-forward). This ensures the message
  1286	   * appears in both JSONL and TopicMemory even when the normal polling handler
  1287	   * didn't receive it.
  1288	   */
  1289	  logInboundMessage(entry: {
  1290	    messageId: number;
  1291	    topicId: number;
  1292	    text: string;
  1293	    timestamp: string;
  1294	    senderName?: string;
  1295	    senderUsername?: string;
  1296	    telegramUserId?: number;
  1297	    /** BIAS-TO-ACTION-SPEC D10: forwarded provenance from the lifeline wire.
  1298	     *  Persisted EXPLICITLY (defaults to false) so the standing-authorization
  1299	     *  resolver can prove a lifeline-ingested operator row is non-forwarded. */
  1300	    forwarded?: boolean;
  1301	  }): void {
  1302	    this.appendToLog({
  1303	      messageId: entry.messageId,
  1304	      topicId: entry.topicId,
  1305	      text: entry.text,
  1306	      fromUser: true,
  1307	      timestamp: entry.timestamp,
  1308	      sessionName: this.topicToSession.get(entry.topicId) ?? null,
  1309	      senderName: entry.senderName,
  1310	      senderUsername: entry.senderUsername,
  1311	      telegramUserId: entry.telegramUserId,
  1312	      forwarded: entry.forwarded === true,
  1313	      provenance: 'user',
  1314	    });
  1315	  }
  1316	
  1317	  /**
  1318	   * Send a message to a specific forum topic.
  1319	   * Returns the Telegram message ID for delivery confirmation.
  1320	   */
  1321	  async sendToTopic(
  1322	    topicId: number,
  1323	    text: string,
  1324	    options?: {
  1325	      silent?: boolean;
  1326	      skipStallClear?: boolean;
  1327	      /** Kind metadata (messageKind/senderClass/advisoryAck…) forwarded to
  1328	       *  the holder on a RELAYED send so the kind survives the cross-machine
  1329	       *  hop (spec outbound-jargon-filepath-gap §2.5). Direct sends ignore it
  1330	       *  — the local route already consumed it. */
  1331	      kindMetadata?: Record<string, unknown>;
  1332	      /** Conversational agent reply vs server-generated outbound traffic. */
  1333	      provenance?: Exclude<MessageProvenance, 'user'>;
  1334	      /** 'html' = the caller already produced ESCAPED Telegram HTML (e.g. the
  1335	       *  attention-hub post) — the send carries `parse_mode: 'HTML'` +
  1336	       *  `_formatMode: 'html'` so applyTelegramFormatter's markdown converter
  1337	       *  does not re-escape the tags into literal `<b>`/`<i>` text (the
  1338	       *  2026-07-11 attention-hub rendering bug). Direct sends only; a relayed
  1339	       *  (tokenless-standby) send keeps today's default formatting. */
  1340	      formatMode?: 'html';
  1341	    },
  1342	  ): Promise<SendResult> {
  1343	    // NOT the chokepoint, and this comment is the correction of a claim that stood here.
  1344	    //
  1345	    // It read "THE CHOKEPOINT. Every Telegram send passes through here." Review pass 29 falsified
  1346	    // that by execution: `send()` — the MessagingAdapter interface method a router calls — reaches
  1347	    // the API without entering this function. Derived population: 14 `apiCall('sendMessage')` sites
  1348	    // in this class across 9 methods, of which this one accounted for 4.
  1349	    //
  1350	    // THERE ARE TWO EGRESS MECHANISMS IN THIS CLASS, not one, and that is the correction that cost
  1351	    // the most to learn. `apiCall` is the only path to `fetch` — but the tokenless-standby branch
  1352	    // below relays the body to another machine's router and never enters `apiCall` at all. Guarding
  1353	    // only the API funnel left that branch uncovered; an independent second-pass reviewer proved it
  1354	    // by execution, which makes the relay the FIFTH falsification of "every send passes through
  1355	    // here" — found inside the change that retired the phrase.
  1356	    //
  1357	    // So the refusal is applied per EGRESS, not per function: `apiCall` covers the API path and the
  1358	    // relay call site covers the relay path. That is not the duplication review pass 23 warns about
  1359	    // (two copies closing the SAME case, masking each other's tests) — these close DIFFERENT cases,
  1360	    // and each has its own test that reds when only its own guard is removed.
  1361	    const params: Record<string, unknown> = {
  1362	      chat_id: this.config.chatId,
  1363	      text,
  1364	    };
  1365	    if (!isGeneralTopic(topicId)) {
  1366	      params.message_thread_id = topicId;
  1367	    }
  1368	    if (options?.silent) {
  1369	      params.disable_notification = true;
  1370	    }
  1371	
  1372	    let result: { message_id: number };
  1373	    // A pool standby's bot token is externalized and arrives UNRESOLVED as a non-string
  1374	    // placeholder (e.g. `{ secret: true }`), not null — which is truthy, so the old
  1375	    // `!this.config.token` check thought a token existed and attempted a doomed direct API
  1376	    // send (the moved session's reply 200'd internally but never reached Telegram). The only
  1377	    // usable token is a non-empty string; anything else (placeholder/null/empty) means
  1378	    // "no usable token" → relay through the Telegram-owning router (bug #7).
  1379	    const hasUsableBotToken = typeof this.config.token === 'string' && this.config.token.length > 0;
  1380	    if (!hasUsableBotToken && this.outboundRelay) {
  1381	      // Tokenless standby (bug #7): relay the send through the Telegram-owning router
  1382	      // instead of calling the API with no token. The rest of this method's bookkeeping
  1383	      // (log, stall-clear, promise-tracking) then runs identically on the relayed id.
  1384	      //
  1385	      // EGRESS 2 of 2. This never reaches `apiCall`, so the funnel refusal cannot see it. Refusing
  1386	      // here keeps the guarantee whole and — equally important — keeps the failure HONEST: the far
  1387	      // end does refuse an invisible body, but with a 400, and `isRelayRefusal` recognises only 422,
  1388	      // so relying on it would surface a CONTENT refusal as `relay failed … router unreachable`.
  1389	      // That conflation of "refused" with "could not reach" is the exact bug TelegramRelay's own
  1390	      // header records having fixed.
  1391	      // THE ONE SURVIVING PER-SENDER GUARD, and the reason CMT-1246's criterion (b) — "every
  1392	      // per-sender call is DELETED" — cannot be met literally without opening a hole.
  1393	      //
  1394	      // The egress door (src/messaging/telegram-egress.ts) owns every other path because every other
  1395	      // path reaches api.telegram.org from THIS process. This one does not: it hands the message to
  1396	      // another machine, which sends it. The door cannot see a request this process never makes.
  1397	      //
  1398	      // Criterion (b) was written before that was understood. It is satisfied everywhere the door can
  1399	      // reach — seven of eight calls deleted — and this one stays, deliberately and named, rather than
  1400	      // deleted to make a checklist come out even.
  1401	      assertTelegramPayloadVisible('sendMessage', { text });
  1402	      const relayed = await this.outboundRelay(topicId, text, {
  1403	        silent: options?.silent,
  1404	        kindMetadata: options?.kindMetadata,
  1405	        provenance: options?.provenance ?? 'automation',
  1406	      });
  1407	      if (!relayed) {
  1408	        throw new Error('telegram outbound relay failed (tokenless standby, router unreachable)');
  1409	      }
  1410	      result = { message_id: relayed.messageId };
  1411	    } else if (options?.formatMode === 'html') {
  1412	      // Caller-authored, already-escaped Telegram HTML: one deterministic send.
  1413	      // On a rare 400 (malformed entity), fall back to the plain-param send so
  1414	      // the message still delivers (tags visible — never worse than the bug).
  1415	      try {
  1416	        result = await this.apiCall('sendMessage', { ...params, parse_mode: 'HTML', _formatMode: 'html' }) as { message_id: number };
  1417	      } catch (err) {
  1418	        // A PRE-FORMAT refusal is terminal — the source carried no content, so no retry can help, and
  1419	        // the bare retry logged it TWICE (review pass 30 finding 2). A POST-FORMAT refusal is NOT
  1420	        // terminal here, and that distinction is review pass 34 finding 1: the plain-params retry is a
  1421	        // DIFFERENT REPRESENTATION, and the post-format rule is precisely a claim about representation.
  1422	        // Malformed HTML with no text nodes has no reader-visible content AS HTML and is perfectly
  1423	        // visible as plain text — the retry shows the tags, which this path exists to do. Refusing it
  1424	        // outright destroyed a deliverable message, which the guard's own policy forbids.
  1425	        //
  1426	        // My sentence above ("retrying cannot make an invisible payload visible") was true of the rule
  1427	        // that existed when I wrote it and false of the rule I added an hour later. The two fixes
  1428	        // interacted, and only a reading that asked about the interaction found it.
  1429	        // BOTH invisible-payload rules are terminal. The retry below re-enters the formatter (it does
  1430	        // not set `_isPlainRetry`), so a post-format refusal would be re-derived and re-recorded —
  1431	        // review pass 35 finding 1 measured two decision records for one operation, reopening the
  1432	        // one-operation-one-record invariant pass 30 closed. Retrying also cannot help: the guard
  1433	        // already allows every representation whose extraction is EMPTY. Reaching here means the
  1434	        // extraction was non-empty and carried nothing visible.
  1435	        //
  1436	        // That is NOT the same as "the reader provably receives nothing", which is what this said
  1437	        // until review pass 36 finding 5: malformed tag-shaped source would be shown to the reader
  1438	        // after Telegram rejects the parse, and this refuses it anyway. The refusal is still right
  1439	        // for the case it was built for and wrong for that one; both ride CMT-1260.
  1440	        if (err instanceof InvisiblePayloadRefusedError) throw err;
  1441	        result = await this.apiCall('sendMessage', params) as { message_id: number };
  1442	      }
  1443	    } else {
  1444	      try {
  1445	        result = await this.apiCall('sendMessage', { ...params, parse_mode: 'Markdown' }) as { message_id: number };
  1446	      } catch (err) {
  1447	        // A PRE-FORMAT refusal is terminal — the source carried no content, so no retry can help, and
  1448	        // the bare retry logged it TWICE (review pass 30 finding 2). A POST-FORMAT refusal is NOT
  1449	        // terminal here, and that distinction is review pass 34 finding 1: the plain-params retry is a
  1450	        // DIFFERENT REPRESENTATION, and the post-format rule is precisely a claim about representation.
  1451	        // Malformed HTML with no text nodes has no reader-visible content AS HTML and is perfectly
  1452	        // visible as plain text — the retry shows the tags, which this path exists to do. Refusing it
  1453	        // outright destroyed a deliverable message, which the guard's own policy forbids.
  1454	        //
  1455	        // My sentence above ("retrying cannot make an invisible payload visible") was true of the rule
  1456	        // that existed when I wrote it and false of the rule I added an hour later. The two fixes
  1457	        // interacted, and only a reading that asked about the interaction found it.
  1458	        // BOTH invisible-payload rules are terminal. The retry below re-enters the formatter (it does
  1459	        // not set `_isPlainRetry`), so a post-format refusal would be re-derived and re-recorded —
  1460	        // review pass 35 finding 1 measured two decision records for one operation, reopening the
  1461	        // one-operation-one-record invariant pass 30 closed. Retrying also cannot help: the guard
  1462	        // already allows every representation whose extraction is EMPTY. Reaching here means the
  1463	        // extraction was non-empty and carried nothing visible.
  1464	        //
  1465	        // That is NOT the same as "the reader provably receives nothing", which is what this said
  1466	        // until review pass 36 finding 5: malformed tag-shaped source would be shown to the reader
  1467	        // after Telegram rejects the parse, and this refuses it anyway. The refusal is still right
  1468	        // for the case it was built for and wrong for that one; both ride CMT-1260.
  1469	        if (err instanceof InvisiblePayloadRefusedError) throw err;
  1470	        result = await this.apiCall('sendMessage', params) as { message_id: number };
  1471	      }
  1472	    }
  1473	
  1474	    // Log outbound messages too
  1475	    this.appendToLog({
  1476	      messageId: result.message_id,
  1477	      topicId,
  1478	      text,
  1479	      fromUser: false,
  1480	      timestamp: new Date().toISOString(),
  1481	      sessionName: this.topicToSession.get(topicId) ?? null,
  1482	      provenance: options?.provenance ?? 'automation',
  1483	    });
  1484	
  1485	    // Clear stall tracking for this topic (agent responded)
  1486	    // Skip for proxy messages — PresenceProxy messages should NOT reset stall timers
  1487	    if (!options?.skipStallClear) {
  1488	      this.clearStallForTopic(topicId);
  1489	    }
  1490	
  1491	    // Promise tracking — detect agent "working on it" messages that need follow-through
  1492	    const sessionName = this.topicToSession.get(topicId);
  1493	    if (sessionName) {
  1494	      // Phase 1c: Delegate to shared StallDetector when flag is enabled
  1495	      if (this.sharedStallDetector) {
  1496	        this.sharedStallDetector.trackOutboundMessage(topicId.toString(), sessionName, text);
  1497	      } else {
  1498	        if (this.isPromiseMessage(text)) {
  1499	          this.pendingPromises.set(topicId, {
  1500	            topicId,
  1501	            sessionName,
  1502	            promiseText: text.slice(0, 100),
  1503	            promisedAt: Date.now(),
  1504	            alerted: false,
  1505	          });
  1506	        } else if (this.pendingPromises.has(topicId) && this.isFollowThroughMessage(text)) {
  1507	          this.pendingPromises.delete(topicId);
  1508	        }
  1509	      }
  1510	    }
  1511	
  1512	    return { messageId: result.message_id, topicId };
  1513	  }
  1514	
  1515	  /**
  1516	   * Send a notification through the batcher, falling back to direct send.
  1517	   * Use this for internal system notifications that should be batched.
  1518	   */
  1519	  async notifyTopic(topicId: number, text: string, tier: NotificationTier, category: string): Promise<void> {
  1520	    if (this.batcher && this.batcher.isEnabled()) {
  1521	      await this.batcher.enqueue({
  1522	        tier,
  1523	        category,
  1524	        message: text,
  1525	        timestamp: new Date(),
  1526	        topicId,
  1527	      });
  1528	    } else {
  1529	      // No batcher or disabled — send directly
  1530	      await this.sendToTopic(topicId, text);
  1531	    }
  1532	  }
  1533	
  1534	  /**
  1535	   * Configure the notification batcher. Call before start() to enable batching.
  1536	   * The batcher's send function is wired to sendToTopic automatically.
  1537	   */
  1538	  configureBatcher(config?: { summaryIntervalMinutes?: number; digestIntervalMinutes?: number; quietHours?: { enabled: boolean; start: string; end: string } }): NotificationBatcher {
  1539	    this.batcher = new NotificationBatcher({
  1540	      enabled: true,
  1541	      ...config,
  1542	    });
  1543	    this.batcher.setSendFunction((topicId, text) => this.sendToTopic(topicId, text));
  1544	    return this.batcher;
  1545	  }
  1546	
  1547	  /**
  1548	   * Get the notification batcher (if configured).
  1549	   */
  1550	  getBatcher(): NotificationBatcher | null {
  1551	    return this.batcher;
  1552	  }
  1553	
  1554	  /**
  1555	   * Create a forum topic in the supergroup.
  1556	   *
  1557	   * THE TOPIC-CREATION CHOKEPOINT. Every topic this process creates is born
  1558	   * here, so the last-resort flood ceiling lives here (see
  1559	   * `topicCreationBudget` on the config). `opts.origin` declares who is
  1560	   * asking:
  1561	   *   - 'user'   — a human asked for this topic (operator command, inbound
  1562	   *                conversation). Exempt: humans are self-rate-limiting.
  1563	   *   - 'system' — a bounded, create-once-then-reuse infrastructure topic
  1564	   *                (Lifeline, Dashboard, Updates, the flood-notice topic
  1565	   *                itself). Exempt: cardinality is fixed by design.
  1566	   *   - 'auto'   — anything a feature decided to create on its own. Counted.
  1567	   *                THIS IS THE DEFAULT — a caller that doesn't declare an
  1568	   *                origin is budgeted, so a future mis-wired feature is
  1569	   *                bounded without having to know this mechanism exists.
  1570	   * Past the budget this throws TopicFloodBudgetError — the same failure
  1571	   * shape as a Telegram 429, which every caller already survives.
  1572	   */
  1573	  async createForumTopic(
  1574	    name: string,
  1575	    iconColor?: number,
  1576	    opts?: { origin?: 'user' | 'system' | 'auto'; label?: string; bounded?: boolean },
  1577	  ): Promise<{ topicId: number; name: string }> {
  1578	    if (this.notAForum) {
  1579	      throw new Error('Chat is not a forum — topic creation skipped');
  1580	    }
  1581	
  1582	    const origin = opts?.origin ?? 'auto';
  1583	    // ── Universal last-resort flood ceiling (2026-07-04 conservatism pass) ──
  1584	    // The ONLY topics exempt from the ceiling are (a) a topic the HUMAN
  1585	    // explicitly asked for (`origin: 'user'`) and (b) a topic a caller declares
  1586	    // is cardinality-BOUNDED by design (`bounded: true` — a create-once-then-
  1587	    // reuse system topic like Lifeline/Dashboard/Updates/Agent-Health/the flood-
  1588	    // notice surface itself). EVERYTHING ELSE — including a bare `origin:
  1589	    // 'system'` — rides the ceiling. This closes the origin:'system' bypass that
  1590	    // let a per-item stream (e.g. HIGH/URGENT attention items) or any future
  1591	    // mis-wired caller dodge the "universal" budget entirely by simply declaring
  1592	    // itself 'system'. Structure over willpower: the ceiling can no longer be
  1593	    // sidestepped with a label. (Operator directive 2026-07-01: "be extremely
  1594	    // conservative with what messages get sent to Telegram … messages should NOT
  1595	    // create their own topics … applies to ALL aspects of INSTAR".)
  1596	    const exemptFromCeiling = origin === 'user' || opts?.bounded === true;
  1597	    if (!exemptFromCeiling) {
  1598	      const label = opts?.label ?? (origin === 'system' ? 'unlabeled-system' : 'unlabeled-auto');
  1599	      const decision = this.topicCreationGuard.decide(label, undefined);
  1600	      if (decision.action === 'coalesce') {
  1601	        console.warn(
  1602	          `[telegram] topic-creation budget: REFUSED ${origin} topic "${name}" ` +
  1603	          `(label=${label}, bucket=${decision.bucket}, #${decision.suppressedCount} in episode) — ` +
  1604	          `the last-resort flood ceiling. If this label is legitimate at this volume, ` +
  1605	          `raise messaging[].config.topicCreationBudget; if it is a bounded create-once ` +
  1606	          `system topic, pass { bounded: true }.`,
  1607	        );
  1608	        throw new TopicFloodBudgetError(name, label, decision.bucket);
  1609	      }
  1610	    }
  1611	
  1612	    const params: Record<string, unknown> = {
  1613	      chat_id: this.config.chatId,
  1614	      name,
  1615	    };
  1616	    if (iconColor !== undefined) {
  1617	      params.icon_color = iconColor;
  1618	    }
  1619	
  1620	    try {
  1621	      const result = await this.apiCall('createForumTopic', params) as {
  1622	        message_thread_id: number;
  1623	        name: string;
  1624	      };
  1625	
  1626	      this.topicToName.set(result.message_thread_id, name);
  1627	      this.saveRegistry();
  1628	
  1629	      console.log(`[telegram] Created forum topic: "${name}" (ID: ${result.message_thread_id})`);
  1630	      return { topicId: result.message_thread_id, name: result.name };
  1631	    } catch (err) {
  1632	      const errStr = String(err);
  1633	      if (errStr.includes('not a forum') || errStr.includes('FORUM_REQUIRED')) {
  1634	        this.notAForum = true;
  1635	        if (!this.notAForumWarned) {
  1636	          this.notAForumWarned = true;
  1637	          console.warn('[telegram] ⚠️ Chat is not a forum-enabled supergroup. Forum topics (Lifeline, Dashboard, per-session) will not be created. Messaging will use the General Topic. To enable topics, convert your Telegram group to a supergroup with Topics enabled in group settings.');
  1638	        }
  1639	      }
  1640	      throw err;
  1641	    }
  1642	  }
  1643	
  1644	  /**
  1645	   * Edit a forum topic's name and/or icon color.
  1646	   * Best-effort — silently ignores failures (topic may not exist).
  1647	   */
  1648	  async editForumTopic(topicId: number, name?: string, iconColor?: number): Promise<boolean> {
  1649	    const params: Record<string, unknown> = {
  1650	      chat_id: this.config.chatId,
  1651	      message_thread_id: topicId,
  1652	    };
  1653	    if (name !== undefined) params.name = name;
  1654	    if (iconColor !== undefined) params.icon_color = iconColor;
  1655	
  1656	    try {
  1657	      await this.apiCall('editForumTopic', params);
  1658	      if (name) {
  1659	        this.topicToName.set(topicId, name);
  1660	        this.saveRegistry();
  1661	      }
  1662	      console.log(`[telegram] Renamed topic ${topicId} → "${name}"`);
  1663	      return true;
  1664	    } catch {
  1665	      // @silent-fallback-ok — best-effort rename
  1666	      return false;
  1667	    }
  1668	  }
  1669	
  1670	  /**
  1671	   * Find an existing topic by name, or create a new one if none exists.
  1672	   * Prevents duplicate topics when sessions respawn or the server restarts.
  1673	   */
  1674	  async findOrCreateForumTopic(
  1675	    name: string,
  1676	    iconColor?: number,
  1677	    opts?: { origin?: 'user' | 'system' | 'auto'; label?: string; bounded?: boolean },
  1678	  ): Promise<{ topicId: number; name: string; reused: boolean }> {
  1679	    const normalizedName = name.toLowerCase().trim();
  1680	    for (const [topicId, existingName] of this.topicToName) {
  1681	      if (existingName.toLowerCase().trim() === normalizedName) {
  1682	        console.log(`[telegram] Reusing existing topic ${topicId} for "${name}"`);
  1683	        return { topicId, name: existingName, reused: true };
  1684	      }
  1685	    }
  1686	    const result = await this.createForumTopic(name, iconColor, opts);
  1687	    return { ...result, reused: false };
  1688	  }
  1689	
  1690	  /**
  1691	   * Get the Lifeline topic ID (if configured).
  1692	   */
  1693	  getLifelineTopicId(): number | undefined {
  1694	    return this.config.lifelineTopicId;
  1695	  }
  1696	
  1697	  /**
  1698	   * Owner principal — the single Telegram user id who controls
  1699	   * security-sensitive decisions for this instance. Falls back to the
  1700	   * promptGate.ownerId for back-compat when ownerUserId isn't
  1701	   * explicitly configured.
  1702	   */
  1703	  getOwnerUserId(): number | undefined {
  1704	    return this.config.ownerUserId ?? this.config.promptGate?.ownerId;
  1705	  }
  1706	
  1707	  /**
  1708	   * Send a private DM to the owner principal. Telegram's bot API
  1709	   * permits the bot to initiate a DM only after the user has messaged
  1710	   * the bot at least once; if the user has never DM'd the bot, the
  1711	   * send will fail with HTTP 403 ("forbidden: bot can't initiate
  1712	   * conversation with a user"). Callers should treat a null return
  1713	   * as a non-fatal degradation, NOT a fatal error.
  1714	   *
  1715	   * Per the tunnel-failure-resilience spec (Part 3 — two-channel
  1716	   * notification), this is the ONLY channel that ever carries the
  1717	   * URL + PIN + signed view links. Group topics get status text
  1718	   * only.
  1719	   *
  1720	   * Returns the SendResult on success; null on any failure (no
  1721	   * owner configured, owner never DM'd the bot, network error,
  1722	   * etc.). All failure paths are logged-not-thrown to preserve the
  1723	   * fire-and-forget contract callers expect for outbound messaging.
  1724	   */
  1725	  async sendToOwnerDM(text: string): Promise<SendResult | null> {
  1726	    const owner = this.getOwnerUserId();
  1727	    if (!owner) {
  1728	      console.warn('[telegram] sendToOwnerDM called but no ownerUserId is configured');
  1729	      return null;
  1730	    }
  1731	    try {
  1732	      const params: Record<string, unknown> = {
  1733	        chat_id: owner,
  1734	        text,
  1735	      };
  1736	      const result = await this.apiCall('sendMessage', params) as { message_id: number };
  1737	      return { messageId: result.message_id };
  1738	    } catch (err) {
  1739	      const msg = err instanceof Error ? err.message : String(err);
  1740	      if (msg.includes('forbidden') || msg.includes('403')) {
  1741	        console.warn(`[telegram] sendToOwnerDM forbidden — owner ${owner} hasn't messaged the bot yet`);
  1742	      } else {
  1743	        console.warn(`[telegram] sendToOwnerDM failed: ${msg}`);
  1744	      }
  1745	      return null;
  1746	    }
  1747	  }
  1748	
  1749	  /**
  1750	   * Ensure the Lifeline topic exists. If it was deleted, recreate it.
  1751	   * Called on startup and can be called periodically.
  1752	   */
  1753	  async ensureLifelineTopic(): Promise<number | null> {
  1754	    if (this.notAForum) return null;
  1755	    const styledName = `${TOPIC_STYLE.SYSTEM.emoji} Lifeline`;
  1756	    if (!this.config.lifelineTopicId) {
  1757	      // No lifeline topic configured — create one
  1758	      try {
  1759	        const topic = await this.createForumTopic(styledName, TOPIC_STYLE.SYSTEM.color, { origin: 'system', bounded: true, label: 'lifeline' });
  1760	        this.config.lifelineTopicId = topic.topicId;
  1761	        this.persistLifelineTopicId(topic.topicId);
  1762	        console.log(`[telegram] Created Lifeline topic: ${topic.topicId}`);
  1763	        return topic.topicId;
  1764	      } catch (err) {
  1765	        // @silent-fallback-ok — lifeline topic creation, logged
  1766	        console.error(`[telegram] Failed to create Lifeline topic: ${err}`);
  1767	        return null;
  1768	      }
  1769	    }
  1770	
  1771	    // Lifeline topic ID exists — verify it's still valid silently.
  1772	    // Don't send a visible message — it spams the user on every server restart.
  1773	    try {
  1774	      await this.apiCall('sendChatAction', {
  1775	        chat_id: this.config.chatId,
  1776	        message_thread_id: this.config.lifelineTopicId,
  1777	        action: 'typing',
  1778	      });
  1779	      // Best-effort rename to styled name if it doesn't match
  1780	      const currentName = this.topicToName.get(this.config.lifelineTopicId);
  1781	      if (currentName && !currentName.includes(TOPIC_STYLE.SYSTEM.emoji)) {
  1782	        await this.editForumTopic(this.config.lifelineTopicId, styledName, TOPIC_STYLE.SYSTEM.color);
  1783	      }
  1784	      console.log(`[telegram] Lifeline topic verified: ${this.config.lifelineTopicId}`);
  1785	      return this.config.lifelineTopicId;
  1786	    } catch (err) {
  1787	      const errStr = String(err);
  1788	      // Topic was deleted — "message thread not found" or "TOPIC_CLOSED" or similar
  1789	      if (errStr.includes('thread not found') || errStr.includes('TOPIC_DELETED') ||
  1790	          errStr.includes('TOPIC_CLOSED') || errStr.includes('not found')) {
  1791	        console.log(`[telegram] Lifeline topic ${this.config.lifelineTopicId} was deleted — recreating`);
  1792	        try {
  1793	          const topic = await this.createForumTopic(styledName, TOPIC_STYLE.SYSTEM.color, { origin: 'system', bounded: true, label: 'lifeline' });
  1794	          this.config.lifelineTopicId = topic.topicId;
  1795	          this.persistLifelineTopicId(topic.topicId);
  1796	          console.log(`[telegram] Recreated Lifeline topic: ${topic.topicId}`);
  1797	          return topic.topicId;
  1798	        } catch (recreateErr) {
  1799	          DegradationReporter.getInstance().report({
  1800	            feature: 'Telegram.Lifeline',
  1801	            primary: 'Verified lifeline topic for emergency agent communication',
  1802	            fallback: 'No lifeline topic — agent unreachable in emergencies',
  1803	            reason: `Lifeline topic deleted and recreation failed: ${recreateErr instanceof Error ? recreateErr.message : String(recreateErr)}`,
  1804	            impact: 'Agent cannot receive emergency commands or stall recovery signals.',
  1805	          });
  1806	          return null;
  1807	        }
  1808	      }
  1809	      // Some other error (network, etc.) — retry once before reporting degradation.
  1810	      // Transient errors like "This operation was aborted" (15s fetch timeout) should
  1811	      // not trigger degradation on the first attempt — a brief retry on startup resolves them.
  1812	      let retryErr: unknown = err;
  1813	      try {
  1814	        await new Promise<void>(resolve => setTimeout(resolve, 3000));
  1815	        await this.apiCall('sendChatAction', {
  1816	          chat_id: this.config.chatId,
  1817	          message_thread_id: this.config.lifelineTopicId,
  1818	          action: 'typing',
  1819	        });
  1820	        console.log(`[telegram] Lifeline topic verified (retry succeeded): ${this.config.lifelineTopicId}`);
  1821	        return this.config.lifelineTopicId;
  1822	      } catch (e) {
  1823	        // @silent-fallback-ok — error assigned to retryErr, reported to DegradationReporter below
  1824	        retryErr = e;
  1825	      }
  1826	      DegradationReporter.getInstance().report({
  1827	        feature: 'Telegram.Lifeline',
  1828	        primary: 'Verified lifeline topic for emergency agent communication',
  1829	        fallback: 'Using unverified (possibly stale) lifeline topic ID',
  1830	        reason: `Lifeline topic check failed after retry: ${retryErr instanceof Error ? retryErr.message : String(retryErr)}`,
  1831	        impact: 'Lifeline may be unreachable — messages to agent could fail silently.',
  1832	      });
  1833	      return this.config.lifelineTopicId;
  1834	    }
  1835	  }
  1836	
  1837	  /**
  1838	   * Persist the Lifeline topic ID back to config.json so it survives restarts.
  1839	   */
  1840	  private persistLifelineTopicId(topicId: number): void {
  1841	    try {
  1842	      // Find config.json in state dir's parent (stateDir is .instar/state or .instar)
  1843	      const candidates = [
  1844	        path.join(this.stateDir, '..', 'config.json'),
  1845	        path.join(this.stateDir, 'config.json'),
  1846	      ];
  1847	      for (const configPath of candidates) {
  1848	        if (fs.existsSync(configPath)) {
  1849	          const raw = fs.readFileSync(configPath, 'utf-8');
  1850	          const config = JSON.parse(raw);
  1851	          // Find the telegram messaging config and update it
  1852	          if (Array.isArray(config.messaging)) {
  1853	            const telegramEntry = config.messaging.find(
  1854	              (m: { type: string }) => m.type === 'telegram'
  1855	            );
  1856	            if (telegramEntry?.config) {
  1857	              telegramEntry.config.lifelineTopicId = topicId;
  1858	              const tmpPath = `${configPath}.${process.pid}.tmp`;
  1859	              fs.writeFileSync(tmpPath, JSON.stringify(config, null, 2));
  1860	              fs.renameSync(tmpPath, configPath);
  1861	              console.log(`[telegram] Saved lifelineTopicId=${topicId} to config`);
  1862	              return;
  1863	            }
  1864	          }
  1865	        }
  1866	      }
  1867	    } catch (err) {
  1868	      // @silent-fallback-ok — config persistence, in-memory ok
  1869	      console.warn(`[telegram] Failed to persist lifelineTopicId: ${err}`);
  1870	    }
  1871	  }
  1872	
  1873	  // ── Dashboard Topic ──────────────────────────────────────────────────
  1874	
  1875	  /**
  1876	   * Get the Dashboard topic ID (if configured).
  1877	   */
  1878	  getDashboardTopicId(): number | undefined {
  1879	    return this.config.dashboardTopicId;
  1880	  }
  1881	
  1882	  /**
  1883	   * Whether the chat supports forum topics. False if we detected
  1884	   * "the chat is not a forum" from the Telegram API.
  1885	   */
  1886	  get isForumChat(): boolean {
  1887	    return !this.notAForum;
  1888	  }
  1889	
  1890	  /**
  1891	   * Ensure the Dashboard topic exists. Creates it on first run, verifies on restart.
  1892	   * Same resilience pattern as the lifeline topic.
  1893	   */
  1894	  async ensureDashboardTopic(): Promise<number | null> {
  1895	    if (this.notAForum) return null;
  1896	    const styledName = `${TOPIC_STYLE.INFO.emoji} Dashboard`;
  1897	    if (!this.config.dashboardTopicId) {
  1898	      try {
  1899	        const topic = await this.createForumTopic(styledName, TOPIC_STYLE.INFO.color, { origin: 'system', bounded: true, label: 'dashboard' });
  1900	        this.config.dashboardTopicId = topic.topicId;
  1901	        this.persistDashboardTopicId(topic.topicId);
  1902	        console.log(`[telegram] Created Dashboard topic: ${topic.topicId}`);
  1903	
  1904	        // Send a one-time setup hint: mute this topic to avoid unread badges.
  1905	        // The bot can't mute topics for users (client-side setting), so we guide them.
  1906	        try {
  1907	          await this.sendToTopic(topic.topicId, [
  1908	            '💡 *Tip*: Mute this topic to avoid notification badges.',
  1909	            '',
  1910	            'Long-press this topic → Mute → Forever.',
  1911	            '',
  1912	            '_The latest dashboard link will always be pinned here._',
  1913	          ].join('\n'), { silent: true });
  1914	        } catch {
  1915	          // @silent-fallback-ok — guidance message is nice-to-have
  1916	        }
  1917	
  1918	        return topic.topicId;
  1919	      } catch (err) {
  1920	        DegradationReporter.getInstance().report({
  1921	          feature: 'TelegramAdapter.ensureDashboardTopic',
  1922	          primary: 'Create Dashboard forum topic for status messages',
  1923	          fallback: 'Dashboard topic unavailable, status messages have no destination',
  1924	          reason: `Failed to create Dashboard topic: ${err instanceof Error ? err.message : String(err)}`,
  1925	          impact: 'Dashboard status messages and pinned URLs will not be delivered',
  1926	        });
  1927	        return null;
  1928	      }
  1929	    }
  1930	
  1931	    // Dashboard topic ID exists — verify it's still valid
  1932	    try {
  1933	      await this.apiCall('sendChatAction', {
  1934	        chat_id: this.config.chatId,
  1935	        message_thread_id: this.config.dashboardTopicId,
  1936	        action: 'typing',
  1937	      });
  1938	      // Best-effort rename to styled name
  1939	      const currentName = this.topicToName.get(this.config.dashboardTopicId);
  1940	      if (currentName && !currentName.includes(TOPIC_STYLE.INFO.emoji)) {
  1941	        await this.editForumTopic(this.config.dashboardTopicId, styledName, TOPIC_STYLE.INFO.color);
  1942	      }
  1943	      return this.config.dashboardTopicId;
  1944	    } catch (err) {
  1945	      // @silent-fallback-ok — self-healing: attempts topic recreation on deletion, returns existing ID for transient errors
  1946	      const errStr = String(err);
  1947	      if (errStr.includes('thread not found') || errStr.includes('TOPIC_DELETED') ||
  1948	          errStr.includes('TOPIC_CLOSED') || errStr.includes('not found')) {
  1949	        console.log(`[telegram] Dashboard topic ${this.config.dashboardTopicId} was deleted — recreating`);
  1950	        try {
  1951	          const topic = await this.createForumTopic(styledName, TOPIC_STYLE.INFO.color, { origin: 'system', bounded: true, label: 'dashboard' });
  1952	          this.config.dashboardTopicId = topic.topicId;
  1953	          this.persistDashboardTopicId(topic.topicId);
  1954	          return topic.topicId;
  1955	        } catch (recreateErr) {
  1956	          DegradationReporter.getInstance().report({
  1957	            feature: 'TelegramAdapter.ensureDashboardTopic',
  1958	            primary: 'Recreate deleted Dashboard forum topic',
  1959	            fallback: 'No dashboard topic available, returning null',
  1960	            reason: `Recreation failed: ${recreateErr instanceof Error ? recreateErr.message : String(recreateErr)}`,
  1961	            impact: 'Dashboard status messages and pinned URLs will not be delivered until next restart',
  1962	          });
  1963	          return null;
  1964	        }
  1965	      }
  1966	      return this.config.dashboardTopicId;
  1967	    }
  1968	  }
  1969	
  1970	  /**
  1971	   * Broadcast the dashboard URL to the Dashboard topic.
  1972	   *
  1973	   * Edit-in-place pattern: instead of posting a new message each restart (which
  1974	   * creates unread badges), we edit the existing pinned message. This means the
  1975	   * Dashboard topic never shows as "unread" — it's a quiet reference the user
  1976	   * checks when they need the link.
  1977	   *
  1978	   * Fallback: if the pinned message was deleted or doesn't exist yet, we send
  1979	   * a new one, pin it, and save its ID for future edits.
  1980	   */
  1981	  async broadcastDashboardUrl(url: string, tunnelType: 'quick' | 'named'): Promise<DashboardBroadcastResult> {
  1982	    const topicId = this.config.dashboardTopicId;
  1983	    if (!topicId) {
  1984	      throw new Error('Dashboard topic is not configured; create or repair the Dashboard forum topic before refreshing the pinned link');
  1985	    }
  1986	
  1987	    // Resolve a REAL PIN — never leak the internal placeholder to the user.
  1988	    // A null result means honestly omit the PIN line — see formatDashboardMessage.
  1989	    const pin = this.resolvedDashboardPin();
  1990	    const isNamed = tunnelType === 'named';
  1991	    const warnings: string[] = [];
  1992	
  1993	    const message = this.formatDashboardMessage(url, pin, isNamed);
  1994	
  1995	    // Try to edit the existing pinned message (no new message = no unread badge)
  1996	    const existingMessageId = this.loadDashboardMessageId();
  1997	    if (existingMessageId) {
  1998	      try {
  1999	        await this.apiCall('editMessageText', {
  2000	          chat_id: this.config.chatId,
  2001	          message_id: existingMessageId,
  2002	          text: message,
  2003	          parse_mode: 'Markdown',
  2004	        });
  2005	        console.log(`[telegram] Edited dashboard message ${existingMessageId} in-place`);
  2006	        return { edited: true, messageId: existingMessageId, warnings }; // Success — no new message, no unread badge
  2007	      } catch (err) {
  2008	        // Edit failed — message was deleted, or content unchanged. Fall through to send new.
  2009	        const errStr = String(err);
  2010	        if (errStr.includes('message is not modified')) {
  2011	          console.log(`[telegram] Dashboard message unchanged — skipping`);
  2012	          return { edited: true, messageId: existingMessageId, warnings };
  2013	        }
  2014	        console.log(`[telegram] Dashboard message ${existingMessageId} edit failed, sending new: ${errStr}`);
  2015	        warnings.push(`existing pinned message edit failed: ${errStr}`);
  2016	      }
  2017	    }
  2018	
  2019	    // Fallback: send a new message, pin it, and save for future edits
  2020	    try {
  2021	      const result = await this.sendToTopic(topicId, message, { silent: true });
  2022	
  2023	      if (result.messageId) {
  2024	        // Unpin old pins, then pin the new message
  2025	        try {
  2026	          await this.apiCall('unpinAllForumTopicMessages', {
  2027	            chat_id: this.config.chatId,
  2028	            message_thread_id: topicId,
  2029	          });
  2030	        } catch {
  2031	          // @silent-fallback-ok — unpinning old messages is best-effort
  2032	        }
  2033	
  2034	        try {
  2035	          await this.apiCall('pinChatMessage', {
  2036	            chat_id: this.config.chatId,
  2037	            message_id: result.messageId,
  2038	            disable_notification: true,
  2039	          });
  2040	        } catch (err) {
  2041	          warnings.push(`pinChatMessage failed: ${err instanceof Error ? err.message : String(err)}`);
  2042	        }
  2043	
  2044	        // Save message ID for future edit-in-place
  2045	        this.saveDashboardMessageId(result.messageId);
  2046	      }
  2047	      return { edited: false, messageId: result.messageId, warnings };
  2048	    } catch (err) {
  2049	      const detail = err instanceof Error ? err.message : String(err);
  2050	      console.error(`[telegram] Failed to broadcast dashboard URL: ${detail}`);
  2051	      throw new Error(`Telegram dashboard broadcast failed: ${detail}`);
  2052	    }
  2053	  }
  2054	
  2055	  /**
  2056	   * Resolve the dashboard PIN for the broadcast: the in-memory config value
  2057	   * first (the normal path — already resolved from the vault by loadConfig),
  2058	   * then a fresh vault read so a transient boot-time secret-resolution failure
  2059	   * still yields the real PIN (the 2026-06-06 topic-5 placeholder-leak
  2060	   * incident). Returns null when no real PIN is available; the broadcast then
  2061	   * omits the PIN line rather than ever emitting the internal placeholder.
  2062	   */
  2063	  private resolvedDashboardPin(): string | null {
  2064	    return pickDashboardPin(this.config.dashboardPin, this.stateDir);
  2065	  }
  2066	
  2067	  private formatDashboardMessage(url: string, pin: string | null, isNamed: boolean): string {
  2068	    const dashboardUrl = url + '/dashboard';
  2069	    const quickLinks = [
  2070	      `Sessions: ${dashboardUrl}?tab=sessions`,
  2071	      `Files: ${dashboardUrl}?tab=files`,
  2072	    ];
  2073	
  2074	    // A null PIN means the value could not be resolved. NEVER substitute an
  2075	    // internal placeholder (the 2026-06-06 leak) — show an honest, actionable
  2076	    // line the user can act on instead.
  2077	    const pinLine = pin
  2078	      ? `PIN: \`${pin}\``
  2079	      : `_PIN unavailable right now — ask me for your dashboard PIN and I'll send it._`;
  2080	
  2081	    if (isNamed) {
  2082	      return [
  2083	        '*Dashboard*',
  2084	        '',
  2085	        `Your permanent dashboard link:`,
  2086	        dashboardUrl,
  2087	        '',
  2088	        pinLine,
  2089	        '',
  2090	        `Quick links:`,
  2091	        ...quickLinks.map(l => `  ${l}`),
  2092	        '',
  2093	        `_This link is permanent — it won't change on restart._`,
  2094	      ].join('\n');
  2095	    }
  2096	    return [
  2097	      '*Dashboard*',
  2098	      '',
  2099	      `Your dashboard is live:`,
  2100	      dashboardUrl,
  2101	      '',
  2102	      pinLine,
  2103	      '',
  2104	      `Quick links:`,
  2105	      ...quickLinks.map(l => `  ${l}`),
  2106	      '',
  2107	      `_This link changes when the server restarts._`,
  2108	      `_For a permanent link, ask me to set up a named tunnel._`,
  2109	    ].join('\n');
  2110	  }
  2111	
  2112	  private loadDashboardMessageId(): number | null {
  2113	    try {
  2114	      const statePath = path.join(this.stateDir, 'state', 'dashboard-message.json');
  2115	      if (fs.existsSync(statePath)) {
  2116	        const data = JSON.parse(fs.readFileSync(statePath, 'utf-8'));
  2117	        return data.messageId ?? null;
  2118	      }
  2119	    } catch {
  2120	      // @silent-fallback-ok — missing state file means first run
  2121	    }
  2122	    return null;
  2123	  }
  2124	
  2125	  private saveDashboardMessageId(messageId: number): void {
  2126	    try {
  2127	      const stateSubdir = path.join(this.stateDir, 'state');
  2128	      fs.mkdirSync(stateSubdir, { recursive: true });
  2129	      const statePath = path.join(stateSubdir, 'dashboard-message.json');
  2130	      const tmpPath = `${statePath}.${process.pid}.tmp`;
  2131	      fs.writeFileSync(tmpPath, JSON.stringify({ messageId, savedAt: new Date().toISOString() }));
  2132	      fs.renameSync(tmpPath, statePath);
  2133	    } catch (err) {
  2134	      console.warn(`[telegram] Failed to save dashboard message ID: ${err}`);
  2135	    }
  2136	  }
  2137	
  2138	  /**
  2139	   * Persist the Dashboard topic ID back to config.json.
  2140	   */
  2141	  private persistDashboardTopicId(topicId: number): void {
  2142	    try {
  2143	      const candidates = [
  2144	        path.join(this.stateDir, '..', 'config.json'),
  2145	        path.join(this.stateDir, 'config.json'),
  2146	      ];
  2147	      for (const configPath of candidates) {
  2148	        if (fs.existsSync(configPath)) {
  2149	          const raw = fs.readFileSync(configPath, 'utf-8');
  2150	          const config = JSON.parse(raw);
  2151	          if (Array.isArray(config.messaging)) {
  2152	            const telegramEntry = config.messaging.find(
  2153	              (m: { type: string }) => m.type === 'telegram'
  2154	            );
  2155	            if (telegramEntry?.config) {
  2156	              telegramEntry.config.dashboardTopicId = topicId;
  2157	              const tmpPath = `${configPath}.${process.pid}.tmp`;
  2158	              fs.writeFileSync(tmpPath, JSON.stringify(config, null, 2));
  2159	              fs.renameSync(tmpPath, configPath);
  2160	              console.log(`[telegram] Saved dashboardTopicId=${topicId} to config`);
  2161	              return;
  2162	            }
  2163	          }
  2164	        }
  2165	      }
  2166	    } catch (err) {
  2167	      console.warn(`[telegram] Failed to persist dashboardTopicId: ${err}`);
  2168	    }
  2169	  }
  2170	
  2171	  /**
  2172	   * Close a forum topic.
  2173	   */
  2174	  async closeForumTopic(topicId: number): Promise<boolean> {
  2175	    try {
  2176	      await this.apiCall('closeForumTopic', {
  2177	        chat_id: this.config.chatId,
  2178	        message_thread_id: topicId,
  2179	      });
  2180	      return true;
