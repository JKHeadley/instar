  1240	  /** Resume the inbound loop from exactly the given position. */
  1241	  async resumeConsuming(position: IngressPosition): Promise<void> {
  1242	    if (position.platform !== 'telegram') {
  1243	      throw new Error(`resumeConsuming: wrong platform ${position.platform} for telegram adapter`);
  1244	    }
  1245	    const cursor = typeof position.cursor === 'number' ? position.cursor : Number(position.cursor);
  1246	    if (Number.isFinite(cursor) && cursor >= 0) {
  1247	      // Resume from exactly this offset (never lower than what we know, to avoid replay).
  1248	      this.lastUpdateId = Math.max(this.lastUpdateId, cursor);
  1249	      this.saveOffset();
  1250	    }
  1251	    if (!this.polling) {
  1252	      await this.start();
  1253	    }
  1254	  }
